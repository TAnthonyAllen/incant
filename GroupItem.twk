include groupIncludes

/******************************************************************************
	A group.
******************************************************************************/
class GroupItem
{
GroupBody       groupBody;
GroupItem	    parent,
                nextInParent,
                priorInParent;
RuleStuff       rStuff;
JitData         jitData;
boolean GroupOptions {
    affiliation:2[isAttribute isMember isEmbedded]
    isCopy } options;
#autoGetSet

/*******************************************************************************
                                GroupItem
    GroupItem constructors
*******************************************************************************/
GroupItem()
{
    groupBody   = new;
    isSingleton = true;
}

GroupItem(String c)
{
    groupBody   = new(c);
    isSingleton = true;
}

/******************************************************************************
                                GroupItem
    Copy constructor. Changes to this group will change the group passed in and
    vice versa. This group will have no parent (that will change as soon as it
    is added to another). The affiliation remains the same pending any change
    in parent.
******************************************************************************/
GroupItem(GroupItem grup)
{
    groupBody   = grup.groupBody;
    isCopy      = true;
    if grup.rStuff {
        rStuff  = new(this);
        *rStuff = *grup.rStuff;
        rule    = this;
        followed = isOK = sukcess = false; }
}

/***************************************************************************
                                addAttribute
	Add an attribute.
***************************************************************************/
GroupItem addAttribute(GroupItem grup)
{
    if !grup            return null;
    if grup.mergeOn && mergeOn { merge(grup); return this; }
    grup                = addGroup(grup);
    grup.isAttribute	= true;
    hasAttributes       = true;
    /***************************************************************
        hasTraits is set if the field passed in is not noPrint-class.
    ***************************************************************/
    if !grup.noPrint    hasTraits = true;
	return grup;
}

/***************************************************************************
                                addGroup
	Add a group to this group. Should only be called from addAttribute()
    or addMember().
***************************************************************************/
GroupItem addGroup(GroupItem group)
{
	if group
        {
        if !groupList   groupList = new(this);
        if group == this
            {
            cerr "GroupItem add: Tried to add " group.tag " to itself\n";
            return null;
            }
        if isREGISTRY || isCLASS
            if !group.registry      group.registry = this;
        /***************************************************************
            The following handles adding an attribute or member.
            Note: if group has a parent it gets copied (using new) before
            it is added.
        ***************************************************************/
        if group.parent             group = new(group);
        group.parent    = this;
        if isSorted || actionType
                put(group);
        else    push(group);
        isInitialized   = true;
        if !isREGISTRY && group.registry && group.registry["grouped"]
            group += this;
        if binType {
            PLGset binGuard = guardSet;
            altered         = true;
            set((int)*group.tag);
            binGuard        = characterSet;
            setSimple(group.tag);
            if isIndexed    group.count = listLength; }
            }
	return group;
}

/***************************************************************************
                                addMember
	Add a member.
***************************************************************************/
GroupItem addMember(GroupItem grup)
{
    if !grup            return null;
    grup                = addGroup(grup);
    grup.isMember       = true;
    hasMembers          = true;
    isSingleton         = false;
	return grup;
}

/***************************************************************************
                                addString
	Adds an attribute, or if this is a container (binType), adds a member.
    If the entry already exists, returns it,
***************************************************************************/
GroupItem addString(String n)
{
GroupItem	group;
	if n {
        group = getFromList(n);
        if !group
            {
            group   = new(n);
            if binType  group = addMember(group);
            else        group = addAttribute(group);
           }
        }
	return group;
}

/***************************************************************************
                                allAttributesOptional
    // allAttributesOptional an attribute with no rStuff counts as MANDATORY -- not yet known is not the same as optional
***************************************************************************/
int allAttributesOptional()
{
GroupItem   attr;
    while attr = nextAttribute(attr)
        if !attr.rStuff || attr.min     return false;
    return true;
}

/*****************************************************************************
                                append
	Append the group passed in to this one. Does not care if there is no
    parent (does not increment parent or listLength).
*****************************************************************************/
void append(GroupItem grup)
{
    grup.priorInParent  = this;
    grup.nextInParent   = nextInParent;
    if nextInParent     nextInParent.priorInParent  = grup;
    or parent           parent.lastInList = grup;
	nextInParent		= grup;
}

/***************************************************************************
                                attachLabel
    // attachLabel the yield protocol IS the skip -- NULL failed, labelNO yields nothing, anything else
    // attachLabel attaches. Do not reach for a flag here, it was falsified fleet-wide
***************************************************************************/
void attachLabel(RuleStuff stuff, RuleStuff pStuff, int promote)
{
GroupRules  ruler = groupRules;
GroupItem   lab = stuff.label;
    if !lab || lab == labelNO   return;
    if !pStuff                  return;
    // caseLocalizer parseTrace-gated -- the interesting failure is a SILENT return at the no-label guard, and
    // caseLocalizer an absent attach announces nothing on its own
    if parseTrace
        cerr "    attachLabel lab=" lab.tag " promote=" promote " isTarget=" stuff.isTarget " pLabel=" (pStuff.label != 0) " pRule=" pStuff.ruleName "\n";
    // promoteUnguarded promotion is an assign and is NOT guarded on the destination -- a parent with no label
    // promoteUnguarded yet is the normal case here, and this is what gives it one
    // pc1Restated the disjunct is PC-1 RESTATED, not loosened -- the forbidden consult is the one where a
    // pc1Restated parent label exists, because that is the one with a subtree to destroy
    if (promote || !pStuff.label) && stuff.isTarget {
        pStuff.label    = lab;
        lab.tag         = pStuff.ruleName;
        return; }
    // attachGuardHere the guard belongs HERE and not above the promote case -- both placements were measured
    // attachGuardHere and each crashes the fleet the other way, three lines apart
    // ia2Narrow the landed spelling is the NARROW one -- the broad one was also green and was rejected
    // ia2Narrow because ZERO of 216 calls fell in the cell where the two differ
    if !pStuff.label {
        // dropSiteProbe parseTrace-gated -- at the instant an option's label is dropped, is there a reachable
        // dropSiteProbe destination in the frame, or is the label simply homeless
-%
        if ( GroupControl::groupController->groupRules->parseTrace )
            {
            const char *pName  = pStuff->ruleName ? pStuff->ruleName : "(none)";
            const char *pPar   = pStuff->parentLabel ? pStuff->parentLabel->groupBody->tag : "(null)";
            const char *ppName = (pStuff->parentStuff && pStuff->parentStuff->ruleName)
                                 ? pStuff->parentStuff->ruleName : "(none)";
            const char *ppLab  = (pStuff->parentStuff && pStuff->parentStuff->label)
                                 ? pStuff->parentStuff->label->groupBody->tag : "(null)";
            const char *sPar   = stuff->parentLabel ? stuff->parentLabel->groupBody->tag : "(null)";
            ::fprintf(stderr,"    IA2 DROP  lab=%s  pRule=%s  pStuff.parentLabel=%s  pStuff.parentStuff=%s pp.label=%s  stuff.parentLabel=%s\n",
                lab->groupBody->tag,pName,pPar,ppName,ppLab,sPar);
            }
%-
        // rung2bRed reachable is not correct -- an alternation must YIELD its winning option's label upward,
        // rung2bRed never park it in the grandparent's subtree
        return; }
    if promote && lab.isGROUP && stuff.max > 1 {
        pStuff.label    +% lab.group;
        lab.clear();
        lab.fLAG        = true;
        return; }
    pStuff.label +% lab;
}

/***************************************************************************
                                captureSpan
    // captureSpan the formula is THIS chair's -- from the action's chair the same rule reads the other way
    // captureSpan round, so the action-chair spelling must never be copied here
***************************************************************************/
void captureSpan(RuleStuff stuff)
{
GroupRules  ruler = groupRules;
GroupItem   label = stuff.label;
String      spanFrom = stuff.hereAt;
String      spanTo   = ruler.atRuleMark;
int         spanLen;
    if !label       return;
    if !spanFrom    return;
    if !spanTo      return;
    spanLen = (int)(spanTo - spanFrom);
    if spanLen < 0  return;
-%
    // oracleBeforeWrite the comparator samples the product BEFORE the write below, or it compares this function
    // oracleBeforeWrite to itself and reads MATCH forever
    if ( GroupControl::groupController->groupRules->parseTrace )
        {
        int   shipLen  = isTOKEN(label->groupBody->flags.data) ? label->groupBody->gCount : -1;
        char *shipFrom = isTOKEN(label->groupBody->flags.data) ? label->groupBody->gText : 0;
        const char *verdict;
        if ( !shipFrom )                                   verdict = "ORACLE-ABSENT";
        else if ( shipLen <= 0 && spanLen <= 0 )           verdict = "VOID-bothEmpty";
        else if ( shipLen != spanLen )                     verdict = "DIVERGE-len";
        else if ( ::strncmp(shipFrom,spanFrom,spanLen) )   verdict = "DIVERGE-bytes";
        else                                               verdict = "MATCH";
        ::fprintf(stderr,"CAPTURE %s rule=%s shipLen=%d spanLen=%d ship=[%.*s] span=[%.*s]\n",
            verdict, groupBody->tag ? groupBody->tag : "?", shipLen, spanLen,
            shipLen > 0 ? shipLen : 0, shipFrom ? shipFrom : "",
            spanLen > 0 ? spanLen : 0, spanFrom);
        }
%-
    label.setToken(spanFrom,spanLen);
}

/******************************************************************************
                                clear
    Clear list and data. Flags are not cleared, neither is rStuff.
******************************************************************************/
void clear()
{
    clearData();
    clearList();
}

/******************************************************************************
                                clearData
    Clears data. Does not clear pointer.
******************************************************************************/
void clearData()
{
    if !isPointer   gText = 0;
    data            = 0;
    gNumber         = 0;
}

/***************************************************************************
                                clearList
	Clear the list.
***************************************************************************/
void clearList()
{
    if !groupList   return;
    groupList       = 0;
    hasAttributes   = hasMembers = 0;
}

/*****************************************************************************
                                contents
	Returns true if this is a registry or data or has anything on its list
    If fLAG is set return true even without contents
*****************************************************************************/
int contents()
{
    if isREGISTRY || data           return true;
    if groupList && listLength      return true;
    return false;
}

/*****************************************************************************
                                copyData
	copyData copies data but not lists. Data type is changed to match input.
    It is called by setContent() which then copies list;
*****************************************************************************/
void copyData(GroupItem item)
{
    if item
        if !item.data   text = item.tag;
        else {
            data    = item.data;
            gText   = item.gText;
            gNumber = item.gNumber; }
    if data isInitialized   = true;
    else    isInitialized   = false;
    if hasListeners  updateListeners();
}

/*****************************************************************************
                                copyListFrom
    Copy the list of this from the list of the group passed in. The new entries
    have the same data content as the source entries (but they are copies
    so they have a new parent);
*****************************************************************************/
void copyListFrom(GroupItem grup)
{
GroupItem   fild,
            entry;
    clearList();
    if grup.groupList
        while entry = grup.next(entry) {
            if entry.groupList    fild = new(entry);
            else    fild = entry;
            if entry.isAttribute  addAttribute(fild);
            else    addMember(fild); }
}

/*****************************************************************************
                                copyListTo
    Copy this list into the grup passed in.
*****************************************************************************/
void copyListTo(GroupItem grup)
{
GroupItem   entry;
    if groupList
        while entry = next(entry)
            if entry.isAttribute    grup.addAttribute(entry);
            else    grup.addMember(entry);
}

/***************************************************************************
                                definingRule
    // definingRule the definer is the first child's PARENT, by pointer, with no name lookup -- and the test
    // definingRule discriminates, which is why it is unguarded on purpose
***************************************************************************/
GroupItem definingRule()
{
GroupItem   first = get(1);
GroupItem   owner;
    if first    owner = first.parent;
    if owner && owner != this   return owner;
    return this;
}

/*****************************************************************************
                                dispatch
	Run a group method in the dispatch Q
*****************************************************************************/
void dispatch()
{
DispatchQ   dq = dispatchQ;
    dq.data = (void*)this;
	if dispatchGroup dispatch_group_async_f(dispatchGroup,qu,dq.data,dispatcher);
	else dispatch_async_f(qu,dq.data,dispatcher);
}

/***************************************************************************
                                dQ
	Like pop treats the list as stack but pops off first item, not last.
***************************************************************************/
GroupItem dQ()
{
GroupItem   stuff;
    if firstInList {
        GroupItem   follows = firstInList.nextInParent;
        stuff       = firstInList.remove();
        if follows  follows.priorInParent = null;
        firstInList = follows;
        if !listLength  groupList = 0; }
    return stuff;
}

/*****************************************************************************
                                dumpField
	dumpField — debugging dump of one field: tag, data value, and (if it has
	a list) the member tags only. tok cousin of the incant dumpField action.
	Uses cerr (not print) so it never disturbs the sticky print default.
	Read-only; never mutates. Call as item.dumpField().
*****************************************************************************/
void dumpField()
{
GroupItem   grup;
	if groupList {
		cerr "  ",tag," | data=",getText()," | listLen=",listLength:;
		while grup = next(grup)
			cerr "      - ",grup.tag:; }
	else cerr "  ",tag," | data=",getText()," | (no list)":;
}

/***************************************************************************
                                embedRule
    embedRule -- THE ONE LEGITIMATE COPY OF AN EMBEDDED RULE, AND THE SOLE WRITER
    OF isEmbedded.   GroupItem.embedRule
***************************************************************************/
void embedRule(GroupItem g)
{
GroupItem   copy;
    if !g || !g.isRule  setGroup(g);
    else {
        copy            = new(g);
        copy.parent     = this;
        copy.isEmbedded = true;
        setGroup(copy); }
}

/***************************************************************************
                                ensureGuard
    // ensureGuard builds and memoises the guard set -- LINE 1 raises isRule on the SHARED body
***************************************************************************/
PLGset ensureGuard()
{
GroupRules  ruler = groupRules;
GroupItem   item;
PLGset      itemGuard;
String      junk;
int         noMoreAttributes;
    setRuleStuff();
    if guarding     goto returnGuard;
    if !isAttribute && !contents()  goto returnGuard;
    if isCondition {
        unGuarded = true;
        goto endSetGuard; }
use rStuff
use guardSet
    guardInProcess  = true;
    if isSET {
        guardSet   = characterSet;
        guarded     = true;
        goto endSetGuard; }
    guardSet = new();
    /***************************************************************************
        Handle data
    ***************************************************************************/
    if registry == opFields || (!data && !groupList) {
        set((int)*tag);
        goto endSetGuard; }
    if !binType
        if data {
            switch(data) {
                case isGROUP:
                    item = group;
                    itemGuard           = item.ensureGuard();
                    if item.guardInProcess  goto returnGuard;
                    if item.unGuarded   unGuarded = true;
                    else                guardSet += itemGuard;
                    if item.rStuff && item.min  goto endSetGuard;
                case isANY:
                case isBUFFER:
                case isITEM:
                case isMAP:
                case isOBJECT:
                case isREGEX:
                case isSTAK:
                    unGuarded = true;
                default:
                    if junk = text  set((int)*junk);
                    else            unGuarded = true; }
            if min  goto endSetGuard; }
        or !groupList   set((int)*tag);
    /***************************************************************************
        Handle hashes, attributes and members
    ***************************************************************************/
    if binType
        while item = next(item)     guardSet += *item.tag;
    else {
        if hasAttributes
            while item = nextAttribute(item) {
                if noMoreAttributes     break;
                if item.noPrint         continue;
                itemGuard       = item.ensureGuard();
                if item.isAttribute
                    if noMoreAttributes             continue;
                    or item.guardInProcess          goto returnGuard;
                    or item.guarded && item.min     noMoreAttributes = true;
                if item.unGuarded   unGuarded = true;
                if itemGuard        guardSet += itemGuard;
                if unGuarded    break; }
        item = 0;
        if hasMembers
            while item = nextMember(item)
                if item.contents()
                    if itemGuard = item.ensureGuard()  guardSet += itemGuard; }
    /***************************************************************************
        Rule guard set built. Assess result and see if we need to keep it.
    ***************************************************************************/
endSetGuard:
    if guardSet {
        if isEmpty()    guardSet    = 0;
        if guardSet {
            guardSet.name = tag " Guardset";
            guarded         = true;
            if isMember && parent.guardSet  parent.guardSet += guardSet; }}
    else unGuarded = true;
returnGuard:
    return  guardSet;
}

/*******************************************************************************
                                ensureRStuff
    // ensureRStuff the constructing half -- it is NOT setRuleStuff, whose second arm
    // re-clones an rStuff belonging to another node
*******************************************************************************/
RuleStuff ensureRStuff()
{
    if !rStuff {
        RuleStuff   fresh = new(this);
        setRStuff(fresh); }
    return rStuff;
}

/***************************************************************************
                                establishFrame
    // establishFrame the SINGLE WRITER of parentLabel, and there is deliberately no save/restore -- the callee
    // establishFrame lifts it at entry, so a parseMethod that reads it LATE is unsafe under recursion
***************************************************************************/
void establishFrame(GroupItem parentLabel)
{
    if rStuff   rStuff.parentLabel = parentLabel;
}

/*****************************************************************************
                                findAttribute
	Searches ancestors bottom up for the first attribute matching name.
    Keep in mind the parent hierarchy has to be reset first for this to work.
*****************************************************************************/
GroupItem findAttribute(String name)
{
GroupItem	result,
            group = this;
	while group
		{
        if result = group%name break;
		if group = group.parent
            if result = group.findAttribute(name) break;
		}
	return result;
}

/*****************************************************************************
                                findParent
	Returns the named parent.
*****************************************************************************/
GroupItem findParent(String name)
{
GroupItem	group = this;
    while group
        {
        if group.tag eq name
            break;
        group = group.parent;
        }
    return group;
}

/***************************************************************************
                                fireLabelMethod
    // fireLabelMethod returns NOTHING deliberately -- a null label already means
    // noLabel-on-success, so handing it back would be one channel with two meanings
***************************************************************************/
void fireLabelMethod(RuleStuff stuff)
{
GroupRules  ruler = groupRules;
    if !stuff.actionMethod {
        GroupItem   builtinActoR = getAttribute("builtinActoR");
        if builtinActoR stuff.actionMethod = builtinActoR.method; }
    ruleSTUFF   = stuff;
    // collisionProbe this seat stays ABOVE captureSpan, so the capture's own comparator
    // line prints inside the bracket
    measureFireLabelEntry(this);
    if tokened  captureSpan(stuff);
    measureFireLabelFork(this,stuff.label);
    if stuff.actionMethod && stuff.label {
        if deferred {
            stuff.label.method    = actionMethod;
            stuff.label.deferred  = true;
            if !stuff.label.data  stuff.label.text = "g" tag; }
        or !parseACTION {
            // replacementReturn IN and OUT are two seats -- one read after the fire
            // cannot tell a replacement from a pass-through
            measureFireLabelActionIn(this,stuff.label);
            stuff.label = stuff.actionMethod(stuff.label);
            measureFireLabelActionOut(this,stuff.label);
            if !stuff.label   stuff.sukcess = false; }}
}

/***************************************************************************
                                firstComponent
	Returns first component with matching tag. Unlike get() it recurses and descends.
    This should check to make sure it does not search the same field more
    than once or it ends up in an infinite loop. TBD need a searchable Stak
***************************************************************************/
GroupItem firstComponent(String name)
{
GroupItem   grup;
GroupItem   entry = get(name);
    if !entry
        if groupList
            while entry = next(entry)
                if grup = entry.firstComponent(name) {
                    entry = grup;
                    break; }
    return entry;
}

/***************************************************************************
                                frameParent
    // frameParent it reads runRule's OWN argument, never the ruleSTUFF singleton -- a singleton answers what
    // frameParent happened last, never who is asking
***************************************************************************/
GroupItem frameParent(GroupItem holder)
{
RuleStuff   holderStuff;
    if !holder  return holder;
    holderStuff = holder.rStuff;
    if holderStuff && holderStuff.label     return holderStuff.label;
    return holder;
}

/***************************************************************************
                                get
	Returns first component with tag == name. The search does not descend.
***************************************************************************/
GroupItem get(String name)
{
GroupItem   entry;
    if name
        if groupList {
            if binType {
                if stakked                              return getFromStak(name);
                or guarded && !guardSet.contains(*name) return null; }
            if listLength
                while entry = next(entry)
                    if entry.tag eq name return entry; }
    return null;
}

/*****************************************************************************
                                get
    Return nth component if it exists. Not efficient unless this is stakked.
*****************************************************************************/
GroupItem get(int offset)
{
GroupItem   entry;
int         i;
    if offset && groupList {
        if stakked      return getFromStak(offset);
        or --offset <= listLength {
            entry = firstInList;
            while offset > i++
                entry = entry.nextInParent; }
        return entry; }
    return null;
}

/*****************************************************************************
                                getAttribute
	Get the named attribute. This will return an attribute even if the
	attribute noPrint flag is set.
*****************************************************************************/
GroupItem getAttribute(String name)
{
GroupItem   block;
    if name
        if block = get(name)
            if block.isAttribute return block;
    return null;
}

/*****************************************************************************
                                getBuffer
	Value getters
*****************************************************************************/
Buffer getBuffer()
{
	if isBUFFER
        return buffer;
	return 0;
}

char getCharacter()
{
String	atStart, atNext;
	if data
        if isCHAR   return character;
		or isSTRING && gCount == 1  atStart = gText;
	if atStart
		{
		if atStart != '\\' return *atStart;
		else {
            atNext = atStart + 1;
            switch(*atNext)
                {
                case 'n':   return '\n';
                case 'r':   return '\r';
                case 'f':   return '\f';
                case 't':   return '\t';
                case '\\':  return '\\';
                default:    return *atNext;
                }
            }
		}
	return null;
}

PLGset getCharacterSet()
{
	if isSET
        return characterSet;
	return 0;
}

int getCount()
{
    if data
        {
        if isCOUNT || isTOKEN || isCHAR || isSTRING return count;
        // roundHalfUp THE site -- every .count read of a double lands here, and it is floor(x+0.5) and NOT
        // roundHalfUp lround, which rounds half AWAY from zero and would send -2.5 to -3
        if isNUMBER     return (int)floor(number + 0.5);
        if isBUFFER     return buffer.length();
        if isGROUP {
        cerr "ERROR getCount on",tag,"-- holds a group; say *":;
        return 0; }
        }
	return 0;
}

int getDataType()
{
    if isGROUP
        if group == this return 0;
    else {
        cerr "ERROR getDataType on",tag,"-- holds a group; say *":;
        return 0; }
    return data;
}

/***************************************************************************
                                getFromList
	Returns first component with tag == name. The search does not descend.
    Called from put() because unlike get() it does not search stakked.
***************************************************************************/
GroupItem getFromList(String name)
{
GroupItem   entry;
    if name
        if groupList
            if guarded && !guardSet.contains(*name) return null;
            or listLength
                while entry = next(entry)
                    if entry.tag eq name return entry;
    return null;
}

/*****************************************************************************
                                getGroup
	Need to test how getMacro works in this case
*****************************************************************************/
GroupItem getGroup()
{
	if isGROUP  return gGroup;
	return 0;
}

/***************************************************************************
                                getGuard
    // getGuard a PURE read -- it builds NOTHING; ensureGuard is what constructs
***************************************************************************/
PLGset getGuard()
{
    return guardSet;
}

PLGitem getItem()
{
	if isITEM || isDate return item;
    if isGROUP {
        cerr "ERROR getItem on",tag,"-- holds a group; say *":;
        return 0; }
	return 0;
}

/***************************************************************************
                                getLabelGroup
	Initializer method for accessing rule results (used in rule actions);
***************************************************************************/
GroupItem getLabelGroup(String name)
{
GroupItem   block = get(name);
    while block && block.isGROUP && !block.isMethod && !block.isRule
        block = block.group;
    return block;
}

/*****************************************************************************
                                getMember
	Return the member matching the tag passed in.
*****************************************************************************/
GroupItem getMember(String name)
{
    if name && hasMembers
        {
        GroupItem    block = get(name);
        if block && block.isMember return block;
        }
    return null;
}

double getNumber()
{
    if data
        {
        if isNUMBER  return number;
        if isCOUNT   return (double)count;
        if isGROUP {
            cerr "ERROR getNumber on",tag,"-- holds a group; say *":;
            return 0; }
        }
	return 0;
}

Object getObject()
{
	if isOBJECT return object;
    if isGROUP {
        cerr "ERROR getObject on",tag,"-- holds a group; say *":;
        return 0; }
	return 0;
}

void *getPointer()
{
    if isPointer    return pointer;
	return 0;
}

PLGrgx getRegex()
{
	if isREGEX return regex;
	return 0;
}

/*******************************************************************************
                                getRStuff
    // getRStuff a PURE getter -- it does not construct, and no miss-complaint belongs
    // in this seat: every caller is asking whether there is one
*******************************************************************************/
RuleStuff getRStuff()
{
    return rStuff;
}

Stak getStak()
{
	if isSTAK return stak;
	return 0;
}

/*******************************************************************************
                                getStuff
	Returns rStuff unless it is inProcess, IWC returns a fresh copy of rStuff
*******************************************************************************/
RuleStuff getStuff(RuleStuff pStuff)
{
    // lazyMaterialisation it asks ensureRStuff BY NAME -- a node arriving with no rStuff is the parser's design,
    // lazyMaterialisation not a mis-use to be repaired
RuleStuff   stuff = ensureRStuff();
    if stuff.rule != this || stuff.inProcess {
        stuff       = new(rStuff);
        stuff.rule  = this; }
    if parentStuff = pStuff
        parentLabel = parentStuff.label;
    if !followed    getWhatFollows();
    return stuff;
}

/*****************************************************************************
                                getText
	getText does what it can to return the contents of this group as text.
    Note: if has text but is not a string, text is ignored.
*****************************************************************************/
String getText()
{
String      junkText;
    if isTOKEN
        {
        junkText = malloc(count + 1);
        strncpy(junkText,gText,count);
        *(junkText + count) = 0;
        }
	or data && !binType
		switch(data ){
            case isSTRING:
                if text     junkText = text;
                else        data = 0;
            case isCOUNT:
            case isNUMBER:
                junkText = malloc(20);
                if isCOUNT	print(junkText) count;
                or isNUMBER	print number;
                if isPercent strcat(junkText,"%");
            // printDoesNotFollow print reads the TAG of a held field and never follows
            // gGroup -- cyclic chains are legal data, so no overflow guard belongs here
            case isGROUP:   if group    junkText =  group.tag;
            case isSET:     junkText = characterSet.name;
            case isBUFFER:  junkText = buffer.toString();
            case isITEM:    junkText = item.toString();
            case isCHAR:
                junkText        = malloc(2);
                *junkText       = character;
                *(junkText + 1) = 0;
            default:        junkText = tag "data type has no toString() method"; }
    or tag  junkText = tag;
	return  junkText;
}

/*****************************************************************************
                                insertAfter
    Insert grup into this's parent list immediately after this. Bookkeeping
    parallel: append() only adjusts sibling pointers, so this wraps it with
    parent/listLength/lastInList updates so the parent list stays consistent.
*****************************************************************************/
void insertAfter(GroupItem grup)
{
    append(grup);
    grup.parent = parent;
    if parent {
        parent.listLength++;
        if !grup.nextInParent   parent.lastInList = grup; }
}

/*****************************************************************************
                                insertGroup
	Insert an item at the beginning of this list. If list has entries and is
    sorted will throw an error and return null;
*****************************************************************************/
GroupItem insertGroup(GroupItem grup)
{
    if !groupList || !listLength    return addGroup(grup);
    if isSorted {
        cerr "insertGroup: cannot insert into a sorted list":;
        return 0; }
    if firstInList  firstInList.prepend(grup);
    else            firstInList = lastInList = push(grup);
    grup.parent = this;
    listLength++;
    return firstInList;
}

/***************************************************************************
                                makeRegistry
    Makes the group passed in a registry
***************************************************************************/
void makeRegistry()
{
    if groupList && listLength && !sortAscending
        cerr "ERROR makeRegistry: " tag " has unsorted list":;
    or !registries[tag]
        {
        /*******************************************************************
            Set the registry. Note: stakked is not set here, it is set
            after the registry is filled using the define command (if there
            are more than 10 members defined).
        *******************************************************************/
        isREGISTRY      = true;
        sortAscending   = true;
        if groupList && listLength {
            GroupItem   grup;
            guardSet    = new();
            while grup = next(grup) guardSet += *grup.tag;
            guarded = true; }
        registries      += this;
        registry        = this;
        }
    else cerr tag,"is already a registry":;
}

/*****************************************************************************
                                matches
    Returns true if this data matches data of the group passed in.
*****************************************************************************/
int matches(GroupItem arg)
{
String  thisString  = data ? text : tag;
String  argString   = arg.data ? arg.text : arg.tag;
    if data && data == arg.data
        switch(data)
            {
            case isCOUNT:
                return gCount == arg.gCount;
            case isNUMBER:
                return gNumber == arg.gNumber;
            case isITEM:
                return item.compare(arg.item) == 0;
            default:
                return compare(thisString,argString) == 0;
            }
    return  compare(thisString,argString) == 0;
}

/*****************************************************************************
                                matches
	Check to see if this matches the string passed in. If this has text
    it matches with the text, otherwise it matches the tag (registry matches
    are always against the tag). If this matches, returns the matching text
    and advances the stream pointer passed in.
*****************************************************************************/
String matches(String &atString)
{
String  atText      = text;
String  matchText   = atString;
String  atStart     = atText;
    while *atText
        if *atText == *atString {
            atText++;
            atString++;  }
        else break;
    if !*atText    return atStart;
    atString = matchText;
    return null;
}

/***************************************************************************
                                merge
	Merge group into this item. Does not add matching attributes.
***************************************************************************/
void merge(GroupItem group)
{
    if group && group.listLength
        {
        if group.hasAttributes mergeAttributes(group);
        if group.hasMembers
            {
            GroupItem	item;
            isSingleton = false;
            hasMembers  = true;
            while item = group.nextMember(item)
                addMember(item);
            }
        }
}

/***************************************************************************
                                mergeAttributes
	Merge attributes from the group passed in into this item. Does not add
    matching attributes.
***************************************************************************/
void mergeAttributes(GroupItem group,int mergeFlag)
{
GroupItem	existing,replacement,item;
	while item = group.nextAttribute(item)
        {
        existing        = getAttribute(item.tag);
		if !existing || (mergeFlag && existing != item)
            {
            /***************************************************************
                The following only happens if item is supposed to override
                an existing copy (based on the mergeFlag passed in)
            ***************************************************************/
            if existing existing.remove();
            /***************************************************************
                Note: if the attribute to be merged has its own attributes
                or members, the attributes and members are merged but not
                the attribute itself
            ***************************************************************/
            if item.mergeOn && item.listLength
                {
                merge(item);
                continue;
                }
            if !item.data
                {
                if replacement = locate(item.tag)
                    {
                    if replacement.mergeOn && replacement.listLength
                        {
                        merge(replacement);
                        continue;
                        }
                    }
                addAttribute(item);
                continue;
                }
            else addAttribute(item);
			}
        }
}

/***************************************************************************
                                moveTo
    Moves this group to the item passed in. No copy involved because remove
    clears the item parent.
***************************************************************************/
void moveTo(GroupItem item)
{
    remove();
    if isAttribute  item.addAttribute(this);
    else    item.addMember(this);
    updateContentFlags();
}

/***************************************************************************
                                next
	Iterates thru attributes and members. The group passed in is taken as
    the last item iterated. If it is null, the first entry found is returned.
***************************************************************************/
GroupItem next(GroupItem current)
{
    while current = nextGroup(current)
        if ignoreNoPrint && current.noPrint continue;
        else    break;
    return current;
}

/***************************************************************************
                                nextAttribute
	Iterates thru attributes. The group passed in is taken as the last item
	iterated. If it is null, the first attribute found is returned.
***************************************************************************/
GroupItem nextAttribute(GroupItem current)
{
    while current = nextGroup(current)
        if current.isAttribute break;
    return current;
}

/***************************************************************************
                                nextGroup
    Return the group following the group passed in. If a null group is
    passed in, returns the first group;
***************************************************************************/
GroupItem nextGroup(GroupItem grup)
{
    if groupList
        if grup return grup.nextInParent;
        else    return firstInList;
    else cerr "nextGroup: ERROR",tag,"does not contain a list":;
    return null;
}

/***************************************************************************
                                nextMember
	Iterates thru members. The group passed in is taken as the last member
	iterated thru. If it is null, the first member found is returned.
***************************************************************************/
GroupItem nextMember(GroupItem current)
{
    while current = nextGroup(current)
        if current.isMember break;
    return current;
}

/***************************************************************************
                                parse
    Treat this field as a rule and match it against the input stream.
***************************************************************************/
GroupItem parse(RuleStuff pStuff)
{
GroupItem   parentLabel;
GroupItem   definer;
GroupRules  ruler       = groupRules;
RuleStuff   defStuff;
RuleStuff   ruleStuff   = getStuff(pStuff);
    if pStuff   parentLabel = pStuff.label;
    kount       = 0;
    isOK        = false;
    inProcess   = true;
    //  genParseRuleAccess
    definer = definingRule();
    defStuff = definer.rStuff;
    // bindReadSeamProbe
    while !isOK && kount < maxRepeat {
continueHere:
        sukcess     = false;
        if !checkInput()    goto matchFailed;
        if hasMacro         setMacroValue(this);
        /*******************************************************************
            Run the matches that determine if this rule succeeds
            //runParseMatches
        *******************************************************************/
        if isRule && hasMembers && !data                            sukcess = testOptions(ruleStuff);
        or testMatch || onGroup || hasAttributes {
            if testMatch                                            sukcess = testMatch(this);
            if !parseACTION {
                if sukcess && onGroup && !onGroup.parse(ruleStuff)  sukcess = false;
                if sukcess && hasAttributes                         sukcess = testAttributes(ruleStuff); }}
        if !sukcess     goto matchFailed;
        /*******************************************************************
            Success. Fire label method if there is one.
        *******************************************************************/
        fireLabelMethod(ruleStuff);
        if sukcess {
            kount++;
            attachLabel(ruleStuff,pStuff,1); }
        else break; }
    if kount >= maxRepeat && maxRepeat > 1 && !limitsSet   reportRepeatLimit(rule,kount,maxRepeat);
matchFailed:
    if !sukcess {
        if !sukcess && kount >= min sukcess = true;
debugHere:
        if !*atRuleMark && inputDiverted {
            while inputDiverted && !*atRuleMark {
                lastIndent = 0;
                popInput(); }
            if sukcess && *atRuleMark   goto continueHere; }
        if !sukcess {
            failedAt    = atRuleMark;
            atRuleMark  = hereAt;
            if label    label = 0; }}
generatedExit:
    if !sukcess && notifyFail   aCTionFailed(rule);
    if sukcess && !label        label = labelNO;
    inProcess   = false;
    return label;
}

/***************************************************************************
                                pop
    Pop treats the list as a stack and pops off the last item.
***************************************************************************/
GroupItem pop()
{
GroupItem    stuff;
    if groupList && listLength {
        stuff = lastInList;
        if lastInList = stuff.priorInParent   lastInList.nextInParent = null;
        stuff.parent        = 0;
        stuff.priorInParent = 0;
        listLength--;
        if !listLength  groupList = 0; }
    return  stuff;
}

/*****************************************************************************
                                prepend
	Insert the group passed in before this one. Does not update listLength
    or parent (in case called from addHash).
*****************************************************************************/
void prepend(GroupItem grup)
{
    grup.priorInParent  = priorInParent;
	grup.nextInParent	= this;
    if priorInParent    priorInParent.nextInParent  = grup;
    or parent           parent.firstInList = grup;
	priorInParent		= grup;
}

/***************************************************************************
                                prior
    Return the group preceeding the group passed in. If a null group is
    passed in, returns the last group;
***************************************************************************/
GroupItem prior(GroupItem grup)
{
    if groupList
        if grup return grup.priorInParent;
        else    return lastInList;
    else cerr "nextGroup: ERROR",tag,"does not contain a list":;
    return null;
}

/*****************************************************************************
                                push
	Add to list. Does not care about duplicates. If sorted sorts in ascending
    order. next and prior methods flip if sort is descending.
*****************************************************************************/
GroupItem push(GroupItem grup)
{
int         comparison;
GroupItem   entry;
    if !groupList   groupList = new(this);
    entry = firstInList;
    if !grup
        {
        cerr "GroupBody add: tried to add a null entry":;
        return grup;
        }
    if isSorted
        {
        while entry
            {
            comparison = compare(grup.tag,entry.tag);
            if comparison > 0
                if entry = entry.nextInParent continue;
                else goto appendLink;
            or comparison == 0
                goto appendLink;
            else goto insertLink;
            }
        }
    else {
        if lastInList lastInList.append(grup);
        else    firstInList = grup;
        lastInList    = grup;
        goto finishAdd;
        }
appendLink:
    if entry    entry.append(grup);
    or lastInList {
        lastInList.append(grup);
        lastInList    = grup; }
    else {
        firstInList = lastInList = grup;
        grup.nextInParent   = null;
        grup.priorInParent  = null;
        }
    goto finishAdd;
insertLink:
    if entry    entry.prepend(grup);
    or firstInList    firstInList.prepend(grup);
    else {
        firstInList = lastInList = grup;
        grup.nextInParent   = null;
        grup.priorInParent  = null;
        }
finishAdd:
    listLength++;
    return grup;
}

/*****************************************************************************
                                put
	Adds an entry unless it already exists. No duplicates
*****************************************************************************/
void put(GroupItem grup)
{
    if !getFromList(grup.tag)   push(grup);
}

/*****************************************************************************
                                remove
	Remove this group from its parent list and return it.
*****************************************************************************/
GroupItem remove()
{
    if parent && parent.groupList
        {
        GroupItem   grup;
        if parent.listLength    parent.listLength--;
        if !parent.listLength   parent.clearList();
        else {
            if priorInParent    priorInParent.nextInParent = nextInParent;
            else parent.firstInList = nextInParent;
            if nextInParent     nextInParent.priorInParent = priorInParent;
            else parent.lastInList  = priorInParent;
            nextInParent            = priorInParent = null;
            if isAttribute {
                grup = parent.nextAttribute(grup);
                if !grup parent.hasAttributes = false; }
            or isMember {
                grup = parent.nextMember(grup);
                if !grup parent.hasMembers = false; }
            if parent.stakked   parent.altered = true;
            parent = null; }}
    return this;
}

/*****************************************************************************
                                remove
	Remove named group from this list, if there is a matching group on the list.
    Returns the removed group.
*****************************************************************************/
GroupItem remove(String name)
{
GroupItem   group = getFromList(name);
    if group group.remove();
    return  group;
}

/*****************************************************************************
                                replace
	If this contains an entry matching the tag of the argument passed in, replace
    the entry with the argument. If no matching entry, insert the argument.
*****************************************************************************/
GroupItem replace(GroupItem argument)
{
GroupItem   grup = getFromList(argument.tag);
    if grup grup.remove();
    if argument.isAttribute argument = addAttribute(argument);
    else                    argument = addMember(argument);
    return  argument;
}

/***************************************************************************
                                resolvedTag
    Returns the right tag in case of loadByValue groups
***************************************************************************/
String resolvedTag()
{
    if isAttribute && registry && registry%"loadByValue" return registry.tag;
    return tag;
}

/***************************************************************************
                                runNotified
    runNotified is called by updateListeners() to handle listener notifications.
***************************************************************************/
GroupItem runNotified(GroupItem notifier)
{
GroupItem onNotify = get("onNotify");
GroupItem action;
    if onNotify action = locate(onNotify.text);
    if action   return action.method(notifier);
    else        setContent(notifier);
    return this;
}

/*******************************************************************************
                                setActions
    setActions adds builtinActoR to contain rule action method. It is not
    a setter. The actionMethod field in rStuff gets set from it in
    fireLabelMethod
*******************************************************************************/
void setActions()
{
RuleStuff   ruleStuff = rStuff;
    if getAttribute("builtinActoR") return;
    if isCoded     method = processAction;
    or !isMethod {
        String  methodName = "aCTion" tag;
        void*   methodAddress;
        if methodAddress = dlsym(RTLD_SELF,methodName) {
            // markThenAdd noPrint is set BEFORE the node is attached, because addAttribute reads it at the instant of adding to decide hasTraits -- marking after is always too late (fixIts F-58)   GroupItem.setActions.markThenAdd
            GroupItem builtinActoR  = new("builtinActoR");
            builtinActoR.noPrint    = true;
            builtinActoR.rStuff     = ruleStuff;
            builtinActoR.method     = methodAddress;
            addAttribute(builtinActoR); }
        free(methodName);
        if gMethod  immediateACTION = true; }
    or gMethod {
        // registeredActor a ruleMethod= registration has ALREADY set gMethod, so the dlsym arm is skipped and NOTHING publishes the actor   GroupItem.setActions.registeredActor
        void*   actorAddress    = gMethod;
        // markThenAdd as the dlsym arm above -- noPrint before the attach, never after (fixIts F-58)
        GroupItem builtinActoR  = new("builtinActoR");
        builtinActoR.noPrint    = true;
        builtinActoR.rStuff     = ruleStuff;
        builtinActoR.method     = actorAddress;
        addAttribute(builtinActoR); }
}

/*****************************************************************************
                                setBuffer
	Value setters
*****************************************************************************/
void setBuffer(Buffer b)
{
    buffer      = b;
    if b        isBUFFER = true;
    else data   = 0;
    isInitialized   = true;
    if hasListeners updateListeners();
}

void setCharacter(char c)
{
    character   = c;
    if c        isCHAR = true;
    else data   = 0;
    isInitialized   = true;
    if hasListeners updateListeners();
}

void setCharacterSet(PLGset set)
{
    characterSet    = set;
    if set          isSET = true;
    else data       = 0;
    isInitialized   = true;
    if hasListeners updateListeners();
}

/*****************************************************************************
                                setContent
	setContent is not a setter. It updates data.
*****************************************************************************/
void setContent(GroupItem item)
{
    if item {
        if groupBody != item.groupBody
            if !item.contents() text = item.tag;
            else {
                if item.groupList   copyListFrom(item);
                if item.isGROUP     group = item.gGroup;
                or item.isBUFFER    text = item.text;
                or item.data        copyData(item); }
        else    cerr "setContent: tried to set group to itself",tag:; }
    else clearData();
}

void setCount(int i)
{
	isCOUNT = true;
    count   = i;
	if hasListeners  updateListeners();
    isInitialized   = true;
}

/***************************************************************************
                                setDebug
	Debug every component below this one.
***************************************************************************/
void setDebug()
{
GroupItem grup;
int debugStatus = debugged;
    while grup = next(grup) {
        if grup.noPrint continue;
        if grup.debugged == debugStatus continue;
        grup.debugged = !grup.debugged;
        if grup.groupList grup.setDebug(); }
}

void setGroup(GroupItem g)
{
    if !g {
        gGroup  = 0;
        data    = 0; }
    else {
        // selfAdd the self-add guard is RETIRED -- a one-element cycle is legal data and nothing follows
        // selfAdd gGroup transitively
        // setGroup NEVER copies; embedRule() owns the one legitimate copy   GroupItem.setGroup
        gGroup          = g;
        isInitialized   = true;
        isGROUP         = true;
        if hasListeners updateListeners(); }
}

void setItem(PLGitem i)
{
    item        = i;
	if i        isITEM = true;
    else groupBody.data   = 0;
    isInitialized = true;
    if hasListeners updateListeners();
}

void setJitEmitter(void* m)
{
    // noFlagSet it sets NO flag deliberately -- presence of the slot IS the gate, and the emitter rides
    // noFlagSet alongside the interpreter binding rather than replacing it
    -% groupBody->gJitEmitter = (GroupItem*(*)(GroupItem*,GroupItem*))m; %-
}

void setMap(BitMAP i)
{
    gMap        = i;
    if i        isMAP   = true;
    else data   = 0;
    isInitialized = true;
    if hasListeners updateListeners();
}

/***************************************************************************
                                setMethod
    // setMethod SYMMETRIC, and the sole maintainer of isMethod -- a raw gMethod write anywhere else
    // setMethod desynchronises the shape fact by construction
***************************************************************************/
void setMethod(GroupItem &m(GroupItem))
{
    method      = m;
    if m        isMethod = true;
    else        isMethod = false;
}

void setNumber(double d)
{
	isNUMBER    = true;
    number      = d;
	if hasListeners  updateListeners();
    isInitialized   = true;
}

void setObject(Object v)
{
    object      = v;
    if v        isOBJECT = true;
    else data   = 0;
    isInitialized = true;
    if hasListeners updateListeners();
}

void setOperat(void* m)
{
    isOperator  = true;
    // gOp by-ref: tok can't render a fnptr cast with a reference param (FormatC.twk bug).
    // Until that's fixed, take the dlsym result as void* and hand-cast it here in raw C++.
    // Revise to typed `void setOperat(GroupItem &m(GroupItem,GroupItem&)){ operat = m; }` post-fix.
    -% groupBody->gOp = (GroupItem*(*)(GroupItem*,GroupItem*))m; %-
}

/*******************************************************************************
                                setParseAction
    // setParseAction the ONE writer for a parseAction, on both roads -- it raises the flag,
    // setParseAction installs the method as the LEAF undisguised, and says so with hasNewParse
*******************************************************************************/
void setParseAction(GroupItem &m(GroupItem))
{
RuleStuff   ruleStuff = ensureRStuff();
    parseACTION = true;
    if m {
        ruleStuff.parseMethod = m;
        hasNewParse           = true; }
}

void setPointer(void *v)
{
    pointer     = v;
    isPointer   = true;
    isInitialized = true;
    if hasListeners updateListeners();
}

void setRegex(PLGrgx v)
{
    gRegex      = v;
    if v        isREGEX = true;
    else data   = 0;
    isInitialized = true;
    if hasListeners updateListeners();
}

/*******************************************************************************
                                setRStuff
    setRStuff is the single writer of the rStuff field. Route every rStuff
    assignment through here so the field has one observable chokepoint (set a
    breakpoint/log here to trace where rStuff took a wrong turn). For now plain.
*******************************************************************************/
void setRStuff(RuleStuff stuff)
{
    rStuff = stuff;
}

/*******************************************************************************
                                setRuleStuff
    Set rStuff and isRule. This takes no argument so not a setter
*******************************************************************************/
void setRuleStuff()
{
    if !isRule
        if registry && registry.isRule              isRule = true;
        or parent && parent.isRule
            if !registry || registry == keyWords    isRule = true;
    if !rStuff  rStuff = new(this);
    or rule != this {
        rStuff  = new(rStuff);
        rule    = this; }
}

void setStak(Stak s)
{
    if s {
        isSTAK  = true;
        stak = s; }
    else data   = 0;
    isInitialized = true;
    if hasListeners updateListeners();
}

void setText(String s)
{
    gText       = s;
    if s {
        gCount      = (int)strlen(s);
        isSTRING	= true;
		}
    else data   = 0;
    isInitialized = true;
    if hasListeners updateListeners();
}

/*****************************************************************************
                                setToken
	setToken is not a setter (there is no token field)
*****************************************************************************/
void setToken(String s,int length)
{
    isTOKEN  = true;
    gText       = s;
    gCount      = length;
    isInitialized = true;
}

/***************************************************************************
                                sort
    Sorts list using the compare method. The basic idea is to walk the list
    forward, and keep the already traversed part of the list in order.
    At the end of the list we done. If order is not null, sort is descending
    NEED TO MAKE SURE THIS WORKS
***************************************************************************/
void sort(int &comparisor(GroupItem,GroupItem))
{
GroupItem   follow;
GroupItem   current;
    if isSorted
        {
        int order = sortDescending ? -1 : 1;
        while current = next(current)
            {
moveForward:
            follow = nextInParent;
            if order * comparisor(current,follow) <= 0 continue;
            else {
                while current = priorInParent
                    {
                    if order * comparisor(follow,current) < 0 continue;
                    else {
                        current.append(follow);
                        goto moveForward;
                        }
                    }
                if !current && firstInList
                    {
                    firstInList.prepend(follow);
                    goto moveForward;
                    }
                }
            }
        return;
        }
     cerr "GroupBody sort: must set isSorted first":;
}

/*****************************************************************************
                                sortByAttribute
    Sort members by the value of the attribute named in the parameter
    passed in.
*****************************************************************************/
void sortByAttribute(String attributeName)
{
String  saveText = text;
    text = attributeName;
    sort(compareAttribute);
    text = saveText;
}

/*******************************************************************************
                                updateContentFlags
	Make sure affiliation and content flags (hasMembers, hasAttributes) match
*******************************************************************************/
void updateContentFlags()
{
	if parent
        if isAttribute
            {
            parent.hasAttributes    = true;
            if !noPrint parent.hasTraits = true;
            }
        or isMember     parent.hasMembers       = true;
    // groupListGuard a LEAF has no list, so a bare listLength read goes through a null groupList and dies at
    // groupListGuard EXC_BAD_ACCESS
    if groupList && listLength
        {
        GroupItem   item;
        // onePassNoEarlyOut three flags, ONE pass -- the old early-outs could break out before a
        // onePassNoEarlyOut trait-bearing attribute was reached, leaving the third flag answering about a partial scan
        hasAttributes   = false;
        hasMembers      = false;
        hasTraits       = false;
        while item = next(item)
            if item.isAttribute
                {
                hasAttributes   = true;
                if !item.noPrint    hasTraits = true;
                }
            or item.isMember    hasMembers = true;
        }
}

/*****************************************************************************
                                updateDispatch
	Not used, was updateListeners, saved here just in case
*****************************************************************************/
void updateDispatch()
{
GroupItem	item,listener;
    if !dispatchQ
        {
        dispatchQ = new;
        dispatchGroup = makeGroup();
        }
	if listener = getAttribute("notifyLIST")
		while item = listener.next(item)
            item.dispatch();
    cout `tag,"finished dispatching listeners":;
	dispatchQ.wait(forever);
    cout `tag,"finished updating listeners":;
}

/*****************************************************************************
                                updateListeners
	Notify groups listening to this one.
*****************************************************************************/
void updateListeners()
{
GroupItem	grup,listener;
	if listener = getAttribute("notifyLIST")
		while grup = listener.next(grup)
            runNotified(grup);
}

/***************************************************************************
                                walk
	Iterates thru the member hierarchy in a depth first walk. The group pointer
    passed in is taken as the last item iterated. If it is null, this group
    is returned. If the item passed in is this group, the first member of
    this group is returned. This way the walk starts with the calling block
    that is, the first block returned is the calling block, unless you pass
    the calling block as the item parameter.
***************************************************************************/
GroupItem walk(GroupItem item)
{
GroupItem result,group;
    if !item result = this;
    or item == this
        result = next(result);
    or item.listLength     result = item.next(result);
    else {
        group = item.parent;
        if group.groupBody == groupBody || !group
            {
            if item.listLength
                result = item.next(result);
            if !result
                {
                result = item;
                result = next(result);
                }
            }
        else {
            result = item.nextInParent;
            if !result
                while item = item.parent
                    {
                    if item.groupBody == groupBody break;
                    if group = item.parent
                        {
                        result = item;
                        if result = group.next(result) break;
                        }
                    }
            }
        }
    return result;
}
}

/*****************************************************************************
                                compareAttribute
    Compare attribute value of group1 to attribute value of group2. The results
    get a little arbitrary if the values differ in type. Attributes are less than members.
    The way this works is text in the group being sorted is set to the name
    of the tag in the attributes whose values are used in the compare for the sort
*****************************************************************************/
int compareAttribute(GroupItem group1,GroupItem group2)
{
String      traitName   = group1.parent.text;
GroupItem   trait1      = group1[traitName];
GroupItem   trait2      = group2[traitName];
int result;
    if group1.isAttribute && !group2.isAttribute result = -1;
    or group1.isMember && !group2.isMember result = 1;
    or !result && group1.isMember
        {
        if trait1.data == trait2.data
            switch(trait1.data)
                {
                case isCOUNT:
                case isNUMBER:
                    result = (int)(trait1.number - trait2.number);
                case isITEM:
                    result = trait1.item.compare(trait2.item);
                case isSTRING:
                    result = compare(trait1.text,trait2.text);
                }
        or !trait1.data result = -1;
        else result = 1;
        }
    return result;
}

/*****************************************************************************
                                compareTags
    Compare tag of group1 to tag of group2. Attributes are less than members.
*****************************************************************************/
int compareTags(GroupItem group1,GroupItem group2)
{
int result;
    if group1.isAttribute && !group2.isAttribute result = -1;
    or group1.isMember && !group2.isMember result = 1;
    or !result && group1.isMember
        {
        result = compare(group1.tag,group2.tag);
        if !result && registry && registry == group1.registry && registry%"loadByValue"
            result = compare(group1.text,group2.text);
        }
    return result;
}

/*****************************************************************************
                                compareValues
    Compare value of group1 to value of group2.
*****************************************************************************/
int compareValues(GroupItem group1,GroupItem group2)
{
int result = -1;
use group1
    if group1 && !group2    result = 1;
    or group2 && !group1    result = -1;
    or groupBody == group2.groupBody    result = 0;
    or data
        switch(data)
            {
            case isITEM:        result = item.compare(group2.item);
            case isNUMBER:
                if group2.isCOUNT || group2.isNUMBER || group2.isSTRING
                                result = (int)(gNumber - group2.number);
            case isBUFFER:
            case isSTRING:
            case isTOKEN:
                if group2.isCOUNT || group2.isNUMBER
                                result = count - group2.count;
                else            result = compare(text,group2.text);
            case isCOUNT:
                if group2.isCOUNT || group2.isNUMBER || group2.isSTRING
                                result = count - group2.count;
            default:            result = compare(text,group2.text);
            }
    or group2.data              result = -1;
    else result = compare(text,group2.text);
    return result;
}
