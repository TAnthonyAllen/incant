extern int processCode(GroupItem field,GroupItem holder)
{
GroupRules  ruler = groupRules;
GroupItem   blockRULE = grokking/BlocK,
            code,
            result,
            priorMETHOD = currentMETHOD,
            action = field;
int         indenter = lastIndent;
int processing  = processingCode;
use field
    // d2Tripwire an rStuff-less label is WRECKAGE, not a specimen (Ruling D2) -- refuse loud here, where it became visible
    if isLabel && !rStuff {
        cerr "processCode: REFUSING " tag " -- isLabel with no rStuff. Only a live parse mints a label (Ruling D2), so this node is wreckage, not a specimen; look upstream at whatever copied or hand-built it.":;
        return false; }
    // labelArmDead no road hands processCode a label (F-130: 0 calls, SEQ 246 tap) -- refuse by name, never guess the rule
    if isLabel {
        if field.labelOf    refuse(field.labelOf,"processCode: the label arm was reached -- a label was handed in where an action belongs (F-130)");
        else                refuse(field,"processCode: the label arm was reached by a label with no labelOf (F-130)");
        return false; }
    // staleIR re-parsing invalidates the action's IR record -- setText, never clear(), or it reads back as its tag
    -%
    GroupItem   *staleIR = field->get("JiT");
    if (staleIR)    staleIR->setText(::strdup(""));
    %-
    code      = holder.getProperty("CodE");
    if isRule action = code;
    currentMETHOD   = action;
    lastIndent      = 0;
    processingCode  = true;
    // compileIsADrive the compile is a DRIVE: BlocK's generated parse when it carries one, the old road otherwise, on a floor either way -- a compile after parser() used to refuse (F-128)
    // compileOwner the ONE writer of gCompileOwner: aCTionNamE mints the body's names into this action, never into the grammar face a generated body makes current (SEQ 214)
    -% GroupItem *priorOwner = gCompileOwner; gCompileOwner = action; %-
    result = driveStep(code,blockRULE,null);
    -% gCompileOwner = priorOwner; %-
    if result {
        result.noPrint  = true;
        holder.addProperty(result);
        field.isAction = true; }
    else    reportCodeFail(field);
    if !processing  processingCode = false;
    lastIndent      = indenter;
    currentMETHOD   = priorMETHOD;
    if result       return true;
    return false;
}

