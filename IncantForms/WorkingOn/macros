/*******************************************************************************
	parseCode is kant version of processCode
*******************************************************************************/
    pcReq owner source result;
    parseCode code={
        code    := argument.CodE;
        if code.datA == 0;
            cerr taG "has no CodE, has parser() been run on it?":;
            return;
        if isRulE;  action := code;
        else        action := argument;
        pcReq.owner  := action;
        pcReq.source := code;
        if compileIn(pcReq);
            blk = pcReq.result;
            *blk :. noPrinT;
            argument :. isActioN;
            argument +< *blk;
            return trueResult;
        cerr "parseCode: failed parse of" taG:;
        return  falseResult;
        };

/*******************************************************************************
	What I remember of runInstruct (old runOP) translated into sort of kant. Assumes
    argument list input is in left to right order; if not change --grup to ++grup
    Entries in the argument list are either an operator or a field. As in kant
    unary operators are afixed prefix. Thus the first entry on a list can be a
    unary operator or a field and the last entry has to be a field.
*******************************************************************************/
    runInstruct code={
        result = 0;
        iterate grup on argument;
        while --grup;               // does --grup go thru the argument list back to front???  I forget but assume it does
            if isOperator(*grup);   // we need an isOperator() command
                op = grup;
                if isUnary(*op)     result := *op(result);  // need an isUnary command too and *op(result); has to work
            or result == 0;         result = grup;          // isGROUP is data so result.group will contain grup.group (after opAssign runs setContent())
            else
                result  +% *op *result *grup;               // kant grammar does not see op as an Operator even tho it contains an Operator
                result  := runOP(result);                   // so cannot enter: *result *op *grup; as an expression statement
        return  *result;

