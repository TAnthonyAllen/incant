    xpListTest isRule lizted=listEntries+ SemI- code={
        iterate grup on *lizted;
        while --grup;
            if *grup.instructTypE != 0;
                /***************************************************************************
                                        temporary workaround
                    if invoke were set on instruct instead of flaG, runOP would run
                    instruct too soon. testOP checks for flaG and treats it like invoke;
                ***************************************************************************/
                clear(instruct);
                op = grup;
                /***************************************************************************
                                unary handling - check for negate and deref
                ***************************************************************************/
                if priorEntry := *grup.prioR;
                    if priorEntry.datA == 0;    convertUnary = true;
                    if *priorEntry.isOperatoR;  convertUnary = true;
                if convertUnary;
                    if *op.taG == "-";  op := Operators["negate"];
                    or *op.taG == "*";  op := Operators["deref"];
                    convertUnary = false;
                if *op.isUnarY;
                    instruct    +% *op;
                    instruct    +% *result;
                    instruct        :. flaG;
                    if result.datA == 0;    target := instruct;
                    else                    result := copyOf(instruct);
                    clear(op);
            else
                if result == 0; result = grup;
                or target == 0; target = grup;
            if op.datA && result.datA  && target.datA != 0;
                clear(instruct);
                instruct    +% *op;
                instruct    +% *target;
                instruct    +% *result;
                instruct    :. flaG;
                result      := copyOf(instruct);
                clear(target);
                clear(op);
        print "We done":;
        if target.datA == 0; target = result;
        listChain(*target);
        result  = testOP(*target);
        return  result;
        };

