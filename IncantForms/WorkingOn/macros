        priorMethod := *currentMETHOD;
        indenter    = lastIndenT;
        processing  = processingCodE;
        currentMETHOD   := *action;
        lastIndent      :. 0;
        processingCodE  :. 1;
        if result = BlocK(CodE);
            result.noPrinT  = 1;
            actionTypE  :. 1; // 1 sets isAction == true;
            argument +< result;
        else
            cerr "parseCode: failed parse of" taG:;
