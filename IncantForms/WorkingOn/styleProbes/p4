                if lwSwap == 1;
                    lwTo := *lkLook[*lwName];
                    *grup := **lwTo;
                lwVia = **grup.isGrouP;
                if lwVia == 1;      *grup := ***grup;
        if hasMemberS;
            for grup in argument; members
                lookWalk(*grup);
        };
    pRun code={
        prReq := argument;
        lkHas = 0;
        if *prReq["look"];      lkHas = 1;
        if lkHas == 1;
            prLook := *prReq["look"];
            lkLook := **prLook;
        prLaid := setFrame(argument);
        lookWalk(*prLaid);
        print "RUN" argument.taG:;
        printDefinition(*prLaid);
        };
