Start();
include(unitTests);
include(utilities);
include(styles);
search reset stack Grokking;
registry(fORMfACTs);
define
    x values="points" inherits="no" status="built" does="where the field sits across; read on the top field, and on a child under a parent that names overlay";
    y values="points" inherits="no" status="built" does="where the field sits down; read as x is";
    width values="points, or N%" inherits="no" status="built" does="the field's width; a percent is of its parent";
    height values="points, or N%" inherits="no" status="built" does="the field's height; a percent is of its parent";
    across values="bare, a count, or *" inherits="no" status="built" does="lays the members out side by side";
    down values="bare, a count, or *" inherits="no" status="built" does="stacks the members; the default when no direction is named";
    overlay values="bare" inherits="no" status="built" does="places each member from its own x and y, measured from this field";
    space values="points, or N%" inherits="no" status="built" does="in a layout, an empty share; in a run's style, the gap after a word";
    fill values="a held colour (fill:=wall), or #rrggbb" inherits="no" status="built" does="paints the field's box";
    border values="bare, or a width" inherits="no" status="built" does="strokes all four sides, inside the frame";
    topBorder values="bare, or a width" inherits="no" status="built" does="strokes the top side only";
    bottomBorder values="bare, or a width" inherits="no" status="built" does="strokes the bottom side only";
    leftBorder values="bare, or a width" inherits="no" status="built" does="strokes the left side only";
    rightBorder values="bare, or a width" inherits="no" status="built" does="strokes the right side only";
    strokeColor values="a held colour, or #rrggbb" inherits="no" status="built" does="the border's colour; black when none is named";
    font values="a held font (font:=titleFont)" inherits="yes" status="built" does="the font the field's text is set in";
    color values="a held colour, or #rrggbb" inherits="yes" status="built" does="the colour of the field's text";
    align values="left center right justify" inherits="yes" status="built" does="where each line of text sits across";
    valign values="top center bottom" inherits="yes" status="built" does="where the text sits down the frame";
    italic values="bare, or off" inherits="yes" status="built" does="slants the text";
    rounded values="bare, or a radius in points" inherits="no" status="built" does="rounds the corners of the fill and of a plain border";
    shadow values="bare" inherits="no" status="built" does="shadows the fill, else the border, else the text";
    opacity values="0 to 1" inherits="no" status="built" does="how opaque the field's fill, border and text are drawn";
    style values="a held style (style:=name)" inherits="no" status="built" does="merges the style's attributes into the field at layout; the field's own always win";
    text values="bare" inherits="no" status="built" does="draws the field's own string in its frame";
    image values="a file path" inherits="no" status="built" does="draws the image in the frame, under the border";
    fit values="none ruled" inherits="no" status="parked" does="how an image or text is fitted to the frame";
    onClick values="a held action (onClick:=name)" inherits="no" status="mock click only" does="the action a click on the field fires";
    ghost values="none" inherits="no" status="none" does="a fact with no attribute behind it: the control for the check below";
    ;
register(RefSpec);
search RefSpec fORMfACTs FORMs UnitTests Utilities cOLOr fONTs sTYLEs list;
define
    rsRows = 0;
    rsOrphans = 0;
    rsBare = 0;
    rsTable code={
        print "name | values | inherited | status | what it does":;
        for grup in argument;
            rtName = *grup.taG;
            rtSelf := *grup;
            rtV := *rtSelf["values"];
            rtI := *rtSelf["inherits"];
            rtS := *rtSelf["status"];
            rtD := *rtSelf["does"];
            rtVt = *rtV;
            rtIt = *rtI;
            rtSt = *rtS;
            rtDt = *rtD;
            rtIs = 0;
            if FORMs[rtName];   rtIs = 1;
            if rtIs == 1;
                print rtName "|" rtVt "|" rtIt "|" rtSt "|" rtDt:;
                rsRows = rsRows + 1;
            if rtIs == 0;
                cerr "CHECK a fact with no attribute in FORMs:" rtName:;
                rsOrphans = rsOrphans + 1;
        };
    rsMissing code={
        for grup in argument;
            rmName = *grup.taG;
            rmData = *grup.datA;
            rmList = *grup.listLengtH;
            rmEmpty = 1;
            if rmData != 0;     rmEmpty = 0;
            if rmList != 0;     rmEmpty = 0;
            rmHas = 0;
            if fORMfACTs[rmName];   rmHas = 1;
            if rmEmpty == 1;
                if rmHas == 0;
                    cerr "CHECK a bare FORMs definition with no fact:" rmName:;
                    rsBare = rsBare + 1;
        };
    ;
rsTable(fORMfACTs);
rsMissing(FORMs);
cerr "REFSPEC rows" rsRows "facts with no attribute" rsOrphans "bare definitions with no fact" rsBare:;
cerr "REFSPEC SENTINEL":;
stop();

referenceSpecimen -- generate, don't type (Tony's ruling R1, 2026-11-14; SEQ 656). A specimen, not the feature.
The forms Reference table is PRINTED by a kant walk, never typed. The facts a reader's table needs (values, inherited or not,
status, one line of what it does) are not on the 28 attribute definitions in FORMs, which carry a name and nothing else.
Here they sit in a registry of their own, fORMfACTs, one entry an attribute, under the attribute's own name.
Two walks: rsTable prints one row for each fact whose name is a FORMs definition; rsMissing names every bare FORMs definition
(no value, no list: an attribute, or a drawing field with no function) that has no fact. Both directions are checked, so a
new attribute with no fact, and a fact whose attribute is gone, are each named. ghost is a fact with no attribute: the control.
Run:  incant IncantForms/WorkingOn/referenceSpecimen
