/*****************************************************************************
    cheat -- the cheat pattern (Topics/forms G3 item 3, stroke 3a; Tony ruled 2026-11-21, SEQ 728).
    A cheat tries a new version of utilities' code without touching utilities: it includes utilities, defines
    CheaT holding its own copies, and puts CheaT first on the search list before the first show (show draws
    under the caller's list with environment.forShow's registries added). Every cheat copy says so on stderr (CHEAT <name> <argument>) and counts itself in
    cheatHits; the foot prints the count and fails by name if no cheat copy was reached.
    Definitions only: an includer loads utilities, includes this file, and searches CheaT ahead of Utilities
    before its first show or redrawForm. cheatShow is the driver (show(firstLight)).
    3a (SEQ 728): setFrame and frameMembers were unchanged copies of utilities'; the PDF matched the control.
    3b (SEQ 729): item 2 inside the cheat -- formFrames, keepFrame, redrawWindow, and setFrame's store read.
    frameMembers is still an unchanged copy. Notes below bail().
*****************************************************************************/
register(CheaT);
define
    cheatHits = 0;
    /***************************************************************************
        formFrames -- G3 item 2 (Tony ruled 2026-11-21): frames kept by form name,
        for one run. An entry is a field named for the form holding any of x y
        width height. setFrame reads its own form's entry for the top field, then
        clears it; keepFrame writes one (a close, a resize, a redraw of an open
        window). Nothing goes to disk: a fresh run starts empty. The ONE place
        this state is defined.
    ***************************************************************************/
    formFrames;
    sfFrom;
    // cheatSays the witness names the source of the top frame and the four values it laid out at
    cheatSays code={
        =:argument x y width height;
        cerr "CHEAT frame" argument.taG sfFrom "x" x "y" y "w" width "h" height:;
        };
    /***************************************************************************
        keepFrame -- ONE argument, a request: form:= the form and frame:= a
        field holding any of x y width height (a window's frame, or a new one).
        Writes the form's entry in formFrames, replacing an old one. A close is
        this alone. Refuses by name a request with no form or no frame.
    ***************************************************************************/
    keepFrame code={
        kfReq := argument;
        kfOk = 1;
        if *kfReq["form"];      kfOk = kfOk + 1;
        if *kfReq["frame"];     kfOk = kfOk + 1;
        if kfOk != 3;
            cerr "keepFrame: REFUSING" argument.taG "-- its request needs form:=theForm and frame:=aFrame":;
            return;
        kfForm := *kfReq["form"];
        kfName := **kfForm.taG;
        kfFrame := *kfReq["frame"];
        kfOld := formFrames[*kfName];
        kfHad = 0;
        if formFrames[*kfName];     kfHad = 1;
        if kfHad == 1;              formFrames -% *kfOld;
        kfEnt := new(*kfName);
        if **kfFrame["x"];          *kfEnt :% copyOf(**kfFrame["x"]);
        if **kfFrame["y"];          *kfEnt :% copyOf(**kfFrame["y"]);
        if **kfFrame["width"];      *kfEnt :% copyOf(**kfFrame["width"]);
        if **kfFrame["height"];     *kfEnt :% copyOf(**kfFrame["height"]);
        formFrames +% *kfEnt;
        cheatHits = cheatHits + 1;
        cerr "CHEAT keepFrame" kfName:;
        };
    /***************************************************************************
        redrawWindow -- ONE argument, a request: form:= frame:= (the window's
        frame now) path= and, optionally, look=. A resize, and any redraw of an
        open window (clickShow's kin): keepFrame first, then redrawForm with a
        request that names no frame, so setFrame takes the frame from the store.
        Returns the laid-out copy, as redrawForm does.
    ***************************************************************************/
    windowReq path form look;
    redrawWindow code={
        rwReq := argument;
        keepFrame(argument);
        windowReq :% copyOf(*rwReq["path"]);
        rwForm := *rwReq["form"];
        windowReq.form := **rwForm;
        windowReq.look = 0;
        rwLk = 0;
        if *rwReq["look"];      rwLk = 1;
        if rwLk == 1;           windowReq :% copyOf(*rwReq["look"]);
        rwLaid := redrawForm(windowReq);
        return *rwLaid;
        };
    frameMembers code={
        // cheatWitness this copy is the cheat's, and says so on every call
        cheatHits = cheatHits + 1;
        cerr "CHEAT frameMembers" argument.taG:;
        =:argument across down overlay width height x y;
        // oneDirection a field names down or across, never both (G3 item 1, Tony 2026-11-21): refused by name, its members are not laid out. A grid is a row level: down on the field, across on the one row it holds, the height on the row
        fmBoth = 0;
        if across.datA != 0;
            if down.datA != 0;  fmBoth = 1;
        if fmBoth == 1;
            cerr "setFrame: REFUSING" argument.taG "-- it names both down and across; a field takes one direction, so write the grid as rows (down on the field, across on a row it holds); its members are not laid out":;
            return;
        sideRoom    = width;
        pWidth      = width;
        headRoom    = height;
        pHeight     = height;
        pX          = x;
        pY          = y;
        boxX        = x;
        boxY        = y;
        boxR        = x + width;
        boxB        = y + height;
        upOut       = 0;
        sideOut     = 0;
        // overlayNamed a parent that names overlay (and neither down nor across) overlays its children: each fills the parent's box unless it declares its own width, height, x or y. A parent naming no direction stacks them, as down does: the old GUI's default, and what descriptions and unitTests' sample rely on (SEQ 626 W3; the default is Tony's to re-rule)
        laysOver    = 0;
        if overlay.datA != 0;
            if across.datA == 0;
                if down.datA == 0;  laysOver = 1;
        if down.datA != 0;
            tARGET="height";
            dIRECTion="down";
            fillDownAcross(argument);
        if across.datA != 0;
            tARGET="width";
            dIRECTion="across";
            fillDownAcross(argument);
   /***************************************************************************
                 Create frame and set width and height
    ***************************************************************************/
        for grup in argument; members
            // hiddenTakesNoRoom an isHidden member is not sized, so it joins no share
            fmHid = *grup.isHiddeN;
            if fmHid == 0;
                =:grup width height;
                if width.isPercenT;
                    width = pWidth * width / 100;
                    *grup :% copyOf(width);
                if height.isPercenT;
                    height = pHeight * height / 100;
                    *grup :% copyOf(height);
                if width.datA != 0;
                    sideRoom    -= width;
                or across.datA == 0;
                    width = pWidth;
                    *grup :% copyOf(width);
                else
                    sideOut     +/ *grup;
                    ++sideOut;
                if height.datA != 0;
                    headRoom    -= height;
                or across.datA != 0;
                    height = pHeight;
                    *grup :% copyOf(height);
                or laysOver == 1;
                    height = pHeight;
                    *grup :% copyOf(height);
                else
                    upOut       +/ *grup;
                    ++upOut;
        if upOut > 0;
            shareN = 0;
            shareUsed = 0;
            shareEdge = 0;
            for grup in upOut;
                ++shareN;
                shareEdge = headRoom * shareN / upOut;
                height = shareEdge - shareUsed;
                shareUsed = shareEdge;
                *grup :% copyOf(height);
        if sideOut > 0;
            shareN = 0;
            shareUsed = 0;
            shareEdge = 0;
            for grup in sideOut;
                ++shareN;
                shareEdge = sideRoom * shareN / sideOut;
                width = shareEdge - shareUsed;
                shareUsed = shareEdge;
                *grup :% copyOf(width);
        headRoom    = 0;
        sideRoom    = 0;
    /***************************************************************************
             Set x and y in frame
    ***************************************************************************/
        // fromTheParent under an overlaying parent a child's declared x and y are measured from the parent's origin (R4); under down or across they are not read, as before
        for grup in argument; members
            fmHid = *grup.isHiddeN;
            if fmHid == 0;
                =:grup width height x y;
                placeY = pY;
                placeX = pX;
                if laysOver == 1;
                    if y.datA != 0;     placeY = pY + y;
                if laysOver == 1;
                    if x.datA != 0;     placeX = pX + x;
                y = placeY;
                *grup :% copyOf(y);
                x = placeX;
                *grup :% copyOf(x);
                // doesNotFit noRoom means only this: wholly outside the parent's box on an axis, or no extent on one (Tony, 2026-11-07). Partly outside is drawn.
                fmRight = placeX + width;
                fmFoot  = placeY + height;
                fmOut   = 0;
                if placeX >= boxR;      fmOut = 1;
                if fmRight <= boxX;     fmOut = 1;
                if placeY >= boxB;      fmOut = 1;
                if fmFoot <= boxY;      fmOut = 1;
                if fmOut == 1;          *grup :. noRooM;
                if laysOver == 0;
                    if across.datA == 0;    pY += height;
                if laysOver == 0;
                    if across.datA != 0;    pX += width;
        for grup in argument; members
            fmSkip = *grup.isHiddeN;
            fmGone = *grup.noRooM;
            if fmGone == 1;     fmSkip = 1;
            if fmSkip == 0;
                // holdsAForm a field written form:=other is filled by that form, laid out in the field's frame (G2 stroke 1b); its own members, if any, are not laid out
                fmHolds = 0;
                fmSelf := *grup;
                if *fmSelf["form"];     fmHolds = 1;
                if fmHolds == 1;        placeForm(*grup);
                if fmHolds == 0;
                    if *grup.hasMemberS;
                        frameMembers(*grup);
        };
    setFrame code={
        // cheatWitness this copy is the cheat's, and says so on every call
        cheatHits = cheatHits + 1;
        cerr "CHEAT setFrame" argument.taG:;
        sfReq := argument;
        sfHas = 0;
        if *sfReq["form"];      sfHas = 1;
        if sfHas == 0;
            cerr "setFrame: REFUSING" argument.taG "-- its request holds no form; write form:=theForm":;
            return;
        sfUse = 0;
        if *sfReq["frame"];     sfUse = 1;
        if sfUse == 1;
            sfFrame := *sfReq["frame"];
            frameWhole(**sfFrame);
            if fwOk == 0;
                cerr "setFrame: REFUSING" argument.taG "-- its frame needs x, y, width and height":;
                return;
        sfForm := *sfReq["form"];
        // holdsItself the names of the forms being laid out; one met again is a form inside itself, refused by name and not laid out
        sfName := **sfForm.taG;
        if sfChain[*sfName];
            cerr "setFrame: REFUSING" argument.taG "-- the form" sfName "holds itself, directly or through another form; it is not laid out inside itself":;
            return;
        sfMark := new(*sfName);
        sfChain +% *sfMark;
        // deepCopy copyOf shares bodies below the second level, so a deep form would be written (measured, SEQ 626)
        sfLaid := copyDeep(**sfForm);
        if sfUse == 1;
            *sfLaid :% copyOf(**sfFrame["x"]);
            *sfLaid :% copyOf(**sfFrame["y"]);
            *sfLaid :% copyOf(**sfFrame["width"]);
            *sfLaid :% copyOf(**sfFrame["height"]);
        // frameStore (G3 item 2) with no frame in the request, the top field takes its form's entry in formFrames, read once and cleared; a part the entry lacks keeps the declared value. A held form never reads it: placeForm always hands it its host field as frame:= (measured SEQ 729: a depth test beside this guarded nothing)
        sfFrom = "declared";
        if sfUse == 1;      sfFrom = "frame";
        sfStore = 0;
        if sfUse == 0;
            if formFrames[*sfName];     sfStore = 1;
        // entOutsideArm bound at the top level: a := made inside an if arm holds nothing after it (measured SEQ 687)
        sfEnt := formFrames[*sfName];
        if sfStore == 1;
            sfFrom = "store";
            if *sfEnt["x"];         *sfLaid :% copyOf(*sfEnt["x"]);
            if *sfEnt["y"];         *sfLaid :% copyOf(*sfEnt["y"]);
            if *sfEnt["width"];     *sfLaid :% copyOf(*sfEnt["width"]);
            if *sfEnt["height"];    *sfLaid :% copyOf(*sfEnt["height"]);
            formFrames -% *sfEnt;
        cheatSays(*sfLaid);
        setLook(argument);
        // lookRefused a look asked for by name that the form's looks list lacks (SEQ 723 R2): refused by name in setLookByName, nothing laid out
        if lkRefused == 1;
            sfChain -% *sfMark;
            return;
        mergeStyles(*sfLaid);
        cardsPick(*sfLaid);
        frameMembers(*sfLaid);
        sfChain -% *sfMark;
        return *sfLaid;
        };
    cheatCount code={
        cout "CHEAT hits" cheatHits:;
        if cheatHits == 0;
            cerr "CHEAT FAILED -- no cheat copy was reached; the run measured utilities, not the cheat":;
        };
    ;
// bailNotStop an included file ends with bail(): a stop() at its foot ends the includer too (measured SEQ 729)
bail();

How to use it as a template (3c keeps this file): copy it, replace the copies in CheaT with the code being tried, keep the
witness lines and cheatCount. Put CheaT first before the first show or redrawForm in the run: a body binds its names at
its first call (F-164), so a utilities body already called keeps the copy it found then.
