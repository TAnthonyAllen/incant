    xpListTest  isRule;
    InvokeD     isRule startBox=[([] xpListTest endParen-?=")" endBrace-?="]";
    InvokeR     isRule ANYtoken InvokeD code={
        print "Running InvokeR":;
        if *InvokeD.listLengtH;
            :InvokeD startBox xpListTest;
            arg := *xpListTest.firsT;
            if startBox == "(";     op := Operators["call"];
            else                    op := Operators["=["];
            result  +% Operators["call"];
            result  +% ANYtoken;
            result  +% *arg;
            dumpField(result);
            return result;
        return ANYtoken;
        };
    listEntries isRule
        InvokeR;
        ANYtoken;
        QuotE;
        NumbeR;
        Operators;
    invokeTEST code={ print "invokeTEST:" taG "=" argument:; return argument; };
    qa=2;
    qb=3;
    qc=4;
    /*****************************************************************************
        Debugging routine to list out an instruction chain: op, argument, target
    *****************************************************************************/
    listChain code={
        dumpField(argument);
        if listLengtH != 0;
            arg     := argument[2];
            target  := argument[3];
            if *arg.taG == "instruct";       listChain(*arg);
            if *target.taG == "instruct";    listChain(*target);
        };
    /*****************************************************************************
        Build the instruction chain walking left to right. Note; operators that
        assign are handled like any other operator. The algorithm is tight as I
        can make it.
    *****************************************************************************/
    xpListTest isRule lizted=listEntries+ SemI?- code={
        print "Running xpListTest":;
        cur := *lizted.firsT;
        haveRoot = 0;
        while cur.datA != 0;
            if *cur.instructTypE != 0;
                if target.datA == 0;            kind = 3;
                or *target.instructTypE != 0;   kind = 3;
                op = cur;
            else
                if target.datA == 0;    target = cur;
                else                    arg = cur;
                if op.datA != 0 && target.datA != 0;
                    if kind == 3;
                        print "kind == 3 unary op?":;
                        if *op.taG == "-";  op := Operators["negate"];
                        or *op.taG == "*";  op := Operators["deref"];
                        instruct    +% op target;
                        target     := copyOf(instruct);
                    if arg.datA != 0;
                        instruct    +% op target arg;
                        target      := copyOf(instruct);
                    clear(instruct);
                    clear(arg);
                    clear(op);
                    dumpField(*target);
            cur := *cur.nexT;
        print "We done":;
        // Here we return an isLabel field named xpListTest that contains the chain it built stashed in an attribute
        xpListTest +% *target;
        listChain(*target);
        return  xpListTest;
        };
    ;

