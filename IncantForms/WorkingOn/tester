                if op.datA && result.datA  && target.datA != 0;
                    instruct    +% *op;
                    instruct    +% *target;
                    instruct    +% *result;
                    instruct    :. flaG;
                    //dumpField(instruct);
                    result      := copyOf(instruct);
                    result      :. flaG;
                    clear(instruct);
                    clear(target);
                    clear(op);
                    grup    = instructEntry;
            if grup.datA;   grup    := *grup.prioR;
        print "We done":;
        listChain(*result);
        return result;
