    /*****************************************************************************
        Debugging routines. listChain lists out an instruction chain: op, argument, target
        invokeTEST just prints out its argument. qa qb and qc are literal value
        fields used in testing
    *****************************************************************************/
    listChain code={
        if listLengtH != 0;
            op      := argument[1];
            target  := argument[2];
            arg     := argument[3];
            print *op.taG;
            if *arg.taG == "instruct";
