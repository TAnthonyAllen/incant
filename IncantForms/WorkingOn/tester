    /***************************************************************************
        fillDownAcross deals with direction framing. The direction can be either
        down or across. When the direction passed in has a value. The value can
        be "*" or a number. The argument passed in has to contain the direction
        attribute (that is down or across respectively).
        
        If the direction value is "*", the argument passed in can have only one
        member (the member may have members); also the member should have its
        target (width or height) specified. If direction value is a number
        (like down=3) the argument can have more than one member, but all members
        should have no target specified. Also, the argument passed in should
        have no data (you can add data after setFrame finishes).
    ***************************************************************************/
    tARGET;
    dIRECTion;
    newStuff isList;
    fillDownAcross code={
        target <: tARGET;
        direct <: dIRECTion;
        =:argument target direct;
        pValue = target;
        memberCount=0;
        for grup in argument; members
            ++memberCount;
            =:grup target;
            if target.datA != 0;    pValue -= target;
        if direct == "*";
            if memberCount > 1; print taG "can only have one member when" $direct "=*":;
            valueCount = pValue / target;
        else
            if direct > 0;
                valueCount = direct - 1;
        clear(newStuff);
        for grup in argument; attributes
            newStuff +% *grup;
        for grup in argument; members
            newStuff +/ copyOf(*grup);
        for grup in argument; members
            while valueCount > 0;
                --valueCount;
                newStuff +/ copyOf(*grup);
        clear(argument);
        argument = newStuff;
        };
    /***************************************************************************
         Set frames for members of the group passed in. It must have x y width
         and height attributes.
         
         Should modify to check for noRoom and bail if there aint none
    ***************************************************************************/
    setFrame code={
        print "Setting frame for" taG:;
        =:argument across down width height x y;
        sideRoom    = width;
        pWidth      = width;
        headRoom    = height;
        pHeight     = height;
        pX          = x;
        pY          = y;
        upOut       = 0;
        sideOut     = 0;
        if down.datA != 0;
            tARGET="height";
            dIRECTion="down";
            fillDownAcross(argument);
        if across.datA != 0;
            tARGET="width";
            dIRECTion="across";
            fillDownAcross(argument);
   /***************************************************************************
                 Create frame and set width and height
    ***************************************************************************/
        for grup in argument; members
            =:grup width height;
            if width.datA != 0;
                sideRoom    -= width;
            or across.datA == 0;
                cout "no across in" taG:;
                width = pWidth;
                *grup :% copyOf(width);
            else
                cout "There is an across in" taG:;
                sideOut     +/ *grup;
                ++sideOut;
            if height.datA != 0;
                headRoom    -= height;
            or across.datA != 0;
                height = pHeight;
                *grup :% copyOf(height);
            else
                upOut       +/ *grup;
                ++upOut;
        if upOut > 0;
            headRoom /= upOut;
            for grup in upOut;
                height = headRoom;
                *grup :% copyOf(height);
        if sideOut > 0;
            sideRoom /= sideOut;
            for grup in sideOut;
                width = sideRoom;
                *grup :% copyOf(width);
        headRoom    = 0;
        sideRoom    = 0;
    /***************************************************************************
             Set x and y in frame
    ***************************************************************************/
        for grup in argument; members
            =:grup width height x y;
            y = pY;
            *grup :% copyOf(y);
            x = pX;
            *grup :% copyOf(x);
            if across.datA == 0;
                cout "when setting x y no across in" taG:;
                pY += height;
            else
                cout "when setting x y there is an across in" taG:;
                pX += width;
        dumpContents(argument);
        for grup in argument; members
            =:grup across down;
            if across.datA != 0 || down.datA != 0;
                setFrame(*grup);
        };
    ;

