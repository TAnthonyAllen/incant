/*****************************************************************************
	This is the tester incantation. It is a working file for testing new features
    under development so it changes when there is a new feature in the works.
*****************************************************************************/
Start();
include(utilities);
include(unitTests);
search reset stack Grokking;
search Utilities UnitTests list;

registry(cOMMANDs);
define
    testOP  immediateAction;
    ;
registry(Operators);
define
    call    operateMethod=opCallTest  assignTier;
    ;
registry(TestStuff);
define
    xpListTest  isRule;
    InvokeD     isRule startBox=[([] xpListTest endParen-?=")" endBrace-?="]";
    InvokeR     isRule ANYtoken InvokeD code={
        if *InvokeD.listLengtH;
            :InvokeD startBox xpListTest;
            arg     = *xpListTest;
            if *startBox == "(";    op := Operators["call"];
            else                    op := Operators["=["];
            result  +% *op;
            result  +% unWrap(ANYtoken);
            result  +% *arg;
            return result;
        return ANYtoken;
        };
    listEntries isRule
        InvokeR;
        ANYtoken;
        QuotE;
        NumbeR;
        Operators;
    invokeTEST code={ print "invokeTEST:" taG "=" argument:; return argument; };
    qa=2;
    qb=3;
    qc=4;
    /*****************************************************************************
        Debugging routine to list out an instruction chain: op, argument, target
    *****************************************************************************/
    listChain code={
        if listLengtH != 0;
            op      := argument[1];
            target  := argument[2];
            arg     := argument[3];
            print *op.taG;
            if *arg.taG == "instruct";
                print ,:+~ "argument is:";
                listChain(*arg);
                print ,-;
            else    print *arg.taG;
            if *target.taG == "instruct";
                print ,:+~ "target is:";
                listChain(*target);
                print ,-;
            else    print *target.taG;
        };
    /*****************************************************************************
        Build the instruction chain walking left to right. Note; operators that
        assign are handled like any other operator. The algorithm is tight as I
        can make it. It does not handle lists yet; not sure how to deal with
        unattached fields in a chain with no operator in sight. Current doctrine
        that may change: we do not make lists willy nilly in an expression
        xpListTest returns a label named xpListTest; it contains the chain it built
        stashed in its group
    *****************************************************************************/
    xpListTest isRule lizted=listEntries+ SemI?- code={
        cur := *lizted.firsT;
        prevOp = 1;
        while cur.datA != 0;
            if *cur.instructTypE != 0;
                if prevOp == 1;     pre = cur;
                else
                    op      = cur;
                    kind    = 1;
                    if *cur["assignTier"] || *cur["shortCircuit"];  kind = 2;
                prevOp = 1;
            else
                prevOp = 0;
                if pre.datA != 0;
                    if *pre.taG == "-";     pre := Operators["negate"];
                    or *pre.taG == "*";     pre := Operators["deref"];
                    instruct    +% pre cur;
                    opnd        := copyOf(instruct);
                    clear(instruct);
                    clear(pre);
                else    opnd = cur;
                if target.datA == 0;    target = opnd;
                else    arg = opnd;
                if op.datA != 0 && target.datA != 0;
                    if arg.datA != 0;
                        curTAG  = *cur.taG;
                        if op.datA;     opTAG = *op.taG;
                        else            opTAG = "no operator";
                        if arg.datA;    argTAG = *arg.taG;
                        else            argTAG = "no argument";
                        if target.datA; targetTAG = *target.taG;
                        else            targetTAG = "no target";
                        print "Build instruction with:" kind curTAG opTAG targetTAG argTAG:;
                        if kind == 1;
                            instruct    +% op target arg;
                            target      := copyOf(instruct);
                        or kind == 2;
                            if assign.datA != 0;
                                print "Has assign":;
                                instruct +% op target arg;
                                *assign     +% copyOf(instruct);
                                arg         = copyOf(assign);
                                clear(assign);
                            else
                                print "Get assign":;
                                instruct +% op target;
                                instruct    = kind;
                                assign      := copyOf(instruct);
                            target = arg;
                    clear(instruct);
                    clear(arg);
                    clear(op);
            cur := *cur.nexT;
        if assign.datA != 0;
            print "Assign at end":;
            *assign +% *target;
            target = assign;
        // the chain goes INTO this rule's label, so a caller (InvokeD, or a command line) gets the label back
        *argument := *target;
        print "We done":;
        return  *argument;
        };
    ;

whatsIt = xpListTest("invokeTEST call ga > qb || righty = 42 || qb > qc");
testOP(whatsIt);
print "Dump of the instruction chain generated by xpListTest":;
listChain(whatsIt);
stop();

debug InvokeD InvokeR xpListTest;
compareXP();
xpListTest("ga > qb || qb > qc || righty = 42")
xpListTest("invokeTEST call qa + qb + qc;");
xpListTest("invokeTEST call qa - qb + qc;");
xpListTest("invokeTEST call qa - qb - qc;");
xpListTest("invokeTEST call - qa + qb;");
xpListTest("invokeTEST call qc - - qa;");
xpListTest("invokeTEST call 13 -= qa - qb + qc;");
xpListTest("invokeTEST call righty -= qa - qb + qc;");
print "SENTINEL tester end":;
stop();
maximus=righty;
whatsIt = qa - qb + qc;
print "whatsIt:" whatsIt:;
whatsIt = maximus -= whatsIt;
print "maximus:" maximus:;
maximus=righty;
print "maximus reset to:" maximus:;
whatsIt = maximus -= qa - qb + qc;
print "whatsIt:" whatsIt "maximus:" maximus:;
xpListTest("invokeTEST call righty -= qa - qb + qc;");
stop();

