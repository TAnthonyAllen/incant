    /*****************************************************************************
        Debugging routines. listChain lists out an instruction chain: op, argument, target
    *****************************************************************************/
    listChain code={
        if listLengtH != 0;
            op      := argument[1];
            target  := argument[2];
            arg     := argument[3];
            print *op.taG;
            if *arg.taG == "instruct";
                print ,:+~ "argument is:";
                listChain(*arg);
                print ,-;
            else    print *arg.taG;
            if *target.taG == "instruct";
                print ,:+~ "target is:";
                listChain(*target);
                print ,-;
            else    print *target.taG;
        };
    /***************************************************************************
        print out incant definition for the group passed in.
    ***************************************************************************/
    printDef code={
        if datA != 0;  print ~$taG "=" argument$;
        else    print ~$taG$;
        if hasAttributeS;
            for grup in argument; attributes
                if datA != 0;
                    print $_taG "=" grup$;
                else    print $_taG$;
        if hasMemberS;
            print :;
            for grup in argument; members
                print +;
                printDef(*grup);
                print ,-;
        else
            print ";":;
        };
    ;

setFrame(sample);
