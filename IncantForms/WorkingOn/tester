/*****************************************************************************
	This is the tester incantation. It is a working file for testing new features
    under development so it changes when there is a new feature in the works.
*****************************************************************************/
Start();
include(utilities);
include(unitTests);
search reset stack Grokking;
search Utilities UnitTests list;

registry(cOMMANDs);
define
    testOP  immediateAction;
    ;
registry(Operators);
define
    call    operateMethod=opCallTest;
    ;
registry(TestStuff);
define
    listEntries isRule
        ANYtoken;
        NumbeR;
        Operators;
    invokeTEST code={ print "invokeTEST:" taG "=" argument:; return argument; };
    qa=2;
    qb=3;
    qc=4;
    /*****************************************************************************
        Debugging routine to list out an instruction chain
    *****************************************************************************/
    listChain code={
        dumpField(argument);
        if listLengtH != 0;
            target  := argument[2];
            arg     := argument[3];
            lengtH = *target.listLengtH;
            flagged = *target.flaG;
            if *target.listLengtH && *target.flaG;  listChain(*target);
            if *arg.listLengtH != 0 && *arg.flaG;   listChain(*arg);
        };
    instructEntry;
    resultPark;
    /*****************************************************************************
        getTarget checks to see if target is leading edge of an instruction chain
        and if it is returns the chain as target, otherwise returns just target
    *****************************************************************************/
    getTarget code={
        $$argument;
        grup := argument.prioR;
        if *grup.instructTypE != 0;
            op = grup;
            grup        := *grup.prioR;
            target      = grup;
            instruct    +% *op;
            instruct    +% *target;
            if resultPark.datA; instruct +% *resultPark;
            else                instruct +% argument;
            instruct    :. flaG;
            instructEntry   = target;
            print "getTarget";
            dumpField(instruct);
            return      instruct;
        instructEntry   := argument;
        return argument;
        };
    getInstruction code={
        grup = instructEntry;
        hold = *grup.taG;
        print "Starting getInstruction on" hold:;
        while grup.datA != 0;
            print "At start loop" grupTAG targetTAG opTAG resultTAG:;
            if *grup.instructTypE != 0;
                /***************************************************************************
                    Set operator. Check for unary and handle if so.
                ***************************************************************************/
                op = grup;
                if priorEntry := *grup.prioR;
                    if priorEntry.datA == 0;    cerr "Cannot start an expression with an operator like" *grup.taG:;
                    if *priorEntry.isOperatoR;  convertUnary = true;
                if convertUnary;
                    if *op.taG == "-";  op := Operators["negate"];
                    or *op.taG == "*";  op := Operators["deref"];
                    convertUnary = false;
                if *op.isUnarY;
                    unstruct    +% *op;
                    unstruct    +% *result;
                    unstruct    :. flaG;
                    result := unstruct;
                    clear(op);
            or result == 0;
                /***************************************************************************
                    First time thru sets result (the right most field)
                ***************************************************************************/
                result = grup;
            else
                /***************************************************************************
                    Set target (left most field)
                ***************************************************************************/
                instructEntry := *grup;
                if result.flaG; resultPark = result;
                else        clear(resultPark);
                $$grup;
                target      := getTarget(*grup);
                // should not have to run the following line but target returned from getTarget gets its fLAG cleared???
                *target     :. flaG;
                /***************************************************************************
                    If have all the parts build instruction
                ***************************************************************************/
                if op.datA && result.datA  && target.datA != 0;
                    instruct    +% *op;
                    instruct    +% *target;
                    instruct    +% *result;
                    instruct    :. flaG;
                    result      := copyOf(instruct);
                    result      :. flaG;
                    print "getInstruction";
                    dumpField(instruct);
                    clear(instruct);
                    clear(target);
                    clear(op);
                    grup    = instructEntry;
            if grup.datA;
                grup    := *grup.prioR;
                grupTAG = *grup.taG;
            else        grupTAG = "no more fields in expression list";
            if op.datA;     opTAG = *op.taG;
            else            opTAG = "no operator";
            if target.datA; targetTAG = *target.taG;
            else            targetTAG = "no target";
            resultTAG       = *result.taG;
        print "We done":;
        listChain(*result);
        return result;
        };
    xpListTest isRule lizted=listEntries+ SemI- code={
        instructEntry := *lizted.lasT;
        result = testOP(getInstruction(trueResult));
        $$result;
        };
    ;

xpListTest("invokeTEST call righty -= qa - qb + qc;");
stop();
xpListTest("invokeTEST call -righty -= qa - qb + qc;");

register(C1Tester);
define
    cv=5;
    n=3;
    lim=8;
    qa=2;
    qb=10;
    ok=1;
    done=0;
    r=0;
    blkBody code={ return argument * 2; };
    fId code={ return argument; };
    c1Run code={
        blk := blkBody;
        cerr "C1 begin":;
        r = *blk(cv) + n * 2 > fId(qa + qb) - lim && ok || !done;
        cerr "C1 r = " r:;
        };
    ;
c1Run();
cerr "C1 SENTINEL":;

/***************************************************************************
    C1 tester (Clod, 2026-10-07, SEQ 320) -- for the expr-accum branch

    TO RUN IN XCODE
      Both repos on expr-accum (Groups and support). No retok needed.
      Scheme Groups, Run:
        Arguments          IncantForms/WorkingOn/tester
        Working directory  the Groups directory
        Environment        INCANT_EXPR_ACCUM=1     the candidate (unset or 0: today's road)
                           INCANT_ACCUM_TRACE=r    trace expressions whose first item is r
      Breakpoints, each hit ONCE (c1Run's line is the only traced expression):
        accTraceFlat   (GroupRules.mm:3473)  the FLAT list, before the split -- inspect flat
        accBuilt       (GroupRules.mm:3483)  the TIER TREE, finished, not run -- inspect node
      accBuild pops every item off flat, so flat is EMPTY by the time accBuilt stops.
      In lldb:  expr (void)accTraceTree(node, 0)   prints the tree to the console
                p node->groupBody->tag   then node->get(1), node->get(3) ...
      The console also carries ACCUM FLAT and ACCUM TREE lines to compare against.

    Expected tree: acA [r, =, acOr [acAnd [acK [acX, >, acX], &&, ok], ||, acU [!, done]]]
    Expected value: blkBody(5) 10, + n 13, * 2 26; fId(12) - lim 4; 26 > 4 true;
    && ok true; || !done is not evaluated; r reads 1.

    blk is a HOLDER of an action with a code body: *blk is the action, so *blk(cv)
    calls blkBody with 5. A star on a field that holds no group is null by ruling,
    which is why blk is not itself the action.

    THE RULED LINE, r = *blk(cv) + n * 2 > lim - fId(qa + qb) && ok || !done;
    DOES NOT PARSE ON EITHER ROAD (measured 2026-10-07): - is a UnaryOPS member,
    so InvokeArg's UnaryXP alternative absorbs - fId into lim's term, and the
    call's (qa + qb) is then a SECOND postfix that TokenXP's single InvokeArg?
    cannot take (bear-trap 52). c1Run flips the subtraction, fId(qa + qb) - lim.
    The UnaryXP alternative leaves the grammar after the buy (expressionRecon,
    C1 BOUGHT IN PRINCIPLE).
***************************************************************************/

