// F-110 SPECIMEN -- the SAME rule referenced TWICE in one rule, with different modifiers.
// Both bodies emit `return wR() && s() && wR();`; on the NEW road the second wR() is
// re-resolved by currentMETHOD.get("wR"), which finds the FIRST face, so it borrows the
// first occurrence's modifier. Consumed is read off traceParse's MARKARM base and
// 2b-before-pop mark. Measured 2026-09-23:
//     wDup  = wR+ s wR   on "w w s w w"   OLD 7   NEW 9  (the second wR repeats)
//     wDup2 = wR s wR+   on "w s w w"     OLD 7   NEW 5  (the second wR stops at one)
// Walk it: break in parseRule on the SECOND wR and read the face `field` becomes.
define
    wR    isRule w-="w";
    wDup  isRule wR+ s-="s" wR;
    wDup2 isRule wR s-="s" two=wR+;
    e1 code={ cerr "E1 wDup  on w w s w w (want consumed 7)":; wDup("w w s w w"); cerr "E1-BACK":; };
    e2 code={ cerr "E2 wDup2 on w s w w   (want consumed 7)":; wDup2("w s w w"); cerr "E2-BACK":; };
    ;
cerr "F110 OLD ROAD":; e1(); e2();
parser(wDup); parser(wDup2);
cerr "F110 NEW ROAD":; e1(); e2();
cerr "F110 SENTINEL":;
stop();

debug;
parser(PrinT);
PrinT("print ++result;");
stop();

