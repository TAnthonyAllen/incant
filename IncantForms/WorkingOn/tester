            instruct    :. flaG;
            if resultPark.datA; instruct +% *resultPark;
            else                instruct +% argument;
            //dumpField(instruct);
            instructEntry   = target;
            targetEntry     := copyOf(instruct);
        else    targetEntry := argument;
        return result;
