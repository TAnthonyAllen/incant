Start();
include(unitTests);
include(utilities);
search reset stack Grokking;
registry(fILEs);
define
    firstLightFile File='IncantForms/Windows/firstLight';
    cheatFile File='IncantForms/WorkingOn/cheat';
    ;
include(styles);
search cOLOr fONTs sTYLEs;
include(firstLightFile);
include(cheatFile);
register(TesterG3);
define
    flWin x=300 y=450 width=500 height=600;
    fsBig x=300 y=450 width=1200 height=800;
    fsMid x=100 y=100 width=900 height=500;
    ;
search TesterG3 CheaT FORMs UnitTests Utilities cOLOr fONTs sTYLEs list;
define
    flReq path="IncantForms/PDF/test.pdf" form:=firstLight frame:=flWin;
    flPlain path="IncantForms/PDF/test.pdf" form:=firstLight;
    dsPlain path="IncantForms/PDF/test.pdf" form:=descriptions;
    flClick form:=firstLight field="ok";
    winTakes code={
        wtF := argument;
        flWin :% copyOf(*wtF["x"]);
        flWin :% copyOf(*wtF["y"]);
        flWin :% copyOf(*wtF["width"]);
        flWin :% copyOf(*wtF["height"]);
        };
    mockOpen code={
        moLaid := redrawForm(argument);
        tsfLine(*moLaid);
        winTakes(*moLaid);
        };
    mockResize code={
        winTakes(argument);
        mrLaid := redrawWindow(flReq);
        tsfLine(*mrLaid);
        };
    mockClose code={    keepFrame(flReq);   };
    mockClickShow code={
        click(flClick);
        mcLaid := redrawWindow(flReq);
        tsfLine(*mcLaid);
        winTakes(*mcLaid);
        };
    ;
cout "G3 open":;                            mockOpen(flPlain);
cout "G3 resize, then a reopen":;           mockResize(fsBig);      mockClose();    mockOpen(flPlain);
cout "G3 resize, then a click redraw":;     mockResize(fsMid);      mockClickShow();
cout "G3 close, then descriptions":;        mockClose();            mockOpen(dsPlain);
cheatCount();
stop();

