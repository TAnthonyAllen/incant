/*******************************************************************************
    The dESCRIPTIONs registry is used in forms to make them self describing
*******************************************************************************/
register(dESCRIPTIONs);
define
    dESCRIPT="this is the default description";
    listChain="mock listChain description";
    ;
search dESCRIPTIONs list;
registry(TestStuff);
define
    /*****************************************************************************
        describe is used to supply descriptions in forms by adding it as a form
        attribute with a text value of the field being described. The describe
        text is initialized as either the tag of a field in the form that has
        a corresponding entry with the same tag in the dESCRIPTIONs registry, or
        as whatever descriptive text the form designer wants to show when the
        form first fires. describe is a dynamic attribute with an action
        When a form field is clicked on selection.group is set to the first selectable
        field found after searching up the parent hierarchy starting with the
        field clicked on. And if the selected field has a describe attribute the
        describe action sets the describe.text for the form layout to display.
        
        See the tabs or descriptions forms in IncantForms/Windows for an example
        of how to define a form that uses descriptions.
    *****************************************************************************/
    describe=dESCRIPT code={
        if selection.isGrouP;   describe = dESCRIPTIONs[*selection.taG];
        or describe.isGrouP;    describe = dESCRIPTIONs[describe];
        };
    /*****************************************************************************
        Debugging routines. listChain lists out an instruction chain: op, argument, target
    *****************************************************************************/
    listChain code={
        if listLengtH != 0;
            op      := argument[1];
            target  := argument[2];
            arg     := argument[3];
            print *op.taG;
            if *arg.taG == "instruct";
                print ,:+~ "argument is:";
                listChain(*arg);
                print ,-;
            else    print *arg.taG;
            if *target.taG == "instruct";
                print ,:+~ "target is:";
                listChain(*target);
                print ,-;
            else    print *target.taG;
        };
    /***************************************************************************
        print out incant definition for the group passed in.
    ***************************************************************************/
    printDef code={
        if datA != 0;  print ~$taG "=" argument$;
        else    print ~$taG$;
        if hasAttributeS;
            for grup in argument; attributes
                if datA != 0;
                    print $_taG "=" grup$;
                else    print $_taG$;
        if hasMemberS;
            print :;
            for grup in argument; members
                print +;
                printDef(*grup);
                print ,-;
        else
            print ";":;
        };
    ;
describe();
print "With no initial description set:" ``describe:;
describe="some description not the default";
describe();
print "After initial description provided:" `describe:;
describe();
print "After initial description unchanged:" `describe:;
selection := listChain;
describe();
print "After a mock selection of listChain:" `describe:;
describe();
print "After a mock selection unchanged:" ``describe:;
selection := dESCRIPT;
describe();
print "After mock deselect and set dESCRIPT:"`describe:;
print "SENTINEL tester driver end":;
stop();

