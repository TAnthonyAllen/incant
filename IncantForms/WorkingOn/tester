                    or *op.taG == "*";  op := Operators["deref"];
                    convertUnary = false;
                if *op.isUnarY;
                    unstruct    +% *op;
                    unstruct    +% *result;
                    unstruct    :. flaG;
                    result := unstruct;
                    clear(op);
            or result == 0;
