        maximus=righty;
        print "maximus reset to:" maximus:;
        whatsIt = maximus -= qa - qb + qc;
        print "After running whatsIt = maximus -= qa - qb + qc; whatsIt:" whatsIt "maximus:" maximus:;
        };

