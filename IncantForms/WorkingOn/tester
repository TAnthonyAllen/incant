/*****************************************************************************
	This is the tester incantation. It is a working file for testing new features
    under development so it changes when there is a new feature in the works.
*****************************************************************************/
Start();
include(utilities);
search reset stack Grokking;
search Utilities list;

// Clod you can change this incantation as needed
register(TESTing);
define
    shSay code={
        v := tell(argument);
        m := *v["matched"]; c := *v["consumed"];
        cerr "DRIVE " argument " matched= " m " consumed= " c:;
        };
    ShA    isRule ka-="a";
    ShRef  isRule ShA kb-="b" TOKENize;
    ShRep  isRule ShA+ kc-="c" TOKENize;
    rsN=0;
    rsRun code={
        rsN = rsN + 1;
        cerr "RS SINK FIRED" rsN:;
        };
    ;
cerr "--- OLD ROAD":;
ShRef("ab");
ShRep("aaac");
parser(ShRef);
parser(ShRep);
debug ShRef ShRep ShA tell;
cerr "--- NEW ROAD":;
ShRef("ab");
ShRep("aaac");
shSay("ShRep aaac");
cerr ::"Running retireSkipsDegraded test":;
rsRun(rsN);
rsRun(rsN);
rsRun(rsN);
stop();

debug;
parser(PrinT);
PrinT("print ++result;");
stop();

