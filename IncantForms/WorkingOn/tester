/*****************************************************************************
	This is the tester incantation. It is a working file for testing new features
    under development so it changes when there is a new feature in the works.
*****************************************************************************/
Start();
include(utilities);
search reset stack Grokking;
search Utilities list;

register(C1Tester);
define
    cv=5;
    n=3;
    lim=8;
    qa=2;
    qb=10;
    ok=1;
    done=0;
    r=0;
    blkBody code={ return argument * 2; };
    fId code={ return argument; };
    c1Run code={
        blk := blkBody;
        cerr "C1 begin":;
        r = *blk(cv) + n * 2 > lim - fId(qa + qb) && ok || !done;
        cerr "C1 r = " r:;
        };
    c1Builds code={
        blk := blkBody;
        cerr "C1 variant begin":;
        r = *blk(cv) + n * 2 > fId(qa + qb) - lim && ok || !done;
        cerr "C1 variant r = " r:;
        };
    ;
c1Run();
c1Builds();
cerr "C1 SENTINEL":;

stop();

