    /*****************************************************************************
        Build the instruction chain walking right to left. An instruction is
        op, argument, target: the target (the left side) is the last slot, so an
        instruction is built as soon as its op and right operand are known and its
        target is filled in when the walk gets to it. slot is the instruction whose
        target is still empty.
            term            pending, waiting for its operator (or the start)
            binary op       new instruction op, pending; it fills the slot, or is
                            the root if there is none; it is the new slot
            assignTier op   fills the slot with pending, then wraps the whole chain
                            as its argument: the assignment comes out last
            unary op        an op with no field or an op to its left: wraps pending
        So qa - qb + qc builds (+ qc (- qb qa)), i.e. (qa - qb) + qc.
    *****************************************************************************/
    xpListTest isRule lizted=listEntries+ SemI- code={
        cur := *lizted.lasT;
        haveRoot = 0;
        while cur.datA != 0;
            if *cur.instructTypE != 0;
                prev := *cur.prioR;
                kind = 1;
                if prev.datA == 0;              kind = 3;
                or *prev.instructTypE != 0;     kind = 3;
                or *cur["assignTier"];          kind = 2;
                if kind == 3;
                    print "kind == 3 unary op?":;
                    op = cur;
                    if *op.taG == "-";  op := Operators["negate"];
                    or *op.taG == "*";  op := Operators["deref"];
                    instruct    +% *op;
                    instruct    +% *pending;
                    dumpField(instruct);
                    pending     := copyOf(instruct);
                    clear(instruct);
                if kind == 2;
                    print "kind == 2 assigning op":;
                    if haveRoot == 1;   *slot +% *pending;
                    if haveRoot == 0;   root := *pending;
                    $$pending;
                    $$root;
                    instruct    +% *cur;
                    instruct    +% *root;
                    dumpField(instruct);
                    root        := copyOf(instruct);
                    clear(instruct);
                    slot        := *root;
                    haveRoot    = 1;
                if kind == 1;
                    print "kind == 1 non assigning op?":;
                    instruct    +% *cur;
                    instruct    +% *pending;
                    dumpField(instruct);
                    node        := copyOf(instruct);
                    clear(instruct);
                    if haveRoot == 1;   *slot +% *node;
                    if haveRoot == 0;   root := *node;
                    slot        := *node;
                    haveRoot    = 1;
            else    pending := *cur;
            cur := *cur.prioR;
        if haveRoot == 1;   *slot +% *pending;
        if haveRoot == 0;   root := *pending;
        listChain(*root);
        result = testOP(*root);
        };
