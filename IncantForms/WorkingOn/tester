            argument +< result;
        else    cerr "parseCode: failed parse of" taG:;
        lastIndenT  :. indenter;
        processingCodE  :. processing;
        currentMETHOD   := *priorMethod;
        $$currentMETHOD;
        $$result;
        if result;  return trueResult;
        return      falseResult;
        };
    ;

