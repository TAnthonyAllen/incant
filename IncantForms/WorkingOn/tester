    /***************************************************************************
        parseCode is kant version of processCode
    ***************************************************************************/
    parseCode code={
        code    := argument.CodE;
        if code.datA == 0;
            cerr taG "has no CodE, has parser() been run on it?":;
            return;
        if isRulE;  action := code;
        else        action := argument;
        priorMethod := *currentMETHOD;
        indenter    = argument.lastIndenT;
        processing  = argument.processingCodE;
        currentMETHOD   := *action;
        $$lastIndenT;
        argument.lastIndenT     = 0;
        argument.processingCodE = 1;
        if result = BlocK(code);
            result :. noPrinT;
            argument :. isActioN;
            argument +< result;
        else    cerr "parseCode: failed parse of" taG:;
        argument.lastIndenT     = indenter;
        argument.processingCodE = processing;
        currentMETHOD   := *priorMethod;
        $$currentMETHOD;
        $$result;
        if result;  return trueResult;
        return      falseResult;
        };
    ;

parseCode(ifTest);
stop();

/***************************************************************************
    parseCode notes (Clod, 2026-10-04)
    Spellings: `:.` takes no value, so values go through a dot -- argument.lastIndenT = 0.
    Any field works left of the dot for lastIndenT/processingCodE; they are globals.
    A bare lastIndenT is the groupFields entry, not the parser's value.
    isAction goes on the action (argument), as processCode does; result gets noPrint.
