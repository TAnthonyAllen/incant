---- rowProbe ----
Start();
include(unitTests);
include(utilities);
search reset stack Grokking;
register(RowP);
define
    rA="s" height=200 width=250 x=100 y=100 down=*
        rRow across=2
            crossing height=50;
    rB="s" height=200 width=250 x=100 y=100 down=*
        rRow2 across=2 height=50
            crossing2;
    rAreq form:=rA;
    rBreq form:=rB;
    rpRun code={
        rpA := setFrame(argument);
        print "RP" argument.taG:;
        tsfLine(*rpA);
        print "RPEND" argument.taG:;
        };
    ;
search RowP UnitTests Utilities list;
rpRun(rAreq);
rpRun(rBreq);
cout "SENTINEL":;
stop();

