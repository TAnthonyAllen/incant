/*****************************************************************************
	This is the delimitedData incantation.
*****************************************************************************/
Start();
include(utilities);
search Utilities list;

registry(TESTing);
/*****************************************************************************
	The following is a first draft of fields that process a comma delimited file.
    The file is assumed to contain records where every record is a row of
    plain text fields separated by a comma, the the row ending in a new line.

    The process: source is a field loaded initially via getFile so it contains
    a buffer with the file contents. Records are read in via loadRecords() which
    calls getRecord repeatedly to read in one record, iterating thru the fieldList
    provided by the user which has a list of fields to go into a record. For
    each of those fields, getRecord runs the DataInputField rule to extract the
    next input field from the source and stick it in the record it returns.
    The contents of a record is a list of every input field read in from a row
    of the source, not includeing skipped fields. A row is a line in the source
    terminated by a \n character.
*****************************************************************************/
define
    comma=",";
    currentField;
    dataDelimiter=[,\n];
    dataFile;
    fieldList one two SKIp some SKIp SKIp more;
    fieldCount=4;
    fieldsRead=0;
    lastField;
    newLine="\n";
    SKIp;
    source File="Tests/delimitTest";
    record;
    recordCount=0;
    DataInputField isRule inputField=dataDelimiter{ newLine?^ comma? guard='n' code={
        if newLine.datA != 0;   lastField = 1;
        if currentField.isGrouP;
            *currentField = *inputField;
            if *currentField == "#end"; return 0;
            record      +/ *currentField;
            ++fieldsRead;
        return  inputField;
        };
    getRecord code={
        iterate grup on fieldList;
        while ++grup;
            fieldName = *grup.taG;
            if fieldName != "SKIp"; currentField := new(fieldName);
            else    clear(currentField);
            if DataInputField();
                if lastField == 1;
                    lastField = 0;
                    if fieldsRead < fieldCount; return 0;
                    else
                        fieldsRead = 0;
                        dataFile +/ copyOf(record);
                        clear(record);
                        ++recordCount;
                        // the following two lines are there as a probe to verify record contents, not needed otherwise
                        recordField := dataFile.lasT;
                        dumpField(*recordField);
                        return recordCount;
            else
                cerr "getRecord ran out of input":;
                return 0;
        };
    loadRecords code={
        pushInputField(argument);
        while getRecord(); continue;
        popInputField();
        if recordCount > 0;    dumpField(dataFile);
        else    cerr "No records loaded":;
        };
    ;
getFile(source);
loadRecords(source);
// The following line is needed otherwise loadRecords will keep on reading text without noticing it ran out of input because the parse just pops diverted input and keeps on parsing. We could use a way to tell it to not do that.
#end
stop();
