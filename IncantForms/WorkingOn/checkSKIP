/*****************************************************************************
	This is the checkSKIP incantation that defines the checkSKIP rule that
    does what the C++ checkSkip() method in GroupRules does: skip space on
    every rule invocation. It also handles the Python like indenting on code
    and also on field definition.
*****************************************************************************/

register(TestStuff);
define
    slash="/";
    star="*";
    openBlockQuote="/";
    endBlockQuote="*";
    openLineComment="/";
    skipInput=(  "what" /* has /* embedded */ comment*/ NotSkipable#);
    skipTester code={
        print "Did the definition work?" skipInput:;
        };
    ;

openBlockQuote += star;
endBlockQuote += slash;
openLineComment += slash;
search Utilities TestStuff list;

register(Grokking);
define
    EmbeddedQuotes
        openBlockQuote;
        endBlockQuote;
    EmbededBody     body-=EmbeddedQuotes};
    EmbeddedCommenT EmbeddedBody+-;
    IndenT=[ \n\t]+;
    BlockCommenT    openBlockQuote- commentBody-=EmbeddedCommenT};
    LineCommenT     openLineComment- commentBody-="\n"};
    CommenT
        BlockCommenT;
        LineCommenT;
    commentBrace
        openBlockQuote;
        endBlockQuote;
    EmbeddedCommenT     commentBrace{ BlockCommenT;
    sKIP
        DelimitText;
        QuotE;
        IndenT;
        CommenT;
    checkSKIP       sKIP+;;     // second ; ends the define command
    
bail();

