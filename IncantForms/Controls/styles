/*  styles -- the colours, fonts and the default style, from the old forms (Tony, 2026-11-05, M5). Not on the
    default search list until defineCapture B2 lands. A reader includes this file and then
    names cOLOr and fONTs in its own search. See docs/m5Recon.md.  */
registry(cOLOr);
define
    red=#ef2b2d;
    blue=#0051ba;
    lightBlue=#ceffff;
    lightGreen=#afd378;
    radialGreen=#afd378;
    green=#009e0f;
    paleGray=#f1f1f1;
    gray=#d6d8d3;
    darkerGray=#afbcbf;
    wall=#f7e8aa;
    white=#ffffff;
    black=#000000;
    saberBrown=#e6d1a2;
    darkBrown=#6b4714;
    ;
registry(fONTs);
define
    courierFont family='Courier New' size=24 bold;
    titleFont family='Palatino' size=24 bold;
    headerFont family='Palatino' size=14 bold;
    normalFont family='Palatino' size=14;
    copperFont family='Copperplate' size=12;
    defaultFont family='Helvetica' size=10;
    EBgaramondFont family='EB Garamond' size=18 bold;
    ;
/*  The default style (Tony, 2026-11-11, SEQ 621 R2). rounded is the corner radius, in points, that a bare
    rounded draws: 5, the old GUI's default (GUI/Control.twk). A reader names sTYLEs in its search.
    emphasis is the first style a run in text names, {emphasis: text} (typesetting's first slice, 2026-11-12): red and italic.
    The search line puts cOLOr and fONTs on the search list while the styles are defined, so a style can hold a colour
    or a font by name (color:=red; Tony, 2026-11-12). It stays on the reader's list afterwards.  */
search cOLOr fONTs;
registry(sTYLEs);
/*  Placeholders and the default look (Tony, 2026-11-14, SEQ 652 R2, R3; built SEQ 654). A form names no explicit colour
    or font: it names a placeholder, spelled by role (fill:=pageFill, font:=headingFont). A placeholder is a virtual
    field, so each look that writes one holds its own. A look is a field holding placeholders; it travels in a form's
    request as look:=, and setFrame resolves every placeholder on the laid-out copy through it. defaultLook is the one
    look used when a request carries none, and the one place it is named. A look of your own that changes one
    placeholder merges this one: myLook merge accent:=green defaultLook;  */
define
    pageFill virtual;
    headingFont virtual;
    bodyFont virtual;
    textColor virtual;
    accent virtual;
    defaultLook merge pageFill:=white headingFont:=titleFont bodyFont:=normalFont textColor:=black accent:=red;
    ;
define
    defaultStyle rounded=5;
    emphasis color:=red italic;
    ;
