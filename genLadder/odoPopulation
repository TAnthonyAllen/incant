define
    opWalk argument code={
        iterate opCur on argument members;
        while ++opCur;
            if noPrinT;             continue;
            if binTypE;             continue;
            if !isRulE;             continue;
            if actionTypE != 0;     continue;
            opEmit(opCur);
        };
    opEmit argument code={
        print "ODOPOP" argument.taG:;
        };
    opRun code={
        opWalk(Grokking);
