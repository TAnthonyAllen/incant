SPELL Scaf
  fold SEQ
  LIT sink=label lit( t1 , " x " ) 
  LIT sink=into  lit( t1 , " x " ) 
SPELL Scaf2
  fold SEQ
  LIT sink=label lit( t1 , " { " ) 
  LIT sink=into  lit( t1 , " { " ) 
  LIT sink=label lit( t2 , " } " ) 
  LIT sink=into  lit( t2 , " } " ) 
SPELL ScafB
  fold SEQ
  CALL sink=label parseR( t1 , label ) 
  CALL sink=into  parseR( t1 , into ) 
  LIT sink=label lit( t2 , " b " ) 
  LIT sink=into  lit( t2 , " b " ) 
SPELL ScafC
  fold SEQ
  MANY sink=label many ScafC1 ( label , t1 ) 
  MANY sink=into  many ScafC1 ( into , t1 ) 
  LIT sink=label lit( t2 , " c " ) 
  LIT sink=into  lit( t2 , " c " ) 
SPELL ScafE
  fold SEQ
  LIT sink=label lit( t1 , " e " ) 
  LIT sink=into  lit( t1 , " e " ) 
  OPT sink=label ( parseR( t2 , label )   || 1) 
  OPT sink=into  ( parseR( t2 , into )   || 1) 
  LIT sink=label lit( t3 , " f " ) 
  LIT sink=into  lit( t3 , " f " ) 
SPELL ScafF
  fold SEQ
  LIT sink=label lit( t1 , " f " ) 
  LIT sink=into  lit( t1 , " f " ) 
  OPT sink=label ( lit( t2 , " , " )   || 1) 
  OPT sink=into  ( lit( t2 , " , " )   || 1) 
  LIT sink=label lit( t3 , " g " ) 
  LIT sink=into  lit( t3 , " g " ) 
SPELL ScafALT
  fold ALT
  CALL sink=label parseR( t1 , label ) 
  CALL sink=into  parseR( t1 , into ) 
  CALL sink=label parseR( t2 , label ) 
  CALL sink=into  parseR( t2 , into ) 
SPELL CodeBody
  fold SEQ
  LITTO sink=label litTo( t1 ,label, " { " , " leftCurly " ) 
  LITTO sink=into  litOption( t1 ,into, " { " ) 
  LITTO sink=label litTo( t2 ,label, " } " , " rightCurly " ) 
  LITTO sink=into  litOption( t2 ,into, " } " ) 
SPELL Limit
  REFUSE min -- inline group / structural data isGROUP (named future kind)
  REFUSE rule Limit -- term min unclassified
  no plan
