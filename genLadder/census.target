PLAN Scaf
  SEQ Scaf
    label=Scaf
    LIT x
      at=1
PLAN Scaf2
  SEQ Scaf2
    label=Scaf2
    LIT {
      at=1
    LIT }
      at=2
PLAN ScafA
  SEQ ScafA
    label=ScafA
    LIT a
      at=1
PLAN ScafB
  SEQ ScafB
    label=ScafB
    CALL ScafA
      at=1
    LIT b
      at=2
PLAN JSONblock
  SEQ JSONblock
    label=JSONblock
    LIT {
      at=1
    MANY JSONfield
      at=2
      min=0
      site=JSONblock2
      CALL JSONfield
        at=2
    LIT }
      at=3
PLAN JSONfield
  REFUSE , -- optional (min 0 max 1) has no kind yet
  REFUSE rule JSONfield -- term , unclassified
PLAN JSONvalue
  ALT JSONvalue
    CALL JSONblock
      at=1
    CALL JSONarray
      at=2
    CALL JSONtoken
      at=3
PLAN JSONtoken
  REFUSE NumbeR -- data isGROUP (rung 5)
  REFUSE rule JSONtoken -- term NumbeR unclassified
PLAN JSONitem
  REFUSE , -- optional (min 0 max 1) has no kind yet
  REFUSE rule JSONitem -- term , unclassified
PLAN JSONlist
  SEQ JSONlist
    label=JSONlist
    MANY JSONitem
      at=1
      min=1
      site=JSONlist1
      CALL JSONitem
        at=1
PLAN JSONarray
  REFUSE JSONlist -- optional (min 0 max 1) has no kind yet
  REFUSE rule JSONarray -- term JSONlist unclassified
PLAN NumbeR
  REFUSE rule NumbeR -- rule-level data isGROUP (§4.1 rule-as-data, rung 5)
PLAN FloaT
  REFUSE rule FloaT -- rule-level data isCHAR (§4.1 rule-as-data, rung 5)
PLAN PoweR
  REFUSE rule PoweR -- rule-level data isSET (§4.1 rule-as-data, rung 5)
PLAN QuotE
  REFUSE tik -- data isSET (rung 5)
  REFUSE rule QuotE -- term tik unclassified
PLAN NamE
  REFUSE first -- data isSET (rung 5)
  REFUSE rule NamE -- term first unclassified
PLAN GrouP
  ALT GrouP
    CALL NamE
      at=1
    CALL QuotE
      at=2
PLAN CodE
  REFUSE rule CodE -- 2 unmaterialised terms
PLAN DatA
  REFUSE NumbeR -- data isGROUP (rung 5)
  REFUSE rule DatA -- term NumbeR unclassified
PLAN Limit
  REFUSE rule Limit -- 3 unmaterialised terms
PLAN MemberS
  SEQ MemberS
    label=MemberS
    LIT :
      at=1
    MANY DefinE
      at=2
      min=1
      site=MemberS2
      CALL DefinE
        at=2
PLAN Modifier
  REFUSE rule Modifier -- rule-level data isSET (§4.1 rule-as-data, rung 5)
PLAN TraiT
  REFUSE Modifier -- data isSET (rung 5)
  REFUSE rule TraiT -- term Modifier unclassified
PLAN TraiTdata
  REFUSE Modifier -- data isSET (rung 5)
  REFUSE rule TraiTdata -- term Modifier unclassified
PLAN Attributes
  REFUSE rule Attributes -- rule-level data isGROUP (§4.1 rule-as-data, rung 5)
PLAN NewGroup
  REFUSE rule NewGroup -- rule-level data isGROUP (§4.1 rule-as-data, rung 5)
PLAN DefinE
  REFUSE NewGroup -- data isGROUP (rung 5)
  REFUSE rule DefinE -- term NewGroup unclassified
PLAN debug
  plan: REFUSING debug -- not a rule; locate finds a non-rule in registry Keywords
PLAN DEBUG
  REFUSE followedBy -- data isSET (rung 5)
  REFUSE rule DEBUG -- term followedBy unclassified
PLAN InvokE
  REFUSE GrouP -- optional (min 0 max 1) has no kind yet
  REFUSE rule InvokE -- term GrouP unclassified
