PLAN Scaf
  SEQ Scaf
    label=Scaf
    LIT x
      at=1
PLAN Scaf2
  SEQ Scaf2
    label=Scaf2
    LIT {
      at=1
    LIT }
      at=2
PLAN ScafA
  SEQ ScafA
    label=ScafA
    LIT a
      at=1
PLAN ScafB
  SEQ ScafB
    label=ScafB
    CALL ScafA
      at=1
    LIT b
      at=2
PLAN JSONblock
  SEQ JSONblock
    label=JSONblock
    LIT {
      at=1
    MANY JSONfield
      at=2
      min=0
      site=JSONblock2
      CALL JSONfield
        at=2
    LIT }
      at=3
PLAN JSONfield
  SEQ JSONfield
    label=JSONfield
    CALL JSONtoken
      at=1
    LIT :
      at=2
    CALL JSONvalue
      at=3
    OPT ,
      at=4
      LIT ,
        at=4
PLAN JSONvalue
  ALT JSONvalue
    CALL JSONblock
      at=1
    CALL JSONarray
      at=2
    CALL JSONtoken
      at=3
PLAN JSONtoken
  ALT JSONtoken
    CALL JSONblock
      at=1
    LITTO false
      at=2
      slot=false
    LITTO true
      at=3
      slot=true
    CALL GrouP
      at=4
    CALL NumbeR
      at=5
PLAN JSONitem
  SEQ JSONitem
    label=JSONitem
    CALL JSONtoken
      at=1
    OPT ,
      at=2
      LIT ,
        at=2
PLAN JSONlist
  SEQ JSONlist
    label=JSONlist
    MANY JSONitem
      at=1
      min=1
      site=JSONlist1
      CALL JSONitem
        at=1
PLAN JSONarray
  SEQ JSONarray
    label=JSONarray
    LIT [
      at=1
    OPT JSONlist
      at=2
      CALL JSONlist
        at=2
    LIT ]
      at=3
PLAN NumbeR
  REFUSE numberSet -- inline group / structural data isSET (named future kind)
  REFUSE rule NumbeR -- term numberSet unclassified
PLAN FloaT
  REFUSE point -- inline group / structural data isCHAR (named future kind)
  REFUSE rule FloaT -- term point unclassified
PLAN PoweR
  REFUSE exponent -- inline group / structural data isSET (named future kind)
  REFUSE rule PoweR -- term exponent unclassified
PLAN QuotE
  REFUSE tik -- inline group / structural data isSET (named future kind)
  REFUSE rule QuotE -- term tik unclassified
PLAN NamE
  REFUSE first -- inline group / structural data isSET (named future kind)
  REFUSE rule NamE -- term first unclassified
PLAN GrouP
  ALT GrouP
    CALL NamE
      at=1
    CALL QuotE
      at=2
PLAN CodeBody
  SEQ CodeBody
    label=CodeBody
    LITTO {
      at=1
      slot=leftCurly
    LITTO }
      at=2
      slot=rightCurly
PLAN DatA
  REFUSE CodeBody -- parseAction (tail position only, §2.8)
  REFUSE rule DatA -- term CodeBody unclassified
PLAN Limit
  REFUSE min -- inline group / structural data isGROUP (named future kind)
  REFUSE rule Limit -- term min unclassified
PLAN MemberS
  REFUSE MEMBERs -- parseAction (tail position only, §2.8)
  REFUSE rule MemberS -- term MEMBERs unclassified
PLAN Modifier
  REFUSE rule Modifier -- rule-level data isSET (§4.1 rule-as-data, rung 5)
PLAN TraiT
  REFUSE Modifier -- inline group / structural data isSET (named future kind)
  REFUSE rule TraiT -- term Modifier unclassified
PLAN TraiTdata
  REFUSE Modifier -- inline group / structural data isSET (named future kind)
  REFUSE rule TraiTdata -- term Modifier unclassified
PLAN Attributes
  REFUSE rule Attributes -- rule-level data isGROUP (§4.1 rule-as-data, rung 5)
PLAN NewGroup
  REFUSE rule NewGroup -- rule-level data isGROUP (§4.1 rule-as-data, rung 5)
PLAN DefinE
  REFUSE NewGroup -- inline group / structural data isGROUP (named future kind)
  REFUSE rule DefinE -- term NewGroup unclassified
PLAN debug
  plan: REFUSING debug -- not a rule; locate finds a non-rule in registry Keywords
PLAN DEBUG
  REFUSE followedBy -- inline group / structural data isSET (named future kind)
  REFUSE rule DEBUG -- term followedBy unclassified
PLAN InvokE
  SEQ InvokE
    label=InvokE
    LIT (
      at=1
    OPT GrouP
      at=2
      CALL GrouP
        at=2
    LIT )
      at=3
