// accessorWrite x.name = v: opDot handed opAssign its isAccessorProduct copy of x's groupField, parented to x; write the field on x through setGroupField, or say by name that it has no write case
extern int accessorWrite(GroupItem argument,GroupItem product)
{
int         value = 0;
    // methodWrite `x.methoD = "name"` binds a METHOD, which no integer can carry -- it leaves before the value is read
    if product.tag eq "methoD"  return accessorWriteMethod(argument,product);
    if argument     value = argument.count;
    return accessorWriteValue(value,product);
}


// accessorWriteMethod x.methoD = "name": find the named method with dlsym, as ruleMethod does, and bind it as x's method; a name dlsym cannot find is refused and x is unchanged
extern int accessorWriteMethod(GroupItem argument,GroupItem product)
{
GroupItem   holder;
String      name;
    holder = product.parent;
    if !holder || !argument {
        cerr "opAssign: `.methoD` needs a field on its left and a method name on its right -- nothing bound":;
        return 1; }
    name = argument.text;
    if !dlsym(RTLD_SELF,name) {
        refuse(holder,"`.methoD`: no method named by the right-hand text -- nothing bound");
        return 1; }
    holder.method = dlsym(RTLD_SELF,name);
    holder.isMethod = true;
    return 1;
}


// accessorWriteValue accessorWrite's body, handed the value rather than its node so the jitted = can call it with a scalar (jitAccessorWriteRT, SEQ 297 R0) -- one writer for both roads
extern int accessorWriteValue(int value,GroupItem product)
{
GroupRules  ruler = groupRules;
GroupItem   flagDef;
use product
    flagDef = groupFields[tag];
    if flagDef
        if setGroupField(product.parent,flagDef.gCount,value)  return 1;
    cerr "opAssign: `." product.tag "` has no write case -- the field is unchanged":;
    return 0;
}


// castStore the cast rule's store (SEQ 347 R0): a count, NUMBER or STRING target that has a kind keeps it and the argument is cast in; answers 1 when it took the store
extern int castStore(GroupItem argument,GroupItem target)
{
    if !target.data || !argument.data       return 0;
    if target.data == argument.data         return 0;
    // castExempt an accessor product is a write THROUGH a field, and those are exempt (R1); a holder carries its group across and lists keep setContent (SEQ 346 R4)
    if target.isAccessorProduct             return 0;
    if argument.isGROUP                     return 0;
    if !target.isCOUNT && !target.isNUMBER && !target.isSTRING  return 0;
    if argument.isCOUNT || argument.isNUMBER || argument.isSTRING || argument.isTOKEN {
        // castCount .count is getCount: a NUMBER rounds half up toward +inf, a STRING or TOKEN reads its text length
        if target.isCOUNT       target.count    = argument.count;
        or target.isNUMBER {
            if argument.isNUMBER    target.number   = argument.number;
            else                    target.number   = argument.count; }
        or target.isSTRING      target.text     = argument.text;
        return 1; }
    refuse(target,"Operator = -- the argument has no count and no text to cast into this kind (SEQ 347 R0)");
    return 1;
}

// concatText a fresh text: left followed by right (SEQ 347 R3)
extern String concatText(String left,String right)
{
    -%
    if ( !left )    left = (char*)"";
    if ( !right )   right = (char*)"";
    size_t n = strlen(left) + strlen(right) + 1;
    char *t = (char*)malloc(n);
    snprintf(t,n,"%s%s",left,right);
    return t;
    %-
}

// getMarkLineAt the getLine command: find the line holding fromThis's text in the source buffer, hand it back as a token field into the buffer (valid only while the buffer holds it in place), and leave the mark at the line's start; a mark already set is where the search starts
extern GroupItem getMarkLineAt(GroupItem argument)
{
GroupItem   source = argument["source"],
            fromThis = argument["fromThis"];
GroupItem   result;
    // notASentinel both refusal arms already return the testable nothing; prose for this chain goes above it, never between its arms (bear-trap #29)
    if source && source.isBUFFER
        if fromThis {
            Buffer      buffer = source.buffer;
            int         matchLength;
            String      lineStart;
            if buffer
                if matchLength = findInBuffer(fromThis.text) {
                    lineStart = mark;
                    // headLineStep  step over the \n the walk STOPPED at, never into line one
                    while lineStart != start && lineStart != '\n' lineStart--;
                    if lineStart == '\n' lineStart++;
                    mark = lineStart + matchLength;
                    while mark < current && mark != '\n' mark++;
                    mark++;
                    result = new("markLine");
                    result.setToken(lineStart,(int)(mark - lineStart));
                    mark = lineStart; }
                else refuse(fromThis,"getLine: no line in the buffer contains the match text");
                }
        else refuse(fromThis,"getLine: no match field provided");
    else refuse(source,"getLine: no source, or the source is not a buffer");
    return result;
}


// opAddAttribute the +% operator: add the argument, or each item of a list argument, as an attribute of target
extern GroupItem opAddAttribute(GroupItem argument,GroupItem target)
{
GroupItem   grup;
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    // listHolderUnwraps a list entry that is a holder attaches its CONTENT, one level -- a dated exception to the star law (Tony, 2026-10-22, SEQ 399); the list arm only
    if argument.isLIST
        while grup = argument.next(grup)
            if grup.isGROUP && grup.group   target +% grup.group;
            else                            target +% grup;
    else    target +% argument;
    return target;
}


// opAddMember the +/ operator: add the argument, or each item of a list, as a member of target -- share-body, as +% is
extern GroupItem opAddMember(GroupItem argument,GroupItem target)
{
GroupItem   grup;
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    // literalRightSideRefuses membership attaches a NODE; a literal is a value, refused by presence (isLiteral), never by a classifier
    if argument.isLiteral   return refuse(target,"Operator +/ -- the right side is a literal; membership attaches a field to a list, and a literal is a value with no node to attach");
    if argument.isLIST
        while grup = argument.next(grup)
            target.addMember(grup);
    else    target.addMember(argument);
    return target;
}


// opAddPointer the +* operator: add an attribute that POINTS AT the argument (+% adds a copy); read it back with *
extern GroupItem opAddPointer(GroupItem argument,GroupItem target)
{
GroupItem   ptr;
    // pointerLifetime nothing checks the pointee's lifetime, deliberately -- point at a tempField and it changes underneath you
    if !argument {
        // f43 name TARGET explicitly (bare tag resolved to ptr, still null here), and refuse -- never hand target back as if it were an answer
        return refuse(target,"Operator +* -- an operand that is nothing"); }
    ptr                 = new(argument.tag);
    ptr.gGroup          = argument;
    ptr.isGROUP         = true;
    ptr.isInitialized   = true;
    target.addAttribute(ptr);
    return target;
}


// opAddProperty the +< operator: file the argument on target's property list, never among its terms (SEQ 224)
extern GroupItem opAddProperty(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing, as for +%
    if ruler.refused    return null;
    target.addProperty(argument);
    return target;
}


// opAND the AND operator's STRICT fallback: both operands have already run, so the short-circuit is runShortCircuit's, never this; answers 1 or 0 through truthOf
extern GroupItem opAND(GroupItem argument,GroupItem target)
{
    if truthOf(target) && truthOf(argument)     return trueResult;
    return falseResult;
}


// opAssign the = operator: setContent -- target takes the argument's data, a holder carries its group across, a null clears; it never aliases, whatever byRef says; jitAssignNodeRT is its jitted twin, so edit the two together (assignRoadT pins both)
extern GroupItem opAssign(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
int         priorLimit = limitWriteGuard(target);
    if jitting {
        -% return jitEmitAssign(argument, target); %-
    }
    // storeRulingHere an armed statement stores nothing -- asked HERE, not at runOP's entry, because an assignment dispatches before its own right-hand side
    if ruler.refused    return null;
    // accessorWrite `x.name = v` writes the FIELD x through setGroupField, not only the copy opDot handed back (SEQ 295 R3)
    if target.isAccessorProduct     accessorWrite(argument,target);
use target
    // castRule a target that has a kind keeps it and the argument is cast in (SEQ 347 R0); one with no kind takes the argument's, as setContent does
    if argument {
        if !castStore(argument,target)  target.setContent(argument); }
    else    target.clearData();
    // limitGuard F-27: a non-zero priorLimit means target IS maxLimit; the guard call sits above the jitting arm on purpose
    if priorLimit   limitWriteCheck(target,priorLimit);
    return  target;
}


// opCallTest test of the call op: run target's action, or its method, on the argument
extern GroupItem opCallTest(GroupItem argument,GroupItem target)
{
GroupItem result;
    if target.actionType    result = runAction(argument,target);
    or target.method
        if argument         result = target.method(argument);
        else                result = target.method(target);
    else cerr "opCallTest: "    target.tag "has no method":;
    return result;
}


// opCerr the cerr rule's operator method, the stderr sink: a SIBLING of opPrint rather than a third arm, and it does not honour the print diversion, on purpose
extern GroupItem opCerr(GroupItem target,Buffer buffer)
{
String      printText   = string();
    if printText    cerr printText;
    else            cerr "cerr: recieved no print text":;
    reset();
    bufferSTAK  += buffer;
    return trueResult;
}


// opCout the cout rule's operator method, the explicit stdout sink: it never consults toBUFFER, and that missing test IS the feature (KANT-23)
extern GroupItem opCout(GroupItem target,Buffer buffer)
{
String      printText   = string();
    if printText    cout printText;
    else            cerr "cout: recieved no print text":;
    reset();
    bufferSTAK  += buffer;
    return trueResult;
}


// opDebug the $$ debug marker: an Xcode inspection point that unwraps a group and hands it back
extern GroupItem opDebug(GroupItem result)
{
GroupRules  ruler = groupRules;
GroupItem   field,
            lastRef;
    lastRef = lastREF;
    field   = result;
    if result.isGROUP   result = unWrap(result);
    return  result;
}


// opDeref the prefix unary *: hand back the group a field holds, or null -- its own op, so the binary * slot (opMultiply) stays isolated; under jit, jitEmitDeref or a degrade by name
extern GroupItem opDeref(GroupItem result)
{
    if jitting {
        // holderHandOver a holder written by a handed-over statement is known only at run time: its dereference is handed over too, never followed at build (SEQ 405)
        -% if ( result && gJitRTHolders.count((void*)result->groupBody) ) { ::jitHandOver((char*)"a dereference of a holder written at run time -- its statement runs at RUN time", result); return 0; } %-
        // ownNode the compiled dereference hands back its own fresh node, never the build-time follow (SEQ 423)
        -% if (::jitEmitDeref(result) && gJitDerefNode) return gJitDerefNode;
           ::jitDegrade("unary * under jit -- emitter refused",result); %-
    }
    // starRuling *x on a field holding no group yields NULL and does not refuse; the consumer of the null refuses, in its own name (Tony, 2026-09-05)
    if result.isGROUP   return result.group;
    return null;
}


// opDiv the / operator: always a DOUBLE, even when exact -- 10 / 4 is 2.5
extern GroupItem opDiv(GroupItem argument,GroupItem target)
{
int     wrote = 0;
    if jitting {
        -% return jitEmitBinary(argument, target, jitSDiv); %-
    }
    // alwaysDouble division never changes meaning by operand type, and an exact quotient stays a double so the jit knows the result type at emit time
    if argument.isCOUNT || argument.isNUMBER || argument.isSTRING || argument.isTOKEN {
        tempField.number = number / argument.number;
        wrote = 1; }
    // ownWrite the operator decides it produced a value by its own write THIS call, never by the shared tempField, which holds the last computation's (F-144, SEQ 432)
    if !wrote {
        return refuse(target,"Operator / -- not supported for these operands"); }
    return tempField;
}


// opDivEQ the /= operator: divide as / does, then narrow into the slot target already is
extern GroupItem opDivEQ(GroupItem argument,GroupItem target)
{
GroupItem   result;
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    if jitting {
        -% return jitEmitAssign(jitEmitBinary(argument, target, jitSDiv), target); %-
    }
use target
    if (isCOUNT || isNUMBER) && (argument.isCOUNT || argument.isNUMBER || argument.isSTRING || argument.isTOKEN) {
        // a count target rounds half-up through getCount's floor(x+0.5), so the two cannot drift; a double keeps the fraction
        if isCOUNT  count   = (int)floor((number / argument.number) + 0.5);
        or isNUMBER number  = number / argument.number;
        result = target;
        if !result  cerr "ERROR Operator /= failed on",tag,"and",argument.tag:; }
    or argument.isLIST
        while result = argument.next(result)
            opDivEQ(result,target);
    return result;
}


// opDot the . operator: the field a dot expression names -- a groupField accessor read off target, or target's component of that tag; local fields are ignored
extern GroupItem opDot(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
GroupItem   product;
    // accessorGate ONE gate for the whole accessor family; remove it and a jitted `if noPrinT` branches on whatever was last in flight
    if jitting {
        -% return jitEmitDot(argument, target, ruler->tempField); %-
    }
use argument
    // leadingOnly !argument means the leading-dot form ONLY -- the right of a dot is a literal tag (ruled 09-16), so a binary null right has no road (F-132)
    if !argument
        if lastREF {
            argument = target;
            target = lastREF.group; }
        else    cerr "opDot: lastREF not set":;
    // what arrived on the right, and whether it is a groupField
    measureDotOperands(argument,target);
    if argument {
        // rightIsATag the right operand is a LITERAL NAME, so read its TAG -- never .text, which answers only through bear-trap #26's fall-through
        // nullTarget a star on a field that holds no group yields NULL, and `*x.y` folds the star onto x -- refuse by name, never read through null (starDotNull, SEQ 301)
        if registry != groupFields {
            if !target  return refuse(argument,"opDot: the left of this dot holds nothing -- in `*x.y` the star binds to x, so read through a temporary: `t = x.y;` then `*t`");
            product = target[tag]; }
        else {
            if !target  return 0;
            product = new(tag);
            // accessorMark the ONE meaning of isAccessorProduct: this node is opDot's copy of a groupField, so `=` on it writes the field through setGroupField (SEQ 295 R3); a node-returning case replaces product and the mark goes with it
            product.isAccessorProduct = true;
use argument
            switch(gCount) {
                case 1:     product.text    = target.tag;
                case 2:     if !target.parent    product = null; else product = target.parent;
                case 3:     if !target.registry  product = null; else product = target.registry;
                case 4:     product.text    = target.text;
                case 5:     if target.groupList     product.count = target.listLength;
                case 6:     product.count   = target.data;
                case 7:     if target.hasAttributes product.count = 1;
                case 8:     if target.hasMembers    product.count = 1;
                // case42hasTraits NOT case 7: setParse makes hasAttributes TRUE for every walked rule, so only this one discriminates
                case 42:    if target.hasTraits     product.count = 1;
                case 9:     if target.isLocal       product.count = 1;
                case 10:    if target.isArgument    product.count = 1;
                case 11:    if target.invoke        product.count = 1;
                case 17:    if target.isLiteral     product.count = 1;
                case 19:    if target.isMethod      product.count = 1;
                case 20:    if target.isOperator    product.count = 1;
                case 23:    if target.isRuleTerm()  product.count = 1;
                case 24:    if target.isShortcut    product.count = 1;
                case 28:    if target.rStuff && target.noLabel  product.count = 1;
                case 29:    if target.noPrint       product.count = 1;
                case 33:    if target.isBIN         product.count = 1;
                case 34:    if target.isAttribute   product.count = 1;
                case 35:    if target.isMember      product.count = 1;
                // hasActionAsksActor "this rule has an action": its builtinActoR, never a fire-time cache (SEQ 205 R1)
                case 36:    if target.getProperty("builtinActoR")   product.count = 1;
                case 40:    if target.isCoded       product.count = 1;
                // case41hasNewParse the READ half; the write half is setGroupField case 41 -- they ship together or the flag is unassertable
                case 41:    if target.hasNewParse   product.count = 1;
                // isGrouPNoWriteHalf READ-ONLY by design: isGROUP is a data KIND, not a flag, so no write half is owed
                case 43:    if target.isGROUP       product.count = 1;
                // debuggeDNoWriteHalf READ-ONLY by design: the debug rule is the flag's only writer, and a second would let a fixture fake its own reading
                case 44:    if target.debugged      product.count = 1;
                case 45:    if target.isUnary       product.count = 1;
                case 46:    if target.fLAG          product.count = 1;
                case 401:   if !target.nextInParent product = null;
                            else {
                                product = target.nextInParent;
                                product.isInitialized = true; }
                case 402:   if !target.priorInParent    product = null;
                            else {
                                product = target.priorInParent;
                                product.isInitialized = true; }
                // cases403to404 the `groupList &&` prefix is LOAD-BEARING -- without it the guard dereferences the pointer it guards
                case 403:   if !target.groupList || !target.firstInList  product = null; else product = target.firstInList;
                case 404:   if !target.groupList || !target.lastInList   product = null; else product = target.lastInList;
                // case405firstMember affiliation-FILTERED first, unlike `.firsT`, which returns the attribute on an attribute-first node
                case 405:   if !target.groupList  product = null; else product = target.nextMember(0);
                case 406:   product.count = target.actionType;
                // case407binType binType is an ENUM, so nonzero means ANY container kind -- deliberately wider than isBIN||isREGISTRY
                case 407:   if target.binType     product.count = 1;
                // case408isAction 406 cannot witness isCoded -> isAction; this tests isAction SPECIFICALLY, as parseRule does
                case 408:   if target.isAction    product.count = 1;
                // unsupportedAccessor a gCount with no case of its own lands on default and SAYS SO, rather than answering with a silent null
                case 409:   product.count = target.instructType;
                case 411:   product.count   = lastIndent;
                case 412:   product.count   = inCompile();
                case 413:   if target.isMethod  product.count = 1;
                default:    product.text    = "access to " tag " not supported yet"; }
            // nullIsLawful seven accessors answer null for 'nothing there' -- guard the read, as the next line does (nullAccessorDeref, born fb9e4de)
            if product && !product.data product.count  = 0;
            if product && !product.parent   product.parent = target; }}
    return product;
}


// opEQ the == operator: a data-less operand equals a numeric zero; otherwise compareValues decides
extern GroupItem opEQ(GroupItem argument,GroupItem target)
{
    if jitting {
        -% return jitEmitCompare(argument, target, jitEQ); %-
    }
    // f41 a refused operand arrives as null -- refuse it by name (see opPlus)
    if !argument {
        return refuse(target,"Operator == -- an operand that is nothing"); }
    if target && !data {
        if argument.isCOUNT || argument.isNUMBER
            if argument.gCount == 0     return trueResult; }
    or argument && !argument.data {
        if isCOUNT || isNUMBER
            if gCount == 0              return trueResult; }
    or !compareValues(target,argument)  return trueResult;
    return null;
}


// opGE the >= operator, on opEQ's shape
extern GroupItem opGE(GroupItem argument,GroupItem target)
{
    if jitting {
        -% return jitEmitCompare(argument, target, jitGE); %-
    }
    // f41 a refused operand arrives as null -- refuse it by name (see opPlus)
    if !argument {
        return refuse(target,"Operator >= -- an operand that is nothing"); }
    if target && !data {
        if argument.isCOUNT || argument.isNUMBER
            if argument.gCount <= 0     return trueResult; }
    or argument && !argument.data {
        if isCOUNT || isNUMBER
            if gCount >= 0              return trueResult; }
    or compareValues(target,argument) >= 0  return trueResult;
    return null;
}


// opGet the [] subscript: target's component by count or by name; a group argument names it by its gText
extern GroupItem opGet(GroupItem argument,GroupItem target)
{
GroupItem   result;
String      txt;
    // nullTarget a null target is a lawful empty answer, as in opDot
    if !target  return null;
    if argument.isGROUP && argument.gText txt = argument.gText;
    else    txt = argument.text;
use target
    if argument.isCOUNT result = get(argument.count);
    else                result = get(txt);
    return result;
}


// opGetAttribute the =% operator: target's attribute named by the argument's text
extern GroupItem opGetAttribute(GroupItem argument,GroupItem target)
{
String strung = lookupName(argument);
    return getAttribute(strung);
}


// opGetMember the =/ operator: target's member named by the argument's text
extern GroupItem opGetMember(GroupItem argument,GroupItem target)
{
String strung = lookupName(argument);
    return getMember(strung);
}


// opGetProperty the =< operator: reads target's property list only, so a term of the same name cannot answer (SEQ 224)
extern GroupItem opGetProperty(GroupItem argument,GroupItem target)
{
String strung = lookupName(argument);
    return getProperty(strung);
}


// opGT the > operator, on opEQ's shape
extern GroupItem opGT(GroupItem argument,GroupItem target)
{
    if jitting {
        -% return jitEmitCompare(argument, target, jitGT); %-
    }
    // f41 a refused operand arrives as null -- refuse it by name (see opPlus)
    if !argument {
        return refuse(target,"Operator > -- an operand that is nothing"); }
    if target && !data {
        if argument.isCOUNT || argument.isNUMBER
            if argument.gCount < 0      return trueResult; }
    or argument && !argument.data {
        if isCOUNT || isNUMBER
            if gCount > 0               return trueResult; }
    or compareValues(target,argument) > 0   return trueResult;
    return null;
}


// opIN the IN operator: a list argument holds target's tag; a set argument holds any of target's characters; a set target holds all of the argument's; a buffer argument contains target's text -- to be rewritten once there are set operators
extern GroupItem opIN(GroupItem argument,GroupItem target)
{
PLGset  set;
GroupItem   result;
    if argument.groupList   result = argument.firstComponent(target.tag);
    or argument.isSET {
        if set = argument.characterSet
            if set.foundIn(target.text)     result = trueResult; }
    or target.isSET {
        if set = target.characterSet
            if set.contains(argument.text)  result = trueResult; }
    or argument.isBUFFER {
        String searchString = target.text;
        // findInBuffer leaves the buffer's mark at the match; target goes back so the caller has the match length
        if argument.buffer.findInBuffer(searchString)    result = target; }
    return result ;
}


// opLastREF the @ operator: point lastREF at the result and hand it back
extern GroupItem opLastREF(GroupItem result)
{
    lastREF.gGroup  = result;
    lastREF.isGROUP = true;
    return result;
}


// opLE the <= operator, on opEQ's shape
extern GroupItem opLE(GroupItem argument,GroupItem target)
{
    if jitting {
        -% return jitEmitCompare(argument, target, jitLE); %-
    }
    // f41 a refused operand arrives as null -- refuse it by name (see opPlus)
    if !argument {
        return refuse(target,"Operator <= -- an operand that is nothing"); }
    if target && !data {
        if argument.isCOUNT || argument.isNUMBER
            if argument.gCount >= 0     return trueResult; }
    or argument && !argument.data {
        if isCOUNT || isNUMBER
            if gCount <= 0              return trueResult; }
    or compareValues(target,argument) <= 0  return trueResult;
    return null;
}


// opLT the < operator, on opEQ's shape
extern GroupItem opLT(GroupItem argument,GroupItem target)
{
    if jitting {
        -% return jitEmitCompare(argument, target, jitLT); %-
    }
    // f41 a refused operand arrives as null -- refuse it by name (see opPlus)
    if !argument {
        return refuse(target,"Operator < -- an operand that is nothing"); }
    if target && !data {
        if argument.isCOUNT || argument.isNUMBER
            if argument.gCount > 0      return trueResult; }
    or argument && !argument.data {
        if isCOUNT || isNUMBER
            if gCount < 0               return trueResult; }
    or compareValues(target,argument) < 0  return trueResult;
    return null;
}


// opMatch the ~= match operator: true when target's text and the argument's compare equal
extern GroupItem opMatch(GroupItem argument,GroupItem target)
{
    if !compare(text,argument.text) return trueResult;
    return null;
}


// opMinus the - operator: numbers subtract (a double operand promotes the result); a string drops the argument's count of characters from its tail
extern GroupItem opMinus(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
int         wrote = 0;
    if jitting {
        -% return jitEmitBinary(argument, target, jitSub); %-
    }
    // f41 a refused operand arrives as null -- refuse it by name (see opPlus)
    if !argument {
        return refuse(target,"Operator - -- an operand that is nothing"); }
    if (isCOUNT || isNUMBER) && (argument.isCOUNT || argument.isNUMBER || argument.isSTRING || argument.isTOKEN) {
        // binaryPromotes a double operand promotes the result; count OP count stays a count (see opPlus)
        if isNUMBER || argument.isNUMBER    tempField.number = number - argument.number;
        else                                tempField.count  = gCount - argument.count;
        wrote = 1; }
    or (isSTRING || isTOKEN) && argument.count > 0
        if gCount > argument.count  {   tempField.text = headToCount(text,gCount - argument.count);
                                        wrote = 1; }
    // ownWrite the operator decides it produced a value by its own write THIS call, never by the shared tempField, which holds the last computation's (see opDiv)
    if !wrote {
        return refuse(target,"Operator - -- cannot apply to these operands"); }
    return tempField;
}


// opMinusEQ the -= operator: remove a member by tag from a list, or subtract in place -- computed in doubles, narrowed at the result
extern GroupItem opMinusEQ(GroupItem argument,GroupItem target)
{
GroupItem   result;
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    if jitting {
        -% return jitEmitAssign(jitEmitBinary(argument, target, jitSub), target); %-
    }
use target
    if groupList  result = remove(argument.tag);
    or data && argument.data {
        result = target;
        switch(data) {
            // narrowAtResult compute in doubles, narrow at the result -- through tempField.count, so getCount stays the ONE half-up implementer
            case isCOUNT:   tempField.number = number - argument.number;
                            gCount  = tempField.count;
            case isNUMBER:  gNumber -= argument.number;
            case isBUFFER:  buffer  -= argument.count;
            case isSTRING:
            case isTOKEN:   text = headToCount(text,gCount - argument.count);
            default:        result = 0; }
        if !result  cerr "ERROR Operator -= failed on",tag,"and",argument.tag:; }
    or argument.isLIST
        while result = argument.next(result)
            opMinusEQ(result,target);
    return result;
}


// opMinusMinus the -- operator: an iterator steps BACK one child; a value steps down by one; a field never assigned is absent and refuses
extern GroupItem opMinusMinus(GroupItem result)
{
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    // handedCursor a cursor whose iterate was handed over at build is not flagged until run time: its -- is the iterator step back (SEQ 403)
    if jitting {
        -% if ( ::jitHandedCursor(result) ) return jitEmitIterStepBack(result); %-
    }
    if isIterator {
        // an iterator is not unwrapped in runOP; -- cannot tell members from attributes, as GroupItem has no priorMember() or priorAttribute()
        // iterGate the jitting gate sits INSIDE the iterator arm and ABOVE its return, or the compiled walk has no loop (F-53)
        if jitting {
            -% return jitEmitIterStepBack(result); %-
        }
        GroupItem iterator;
        if !result.data     iterator = result.lastInList;
        else {
            iterator    = result.group;
            iterator    = priorInParent; }
        lastREF.gGroup  = iterator;
        lastREF.isGROUP = true;
        result.group    = iterator;
        if !iterator    result = 0;
        return result; }
    if jitting {
        -% return jitEmitUnary(result, jitDec); %-
    }
    // zeroIsNotAbsent a field never assigned refuses by name; there is no pop arm -- removing a member is remove's job
    if !data     return refuse(result,"Operator -- -- this field has no value to step; a field assigned 0 is a count and steps to -1, one never assigned is absent");
    or isCOUNT   gCount--;
    or isNUMBER  gNumber -= 1.0;
    or isSTRING || isTOKEN
        if isPointer {
            gText--;
            gCount++; }
        or gText && gCount > 0 {
            gCount--;
            *(gText + gCount) = 0; }
        else    text = 0;
    or isSTAK   result = gStak.pop();
    else    return refuse(result,"Operator -- -- not supported for this data type");
    return result;
}


// opMultiply the * multiply operator: a double operand promotes the result
extern GroupItem opMultiply(GroupItem argument,GroupItem target)
{
int     wrote = 0;
    if jitting {
        -% return jitEmitBinary(argument, target, jitMul); %-
    }
    // binaryPromotes as for + (see opPlus)
    // f41 a refused operand arrives as null -- refuse it by name (see opPlus); F-36's second crash was here
    if !argument {
        return refuse(target,"Operator * -- an operand that is nothing"); }
    if argument.isCOUNT || argument.isNUMBER || argument.isSTRING || argument.isTOKEN
        if isNUMBER || argument.isNUMBER    {   tempField.number = number * argument.number;
                                                wrote = 1; }
        or isCOUNT                          {   tempField.count  = count * argument.count;
                                                wrote = 1; }
    // ownWrite the operator decides it produced a value by its own write THIS call, never by the shared tempField, which holds the last computation's (see opDiv)
    if !wrote {
        return refuse(target,"Operator * -- cannot apply to these operands"); }
    return tempField;
}


// opMultiplyEQ the *= operator: multiply in place -- computed in doubles, narrowed at the result
extern GroupItem opMultiplyEQ(GroupItem argument,GroupItem target)
{
GroupItem   result;
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    if jitting {
        -% return jitEmitAssign(jitEmitBinary(argument, target, jitMul), target); %-
    }
use target
    if data && argument.data {
        if isCOUNT  {   tempField.number = number * argument.number;
                        gCount  = tempField.count; }
        or isNUMBER gNumber *= argument.number;
        result  = target;
        if !result  cerr "ERROR Operator += failed on",tag,"and",argument.tag:; }
    or argument.isLIST
        while result = argument.next(result)
            opMultiplyEQ(result,target);
    return result;
}


// opNOT the ! operator: answers by truthOf, never by presence -- a node holding zero is false, so !0 is true
extern GroupItem opNOT(GroupItem result)
{
    if !truthOf(result)   return trueResult;
    return null;
}


// opNotEQ the != operator, on opEQ's shape
extern GroupItem opNotEQ(GroupItem argument,GroupItem target)
{
    if jitting {
        -% return jitEmitCompare(argument, target, jitNE); %-
    }
    if target && !data {
        if argument.isCOUNT || argument.isNUMBER
            if argument.gCount != 0     return trueResult; }
    or argument && !argument.data {
        if isCOUNT || isNUMBER
            if gCount != 0              return trueResult; }
    or compareValues(target,argument)   return trueResult;
    return null;
}


// opOR the OR operator's STRICT fallback, as for AND (see opAND)
extern GroupItem opOR(GroupItem argument,GroupItem target)
{
    if truthOf(target) || truthOf(argument)     return trueResult;
    return falseResult;
}


// opPlus the + operator: numbers add (a double operand promotes the result); a string advances by the argument's count
extern GroupItem opPlus(GroupItem argument,GroupItem target)
{
int     wrote = 0;
    if jitting {
        // concatJit a STRING or TOKEN left is a run-time concatenation, published as a node (SEQ 347 R3)
        if target.isSTRING || target.isTOKEN {
            -% return jitEmitConcat(argument, target); %-
        }
        -% return jitEmitBinary(argument, target, jitAdd); %-
    }
    // f41 a refused operand arrives as null -- refuse it by name, beside the wrong-type case each operator already names
    if !argument {
        return refuse(target,"Operator + -- an operand that is nothing"); }
    // nullTarget a target that is nothing refuses by name too, before any read of it (SEQ 432 R1; testerChainT TC-10 was a crash)
    if !target {
        return refuse(target,"Operator + -- a target that is nothing"); }
    // concatLeft a STRING or TOKEN on the left concatenates the right side's text (SEQ 347 R3)
    if data && (isSTRING || isTOKEN) && argument.data {
        tempField.text = concatText(text,argument.text);
        wrote = 1; }
    or data && (argument.isCOUNT || argument.isNUMBER || argument.isSTRING || argument.isTOKEN) {
        // binaryPromotes a binary op has no count slot to narrow into, so a double operand promotes the result; count OP count stays a count
        if isNUMBER || argument.isNUMBER    {   tempField.number = number + argument.number;
                                                wrote = 1; }
        or isCOUNT                          {   tempField.count  = gCount + argument.count;
                                                wrote = 1; } }
    // ownWrite the operator decides it produced a value by its own write THIS call, never by the shared tempField, which holds the last computation's (see opDiv)
    if !wrote {
        return refuse(target,"Operator + -- cannot apply to these operands"); }
    return tempField;
}


// opPlusEQ the += operator, now only the named refusal: every kind is a member of '+=' picked by pickKindOP on both roads, and this answers a pick with no member
extern GroupItem opPlusEQ(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
use target
    measurePlusEQWrite(target);
    // keptJitLine the one jitting line announces opPlusEQ reached at EMIT time, which happens only if '+=' has no members
    if jitting  jitDegrade("+= on an unhandled datA",target);
    else cerr "ERROR Operator += failed on",tag,"and",argument.tag:;
    return target;
}


// opPlusEQisBUFFER the '+=isBUFFER' member: an empty target takes the argument's data; else write the text into the buffer
extern GroupItem opPlusEQisBUFFER(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    if ruler.refused    return null;
use target
    measurePlusEQWrite(target);
    measureKindArm("opPlusEQisBUFFER",target);
    if !data {
        target.copyData(argument);
        return target; }
    if argument.isLIST || !argument.data    return plusEQshapeRefusal("isBUFFER",argument,target);
    // with a mark set the text goes in at the mark, else at the end; the mark is left as is
    buffer  += argument.text;
    return target;
}


// opPlusEQisCOUNT the '+=isCOUNT' member: an empty target takes the argument's data; else add, computed in doubles and narrowed at the result
extern GroupItem opPlusEQisCOUNT(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    // refusedFirst the store ruling is asked BEFORE any gate reads argument -- a refused rhs arrives as null
    if ruler.refused    return null;
use target
    measurePlusEQWrite(target);
    measureKindArm("opPlusEQisCOUNT",target);
    if !data {
        target.copyData(argument);
        return target; }
    if argument.isLIST || !argument.data    return plusEQshapeRefusal("isCOUNT",argument,target);
    tempField.number = number + argument.number;
    gCount  = tempField.count;
    return target;
}


// opPlusEQisNUMBER the '+=isNUMBER' member: an empty target takes the argument's data; else add
extern GroupItem opPlusEQisNUMBER(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    if ruler.refused    return null;
use target
    measurePlusEQWrite(target);
    measureKindArm("opPlusEQisNUMBER",target);
    if !data {
        target.copyData(argument);
        return target; }
    if argument.isLIST || !argument.data    return plusEQshapeRefusal("isNUMBER",argument,target);
    gNumber += argument.number;
    return target;
}


// opPlusEQisSTAK the '+=isSTAK' member: an empty target takes the argument's data; else push the argument
extern GroupItem opPlusEQisSTAK(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    if ruler.refused    return null;
use target
    measurePlusEQWrite(target);
    measureKindArm("opPlusEQisSTAK",target);
    if !data {
        target.copyData(argument);
        return target; }
    if argument.isLIST || !argument.data    return plusEQshapeRefusal("isSTAK",argument,target);
    gStak.push(argument);
    return target;
}


// opPlusEQisSTRING the '+=isSTRING' and '+=isTOKEN' member, one method under two registrations: a list argument concatenates, into an EMPTY target too (pick step 4a); else append the text
extern GroupItem opPlusEQisSTRING(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    if ruler.refused    return null;
use target
    measurePlusEQWrite(target);
    measureKindArm("opPlusEQisSTRING",target);
    if argument.isLIST {
        Buffer  concatBuf = bufferSTAK.pop();
        if !concatBuf   concatBuf = new("concat buffer");
        if data     appendGroup(target,0,concatBuf);
        appendGroup(argument,0,concatBuf);
        return opString(target,concatBuf); }
    if !data {
        target.copyData(argument);
        return target; }
    if !argument.data   return plusEQshapeRefusal("isSTRING",argument,target);
    text    += argument.text;
    return target;
}


// opPlusEQstruct the '+=struct' member: a bin or registry, a field with members (a grammar graft included), or an empty field given a dataless node -- a list argument is copied in (copyListTo), anything else appended
extern GroupItem opPlusEQstruct(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    if ruler.refused    return null;
    measurePlusEQWrite(target);
    measureKindArm("opPlusEQstruct",target);
    if argument.isLIST {
        argument.copyListTo(target);
        return target; }
    target += argument;
    return target;
}


// opPlusPlus the ++ operator: an iterator steps to the next child; a value steps up by one; a field never assigned is absent and refuses
extern GroupItem opPlusPlus(GroupItem result)
{
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    measurePlusPlusWrite(result);
    // handedCursor a cursor whose iterate was handed over at build is not flagged until run time: its ++ is the iterator step (SEQ 402)
    if jitting {
        -% if ( ::jitHandedCursor(result) ) return jitEmitIterStep(result); %-
    }
    if isIterator {
        // iterGate the jitting gate sits INSIDE the iterator arm, or the compiled walk visits nothing (Tony, 2026-08-04)
        if jitting {
            -% return jitEmitIterStep(result); %-
        }
        //note: because result is an iterator it is not unwrapped in runOP()
        GroupItem iterator = group;
        if result.hasAttributes iterator = result.nextAttribute(iterator);
        or result.hasMembers    iterator = result.nextMember(iterator);
        or !iterator    iterator = result.firstInList;
        else            iterator = nextInParent;
        if iterator {
            lastREF.gGroup  = iterator;
            lastREF.isGROUP = true;
            iterator.isInitialized = true;
            result.group    = iterator; }
        else {
            result.group    = 0;
            result          = 0; }
        return result; }
    if jitting {
        -% return jitEmitUnary(result, jitInc); %-
    }
    measurePlusPlusWrite(result);
    // zeroIsNotAbsent a field assigned 0 is a count and bumps to 1; one never assigned is absent and refuses by name
    if !data        return refuse(result,"Operator ++ -- this field has no value to bump; a field assigned 0 is a count and bumps to 1, one never assigned is absent");
    or isCOUNT      gCount++;
    or isNUMBER     gNumber++;
    or isSTRING || isTOKEN
        if gCount == 0 text = 0;
        else {
            gText++;
            gCount--; }
    else    return refuse(result,"Operator ++ -- not supported for this data type");
    return result;
}


// opPointer the =* unary: mark the operand a pointer -- fired as a noPrint definition attribute (setPointer), fLAG redirects it to the field being defined, a la processFlags
extern GroupItem opPointer(GroupItem field)
{
    if field.fLAG  field = field.parent;
    field.isPointer = true;
    return field;
}


// opPrint the print rule's operator method: the text goes to the buffer printTO diverted to, else to stdout
extern GroupItem opPrint(GroupItem target,Buffer buffer)
{
GroupRules  ruler       = groupRules;
String      printText   = string();
    if printText
        if toBUFFER toBUFFER += printText;
        else        cout printText;
    else cerr "print: recieved no print text":;
    reset();
    bufferSTAK  += buffer;
    useDefaultSpace = true;
    return trueResult;
}


// opPrintList the print instruct's unary op (rung 1, Tony 2026-10-27): each item, an instruct run first, goes through appendGroup; opPrint flushes to stdout, or to printTO's divert
extern GroupItem opPrintList(GroupItem items)
{
GroupItem   grup,
            value,
            fmtCount,
            fmtNumber,
            fmtString;
Buffer      buffer = bufferSTAK.pop();
int         kind;
    if !buffer      buffer = new("print buffer");
    while grup = items.next(grup) {
        // formatItem a format (it carries formatTYPE) prints nothing: it sets its type's slot, and the slots are this call's locals, so a format ends with its statement (Tony, SEQ 449 R4)
        if grup["formatTYPE"] {
            kind = printFormatKind(grup);
            if kind == 1    fmtCount = grup;
            if kind == 2    fmtNumber = grup;
            if kind == 3    fmtString = grup;
            continue; }
        value = grup;
        // shortcutHandover a printShortcut instruct writes into THIS print's buffer, so the buffer goes on the pool for its op to take (SEQ 461)
        if isShortcutInstruct(value)    bufferSTAK += buffer;
        -% if ( value && (void*)value->groupBody->gMethod == (void*)&testOP ) value = ::testOP(value); %-
        appendGroup(value,implicitFormat(value,fmtCount,fmtNumber,fmtString),buffer); }
    return opPrint(items,buffer);
}


// opPrintShortcut the printShortcut instruct's unary op: its operand's text runs on the buffer opPrintList handed over; it prints no item of its own (SEQ 461)
extern GroupItem opPrintShortcut(GroupItem shortcut)
{
Buffer      buffer = bufferSTAK.pop();
    if !buffer  return null;
    runShortcuts(shortcut.text,buffer);
    return null;
}


// isShortcutInstruct an instruct whose op runs opPrintShortcut -- known by the op's method, never its name
extern int isShortcutInstruct(GroupItem value)
{
    -%
    if ( !value || (void*)value->groupBody->gMethod != (void*)&testOP )   return 0;
    GroupItem *op = value->get(1);
    return op && (void*)op->groupBody->gMethod == (void*)&opPrintShortcut;
    %-
}


// printFormatKind which type a format item sets, from its LAST letter (TOKENize keeps the whole match, `#8.2f`): 1 count, 2 number, 3 string or token, 0 none
extern int printFormatKind(GroupItem format)
{
String      letter;
    letter = format.text;
    if !letter  return 0;
    -%
    size_t pfkLen = ::strlen(letter);
    if ( !pfkLen ) return 0;
    char pfkType = letter[pfkLen - 1];
    if ( ::strchr("diuxXoc", pfkType) ) return 1;
    if ( ::strchr("feEgG", pfkType) )   return 2;
    if ( pfkType == 's' )               return 3;
    %-
    return 0;
}


// implicitFormat the slot for this value's type, or none: a shortcut or a list keeps the defaults (appendGroup hands one format to every member)
extern GroupItem implicitFormat(GroupItem value,GroupItem fmtCount,GroupItem fmtNumber,GroupItem fmtString)
{
GroupItem   probe;
    if !value || value.isShortcut || value.isLIST   return null;
    probe = value;
    if probe.isGROUP && probe.gGroup    probe = probe.gGroup;
    if probe.isCOUNT                    return fmtCount;
    if probe.isNUMBER                   return fmtNumber;
    if probe.isSTRING || probe.isTOKEN  return fmtString;
    return null;
}


// opSeq the seq instruct's unary op (SEQ 446): each statement instruct runs in order, through testOP; hands back its argument list, as opPrintList does, until the runner hands an op its own instruct
extern GroupItem opSeq(GroupItem items)
{
GroupRules  ruler = groupRules;
GroupItem   grup;
    while grup = items.next(grup) {
        // clearFirst each statement starts with no signal, as aCTionBlocK clears -- a stale one cannot cut this seq short (SEQ 476)
        ruler.branchKind = 0;
        -% if ( (void*)grup->groupBody->gMethod == (void*)&testOP ) ::testOP(grup); %-
        // stopOnSignal a break or continue stops the list, and the signal stays set for the loop to read (SEQ 476 R3)
        if ruler.branchKind     break; }
    return items;
}


// opWhile the whileLoop instruct's unary op (SEQ 478 R1): its operand list holds the condition and the statement; each pass runs the condition through testOP and ends on false, runs the statement, then reads the signal -- break clears and ends, continue clears and loops, any other stays set and ends the loop; hands back nothing; retires when a kant action of the same name passes the same rows (whileT)
extern GroupItem opWhile(GroupItem arms)
{
GroupItem   cond = arms[1],
            body = arms[2];
    if !cond || !body   return null;
    -%
    GroupRules *whileRuler = GroupControl::groupController->groupRules;
    for (;;) {
        GroupItem *test = cond;
        if ( (void*)cond->groupBody->gMethod == (void*)&testOP ) test = ::testOP(cond);
        if ( !::truthOf(test) ) break;
        whileRuler->branchKind = 0;
        if ( (void*)body->groupBody->gMethod == (void*)&testOP ) ::testOP(body);
        int whileKind = whileRuler->branchKind;
        if ( whileKind == 1 ) { whileRuler->branchKind = 0; break; }
        if ( whileKind == 2 ) { whileRuler->branchKind = 0; continue; }
        if ( whileKind ) break;
    }
    %-
    return null;
}


// opDo the doLoop instruct's unary op (SEQ 480 R1): its operand list holds the statement and the condition; each pass runs the statement, then reads the signal -- break clears and ends, continue clears and goes to the condition, any other stays set and ends -- then runs the condition through testOP, false ends it; hands back nothing; its own op, one loop shape; retires when a kant action of the same name passes the same rows (doT)
extern GroupItem opDo(GroupItem arms)
{
GroupItem   body = arms[1],
            cond = arms[2];
    if !cond || !body   return null;
    -%
    GroupRules *doRuler = GroupControl::groupController->groupRules;
    for (;;) {
        doRuler->branchKind = 0;
        if ( (void*)body->groupBody->gMethod == (void*)&testOP ) ::testOP(body);
        int doKind = doRuler->branchKind;
        if ( doKind == 1 ) { doRuler->branchKind = 0; break; }
        if ( doKind == 2 ) doRuler->branchKind = 0;
        else if ( doKind ) break;
        GroupItem *test = cond;
        if ( (void*)cond->groupBody->gMethod == (void*)&testOP ) test = ::testOP(cond);
        if ( !::truthOf(test) ) break;
    }
    %-
    return null;
}


// opFor the forLoop instruct's unary op (SEQ 482 R2): its operand list holds the cursor, the source and the statement, and a fourth entry when `<-` asked for reverse; at RUN the source is resolved (an instruct runs, holders unwrap to the list, as the old road) and the cursor is bound as a holder of each member in turn; break clears and ends, continue clears and goes to the next member, any other signal stays set and ends; a source with no list says so, as the old road; hands back nothing; retires when a kant action of the same name passes the same rows (forT)
extern GroupItem opFor(GroupItem arms)
{
GroupItem   cursor = arms[1],
            source = arms[2],
            body = arms[3],
            reverse = arms[4];
int         backward;
    if !cursor || !source || !body  return null;
    // usedOutside the passthrough reads backward, not reverse: tok prunes a local only the passthrough names (bear-trap 13)
    if reverse  backward = 1;
    -%
    GroupRules *forRuler = GroupControl::groupController->groupRules;
    GroupItem *loopOn = source;
    if ( (void*)source->groupBody->gMethod == (void*)&testOP ) loopOn = ::testOP(source);
    if ( !loopOn ) return 0;
    GroupItem *listed = 0;
    while ( isGROUP(loopOn->groupBody->flags.data) && loopOn->getGroup() ) {
        loopOn = loopOn->getGroup();
        if ( loopOn->groupBody->groupList ) listed = loopOn; }
    if ( !loopOn->groupBody->groupList && listed ) loopOn = listed;
    cursor->clear();
    GroupItem *member = 0;
    while ( (member = backward ? loopOn->prior(member) : loopOn->next(member)) ) {
        cursor->setGroup(member);
        forRuler->branchKind = 0;
        if ( (void*)body->groupBody->gMethod == (void*)&testOP ) ::testOP(body);
        int forKind = forRuler->branchKind;
        if ( forKind == 1 ) { forRuler->branchKind = 0; break; }
        if ( forKind == 2 ) { forRuler->branchKind = 0; continue; }
        if ( forKind ) break;
    }
    %-
    return null;
}


// opBranch the branchSignal instruct's unary op (SEQ 476 R0): its operand is the keyword; break sets branchKind 1, continue 2 -- a signal, never a target; retires when a kant action of the same name passes the same rows (branchT)
extern GroupItem opBranch(GroupItem keyword)
{
GroupRules  ruler = groupRules;
    if !keyword     return null;
    if *keyword.tag == 'b'      ruler.branchKind = 1;
    or *keyword.tag == 'c'      ruler.branchKind = 2;
    return null;
}


// opIf the if instruct's unary op (SEQ 473): its operand list holds the condition, the then-statement and, if present, the else-statement; the condition runs through testOP, then one arm does, or none -- an unrun if hands back nothing; retires when a kant action of the same name passes the same rows (ifT)
extern GroupItem opIf(GroupItem arms)
{
GroupItem   cond = arms[1],
            thenArm = arms[2],
            elseArm = arms[3],
            arm,
            result;
    -% if ( cond && (void*)cond->groupBody->gMethod == (void*)&testOP ) cond = ::testOP(cond); %-
    if truthOf(cond)    arm = thenArm;
    else                arm = elseArm;
    if !arm             return null;
    result = arm;
    -% if ( (void*)arm->groupBody->gMethod == (void*)&testOP ) result = ::testOP(arm); %-
    return result;
}


// opRebind the <- operator: point the target local's group at the evaluated right side -- no content copy, no byRef stamp; a fresh handle each loop pass: cell <- argument :+ new(nm);
extern GroupItem opRebind(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    if argument target.group = argument;
    return      target;
}


// opRem the % operator: integer remainder
extern GroupItem opRem(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    // jitEmitRem emits a CALL to this very function and unboxes its result, the shape every non-scalar op uses
    if jitting {
        -% return jitEmitRem(argument, target, ruler->tempField); %-
    }
    if (isCOUNT || isNUMBER) && (argument.isCOUNT || argument.isNUMBER || argument.isSTRING || argument.isTOKEN)
        tempField.count = count % argument.count;
    // a refusal, never a data-less tempField that reads back as its own tag (promoted from sentinel-as-data, 2026-09-05)
    if !tempField.data  return refuse(target,"Operator % -- cannot apply to these operands");
    return tempField;
}


// opReplaceAttribute the :% operator: replace target's component of the same tag with the argument, or each list item, as an attribute
extern GroupItem opReplaceAttribute(GroupItem argument,GroupItem target)
{
GroupItem   grup,
            added;
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    if argument.isLIST
        while grup = argument.next(grup) {
            added = target.replace(grup);
            added.isAttribute = true; }
    else {
        added = target.replace(argument);
        added.isAttribute = true; }
    return target;
}


// opReplaceMember the :+ operator: replace target's component of the same tag with the argument, or each list item, as a member
extern GroupItem opReplaceMember(GroupItem argument,GroupItem target)
{
GroupItem   grup,
            added;
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    if argument.isLIST
        while grup = argument.next(grup) {
            added = target.replace(grup);
            added.isMember = true; }
    else {
        added = target.replace(argument);
        added.isMember = true; }
    return target;
}


// opSetFlag the :. operator, the inverse of opDot: SET the groupField flag the argument names on target -- it never toggles; explicit operands sidestep processFlags' command detection
extern GroupItem opSetFlag(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
GroupItem   flagDef;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
use argument
    if !argument
        if lastREF {
            argument = target;
            target = lastREF.group; }
        else    cerr "opSetFlag: lastREF not set":;
    if !argument || !target {
        cerr "opSetFlag: missing operand":;
        return target; }
    flagDef = groupFields[tag];
    // notAFlag a name with no groupFields entry has no flag to set -- refused by name, never a no-op (kant's generic flaG, case 12, retired 2026-10-02)
    if !flagDef {
        String  why = "`:. " tag "` -- not a groupField, so there is no flag to set; for a use-then-toss mark, +% a noPrint marker defined in pROPERTIEs (docs/flagCensus.md)";
        return refuse(target,why); }
    // setsNeverToggles a toggle makes "make sure it is on" unwritable (Tony, 2026-08-17)
    // enumLiteral an enum KIND (binType, actionType) is written as a literal value, never through its test macro, which can only write 0 or 1
    // oneSetter `:.` is setGroupField with the value 1 -- the cases live there, beside `=`'s (SEQ 295 R3)
    if argument && target {
        if !setGroupField(target,flagDef.gCount,1)
            cerr "opSetFlag WARNING: groupField",tag,"has no case yet -- guessing from gCount",toStringFromInt(flagDef.gCount),"; the value stands":; }
    else    cerr "opSetFlag: missing operand":;
    return target;
}


// opSetGroup the := operator: hold the argument as target's group, parent and affiliation unchanged -- through setGroup, never by hand, so x := null CLEARS x
extern GroupItem opSetGroup(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    if target   target.setGroup(argument);
    return      target;
}


// opSetTag the <: operator: target takes the argument's text as its tag
extern GroupItem opSetTag(GroupItem argument,GroupItem target)
{
GroupRules  ruler = groupRules;
    // storeRuling an armed statement stores nothing
    if ruler.refused    return null;
    if argument target.tag = argument.text;
    return      target;
}


// opString the string rule's operator method: the print text becomes target's text
extern GroupItem opString(GroupItem target,Buffer buffer)
{
    target.text = toString();
    reset();
    bufferSTAK  += buffer;
    useDefaultSpace = true;
    return target;
}


// opUnaryMinus the prefix unary - (negate): 0 - operand into tempField, the operand untouched -- its own op, distinct from the binary - slot
extern GroupItem opUnaryMinus(GroupItem result)
{
GroupRules  ruler = groupRules;
int         wrote = 0;
    if jitting {
        -% return jitEmitUnary(result, jitNeg); %-
    }
    if isCOUNT   {  tempField.count  = 0 - gCount;
                    wrote = 1; }
    or isNUMBER  {  tempField.number = 0 - gNumber;
                    wrote = 1; }
    // ownWrite the operator decides it produced a value by its own write THIS call, never by the shared tempField, which holds the last computation's (see opDiv)
    if !wrote {
        return refuse(result,"Operator unary - -- cannot apply"); }
    return tempField;
}


// plusEQshapeRefusal a += member's refusal of a list or dataless argument, through refuse(), which prints REFUSED and never ERROR -- pop.sh's ERROR ratchet
extern GroupItem plusEQshapeRefusal(String kind,GroupItem argument,GroupItem target)
{
    -%
    char why[160];
    ::snprintf(why,sizeof why,"+= of a list or dataless argument onto %s -- no member takes that shape",kind ? kind : "?");
    return ::refuse(target,why);
    %-
}


// resetField the reset command (reset immediateAction=resetField): for now it knows buffers, and resets the mark
extern GroupItem resetField(GroupItem argument)
{
Buffer buff = buffer;
    if buff reset();
    return null;
}


// setFile point the buffer field's buffer at the named file
extern void setFile(GroupItem bufField,String name)
{
    if bufField.isBUFFER    bufField.buffer.setFile(name);
}


// setFileOp the modedOP shim over Buffer.setFile: doc modedOP "path" points doc's buffer at a file -- opAssign's (argument, target) shape
extern GroupItem setFileOp(GroupItem argument,GroupItem target)
{
    if target.isBUFFER  target.buffer.setFile(argument.text);
    return target;
}


// setGroupField THE ONE WRITER OF A groupField BY NUMBER (SEQ 295 R3): x :. name hands it 1, x.name = v hands it v; a flag takes value != 0, an enum kind is set by non-zero and cleared by zero only when it holds that kind; 0 back when the number has no write case; the read-only accessors (43, 44) have none, on purpose
extern int setGroupField(GroupItem target,int fieldNo,int value)
{
GroupRules  ruler = groupRules;
int         on = 0;
    if !target  return 0;
    if value    on = 1;
    // invokeWrite  case 11 is the write half of opDot's case 11; without it x.invokE = 1 and x :. invokE fell to default and wrote nothing at exit 0 (2026-10-09)
    switch(fieldNo) {
            case 11:    target.invoke       = on;
            case 21:    target.isPercent    = on;
            case 25:    target.isVirtual    = on;
            case 26:    target.mergeOn      = on;
            case 29:    target.noPrint      = on;
            case 31:    target.byRef        = on;
            // hasNewParse the artifact gate: a generated parse body parks as a noPrint member on the shared child list, and this flag says one is there (2026-08-24)
            case 32:    if on   target.binType = 3;
                        or target.binType == 3  target.binType = 0;
            case 33:    if on   target.binType = 1;
                        or target.binType == 1  target.binType = 0;
            case 40:    if on   target.actionType = 2;
                        or target.actionType == 2   target.actionType = 0;
            case 41:    target.hasNewParse  = on;
            case 46:    target.fLAG         = on;
            // isActionWrite the write half of opDot case 408, as a LITERAL -- `target.isAction = true` would be right here only by coincidence
            case 408:   if on   target.actionType = 1;
                        or target.actionType == 1   target.actionType = 0;
            case 411:   lastIndent      = value;
            // compileReadOnly processingCodE reads the nearest drive floor; a compile marks its own, so a kant write has no road (SEQ 297 R2)
            case 412:   refuse(target,"processingCodE is read-only -- it reads the nearest drive floor, which processCode marks; there is no kant write (SEQ 297)");
            default:    return 0; }
    return 1;
}


// setMark the setMark command: advance the source buffer's mark by markOffset, or set it that far from the start; an offset past the current end refuses
extern GroupItem setMark(GroupItem argument)
{
GroupItem   source = argument["source"],
            markOffset = argument["markOffset"];
int         offset = markOffset.count;
    if source {
        Buffer buffer = source.buffer;
        if mark && current >= mark + offset     mark += offset;
        or current >= start + offset            mark = start + offset;
        else refuse(source,"setMark: the mark offset exceeds the current buffer length"); }
    else cerr "setMark: ERROR no buffer source provided":;
    return null;
}


// truthOf THE OPERAND TRUTHINESS CONTRACT, in ONE place (Tony, 2026-08-11): absent is false, a numeric node answers by its value, any other node is true by presence
extern int truthOf(GroupItem field)
{
    if !field                       return 0;
    if field.isCOUNT || field.isNUMBER  return field.gCount != 0;
    return 1;
}


// unMark clear the buffer field's mark
extern void unMark(GroupItem bufField)
{
    if bufField.isBUFFER    bufField.buffer.unMark();
}
