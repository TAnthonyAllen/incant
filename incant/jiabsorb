Start();
/*****************************************************************************
    jiabsorb — absorb POP (operation #2 of the four). WORKING end to end:
    insert + persistence + DEDUP.

    Live handle to a nested corpus group = `:= argument.member` on a
    live-passed root (the tInsert idiom Tony's debugger confirmed). With the
    makeNew text-clear + := handle, a constructed claim lands clean. Name the
    handle distinctly (`cg`, NOT `claims` — a local named the same as the
    member tag it aliases self-collides: "setGroup: cannot add a group claims
    to itself").

    absorbClaim: dedup via `if cand IN cg; else insert` — natural order, item
    on the left, container on the right (no `!IN`). Run twice -> #1 absorbs,
    #2 SKIPS (the member #1 added is found), so claims keeps ONE absorbedClaim.
    This works because the opIN list gate was fixed to test the CONTAINER for a
    list (`argument.groupList`), not the candidate (`target.groupList`) — the
    candidate never carries its own list. See docs/field-directive-idioms.md.
*****************************************************************************/
include(utilities);
include(jigcorpus);

search reset stack Grokking;
search jigCorpus Utilities list;

define
    showClaims code={
        cg := argument.claims;
        for grup in cg; print ``"    " grup.taG:;
        };

    absorbClaim code={
        cg     := argument.claims;
        cand   := new("absorbedClaim");
        if cand IN cg;
            print ``"  present — skip (dedup)":;
        else
            cg += cand;
            print ``"  absorbed":;
        };
    ;

print ``"=== claims before ===":;
showClaims(jitIgor);

print ``"=== absorb #1 (expect: absorbed) ===":;
absorbClaim(jitIgor);
showClaims(jitIgor);

print ``"=== absorb #2 (expect: dedup skip; claims unchanged) ===":;
absorbClaim(jitIgor);
showClaims(jitIgor);
stop();
