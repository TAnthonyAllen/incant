/*  spacingT -- THE SPELLING LAW: TIGHT BINDS, SPACED DOES NOT.
    Minted 2026-09-01 as F-36's certificate, and built to hold the `+*` rows in
    the same file when that operator lands -- it is one law, not two.

    THE LAW, as ruled: an operator character written TIGHT to its operand is the
    prefix/unary form; the same character with a SPACE after it is the binary
    form and binds to whatever precedes it. Longest match decides the token; the
    spacing decides which operator you get. USER BEWARE, no guard -- C has lived
    with a+*b for forty years.

    ⚠ ROW C IS THE ROW THAT MATTERS AND IT IS NOT WHAT ITS NAME SUGGESTS.
    `* *x` was recorded as F-36, "two space-separated unary stars", and read as a
    defect in composing unwraps. IT IS NOT. With a space the leading `*` is
    BINARY MULTIPLY against the preceding item, so row C is a multiply that
    cannot apply -- and it correctly REFUSES BY NAME. What was broken was only
    that the refusal then CRASHED THE PROCESS at 139 with no sentinel.

    ⚠ ROW A IS THE ANTI-VACUITY CONTROL AND MUST STAY A CLEAN ERROR. A single
    `*` on a field holding no group has always errored cleanly and returned 0. If
    it ever becomes a crash, or silently succeeds, rows B and C mean nothing.  */

register(SpacingT);
define
    spLeaf="LEAF";
    spWrap;
    spA; spB; spC; spD;
    spNum=5; spNumLeaf=7; spNumWrap;
    spListSrc q1 q2 q3;
    spDest1; spDest2;
    spG; spG2; spH; spI;
    spFp; spFm; spFg; spFl; spFe; spFge; spFle;
    spRun code={
        spWrap := spLeaf;
        /*  ⚠ CAPTURE FIRST, THEN PRINT -- and the two positions are DIFFERENT
            MEASUREMENTS, which is why both are here. Writing the expression
            inside a print item list makes the LABEL an operand: `"C =" * *spWrap`
            is the string TIMES the deref, ONE item, so a refusal prints nothing
            at all and the row cannot be asserted by value.
            ⚠⚠ AND IT ALSO CHANGES WHICH OPERATOR YOU GET. In ASSIGNMENT position
            there is nothing to the left, so a spaced leading `*` is UNARY and
            `* *x` composes as two unwraps. In PRINT-ITEM position there IS
            something to the left, so it is BINARY MULTIPLY. Same three
            characters, two operators, decided by what precedes them. Rows A-D
            measure the assignment side; ROW E measures the print side and is the
            line F-36 actually reported.
            ⚠ ROWS A, C, D READ BACK AS THEIR OWN TAG, and that is the honest
            value rather than a defect: a refusal leaves the field with no data,
            and a field with no data returns its tag (bear-trap #26). Pinning the
            tag echo is pinning "holds nothing".  */
        spA = *spWrap;
        spB = **spWrap;
        spC = * *spWrap;
        spD = ***spWrap;
        print "spacingT A tight-1  =" spA "  want spA -- holds nothing, named error above":;
        print "spacingT B tight-2  =" spB "  want LEAF -- the fixpoint":;
        print "spacingT C spaced   =" spC "  want spC -- TWO unwraps, both refuse, NO crash":;
        print "spacingT D tight-3  =" spD "  want spD -- no crash":;
        print "spacingT E print-position, the F-36 line, binary multiply follows:":;
        print "spacingT E value    =" * *spWrap:;
        print "spacingT E survived -- reaching this line IS the certificate":;
        /*  F-41 ROWS. Each drives ONE operator into a refused operand with the
            spelling the +* fixture is about to make ordinary -- `a OP *b` where
            b holds no group, so the tight unary refuses and hands the operator
            nothing. Every row is asserted by THE TEXT OF ITS REFUSAL, never by
            the absence of a crash (H4): a check that passes because no message
            appeared would also pass the day somebody deletes the guard.
            ⚠ ROW A ABOVE IS RE-READ ON THIS SAME RUN and is what says the unary
            still refuses cleanly rather than having started to succeed -- which
            would make every row here vacuous, since there would be no null.  */
        spFp = 1 + *spWrap;
        spFm = 1 - *spWrap;
        spFg = 1 > *spWrap;
        spFl = 1 < *spWrap;
        spFe = 1 == *spWrap;
        spFge = 1 >= *spWrap;
        spFle = 1 <= *spWrap;
        print "spacingT F seven operators driven into a refused operand, above":;
        /*  ⚠ THE LONGEST-MATCH ROWS. This is Tony's question -- does longest
            match solve `a + *b`? -- asked of the machine rather than reasoned
            about, and it can be asked TODAY because `+*` ALREADY EXISTS: it has
            been bound to opCopyList in incant/setup since before this charter,
            with ZERO call sites anywhere in the corpus.

            ⚠⚠ AND THE ANSWER CORRECTS THE LAW'S SPELLING. `a + *b` was stated as
            "addition through a pointer", but MEASURED, A SINGLE `*` NEVER YIELDS
            A VALUE HERE -- it unwraps one level PAST the leaf and refuses, at
            every wrapping depth. Probed directly:

                *dpW    refuses        **dpW    = 7
                *dpD    refuses        **dpD    = 7      (dpD wraps dpW)
                5 + **dpW = 12         5 + *dpD  refuses

            Wrapping deeper does not help, so this is not a depth accident: `**`
            is the fixpoint read and `*` is the differ-row that must refuse, which
            is exactly derefAllT's standing ruling. SO THE WORKING SPELLING TODAY
            IS `a + **b`, and row G uses it.

            ⚠ ROW G2 PINS `a + *b` AS A REFUSAL, ON PURPOSE. It is the tripwire:
            the `*` quarantine lifts at the flip, and if `*` ever starts reading a
            pointer this row goes RED and somebody looks at the law again. A row
            that only ever agreed with itself would not do that.

            G, H and I are the law: G is SPACED-then-TIGHT and is arithmetic;
            H and I are the OPERATOR, spaced and tight. H DIFFERS FROM G BY ONE
            SPACE AND NOTHING ELSE, which is the whole hazard, and both are
            correct behaviour.  */
        spNumWrap := spNumLeaf;
        spG  = spNum + **spNumWrap;
        spG2 = spNum + *spNumWrap;
        spDest1 +* spListSrc;
        spDest2+*spListSrc;
        spH = spDest1.listLengtH;
        spI = spDest2.listLengtH;
        print "spacingT G a + **b  =" spG "  want 12 -- SUM through a pointer":;
        print "spacingT G2 a + *b  =" spG2 "  want spG2 -- a single star REFUSES today":;
        print "spacingT H a +* b   =" spH "  want 3 -- the OPERATOR, spaced":;
        print "spacingT I a+*b     =" spI "  want 3 -- the OPERATOR, tight":;
        };
    ;
spRun();
print "SPACINGT SENTINEL -- reached the foot":;
stop();

WHAT THE FIX WAS, and it is not where the ticket pointed.

opMultiply refuses correctly -- it prints `ERROR Operator * failed on <a> and <b>`
and returns NULL, exactly as opPlus and opMinus do. appendPrintXP then runs the
expression for a print item and hands the result straight to appendGroup, which
dereferenced it two lines in. So EVERY refusing binary operator in print position
was a latent 139, and `*` was merely the one somebody typed.

The guard is in appendGroup (GroupActions.rtn), not in the star: a null input
returns quietly, because the operator has already named the error and printing a
second one would say nothing new.
