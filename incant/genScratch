Start();

/*  genParse (emitter), parseMethod (the §4.1 binder) and traceParse (the §1.8
    instrumentation switch) are C++ commands in genParse.rtn. Register them the
    proven way: registry(cOMMANDs) + immediateAction=value. parseMethod is
    registered BEFORE the rules are defined, because it is used as a DEFINITION
    ATTRIBUTE below and has to exist by the time that define is parsed.

    parseMethod is declared noPrint, the same way incant/setup declares every
    definition attribute. noPrint attributes are fire-and-forget: they change
    the group being defined without becoming part of it. Without it the binding
    attribute lands in the rule's own term list as a bogus second term, and
    genParse emits a term local for it -- which is exactly the S1.5 hazard,
    arriving from a direction nobody predicted.  */
registry(cOMMANDs);
define genParse immediateAction=genParse; ;
registry(cOMMANDs);
define parseMethod immediateAction=parseRuleMethod noPrint; ;
registry(cOMMANDs);
define parseTerms immediateAction=parseTermCount noPrint; ;
registry(cOMMANDs);
define traceParse immediateAction=traceParse; ;
registry(cOMMANDs);
define demoRprime immediateAction=demoRprime; ;
registry(cOMMANDs);
define manyMode immediateAction=manyMode; ;

/*  THE KANT emitMany (minionA round 2). emitMany's fork routes here instead of
    running its own body once `spellMany` is on the search list, and manyMode's
    line below is what says which of the two actually ran -- both produce the
    same bytes, so a silent fork cannot be told apart.

    THE fILEs ENTRY IS NOT OPTIONAL: `include(name)` resolves through the fILEs
    registry, not the filesystem, and an unregistered name is looked up relative
    to the current directory and exits 2. Registered here rather than in
    incant/setup deliberately -- this is the fixture's dependency, not the
    language's.

    ⚠ REGISTRY `Maniers`, NOT `Spellers`, and that separation is load-bearing:
    sharing one registry would mean this file could not adopt a kant emitMany
    without switching every rung's LEAF spelling to kant in the same commit.  */
registry(fILEs);
define genMany File='incant/genMany'; ;
include(genMany);

/*  Scaffold rules inlined (include-path resolution for a brand-new file in
    incant/ is unreliable; inline sidesteps it). Simplest-first per Clay's
    ladder (docs/genParseLadder.md).

    parseMethod=parseScafN is genParseShape §4.1's binding, in the same shape
    the grammar already uses for ruleMethod= and interpretMethod=. It is what
    lets parse()'s §1.3 fork find a generated method at all.  */
register(Ladder);
define
    Scaf  isRule "x"- parseTerms=1 parseMethod=parseScaf;
    Scaf2 isRule "{"- "}"- parseTerms=2 parseMethod=parseScaf2;
    ScafA isRule "a"- parseTerms=1 parseMethod=parseScafA;
    ScafB isRule ScafA "b"- parseTerms=2 parseMethod=parseScafB;
    ScafC isRule ScafA+ "c"- parseTerms=2 parseMethod=parseScafC;
    ScafE isRule "e"- ScafA? "f"- parseTerms=3 parseMethod=parseScafE;
    ScafF isRule "f"- ","?- "g"- parseTerms=3 parseMethod=parseScafF;
    ScafI isRule "i"- parseTerms=1 parseMethod=parseScafI;
    ScafALT isRule
        ScafA;
        ScafI;
    ;

/*  ScafALT is bound in a SECOND define block, deliberately. A definition
    attribute fires WHEN IT IS PARSED, so parseMethod= on an alternation's own
    line runs before its members exist and the §3 count guard sees 0 terms and
    refuses — correctly. Sequence rules do not have this problem; their terms
    are on the same line. Do not collapse these blocks.  */
define
    ScafALT parseTerms=2 parseMethod=parseScafALT;
    ScafOUT isRule "("- ScafALT ")"- parseTerms=3 parseMethod=parseScafOUT;
    ;
search reset stack Grokking Maniers Ladder list;

/*  Called BEFORE the first genParse on purpose: rung12.target starts at the
    first emitted line, so the mode line is asserted separately and cannot move
    the target.  */
manyMode('');

/*  --- rungs 1-2 TEXT-EMIT POP (diff vs genLadder/rung12.target) --- */
genParse('Scaf');
genParse('Scaf2');
genParse('ScafA');
genParse('ScafB');
genParse('ScafC');
genParse('ScafE');
genParse('ScafI');
genParse('ScafF');

/*  --- RUNTIME LOOP, NO ENTRY WRAPPER (genParseShape §1.7) ---
    runScaf/runScaf2 are retired. Invocation is Scaf('x'), exactly as Start(),
    so the run exercises emission, the fork, binding and dispatch -- a bespoke
    wrapper called parseScaf directly and exercised none of them.

    Invariant R is reported from leaveRule (§1.8), not from a wrapper, so it is
    on for every rule and survives the kant handover. Scaf2 on "{" is the
    meaningful case: lit("{") advances, lit("}") fails, so the rewind has real
    ground to give back (a single-lit fail never advanced).  */
traceParse('on');
Scaf('x');
Scaf('y');
Scaf2('{}');
Scaf2('{');

/*  --- RUNG 4: a generated rule reached from ANOTHER RULE'S REFERENCE TERM,
    not by name. ScafB's first term is a reference to ScafA. Only if parse()
    resolves parseMethod from the DEFINING rule does ScafA's generated method
    run here -- a term node has its own rStuff and was never bound.
    The tell in the trace is a HIT/WIN for ScafA nested inside ScafB's.  */
ScafB('ab');
ScafB('ax');

/*  --- RUNG 5: repetition. ScafC is ScafA+ "c"-, so the emitted body is
    manyScafC1(label,t1) && lit(t2,"c") with the helper emitted alongside it.
    'aaac' exercises three passes; 'aax' fails the trailing literal after two
    successful passes, so leaveRule has to give back everything the loop
    consumed -- R across a generated LOOP, not just a generated call.  */
ScafC('ac');
ScafC('aaac');
ScafC('aax');
ScafC('c');

/*  --- INVARIANT R′, both clauses, side by side. See demoRprime: min >= 2 is
    unreachable through the grammar today, so the mark clause is shown as a
    controlled comparison of the two loop shapes rather than as a rule.  */
demoRprime('a');
demoRprime('aa');

/*  --- RUNG 6: optional. ScafE has an optional REFERENCE between two mandatory
    terms; ScafF an optional noLabel LITERAL. Present, absent, and -- the case
    that proves the plan is right rather than merely permissive -- a FAILING
    mandatory neighbour, which the optional must not swallow.  */
ScafE('ef');
ScafE('eaf');
ScafE('ex');
ScafF('fg');
ScafF('f,g');
ScafF('fx');

/*  --- RUNG 7: ALT emission. ScafALT is an alternation reached as a term of
    ScafOUT. The text POP is rung7.target; the TREE acceptance test (§2.4) is
    separate — sh genLadder/tree.sh — because an ALT that builds the wrong tree
    still passes every WIN/FAIL check.  */
ScafOUT('(a)');
ScafOUT('(i)');
ScafOUT('(x)');
genParse('ScafALT');
genParse('ScafOUT');
stop();
