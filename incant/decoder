/*****************************************************************************
    THE PRINT VERB. It lives WITH the corpus rather than in the runner, because
    the brief's whole object is "a lookup table with a print verb" -- splitting
    them would let a caller reach the table without the discipline.

    ⚠ DISCIPLINE 2 (WT14) IS ENFORCED HERE, NOT MERELY DOCUMENTED: an undefined
    term FAILS LOUD, by name, and says to mint it. A missing definition is a
    finding, not a shrug -- and a decode that printed nothing for an unknown
    term would let every future dispatch under-report in silence.

    ⚠ THE NAME COMES FROM `.taG`, NEVER FROM `.text` (bear-trap #26's family).
    Measured 2026-08-09: `decodeCorpus[argument.text]` exits 139 with ZERO bytes
    of output, while `decodeCorpus[argument.taG]` in the identical position
    works. Symptom recorded; cause NOT diagnosed.
*****************************************************************************/
register(Decoder);
define

    /*  Print ONE term. Fails loud when the corpus has no entry.  */
    decodeOne argument code={
        hit = decodeCorpus[argument.taG];
        if hit;
            print argument.taG " -- " hit.definition:;
        else
            print "decode UNDEFINED TERM " argument.taG " -- FAILS LOUD, mint the entry now (WT14)":;
        };

    /*  The decode line. ONE CALL, N NAMES -- measured, not assumed. An action
        takes one argument, so a multi-name call arrives as a synthesised node
        whose MEMBERS carry the names.
        ⚠ THE GUARD IS LOAD-BEARING: a single-name call has no member list at
        all, and `for x in y;` over a leaf is the nextGroup does-not-contain-a-
        list error. Walked reversed so names print in the order written.  */
    decodE argument code={
        if argument.listLengtH;
            for grup in <- argument;
                decodeOne(grup);
        else
            decodeOne(argument);
        };

    /*  The whole corpus, one line per term. Small enough to be a legitimate
        preamble on its own.  */
    decodeAll code={
        for grup in decodeCorpus;
            print grup.taG " -- " grup.definition:;
        };
    ;
