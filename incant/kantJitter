        if krrHas == 0;     return 0;
        if *krrOp["compareTier"];   return 0;
        krrL := argument[2];
        krrR := argument[3];
        krrA = krKindOf(*krrL);
        krrB = krKindOf(*krrR);
        if krrA == 0;   return 0;
        if krrB == 0;   return 0;
        if *krrT == "/";    return 9;
        if krrA == 9;   return 9;
        if krrB == 9;   return 9;
        return 5;
        };
    krNoteWrite code={
        nwOp := argument[1];
        nwTg := argument[2];
        nwLoc := *nwTg.isLocaL;
        if *nwLoc != 1;     return 0;
        nwT  := *nwOp.taG;
        nwK = 99;
        nwIs = 0;
        if *nwT == "=";     nwIs = 1;
        if nwIs == 1;
            nwSrc := argument[3];
            nwK = krKindOf(*nwSrc);
        if nwIs == 0;
            nwTier = 0;
            if *nwOp["assignTier"];     nwTier = 1;
            if nwTier == 0;     return 0;
        nwNm := *nwTg.taG;
        if krTab[*nwNm];
            nwE := krTab[*nwNm];
            nwOld = *nwE;
            if nwOld == nwK;    return 0;
            nwKeep = 0;
            if krFirm[*nwNm];   nwKeep = nwIs;
            if nwKeep == 0;     *nwE = 99;
            return 0;
        nwNew := new(*nwNm);
        *nwNew = nwK;
        *nwNew :. noPrinT;
        krTab +% *nwNew;
        if krDepth == 2;
            nwF := new(*nwNm);
            *nwF = 1;
            *nwF :. noPrinT;
            krFirm +% *nwF;
        return 0;
        };
    krInside code={
        kiIn := argument.instructTypE;
        if *kiIn == 1;      return 1;
        kiT := argument.taG;
        if *kiT == "blockStmts";    return 1;
        if *kiT == "opArms";        return 1;
        if *kiT == "printItems";    return 1;
        return 0;
        };
    krScan code={
        ksGo = krInside(argument);
        if ksGo == 0;       return 0;
        ++krDepth;
        ksIn := argument.instructTypE;
        ksLen := argument.listLengtH;
        if *ksIn == 1;
            if *ksLen == 3;     krNoteWrite(argument);
        if *ksLen > 0;
            iterate ksC on argument;
            while ++ksC;
                krScan(*ksC);
        --krDepth;
        return 0;
        };
    krMarkOne code={
        kmOp := argument[1];
        kmT  := *kmOp.taG;
        kmL  := argument[2];
        kmR  := argument[3];
        kmA = krKindOf(*kmL);
        kmB = krKindOf(*kmR);
        kmIsEq = 0;
        if *kmT == "=";     kmIsEq = 1;
        if kmIsEq == 1;
            kmLoc := *kmL.isLocaL;
            if *kmLoc != 1;     return 0;
            kmA = kmB;
        if kmA == 0;    return 0;
        if kmB == 0;    return 0;
        kmCanWiden = 0;
        if *kmOp["irWIDE"];     kmCanWiden = 1;
        kmWide = 0;
        if kmA != kmB;
            if kmCanWiden == 0;     return 0;
            if kmA == 5;    kmWide = 2;
            if kmB == 5;    kmWide = 3;
            kmA = 9;
        if kmA == 5;    kmNm = "irCOUNT";
        if kmA == 9;    kmNm = "irNUMBER";
        kmHas = 0;
        if *kmOp[kmNm];     kmHas = 1;
        if kmHas == 0;
            if kmA == 9;        return 0;
            if kmCanWiden == 0; return 0;
            kmWide = 23;
            kmNm = "irNUMBER";
        kmMark := new("KinD");
        *kmMark = kmNm;
        *kmMark :. noPrinT;
        argument +% *kmMark;
        if kmWide != 0;
            kmSide := new("WideN");
            *kmSide = kmWide;
            *kmSide :. noPrinT;
            argument +% *kmSide;
        ++krCount;
        return 0;
        };
    krMark code={
        kbGo = krInside(argument);
        if kbGo == 0;       return 0;
        kbIn := argument.instructTypE;
        kbLen := argument.listLengtH;
        if *kbIn == 1;
            if *kbLen == 3;     krMarkOne(argument);
        if *kbLen > 0;
            iterate kbC on argument;
            while ++kbC;
                krMark(*kbC);
        return 0;
        };
    krChanged=0;
    krDoubt code={
        kuOp := argument[1];
        kuTier = 0;
        if *kuOp["assignTier"];     kuTier = 1;
        if kuTier == 0;     return 0;
        kuT := *kuOp.taG;
        kuWho := argument[3];
        kuEq = 0;
        if *kuT == "=";     kuEq = 1;
        if kuEq == 1;
            kuK = krKindOf(*kuWho);
            if kuK != 0;    return 0;
            kuWho := argument[2];
        kuLoc := *kuWho.isLocaL;
        if *kuLoc != 1;     return 0;
        kuNm := *kuWho.taG;
        if krTab[*kuNm];
            kuE := krTab[*kuNm];
            kuOld = *kuE;
            if kuOld == 0;      return 0;
            if kuOld == 99;     return 0;
            *kuE = 99;
            ++krChanged;
        return 0;
        };
    krUnsure code={
        kuGo = krInside(argument);
        if kuGo == 0;       return 0;
        kuIn := argument.instructTypE;
        kuLen := argument.listLengtH;
        if *kuIn == 1;
            if *kuLen == 3;     krDoubt(argument);
        if *kuLen > 0;
            iterate kuC on argument;
            while ++kuC;
                krUnsure(*kuC);
        return 0;
        };
    krResolve code={
        if argument.KinDs;      return 0;
        krB := argument.BlocK;
        krS := *krB[2];
        clear(krTab);
        clear(krFirm);
        krDepth = 0;
        krScan(*krS);
        krDepth = 0;
        krScan(*krS);
        krChanged = 1;
        while krChanged > 0;
            krChanged = 0;
            krUnsure(*krS);
        krSure := new("SurE");
        *krSure :. noPrinT;
        krsN := krTab.listLengtH;
        if *krsN > 0;
            iterate krsE on krTab;
            while ++krsE;
                krsNm := *krsE.taG;
                krsOk = 0;
                if krFirm[*krsNm];  krsOk = *krsE;
                if krsOk == 99;     krsOk = 0;
                if krsOk > 0;
                    krsNew := new(*krsNm);
                    *krsNew = krsOk;
                    *krsNew :. noPrinT;
                    *krSure +% *krsNew;
        argument +% *krSure;
        krCount = 0;
        krMark(*krS);
        krDone := new("KinDs");
        *krDone = krCount;
        *krDone :. noPrinT;
        argument +% *krDone;
        return krCount;
        };
    krAct;
    krSay code={
        ksyLit := argument.isLiteraL;
        ksyIn  := argument.instructTypE;
        ksyDone = 0;
        if *ksyLit == 1;
            cerr argument.texT;
            ksyDone = 1;
        if *ksyIn == 1;
            ksyOp := argument[1];
            ksyT  := *ksyOp.taG;
            cerr $"(" ksyT ")"$;
            ksyDone = 1;
        if ksyDone == 0;    cerr argument.taG;
        };
    krShowOne code={
        ksoOp := argument[1];
        ksoT := *ksoOp.taG;
        cerr "KR" krAct ksoT;
        ksoL := argument[2];
        ksoR := argument[3];
        krSay(*ksoL);
        krSay(*ksoR);
        ksoHas = 0;
        if argument.KinD;   ksoHas = 1;
        if ksoHas == 1;
            ksoK := argument.KinD;
            ksoIR := *ksoOp[*ksoK];
            ksoW = 0;
            if argument.WideN;      ksoW = argument.WideN;
            if ksoW == 0;   cerr "->" ksoK "=" ksoIR:;
            if ksoW != 0;   cerr "->" ksoK "=" ksoIR "widening" ksoW:;
        if ksoHas == 0;     cerr "-> unmarked":;
        };
    krShowWalk code={
        kvGo = krInside(argument);
        if kvGo == 0;       return 0;
        kvIn := argument.instructTypE;
        kvLen := argument.listLengtH;
        if *kvIn == 1;
            if *kvLen > 2;      krShowOne(argument);
        if *kvLen > 0;
            iterate kvC on argument;
            while ++kvC;
                krShowWalk(*kvC);
        return 0;
        };
    krShow code={
        krAct = argument.taG;
        kshB := argument.BlocK;
        kshS := *kshB[2];
        krShowWalk(*kshS);
        cerr "KR" krAct "marked" argument.KinDs:;
        };
    ;
bail();

kantJitter -- the kant jitter's own incantation (SEQ 670, Tony's ruling R0 of 2026-11-16). A fixture includes it and
searches KantJitter. It holds the walk from step 2c, the kind-resolve pass of step 3a, the native statements of
step 3b, the native if and while of step 4 and the slot locals of step 5. No C++ belongs to it but the door (compileIR, callIR) and the helpers the walk's text names: testOP, irAt,
irGoOn, irSeqEnd, and for native statements irCountOf, irNumberOf, irSetCount, irSetNumber.

What Is In Here
    kwCompile(action)   step 2c, the walk. Writes one function for the action: one testOP call per statement of its
                        chain, statement k reached by position (irAt), a go-on check after each (irGoOn), the ending
                        opSeq's (irSeqEnd). Compiles the text through compileIR and marks the action KanT, so ordinary
                        calls run the function. A statement-list member that is not an instruct gets no call, as the
                        interpreter's walk skips it (R4): the label count and the list position are kept apart.
                        On an action krResolve has marked (KinDs), a statement krPlan marked KnaT is written natively
                        (step 3b, below) in place of its testOP call; the text then also keeps a count of its testOP
                        calls (<name>_t, read by <name>_tops). An unresolved action's text is step 2c's, byte for byte.
    krResolve(action)   step 3a, the kind-resolve pass. Marks each two-operand instruct in the action's chain, the
                        insides of if and loops included, with the per-kind IR attribute of its operator -- an attribute KinD
                        whose text is that attribute's name (irCOUNT, irNUMBER) -- when it is sure of the kind. Writes no
                        IR. Marks the action KinDs (its text the count marked); a second call does nothing.
    krShow(action)      prints the chain's two-operand instructs on stderr, one line each, with the mark or "unmarked".
    jitNotes()          toggles the compile notes, OFF at the start of a run: while on, each operator that widens a count
                        notes itself once on stderr when its action is compiled (JIT NOTE kw_mq : * widens its left count
                        to a number). It stays as set for the rest of the run.

How The Pass Decides
    Kinds are the engine's own numbers, as datA reads them: 5 a count, 9 a number. 0 is not known; 99 is two kinds.
    The walks (krScan, krMark, krShowWalk) go inside a node only when krInside says the chain continues there: an
    instruct, or one of the three lists the build makes inside one (blockStmts, opArms, printItems). They never go
    inside an operand that is a field: a call's callee is the action itself (a self-call would never end), and an
    action handed as an argument would have its own chain marked with this action's table.
    krTab holds one entry per local the action writes. krScan walks the chain twice, in order, noting each writer
    (krNoteWrite): `=` into a local gives it the kind of the right side. A local's kind is its first writer's (Tony,
    2026-11-04): a later = of another kind is cast in by the store and does not change it -- but only when that first
    writer is a top-level statement (krFirm; krDepth is 2 there), because only then is it surely the first to run.
    A first writer inside an if or a loop, followed by one of another kind, makes it 99; so does any other assigning
    operator (it carries assignTier) on a local. ++ and -- are not writers.
    krKindOf answers for an operand: a literal has its own kind; a local has its table kind (99 and absent answer 0);
    an instruct answers by krResultKind; anything else -- a field from outside the action, a string -- answers 0.
    krResultKind is the measured table (incant/pop/kindResolveT, R1): + - * give a count from two counts and a number
    when either is a number; / always gives a number; a compare gives no kind (true is a count 1, false is nothing).
    krMarkOne marks an operator when both operands have a known kind. Same kind: KinD is that kind's attribute, if the
    operator carries it. A count with a number (step 3c): if the operator carries irWIDE it is marked irNUMBER, with
    WideN naming the side that widens (2 the left, 3 the right). Two counts on an operator with no irCOUNT but with
    irWIDE -- that is / -- is marked irNUMBER, WideN 23 (both). Compares carry no irWIDE, so a mixed compare stays
    unmarked. An = is marked with its RIGHT side's kind whenever that is known and its target is a local: the store
    helper for that kind is opAssign, which casts into whatever kind the target already has.
    Sure of the kind (SEQ 678, Tony's ruling of 2026-11-17). After the two scans krUnsure walks the chain, again and
    again until a walk changes nothing, and krDoubt makes a local 99 -- not sure, so every read of it is unmarked and
    stays on testOP -- when it is (a) the target of an = whose right side has no known kind, or (b) the right operand
    of any assigning operator but = : a call's argument (clear and every other command; no call is taken as a reader),
    the source of a := , what +% and its kin attach. Measured (SEQ 677 M1, SEQ 678 M4): clear(a), a = new("x") and
    a = a group field change a local's kind (datA 0, 13, 13), directly, by a callee on its argument, and through a
    holder; nothing else tried does. The walk repeats because what is computed from a not-sure local has no known kind
    either. A local with no entry, or an entry of 0 (which `if krTab[name]` reads as absent), has no known kind already
    and is left alone: making an entry for it there never ended (met SEQ 678, `d = argument`). print is no call and no assigning operator, so a printed local stays sure. A store of a known kind INTO a
    not-sure local is still marked and native: it is opAssign either way. NOT SEEN BY THE PASS, found and not ruled
    (M5): another action writing the local by name during a call (f.a = g). incant/pop/sureKindT.
    Which operators have kinds is data: the irCOUNT= and irNUMBER= attributes in incant/setup's Operators
    (irCOUNT="add i32"). The pass reads them through the instruct's own op entry, which shares its body with the
    registry's. They are attributes and not members named <op><kind>, as the ruling first spelled them, because the
    engine picks a member of that name AS the operator (pickKindOP): measured SEQ 670, == and != then build nothing.

Native Statements (step 3b)
    krPlan walks the top-level statements in order and marks one KnaT when krIsStore says it is a marked = into a local
    and krNatExpr says its right side is native all the way down: a literal; a local in krSeen, the locals an earlier
    top-level marked store wrote (so a native read never meets a local no statement has surely written yet); or a
    marked + - * or / whose two sides are native. An if or a while is one statement and is native all or nothing
    (step 4, below). Anything computed from `argument` is not marked that far, so it stays on testOP.
    The text for a native statement at list position p: at the top of the function, once, krFetch fetches the
    statement (%tp), its target (%tp_2), its right side (%tp_3) and, inside an operator, each side again (_2, _3) --
    by position with irAt, so no address is in the text. In the statement's block krValue leaves each node's value in
    %v<path>: a leaf is read with irCountOf or irNumberOf (literals too: one spelling, no number formatting in kant),
    an operator is one line of its own IR text, `%vtp_3 = add i32 %vtp_3_2, %vtp_3_3`. Each node has its own kind,
    handed down in kgKind: an operator's sides have its KinD, except the side WideN names, which is a count and gets
    one more line, the operator's irWIDE text, `%wtp_3_3 = sitofp i32 %vtp_3_3 to double`. The store is ='s own data,
    `call ptr @irSetCount(ptr %tp_2, i32 %vtp_3)`: opAssign, so the cast, the guards and the notify are the engine's.
    What it hands back goes to %last, and the go-on check follows, as after a testOP statement.

Native If And While (step 4, SEQ 675, Tony's ruling of 2026-11-17: the all-or-nothing cut)
    An if or a while is native only when its condition is a compare the pass marked whose two sides are native
    (krNatCond) and every statement in every arm or body is native (krNatStmt): a store as above, a block of native
    statements, or another native if or while, to any depth. Anything else in it -- a print, a break, a call, a bare
    field or a call as the condition -- leaves the WHOLE statement on testOP. A compare as a value (x = a < b) is not
    native: krNatExpr takes only + - * /, because a false compare is nothing, not a count.
    krShape tells the statements apart by their operator, never by listLengtH: a mark is an attribute and is counted
    in the length (measured: a marked compare reads 4). 1 a two-operand instruct, 2 a block (seq, or bodySeq inside a
    loop), 3 an if (ifThen), 4 a while (whileLoop). The built shapes are pinned in genLadder/kantCondT.m2.txt: an if
    is [ifThen, opArms] with opArms = condition, then, else when present; an `or` arm is an if in the else slot; a
    block is [seq, its statement list]; a while is [whileLoop, opArms] with opArms = condition, body.
    Surely written. krSeen holds each local a store has written, its value the level it was written at: 1 the top
    level, one more inside each if or while. krLeave, called when an arm or a body ends, sets the entries of that level
    to 99, which reads as not written; krWrote brings a 99 entry back to life at the current level. So a native read
    needs its local written by an earlier top-level store, or by an earlier store in the same block or an enclosing
    one, and a store inside a block counts for nothing after the block ends. A statement that fails this is not
    native, so its whole if or while is not.
    The text. krFetch fetches a native if or while once, at the top of the function, by position: its list (%p_2) and
    each member (%p_2_1 the condition, %p_2_2, %p_2_3), and so on down. krEmit writes it where the statement runs. A
    condition is one line of the compare's own IR text, `%vp_2_1 = icmp slt i32 %vp_2_1_2, %vp_2_1_3`, feeding
    `br i1`; a mixed compare widens its count side with the operator's irWIDE text first, as + - * do. The labels are
    y (the then arm, or the loop body), x (the else arm, or the loop's end), z (after an if), w (a loop's condition),
    n (after a store's go-on check), each followed by the statement's path. A store inside a block is step 3b's
    store, then the go-on check, which leaves by %done as at the top level. No count is kept inside a native if or
    while: <name>_n counts it as one statement, and <name>_t is not touched.
    What it hands %last (measured, kantCondT M1): a store its target field; a block its own statement list; an if what
    its arm handed back, or null when no arm ran; a while null.
    The number compares say what the interpreter says (kantCondT ROW2): a nan difference counts as equal, so ==, <=
    and >= are fcmp ueq, ule, uge and != is fcmp one; < and > are olt and ogt.
    Speed, first measured SEQ 675 (genLadder/kantSpeed.sh): a native summing loop runs no faster than the interpreted
    one. Every native store boxes its value into a new field for opAssign (irSetCount), and the collector is most of
    the time (sampled). The frozen C++ walk, which keeps values out of the fields, is far faster.

Slot Locals (step 5, SEQ 680, Clay's dispatch of 2026-11-17 on Tony's rulings SEQ 677-679: values out of the fields)
    krResolve also writes SurE on the action: one entry per local it is sure of whose first writer is top-level, its value
    the kind (5 or 9). kwCompile reads it there because by compile time the chain carries its marks, and a mark is counted
    in an instruct's length, so a second scan of the chain would not see the stores (measured SEQ 680).
    A SLOT LOCAL is such a local met in a native statement, unless a native store of a number into a count reaches it
    anywhere (krNarWalk fills krNarrow; that local keeps step 4's text). krLeaf, called by krFetch on every leaf of a native
    statement, reads a literal once (%v<path>, by its own kind) and names a slot's field once (%F<name>, a bitcast of the
    first path that meets it). At the top each slot has %S<name> (an alloca of its kind) and %D<name> (an i1 flag, 0), and
    is read from its field (krReload with kgSite I). A native read of a slot is a load from %S; a native store into one
    (krEmit) is a store to %S, the flag set to 1, the target field to %last, and no go-on check; a count into a number slot
    first takes ='s irWIDE text (data in incant/setup).
    Before a testOP statement krBack writes back each slot whose flag is 1, by irSetCount or irSetNumber, and clears it
    (Tony's rule, SEQ 679 R3: only the slots stored natively since the last read). After it, if it goes on, krReload reads
    every slot again (label q<k>). A stop after it goes to done with no write-back. The normal end and a stop after a
    non-slot store's go-on check go to back, which writes back by the flags, then to done. kgSite names the site in the
    labels and values (a statement number, B or I). An action with no slot writes no flag, alloca or write-back.
    incant/pop/kantSlotT. Speed (genLadder/kantSpeed.sh, SEQ 680): the native summing loop runs at the floor.

Current State -- WIP
    Settled: the walk (2c) and its skip; the pass marks and prints. testOP runs a marked chain as an unmarked one.
    Settled (3b): + - * and same-kind stores of top-level statements run natively, values staying in the fields.
    `=` carries its store as data, so the pass marks an = whose two sides have the same known kind.
    Settled (3c): a count mixed with a number, / on any pair, a store of the other kind, the notes toggle.
    Settled (4): a compare as a condition, native if (else, elseif) and while, nested to any depth, all or nothing.
    Settled (SEQ 678): a local whose kind may change (an = of unknown kind, a call's argument, a := source) is not sure.
    Settled (5, SEQ 680): values out of the fields -- slot locals, the write-back rule, literals read once.
    Not built: an if or a while with anything not native inside it (mixed bodies, a later step with its own design);
    Do, FOr, ITERATe; a bare field or a call as a condition; the kind of `argument`; the engine's rounding for a native
    number into a count (such a local is no slot yet).
