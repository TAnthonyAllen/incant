Start();
include(unitTests);
include(generate);
include(utilities);
registry(fILEs);
define
    kantGrammar File='incant/kantGrammar';
    ;
include(kantGrammar);
search reset stack Grokking;
search Generating UnitTests Utilities list;
register(KgLoad);
define
    kgTop code={
        iterate kgT on KantGrammar;
        while ++kgT;
            kgRule(*kgT);
        };
    kgRule code={
        cerr "KGNEW " taG:;
        iterate kgC on argument;
        while ++kgC;
            kgKid(*kgC);
        };
    kgKid code={ cerr "KGKID " taG:; };
    ;
kgTop();
cerr "KGLOAD SENTINEL":;
stop();

kantGrammarLoad -- SEQ 436 R3 (2026-10-27). Run by genLadder/kantGrammarNames.sh, not alone.
Loads incant/kantGrammar through a fILEs entry declared here (setup is untouched -- nothing in the fleet loads the file)
and lists each top-level rule (KGNEW) and its children (KGKID): rules, terms and labels alike. The include sits at the
top because, placed after the first define, it took no effect (the KantGrammar registry never appeared).
