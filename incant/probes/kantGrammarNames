include(unitTests);
include(generate);
include(utilities);
search reset stack Grokking;
search Generating UnitTests Utilities list;
register(KgNames);
define
    kgN=0;
    kgReg code={
        iterate kgM on argument;
        while ++kgM;
            kgOne(*kgM);
        };
    kgOne code={ cerr "KGM " taG:; };
    kgWalk code={
        iterate kgR on registries;
        while ++kgR;
