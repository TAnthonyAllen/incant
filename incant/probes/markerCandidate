Start();
include(unitTests);
include(utilities);
search reset stack Grokking UnitTests Utilities list;
registry(pROPERTIEs);
define
    pfMark noPrint;
    pfBare;
    ;
register(PfLadder);
define
    pfF=5;
    pfG=5;
    pfN=0;
    pfR isRule "a";
    pfS isRule "a";
    pfAct code={
        pfN = 0;
        if pfAct["pfMark"];     pfN = 1;
        cerr "MC-F1 inside the action the marker is attached " pfN:;
        };
    pfRun code={
        pfN = 0;
        if pROPERTIEs["pfMark"];    pfN = 1;
        cerr "MC-0  the marker is defined in pROPERTIEs " pfN:;
        pfN = 0;
        if pROPERTIEs["pfMark"].noPrinT;    pfN = 1;
        cerr "MC-0n the defined marker carries noPrint " pfN:;
        pfF +% pfMark;
        pfG +% pfBare;
        pfN = 0;
        if pfF["pfMark"];   pfN = 1;
        cerr "MC-1  set and test by subscript " pfN:;
        cerr "MC-2  listLengtH with the marker " pfF.listLengtH " control " pfG.listLengtH:;
        cerr "MC-3  hasTraitS with the marker " pfF.hasTraitS " control " pfG.hasTraitS:;
        cerr "MC-4  print of the marked field follows":;
        dumpContents(pfF);
        cerr "MC-4c print of the control field follows":;
        dumpContents(pfG);
        cerr "MC-4e end of prints":;
        pfN = 0;
        for pfW in pfF;     pfN = pfN + 1;
        cerr "MC-5  for-walk members of the marked field " pfN:;
        pfF -= pfMark;
        pfG -= pfBare;
        pfN = 0;
        if pfF["pfMark"];   pfN = 1;
        cerr "MC-6  after the toss the marker is attached " pfN:;
        cerr "MC-6b after the toss listLengtH " pfF.listLengtH " hasTraitS " pfF.hasTraitS " control hasTraitS " pfG.hasTraitS:;
        pfN = 0;
        if pROPERTIEs["pfMark"];    pfN = 1;
        cerr "MC-6c after the toss the pROPERTIEs definition survives " pfN:;
        pfR +% pfMark;
        pfN = 0;
        pfV := tell("pfR a");
        if *pfV;   pfN = 1;
        cerr "MC-7  a rule carrying the marker still parses (testAttributes skip) " pfN:;
        pfAct +% pfMark;
        pfAct();
        pfN = 0;
        if pfAct["pfMark"];     pfN = 1;
        cerr "MC-8  after the action ran the marker is still attached " pfN:;
        cerr "MC-8b the action's frame stack exists " pfAct["frameSTAK"]:;
        pfS +% pfBare;
        pfN = 0;
        pfV := tell("pfS a");
        if *pfV;   pfN = 1;
        cerr "MC-7c CONTROL a rule carrying a non-noPrint marker parses " pfN:;
        };
    ;
search PfLadder pROPERTIEs UnitTests Utilities list;
pfRun();
cerr "MARKER SENTINEL":;
stop();
