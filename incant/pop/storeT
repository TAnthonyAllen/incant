register(StoreT);
define
    swBag;
    swOther=9;
    swAssign=101; swSetGroup=102; swRebind=103; swSetTag=104;
    swPlusEQ=105;  swMinusEQ=106; swMultEQ=107; swDivEQ=108;
    swAddAttr=109; swReplM=110;   swReplA=111;
    wAssign   code={ swAssign   =  swBag +* Grokking["swNoRule"]; };
    wSetGroup code={ swSetGroup := swBag +* Grokking["swNoRule"]; };
    wRebind   code={ swRebind   <- swBag +* Grokking["swNoRule"]; };
    wSetTag   code={ swSetTag   <: swBag +* Grokking["swNoRule"]; };
    wPlusEQ   code={ swPlusEQ   += swBag +* Grokking["swNoRule"]; };
    wMinusEQ  code={ swMinusEQ  -= swBag +* Grokking["swNoRule"]; };
    wMultEQ   code={ swMultEQ   *= swBag +* Grokking["swNoRule"]; };
    wDivEQ    code={ swDivEQ    /= swBag +* Grokking["swNoRule"]; };
    wAddAttr  code={ swAddAttr  +% swBag +* Grokking["swNoRule"]; };
