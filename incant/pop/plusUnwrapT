search reset stack Grokking;
search Generating UnitTests Utilities list;
register(PlusUnwrapT);
define
    nOp=1;
    nTgt=2;
    nArg=3;
    nEmpty;
    hOp;
    hTgt;
    hArg;
    hDataless;
    hNull;
    pb;
    pm;
    pe;
    pn;
    puSetUp code={
        hOp := nOp;
        hTgt := nTgt;
        hArg := nArg;
        hDataless := nEmpty;
        hNull := Grokking["zzzNoSuchRule"];
        };
    puRun code={
        pb +% hOp hTgt hArg;
        pm +% hOp nTgt nArg;
        pe +% hDataless nArg;
        pn +% hNull nArg;
        print "PU-0 the line after the four +% ran":;
        };
    ;
puSetUp();
puRun();
print "== pb":;
dumpField(pb);
print "== pm":;
