/*  dotChainT -- WHAT EACH DOT SPELLING READS. Built 2026-09-16 for item 6.

    ONE ACTION PER ROW, DELIBERATELY. A spelling that will not parse costs ONE
    row here; in a single-action fixture it kills every row after it and the
    run still exits 0. That is how the first cut of this file lost eight rows
    to one bad spelling, and it is bear-trap 32's misdirection in fixture form.

    ⚠ ECHOES ARE PINNED AS ECHOES. A row reading back the RECEIVING LOCAL'S OWN
    NAME is bear-trap 26 saying NO DATA -- it is not a value and must never be
    recorded as one. DC-7, DC-8 and DC-9 are all of those and they are pinned
    that way ON PURPOSE: DC-7 and DC-8 are the rows that prove the BARE
    leading-dot form was not disturbed by the chain fold.

    ⚠ AND THE TREE IS SEEDED WITH REAL VALUES SO THE PASSING ROWS CANNOT BE
    ECHOES TOO. dcMid holds MIDVAL and dcLeaf holds LEAFVAL, so a row that reads
    its node correctly answers with a VALUE and a row that merely reaches a
    data-less node answers with a tag -- and the two are told apart on sight.
    The seed goes through the SUBSCRIPT, `dcRoot["dcMid"] = "MIDVAL"`, because
    assigning to the local that `+%` returned sets the LOCAL and not the
    attached node; measured 2026-09-16, the local-assign form reads back a tag.

    THE ROWS
      DC-1  a.b        one dot, the shape that always worked
      DC-2  a.b.c      the CHAIN
      DC-3  a[b]       subscript, the control for DC-4
      DC-4  a[b].c     subscript then dot
      DC-5  *a.b       star and dot in one term
      DC-7  .b  after a call, lastREF set
      DC-8  .b  with nothing in lastREF
      DC-9  a.*b       a unary on the RIGHT operand. ⚠ NOW REFUSED (2026-09-17,
                       F-72) AND STILL AN ECHO -- both, deliberately.
                       ⚠ THE 09-16 READING WAS WRONG AND IS CORRECTED HERE: it
                       said `a.*b` never forms a dot at all. It DOES -- opDot
                       fires. What it never sees is the STAR. `a.*b` parses as
                       TWO terms, `a` bare and `*b` unary-only with no
                       dot-COMPOSED arm, and `*b` on a non-group field yields
                       NULL by the 09-05 star ruling -- so opDot arrives with a
                       null right operand, cannot tell that from a LEADING dot,
                       and its lastREF fixup rewrites BOTH operands. That is why
                       DOTOPERANDS read left=right=a, and why the refusal could
                       not go where the ruling sited it: by opDot the evidence
                       is gone. It sits in interpretXP, where the uxp still
                       carries its operator.
                       ⚠ ESCALATED 2026-09-17 (Tony's ruling) -- IT IS NOW
                       `refuse()` PROPER AND DC-9 PRINTS NO VALUE AT ALL. The
                       refusal ends the action, aCTionBlocK breaks, and dcR9's
                       cerr never runs. The echo pin that stood here predicted
                       its own death and got it the same day.
                       ⚠ THE ROW IS PINNED AS A COUNT, NOT AS AN ABSENCE: eight
                       DC value lines, DC-9 among the missing. Nine means the
                       escalation was reverted; seven means a DIFFERENT row died,
                       which is a different fact and gets looked at.
                       ⚠ AND THE DEFINE-TIME HALF IS NOT HERE, DELIBERATELY --
                       see fixIts F-76. `a.*b` inside a define does NOT reach
                       aCTionDefinE's refusalBoundary: it TRUNCATES the file at
                       exit 0 with no sentinel. A fixture row for it would take
                       this whole file hostage, which is rule H5.
      DC-S  ⚠ THE SEED CHECK, AND IT IS NOT DECORATION. DC-A's old wrong answer was
            MIDVAL -- which is exactly what an unseeded dcTwig would also produce. This
            row reads the tree stepwise through subscripts, where the answer is not in
            doubt, so DC-A and DC-B cannot pass or fail for the wrong reason.
      DC-A  a.b.c.d    -- FOUR names. Read MIDVAL (depth 2) until 2026-09-17
      DC-B  a[b].c.d   -- the same chain reached through a subscript
    ⚠ FIVE NAMES IS NOT HERE AND THAT IS DELIBERATE -- see fixIts F-80. `a.b.c.d.e`
    TRUNCATES THE RUN at exit 0 with the chain fold in place, where before it answered
    `xl1`. A row for it would take this whole file hostage (rule H5).
    DC-6 was `(*a).b` and is NOT here: parenthesised grouping does not parse in
    this position, measured 2026-09-16. Its question is DC-5's.

    Sentinel at the foot, checked first, single stop.  */
Start();
include(unitTests);
include(utilities);
search reset stack Grokking UnitTests Utilities list;
register(DotChainT);
define
    dcRoot;
    dcOther="OTHERVAL";
    dcSeed code={
        dcRoot +% new("dcMid");
        dcRoot["dcMid"] = "MIDVAL";
        dcM := dcRoot["dcMid"];
        *dcM +% new("dcLeaf");
        *dcM["dcLeaf"] = "LEAFVAL";
        dcL := *dcM["dcLeaf"];
        *dcL +% new("dcTwig");
        *dcL["dcTwig"] = "TWIGVAL";
        cerr "DC-0 seeded dcRoot -> dcMid=MIDVAL -> dcLeaf=LEAFVAL -> dcTwig=TWIGVAL":;
        };
    dcR1 code={ dcA := dcRoot.dcMid;           cerr "DC-1 a.b        = " dcA:; };
    dcR2 code={ dcB := dcRoot.dcMid.dcLeaf;    cerr "DC-2 a.b.c      = " dcB:; };
    dcR3 code={ dcC := dcRoot["dcMid"];        cerr "DC-3 a[b]       = " dcC:; };
    dcR4 code={ dcD := dcRoot["dcMid"].dcLeaf; cerr "DC-4 a[b].c     = " dcD:; };
    dcR5 code={ dcH := dcRoot; dcE := *dcH.dcMid; cerr "DC-5 *a.b     = " dcE:; };
    dcTouch code={ dcT := dcOther; return dcT; };
    dcR7 code={ dcTouch(dcOther); dcG := .dcT; cerr "DC-7 .b afterCall = " dcG:; };
    dcR8 code={ dcI := .dcNeverSet;            cerr "DC-8 .b noLastREF = " dcI:; };
    dcR9 code={ dcJ := dcRoot.*dcMid;          cerr "DC-9 a.*b       = " dcJ:; };
    dcSeedCk code={
        dcQ1 := dcRoot["dcMid"];
        dcQ2 := *dcQ1["dcLeaf"];
        dcQ3 := *dcQ2["dcTwig"];
        cerr "DC-S seed: mid=" *dcQ1 " leaf=" *dcQ2 " twig=" *dcQ3:; };
    dcRA code={ dcK := dcRoot.dcMid.dcLeaf.dcTwig;      cerr "DC-A a.b.c.d    = " dcK:; };
    dcRB code={ dcL2 := dcRoot["dcMid"].dcLeaf.dcTwig;  cerr "DC-B a[b].c.d   = " dcL2:; };
    dcRun code={
        dcSeed(dcRoot);
        dcR1(dcRoot); dcR2(dcRoot); dcR3(dcRoot); dcR4(dcRoot);
        dcR5(dcRoot); dcR7(dcRoot); dcR8(dcRoot); dcR9(dcRoot);
        dcSeedCk(dcRoot); dcRA(dcRoot); dcRB(dcRoot);
        };
    ;
dcRun();
print "DOTCHAIN SENTINEL -- reached the foot":;
stop();
