Start();
include(utilities);
include(unitTests);
registry(fILEs);
define
    kantGrammar File='incant/kantGrammar';
    ;
include(kantGrammar);
search reset stack KantGrammar Grokking;
search Utilities UnitTests;
registry(NewLocalT);
define
    nlReqN owner source result rule;
    nlReqO owner source result;
    nlOutN = 5;
    nlOutO = 5;
    nlDepN = 2;
    nlDepO = 2;
    itW;
    it5;
    nlNew code={
        nlSrc := argument.CodE;
        nlReqN.owner  := argument;
        nlReqN.source := nlSrc;
        nlReqN.rule   := KantGrammar["STARt"];
        if compileIn(nlReqN);
            nlBlock = nlReqN.result;
            *nlBlock :. noPrinT;
            argument :. isActioN;
            argument +< *nlBlock;
        };
    nlOld code={
        nlSrc := argument.CodE;
        nlReqO.owner  := argument;
        nlReqO.source := nlSrc;
        if compileIn(nlReqO);
            nlBlock = nlReqO.result;
            *nlBlock :. noPrinT;
            argument :. isActioN;
            argument +< *nlBlock;
        };
    nlTag code={ print argument.taG:; };
    nlHas code={
        if nl1n["lvNew"];   print "NL AL-1h n 1":;
        else                print "NL AL-1h n 0":;
        if nl1o["lvNew"];   print "NL AL-1h o 1":;
        else                print "NL AL-1h o 0":;
        if nl1n["zzNoSuch"];    print "NL AL-1h control 1":;
        else                    print "NL AL-1h control 0":;
        if nl1n["lv5n"];    print "NL AL-5h n 1":;
        else                print "NL AL-5h n 0":;
        if nl1o["lv5o"];    print "NL AL-5h o 1":;
        else                print "NL AL-5h o 0":;
        };
    nlWit code={
        print "NL AL-W n":;
        bl := nl1n =< "BlocK";
        g := *bl[1];
        nlTag(*g);
        print "NL AL-W o":;
        bo := nl1o =< "BlocK";
        go := *bo[1];
        nlTag(*go);
        print "NL AL-W ownerless":;
        a := itW[1];
        nlTag(*a);
        };
    nlRPn code={ print "[" 7 #5d "]":; };
    nlRPo code={ print "[" 7 #5d "]":; };
    nl1n code={ lvNew = 7; print lvNew:; };
    nl1o code={ lvNew = 7; print lvNew:; };
    nl2n code={ print lv2:; lv2 = 3; print lv2:; };
    nl2o code={ print lv2:; lv2 = 3; print lv2:; };
    nl3n code={ lv3 = nlDepN; nlDepN = nlDepN - 1; if lv3 > 0; nl3n(9); print lv3:; };
    nl3o code={ lv3 = nlDepO; nlDepO = nlDepO - 1; if lv3 > 0; nl3o(9); print lv3:; };
    nl3an code={ lv3a = argument; if lv3a > 0; nl3an(lv3a - 1); print lv3a:; };
    nl3ao code={ lv3a = argument; if lv3a > 0; nl3ao(lv3a - 1); print lv3a:; };
    nl4n code={ print nlOutN:; nlOutN = 6; };
    nl4o code={ print nlOutO:; nlOutO = 6; };
    ;
search NewLocalT;
nlNew(nlRPn);
nlOld(nlRPo);
nlNew(nl1n);
nlOld(nl1o);
nlNew(nl2n);
nlOld(nl2o);
nlNew(nl3n);
nlOld(nl3o);
nlNew(nl3an);
nlOld(nl3ao);
nlNew(nl4n);
nlOld(nl4o);
print "NL RP n":;
nlRPn();
print "NL RP o":;
nlRPo();
print "NL AL-1 n":;
nl1n();
print "NL AL-1 o":;
nl1o();
print "NL AL-2 n":;
nl2n();
nl2n();
print "NL AL-2 o":;
nl2o();
nl2o();
print "NL AL-3 n":;
nl3n(9);
print "NL AL-3 o":;
nl3o(9);
print "NL AL-3a n":;
nl3an(2);
print "NL AL-3a o":;
nl3ao(2);
print "NL AL-4 n":;
nl4n();
print nlOutN:;
print "NL AL-4 o":;
nl4o();
print nlOutO:;
print "NL AL-5 n":;
it5 = STARt("lv5n = 4; print lv5n:;");
testOP(it5);
print "NL AL-5 o":;
lv5o = 4; print lv5o:;
itW = STARt("lvNew = 7; print lvNew:;");
nlWit();
nlHas();
print "NL END":;
cerr "NEWLOCALT SENTINEL":;
stop();

newLocalT -- SEQ 502 (Tony, 2026-11-01): rung 5, step 1. Ruling A: a name the new road meets inside an action body that
resolves to nothing becomes a local of that action, created when the action is built, once -- the set the old road creates
through aCTionNamE and the frame bracket saves.

One process. Every action under test comes in a pair with the SAME body: the `n` action is built on the NEW road by
compileIn with a `rule` (KantGrammar's STARt), the `o` action on the OLD road by compileIn with none (the control). Each
block of output starts with a line `NL <row> <road>`; pop.sh reads the lines up to the next NL line.

ROWS
RP   road proof, read before any value row: print "[" 7 #5d "]". The roads bind a format in opposite directions -- the
     old road puts #5d on the 7 before it ([     7 ]), the new road on what follows it, and nothing follows ([ 7 ]). So
     a 7 built by the old road cannot pass as a new-road green below.
AL-W the built BlocK's first entry: the new road's must be its seq op; the old road's is a StatemenT. The ownerless
     control is the same text built by STARt at the top level, with no owner: its first entry is an instruct. Replaces the temporary tap of R1 (24 statement runs suppressed
     under the owner's floor): a build that suppressed them hands back raw STATEMENt labels and this row reads it.
AL-1 lvNew = 7; print lvNew -- prints 7; AL-1h: lvNew is an attribute of the action (with a never-written control, 0).
AL-2 called twice; print before the write, write 3, print: the local does not leak, both calls read alike.
AL-3 nl3n calls itself while a declared depth counter (2) counts down, printing its local on the way back: each level
     keeps its own lv3 across the inner call (0 1 2); a shared local would print 0 0 0. RE-PINNED before the buy (SEQ 502
     R3): the dispatched shape read its depth from `argument`, and that rides two new-road gaps outside Ruling A, so
     it is AL-3a. The claim -- the frame bracket covers a new-road local -- needs neither.
AL-3a the dispatched shape, lv3a = argument, recursing on lv3a - 1. A KNOWN GAP on the new road, pinned red: (1)
     `argument` in an action body is resolved at BUILD, before runAction mints the action's argument (at its first
     call), so it resolves to another action's argument field; (2) arithmetic on a holder refuses on the new road --
     measured with no action and no owner, `hz := qa; print hz - 1` refuses at the top level.
AL-4 a declared outer field used inside: it reads the outer 5, the write reaches it (6 after), no local shadows it.
AL-5 the same kind of statement at the top level, outside any action: nothing is created in an action (AL-5h).

ON TRUNK (born red): compileIn ignores `rule` there, so every `n` action is built on the OLD road -- RP n reads the old
road's value and AL-W n reads StatemenT. The value rows of the n road would read the old road through the n name, so
pop.sh prefixes every n row with RP n's reading: no n row can go green until the road proof has. Branch action-locals
builds the new road.
