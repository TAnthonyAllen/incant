Start();
include(utilities);
search reset stack Grokking;
include("IncantForms/WorkingOn/parser");
define
    s2Y=0;
    s2N=2;
    olEqJ root="ExpressioN" armed="Token" msg=(==#) jitted=1;
    olEqI root="ExpressioN" armed="Token" msg=(==#) jitted=0;
    olLeJ root="ExpressioN" armed="Token" msg=(<=#) jitted=1;
    olLeI root="ExpressioN" armed="Token" msg=(<=#) jitted=0;
    olPeJ root="ExpressioN" armed="Token" msg=(+=#) jitted=1;
    olPeI root="ExpressioN" armed="Token" msg=(+=#) jitted=0;
    olAsJ root="ExpressioN" armed="Token" msg=(=#) jitted=1;
    olAsI root="ExpressioN" armed="Token" msg=(=#) jitted=0;
    oEq=(if s2N == 2; s2Y = 5;#);
    oEqNo=(if s2N == 3; s2Y = 5;#);
    oLe=(if s2N <= 1; s2Y = 5;#);
    oPe=(s2Y += 4;#);
