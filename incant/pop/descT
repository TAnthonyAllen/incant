Start();
include(unitTests);
include(utilities);
include(styles);
search cOLOr fONTs;
registry(fILEs);
define
    descriptionsFile File='IncantForms/Windows/descriptions';
    ;
include(descriptionsFile);
register(DescT);
define
    deX = 0;
    deY = 0;
    deAt code={
        px = deX;
        py = deY;
        argument :% copyOf(px);
        argument :% copyOf(py);
        pixelAt(argument);
        };
    ;
search DescT FORMs dESCRIPTIONs UnitTests Utilities cOLOr fONTs list;
cerr "DE the descriptions registry after the form's define":;
cerr "DED saber [" dESCRIPTIONs["saber"] "]":;
cerr "DED describeHelp [" dESCRIPTIONs["describeHelp"] "]":;
define
    laid;
    layIt code={ laid := setFrame(argument); };
    descriptionsReq form:=descriptions;
    dePdfReq path="IncantForms/PDF/output.pdf" form:=descriptions;
    pdfRead path="IncantForms/PDF/output.pdf";
    ;
layIt(descriptionsReq);
printDefinition(*laid);
makeDisplay(*laid);
drawWalk(*laid);
cerr "DE pixels: first (10,10), saber (100,300), trees (350,300), describeHelp (100,550)":;
deX = 10; deY = 10; deAt(*laid);
deX = 100; deY = 300; deAt(*laid);
deX = 350; deAt(*laid);
deX = 100; deY = 550; deAt(*laid);
cerr "DE borders: saber's left (0,300), trees' left (250,300), describeHelp's top (100,325)":;
deX = 0; deY = 300; deAt(*laid);
deX = 250; deAt(*laid);
deX = 100; deY = 325; deAt(*laid);
cerr "DE the PDF (stroke 1a): the same seven points read back from the page":;
redrawForm(dePdfReq);
readPDF(pdfRead);
deX = 10; deY = 10; deAt(pdfRead);
deX = 100; deY = 300; deAt(pdfRead);
deX = 350; deAt(pdfRead);
deX = 100; deY = 550; deAt(pdfRead);
deX = 0; deY = 300; deAt(pdfRead);
deX = 250; deAt(pdfRead);
deX = 100; deY = 325; deAt(pdfRead);
cerr "DESCT SENTINEL":;
stop();

descT -- the descriptions form's driver (SEQ 607, Tony, 2026-11-10). RUN ALONE since 2026-11-13: IncantForms/Windows/descriptions
is definitions only and this file includes it (until then formsPop joined the form, up to its stop(), to this driver).
The form is named descriptions (it was webViewExample). Stroke 1a: the form is also drawn to a PDF by redrawForm and the
same seven points are read back from the page (DE-10, DE-11). Rows in formsPop. Coordinates are page coordinates (the top's x and y are the
origin). The DED lines read the descriptions registry after the form is defined: with dESCRIPTIONs on the search list
during the form's define (R1), a form field of the same name is the registry's entry, not a second field.

2026-11-13 (Tony's fix for the capture): the form's captions (describeHead, saber, trees) are plain FORMs definitions made
before dESCRIPTIONs is searched, and the form names them with no text. DE-6 now reads the registry's long text; DE-12 reads
the captions off the laid-out form. H7: with the three captions put back on the form's own lines DE-6 reads the caption again.
