define
    njReq owner source result rule;
    njNew code={
        njSrc := argument.CodE;
        njReq.owner  := argument;
        njReq.source := njSrc;
        njReq.rule   := KantGrammar["STARt"];
        if compileIn(njReq);
            njBlock = njReq.result;
            *njBlock :. noPrinT;
            argument :. isActioN;
            argument +< *njBlock;
        };
    knReq name text arg;
    kwRan code={
        kjReq.name = string $"kw_" argument.taG "_ran"$;
        kwGot = callIR(kjReq);
        kjReq.name = string $"kw_" argument.taG "_tops"$;
        kwTop = callIR(kjReq);
        cerr "KN RAN" argument.taG kwGot "testOP" kwTop:;
        };
    nj4 code={ a4 = 3; b4 = a4 + 4; c4 = b4 * 2; print c4:; };
    nn code={ a = 1.5; b = a * 2.5; c = b - 0.5 + a; print c:; };
    nx code={ a = 3; print a:; if a > 2; a = 10; b = a + 1; print b:; };
    nt code={ s = 5; t = s * 2; print t:; s = t - 1; print s:; };
    nr code={ d = argument; e = 3; f = e + 4; if d > 0; nr(d - 1); print f:; g = f * 2; print g:; };
    lsSrc=1;
    lsFired=0;
    lsL listenTo:=lsSrc code={ lsFired = lsFired + 1; };
    lsText="define ptr @ls_set(ptr %a) {  %r = call ptr @irSetCount(ptr %a, i32 7)  ret ptr %r } declare ptr @irSetCount(ptr, i32)";
    lsGo code={
        lsFired = 0;
        lsSrc = 9;
        cerr "KN LISTEN interpreted = : fired" lsFired "value" lsSrc:;
        knReq.name = "ls_set";
        knReq.text = lsText;
        compileIR(knReq);
        lsFired = 0;
        knReq.arg := lsSrc;
        callIR(knReq);
        cerr "KN LISTEN native write: fired" lsFired "value" lsSrc:;
        };
    ;
