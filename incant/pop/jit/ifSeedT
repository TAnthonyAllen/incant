isLoop();
cerr "IS-C3 after the loop: isLo [" isLo "] mark [" ,*isH4 "]":;
isStale();
cerr "IS-S read before the if: isPre [" isPre "] isSt [" isSt "] mark [" ,*isH5 "]":;
snWrite();
cerr "SN-1 a star target: mark [" ,*isH6 "]":;
snCond();
cerr "SN-2 a star in a condition: snA [" snA "] mark [" ,*isH7 "]":;
cerr "IFSEED SENTINEL":;
