search reset stack Grokking;
search Generating UnitTests Utilities list;
register(IfSeedT);
define
    isH; isH2; isH3; isH4; isH5; isH6; isH7; isC=1; snA=0; isOut=0; isIn=0; isBo=0; isLo=0; isN=0; isPre=0; isSt=0;
    isAfter code={
        if isC == 1;    *isH = 1;
        if *isH == 1;   isOut = isOut + 1;
        };
    isInside code={
        if isC == 1;
            *isH2 = 1;
            if *isH2 == 1;  isIn = isIn + 1;
        };
    isBoth code={
        if isC == 1;    *isH3 = 1;
        else            *isH3 = 2;
        if *isH3 == 1;  isBo = isBo + 1;
        };
    isLoop code={
        isN = 0;
        while isN < 2;
            *isH4 = isN + 1;
            isN = isN + 1;
        if *isH4 == 2;  isLo = isLo + 1;
        };
    isStale code={
        if *isH5 == 0;  isPre = isPre + 1;
        if isC == 1;    *isH5 = 1;
        if *isH5 == 1;  isSt = isSt + 1;
        };
    snWrite code={
        *isH6 = 1;
        };
    snCond code={
        if *isH7 == 0;  snA = snA + 1;
        };
    ;
isH := new("mark");
