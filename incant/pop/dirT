/*  dirT -- the POP fixture for incant/directives.

    Split out 2026-09-15 so incant/directives could become definitions-only and
    therefore includable. The actions come from the include; the sample
    directives and the driver live here, which is where a fixture's data belongs.
    ⚠ SOURCE MUST BE NAMED `source`: replaceAt/insertAt hoist it by that literal
    name (`:argument source fromThis toThis`), so a differently-named field
    silently gives the hoist nothing and EVERY directive misses.
    ⚠ getFile IS ONCE PER FIELD: a second call reads the buffer CONTENTS back as
    a filename. One source field, one getFile, directives in forward order --
    the buffer mark only ever advances.  */
Start();
include(directives);

register(Directives);
define
    /***************************************************************************
        POP fixtures. source points at a committed read-only sample
        (incant/dirSample). The POP only getFile's it (read) and rewrites the
        in-memory buffer — it never closeFile's, so the sample on disk is
        never touched. To rewrite a REAL file, see the copy-to-Tests/ workflow
        in the guide below.
    ***************************************************************************/
    source="incant/dirSample";
    dIRECTive1 source fromThis="matchOnThis:" toThis="\tStick this in instead";
    dIRECTive2 source fromThis="x =" toThis='\t\tprint "Stuck this in before":;\n' where=before;
    dIRECTive3 source fromThis="x:;" toThis='\t\tprint "Stuck this in after":;\n' where;
    /*  A DELIBERATE MISS. fromThis is not in the sample, so this directive must
        write NOTHING and must say so by name. Before 2026-09-15 it wrote its
        toThis at the buffer head instead -- a stale fromThis in a generated
        batch corrupted the top of the file silently.  */
    dIRECTive4 source fromThis="zzzNotInTheSample" toThis='\t\tMISS-MUST-NOT-APPEAR\n' where=before;

    /*  deleteAt, F-66, ruled 2026-09-16: a SEPARATE VERB, so neither of these
        carries a toThis at all. Three rows, and the third is the one that needs
        saying: dIRECTive5 is fired TWICE. The second fire must find nothing --
        the text is gone -- so it must take the miss arm and leave the buffer
        alone. A verb that deleted by re-reading an absent toThis could not
        tell that second fire from the first.
        ⚠ THE DELETE TARGETS THE LAST LINE OF THE SAMPLE because the mark only
        ever advances: it has to sit forward of dIRECTive3's insert.  */
    dIRECTive5 source fromThis=" she wrote";
    dIRECTive6 source fromThis="zzzNotInTheSampleEither";

    /*  TAIL placement, both directions, F-67. Together they BRACKET the sample's
        last line, so both rows name the same neighbour and a payload on the
        wrong side of it cannot pass either.
        ⚠ THEY STRADDLE THE DELETES, AND THAT IS THE MARK, NOT A PREFERENCE. The
        mark only ever advances, so dIRECTive7 must run BEFORE the delete (its
        anchor is behind the delete site) and dIRECTive8 AFTER it -- which is why
        dIRECTive8 anchors on `};`, the only text forward of where the delete left
        the mark.
        HEAD is not here and cannot be: a head case cannot share a buffer with
        anything, since everything else is forward of it. It has its own run --
        incant/pop/dirHeadT -- and it is red on purpose.  */
    dIRECTive7 source fromThis="Thats all" toThis='TAIL-BEFORE\n' where=before;
    dIRECTive8 source fromThis="};" toThis='TAIL-AFTER\n' where;

    /***************************************************************************
        replaceAt — find fromThis in source, replace it with toThis.
        IN sets the buffer mark at the match; -= removes the matched text at
        the mark; += inserts toThis there. Deleting is deleteAt's job, not a
        replaceAt with something missing (F-66, ruled 2026-09-16).
    ***************************************************************************/
    ;

getFile(source);
print ``"--- BEFORE directives ---":source:;
replaceAt(dIRECTive1);
insertAt(dIRECTive2);
insertAt(dIRECTive3);
insertAt(dIRECTive4);
insertAt(dIRECTive7);
deleteAt(dIRECTive5);
print "--- deleteAt second fire, must be inert ---":;
deleteAt(dIRECTive5);
deleteAt(dIRECTive6);
insertAt(dIRECTive8);
print ``"--- AFTER directives ---":source:;
print "DIRT SENTINEL":;
stop();