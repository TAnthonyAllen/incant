registry(RefusalEndsT);
define
    reReq owner source result rule;
    reNew code={
        reSrc := argument.CodE;
        reReq.owner  := argument;
        reReq.source := reSrc;
        reReq.rule   := KantGrammar["STARt"];
        if compileIn(reReq);
            reBlock = reReq.result;
            *reBlock :. noPrinT;
            argument :. isActioN;
            argument +< *reBlock;
        };
    reS=3;
    reN=0;
    reArm=0;
    reTail=0;
    reList kind
        one;
        two;
        three;
    nSeq code={ reTail = 0; hz := reS; x = hz - 1; reTail = 1; };
    nWhile code={ reN = 0; reTail = 0; hz := reS; while ++reN < 3; x = hz - 1; reTail = 1; };
    nDo code={ reN = 0; reTail = 0; hz := reS; do x = hz - 1; while ++reN < 3; reTail = 1; };
    nFor code={ reN = 0; reTail = 0; hz := reS; for c in reList; x = hz - ++reN; reTail = 1; };
    nIfC code={ reArm = 0; reTail = 0; hz := reS; if hz - 1; reArm = 1; else reArm = 2; reTail = 1; };
    nCaller code={ reTail = 0; nSeq(1); reTail = 7; };
    oSeq code={ reTail = 0; hz := reS; x = hz - 1; reTail = 1; };
    oWhile code={ reN = 0; reTail = 0; hz := reS; while ++reN < 3; x = hz - 1; reTail = 1; };
    oDo code={ reN = 0; reTail = 0; hz := reS; do x = hz - 1; while ++reN < 3; reTail = 1; };
    oFor code={ reN = 0; reTail = 0; hz := reS; for c in reList; x = hz - ++reN; reTail = 1; };
    oIfC code={ reArm = 0; reTail = 0; hz := reS; if hz - 1; reArm = 1; else reArm = 2; reTail = 1; };
    oCaller code={ reTail = 0; oSeq(1); reTail = 7; };
    reBump code={ reArm = 9; };
    nWhile1 code={ reTail = 0; hz := reS; while 1; x = hz - 1; reTail = 1; };
    nDo1 code={ reTail = 0; hz := reS; do x = hz - 1; while 1; reTail = 1; };
    nIfCall code={ reArm = 0; reTail = 0; hz := reS; if hz - 1; reArm = 1; else reBump(1); reTail = 1; };
    oWhile1 code={ reTail = 0; hz := reS; while 1; x = hz - 1; reTail = 1; };
    oDo1 code={ reTail = 0; hz := reS; do x = hz - 1; while 1; reTail = 1; };
    oIfCall code={ reArm = 0; reTail = 0; hz := reS; if hz - 1; reArm = 1; else reBump(1); reTail = 1; };
    ;
