Start();
include(utilities);
search reset stack Grokking;
search GroupFields Utilities list;

register(Utilities);
define
    tpName; tpPending; tpRows=0; tpTrue=0; tpNot; tpV; tpBag; tpOuter; tpNode; tpMark; tpSlot; tpRead;

    tpSeed code={
        clear(tpBag);
        clear(tpOuter);
        tpV = 7;
        tpKid := new("kid");
        *tpKid = 7;
        tpBag +% *tpKid;
        tpInner := new("bag");
        tpOuter +% *tpInner;
        tpNode := new("extra");
        *tpNode = 1;
        };
    tpMintRow code={
        // tpMintRow ONE marker per row, tagged with the row's own slug, and tpSlot points at the
        // tpMintRow ATTACHED COPY because +% copies. Called from tpTestResult for the ordinary
        // tpMintRow rows and directly by the two INVERTED rows, which never reach tpTestResult
        tpMark := new(argument);
        *tpMark = 0;
        tpPending +% *tpMark;
        tpSlot := tpPending[argument];
        tpRows = tpRows + 1;
        };
    tpTestResult code={
        tpName := argument.taG;
        tpMintRow(*tpName);
        if *tpRead == argument; *tpSlot = 1;
        if *tpSlot == 1;        tpTrue = tpTrue + 1;
        // rowLabelIsCaptured tpMintRow sits between the capture and this line, and lastREF
        // rowLabelIsCaptured answers WHAT WAS REFERENCED LAST, calls included -- so a bare taG
        // rowLabelIsCaptured here prints the string taG. Capture, then call, then read the capture
        cerr "ROW" *tpName "WANT" argument "GOT " *tpRead:;
        };
    tpAssignBare code={
        // tpMark := new("assignBare"); tpPending +% *tpMark; writes the target outright. A bare name IS the field.
        tpV = 9;
        tpRead := tpV;
        tpTestResult(assignBare=9);
        };
    tpAssignArgDo code={
        argument = 9;
        };
    tpAssignArg code={
        // writes the target outright. An argument is a binding to the caller's field, so writing it writes what the caller passed.
        tpK := tpBag["kid"];
        tpAssignArgDo(*tpK);
        tpRead := tpBag["kid"];
        tpTestResult(assignArg=9);
        };
    tpAssignSub code={
        // tpBag["kid"] = 9; writes the target outright. A subscript names a member of the bag, and the write lands on that member.
        tpBag["kid"] = 9;
        tpRead := tpBag["kid"];
        tpTestResult(assignSub=9);
        };
    tpAssignDot code={
        // tpBag.kid = 9; writes the target outright. A dot navigates to the same member a subscript reaches.
        tpBag.kid = 9;
        tpRead := tpBag["kid"];
        tpTestResult(assignDot=9);
        };
    tpAssignStar code={
        // tpH := tpBag["kid"]; *tpH = 9; writes the target outright. A star reaches through a holder to the field it holds.
        tpH := tpBag["kid"];
        *tpH = 9;
        tpRead := tpBag["kid"];
        tpTestResult(assignStar=9);
        };
    tpAssignStarsub code={
        // *tpH["kid"] = 9; writes the target outright. The star reaches through the holder FIRST and the subscript then names a member of what it holds -- star to the base, subscript after.
        tpH := tpBag;
        *tpH["kid"] = 9;
        tpRead := tpBag["kid"];
        tpTestResult(assignStarsub=9);
        };
    tpPlusEQBare code={
        // tpV = 7; tpV += 1; adds one into the target. A bare name IS the field, so nothing has to be navigated first.
        tpSeed();
        tpV += 1;
        tpRead := tpV;
        tpTestResult(plusEQBare=8);
        };
    tpPlusEQArgDo code={
        argument += 1;
        };
    tpPlusEQArg code={
        // adds one into the target. An argument is a binding to the caller's field, so writing it writes what the caller passed.
        tpK := tpBag["kid"];
        tpPlusEQArgDo(*tpK);
        tpRead := tpBag["kid"];
        tpTestResult(plusEQArg=8);
        };
    tpPlusEQSub code={
        // tpBag["kid"] += 1; adds one into the target. A subscript names a member of the bag, and the write lands on that member.
        tpSeed();
        tpBag["kid"] += 1;
        tpRead := tpBag["kid"];
        tpTestResult(plusEQSub=8);
        };
    tpPlusEQDot code={
        // tpBag.kid += 1; adds one into the target. A dot navigates to the same member a subscript reaches.
        tpSeed();
        tpBag.kid += 1;
        tpRead := tpBag["kid"];
        tpTestResult(plusEQDot=8);
        };
    tpPlusEQStar code={
        // *tpH += 1; adds one into the target. A star reaches through a holder to the field it holds.
        tpSeed(tpBag);
        tpH := tpBag["kid"];
        *tpH += 1;
        tpRead := tpBag["kid"];
        tpTestResult(plusEQStar=8);
        };
    tpPlusEQStarsub code={
        // *tpH["kid"] += 1; adds one into the target. The star reaches through the holder FIRST and the subscript then names a member of what it holds -- star to the base, subscript after.
        tpSeed(tpBag);
        tpH := tpBag;
        *tpH["kid"] += 1;
        tpRead := tpBag["kid"];
        tpTestResult(plusEQStarsub=8);
        };
    tpPlusPlusBare code={
        // tpV = 7; ++tpV; bumps the target by one. A bare name IS the field, so nothing has to be navigated first.
        tpSeed(tpBag);
        ++tpV;
        tpRead := tpV;
        tpTestResult(plusPlusBare=8);
        };
    tpPlusPlusArgDo code={
        ++argument;
        };
    tpPlusPlusArg code={
        // bumps the target by one. An argument is a binding to the caller's field, so writing it writes what the caller passed.
        tpSeed(tpBag);
        tpK := tpBag["kid"];
        tpPlusPlusArgDo(*tpK);
        tpRead := tpBag["kid"];
        tpTestResult(plusPlusArg=8);
        };
    tpPlusPlusDot code={
        // ++tpBag.kid; a prefix unary binds before the dot as well, for the same reason it binds before a subscript.
        tpSeed(tpBag);
        ++tpBag.kid;
        tpRead := tpBag["kid"];
        tpTestResult(plusPlusDot=8);
        };
    tpMinusMinusBare code={
        // tpV = 7; --tpV; steps the target down by one. A bare name IS the field, so nothing has to be navigated first.
        tpSeed(tpBag);
        --tpV;
        tpRead := tpV;
        tpTestResult(minusMinusBare=6);
        };
    tpMinusMinusArgDo code={
        --argument;
        };
    tpMinusMinusArg code={
        // steps the target down by one. An argument is a binding to the caller's field, so writing it writes what the caller passed.
        tpSeed(tpBag);
        tpK := tpBag["kid"];
        tpMinusMinusArgDo(*tpK);
        tpRead := tpBag["kid"];
        tpTestResult(minusMinusArg=6);
        };
    tpMinusMinusDot code={
        // --tpBag.kid; a prefix unary binds before the dot as well, for the same reason it binds before a subscript.
        tpSeed(tpBag);
        --tpBag.kid;
        tpRead := tpBag["kid"];
        tpTestResult(minusMinusDot=6);
        };
    tpAddAttrBare code={
        // tpBag +% *tpNode; adds the node to the bag as an attribute. A bare name IS the bag.
        tpSeed(tpBag);
        tpBag +% *tpNode;
        tpRead := tpBag.listLengtH;
        tpTestResult(addAttrBare=2);
        };
    tpAddAttrArgDo code={
        argument +% *tpNode;
        };
    tpAddAttrArg code={
        // adds the node as an attribute through an argument binding.
        tpSeed(tpBag);
        tpAddAttrArgDo(tpBag);
        tpRead := tpBag.listLengtH;
        tpTestResult(addAttrArg=2);
        };
    tpAddAttrStar code={
        // *tpH +% *tpNode; adds the node as an attribute through a holder.
        tpSeed(tpBag);
        tpH := tpBag;
        *tpH +% *tpNode;
        tpRead := tpBag.listLengtH;
        tpTestResult(addAttrStar=2);
        };
    tpZeroBump code={
        // zero is a VALUE: assigning 0 puts a count in the slot, so the bump reads it and writes 1.
        tpZ = 0;
        ++tpZ;
        tpRead := tpZ;
        tpTestResult(zeroBump=1);
        };
    tpZeroStep code={
        // the same rule downward: a field holding zero steps to minus one, it does not refuse.
        tpZ = 0;
        --tpZ;
        tpRead := tpZ;
        tpTestResult(zeroStep= -1);
        };
    tpAbsentBump code={
        // a field that was never assigned is ABSENT, not zero, and the bump refuses it by
        // name rather than inventing a value. THIS ROW IS INVERTED: it marks itself TRUE
        // first and clears the mark on the line AFTER the statement, which only runs if
        // the statement did NOT refuse. A refusal is terminal for the action, so the mark
        // survives exactly when the refusal happened.
        tpMintRow("absentBump");
        *tpSlot = 1;
        tpTrue = tpTrue + 1;
        cerr "ROW absentBump -- wants a refusal, and prints nothing after it":;
        ++tpNever;
        *tpSlot = 0;
        tpTrue = tpTrue - 1;
        cerr "    absentBump  DID NOT REFUSE -- the absent kind was accepted":;
        };
    tpAbsentStep code={
        // a field that was never assigned is ABSENT, not zero, and the step refuses it by
        // name rather than inventing a value. THIS ROW IS INVERTED: it marks itself TRUE
        // first and clears the mark on the line AFTER the statement, which only runs if
        // the statement did NOT refuse. A refusal is terminal for the action, so the mark
        // survives exactly when the refusal happened.
        tpMintRow("absentStep");
        *tpSlot = 1;
        tpTrue = tpTrue + 1;
        cerr "ROW absentStep -- wants a refusal, and prints nothing after it":;
        --tpNever;
        *tpSlot = 0;
        tpTrue = tpTrue - 1;
        cerr "    absentStep  DID NOT REFUSE -- the absent kind was accepted":;
        };
 
//  ============ SECTION 2: NOT YET -- WAITING ON WORK ============
//  Every row here is the same singular-slot grammar line: TokenXP carries ONE prefix
//  and ONE postfix, so a unary binds to the name before a subscript and a second
//  prefix is dropped. The fold is what graduates these; nothing here needs a ruling.

    runSection2 code={
        print "Running" taG:`;
        tpSeed(tpBag);
        };
    tpPlusPlusSub code={
        // ++tpBag["kid"]; a prefix unary binds to the NAME before the subscript, so today this bumps the BAG and leaves the member alone. The fold is what makes the subscript bind first.
        runSection2(tpPlusPlusSub);
        ++tpBag["kid"];
        tpRead := tpBag["kid"];
        };
    tpPlusPlusStar code={
        // ++*tpH;two prefix unaries meet one name, and the slot holds only one -- so the second is dropped and the statement does nothing at all, silently.
        runSection2(tpPlusPlusStar);
        tpH := tpBag["kid"];
        ++*tpH;
        tpRead := tpBag["kid"];
        tpTestResult(plusPlusStar=8);
        };
    tpPlusPlusStarsub code={
        // ++*tpH["kid"]; bumps the target by one. The star reaches through the holder FIRST and the subscript then names a member of what it holds -- star to the base, subscript after.
        runSection2(tpPlusPlusStarsub);
        tpH := tpBag;
        ++*tpH["kid"];
        tpRead := tpBag["kid"];
        tpTestResult(plusPlusStarsub=8);
        };
    tpMinusMinusSub code={
        // --tpBag["kid"]; a prefix unary binds to the NAME before the subscript, so today this bumps the BAG and leaves the member alone. The fold is what makes the subscript bind first.
        runSection2(tpMinusMinusSub);
        --tpBag["kid"];
        tpRead := tpBag["kid"];
        };
    tpMinusMinusStar code={
        // --*tpH; two prefix unaries meet one name, and the slot holds only one -- so the second is dropped and the statement does nothing at all, silently.
        runSection2(tpMinusMinusStar);
        tpH := tpBag["kid"];
        --*tpH;
        tpRead := tpBag["kid"];
        tpTestResult(minusMinusStar=6);
        };
    tpMinusMinusStarsub code={
        // --*tpH["kid"]; steps the target down by one. The star reaches through the holder FIRST and the subscript then names a member of what it holds -- star to the base, subscript after.
        runSection2(tpMinusMinusStarsub);
        tpH := tpBag;
        --*tpH["kid"];
        tpRead := tpBag["kid"];
        tpTestResult(minusMinusStarsub=6);
        };
    tpAddAttrSub code={
        // tpOuter["bag"] +% *tpNode; adds the node as an attribute to a bag reached by subscript.
        runSection2(tpAddAttrSub);
        tpOuter["bag"] +% *tpNode;
        tpInner := tpOuter["bag"];
        tpRead := tpInner.listLengtH;
        tpTestResult(addAttrSub=1);
        };
    tpAddAttrDot code={
        // tpOuter.bag +% *tpNode;adds the node as an attribute to a bag reached by a dot.
        runSection2(tpAddAttrDot);
        tpOuter.bag +% *tpNode;
        tpInner := tpOuter["bag"];
        tpRead := tpInner.listLengtH;
        tpTestResult(addAttrDot=1);
        };
    tpAddAttrStarsub code={
        // *tpH["bag"] +% *tpNode; adds the node as an attribute to a bag reached through a holder and then a subscript.
        runSection2(tpAddAttrStarsub);
        tpH := tpOuter;
        *tpH["bag"] +% *tpNode;
        tpInner := tpOuter["bag"];
        tpRead := tpInner.listLengtH;
        tpTestResult(addAttrStarsub=1);
        };

//  ============ SECTION 4: NOT YET -- THE FORMERLY-CRASHING ROWS ============
//  These four exited 139 until the null-target guard landed. They now run and are
//  SILENT: with a navigated left side the statement never forms an operator
//  expression at all, so the unknown-operator gate never sees a +/ in op position
//  and cannot refuse it. Not a crash any more, not yet loud. Kept last because they
//  are the rows most likely to change shape when the parse is fixed.

    tpAddMemberSub code={
        // adds the node as a member to a bag reached by subscript. This one is not built yet: the token is registered with no road, so it refuses by name.
        tpSeed(tpBag);
        tpOuter["bag"] +/ *tpNode;
        tpInner := tpOuter["bag"];
        tpRead := tpInner.listLengtH;
        tpTestResult(addMemberSub=1);
        };
    tpAddMemberDot code={
        // adds the node as a member to a bag reached by a dot. This one is not built yet: the token is registered with no road, so it refuses by name.
        tpSeed(tpBag);
        tpOuter.bag +/ *tpNode;
        tpInner := tpOuter["bag"];
        tpRead := tpInner.listLengtH;
        tpTestResult(addMemberDot=1);
        };
    tpAddMemberStar code={
        // adds the node as a member through a holder. This one is not built yet: the token is registered with no road, so it refuses by name.
        tpSeed(tpBag);
        tpH := tpBag;
        *tpH +/ *tpNode;
        tpRead := tpBag.listLengtH;
        tpTestResult(addMemberStar=2);
        };
    tpAddMemberStarsub code={
        // adds the node as a member to a bag reached through a holder and then a subscript. This one is not built yet: the token is registered with no road, so it refuses by name.
        tpSeed(tpBag);
        tpH := tpOuter;
        *tpH["bag"] +/ *tpNode;
        tpInner := tpOuter["bag"];
        $$tpInner;
        tpRead := *tpInner.listLengtH;
        $$tpRead;
        tpTestResult(addMemberStarsub=1);
        };

    tpReport code={
        cerr "PRECEDENCE MAP -- rows not yet true, by slug:":;
        tpLen := tpPending.listLengtH;
        if *tpLen;
            iterate tpCur on tpPending;
            while ++tpCur;
                tpVal := *tpCur;
                if *tpVal == 0;     cerr "    PENDING " taG:;
        tpNot = tpRows - tpTrue;
        cerr "PRECEDENCE ROWS NOT YET TRUE = " tpNot " of " tpRows:;
        cerr "PRECEDENCE SENTINEL":;
        };
    ;

tpSeed(tpBag);
tpAssignBare(tpBag);
tpAssignArg(tpBag);
tpAssignSub(tpBag);
tpAssignDot(tpBag);
tpAssignStar(tpBag);
tpAssignStarsub(tpBag);
tpPlusEQBare(tpBag);
tpPlusEQArg(tpBag);
tpPlusEQSub(tpBag);
tpPlusEQDot(tpBag);
tpPlusEQStar(tpBag);
tpPlusEQStarsub(tpBag);
tpPlusPlusBare(tpBag);
tpPlusPlusArg(tpBag);
tpPlusPlusDot(tpBag);
tpMinusMinusBare(tpBag);
tpMinusMinusArg(tpBag);
tpMinusMinusDot(tpBag);
tpAddAttrBare(tpBag);
tpAddAttrArg(tpBag);
tpAddAttrStar(tpBag);
tpZeroBump(tpBag);
tpZeroStep(tpBag);
tpAbsentBump(tpBag);
tpAbsentStep(tpBag);
//section 2
tpPlusPlusSub(tpBag);
tpPlusPlusStar(tpBag);
tpPlusPlusStarsub(tpBag);
tpMinusMinusSub(tpBag);
tpMinusMinusStar(tpBag);
minusMinusStarsub(tpBag);
tpAddAttrSub(tpBag);
tpAddAttrDot(tpBag);
tpAddAttrStarsub(tpBag);
//section 4
tpAddMemberSub(tpBag);
tpAddMemberDot(tpBag);
tpAddMemberStar(tpBag);
tpAddMemberStarsub(tpBag);
tpReport();
stop();

testPrecedence -- HOW KANT READS A CHAINED EXPRESSION, AS A MAP.

This is an example before it is a test. Six ways to name a target crossed with six
operators, thirty-six rows, each printing WANT and GOT and each carrying one sentence
saying what the language does with that spelling. The number at the foot is the count of
rows that are not true YET. It is meant to go down. A row that moves from pending to true
is a stroke landing; the fleet tracks the count and goes red only if it goes UP.

THE SIX TARGET SHAPES are the six ways an expression can name the thing being written:
a bare name, an argument, a subscript, a dot, a star through a holder, and a star through
a holder followed by a subscript. THE SIX OPERATORS are the four value-channel ones
(= += ++ --) and the two membership ones (+% attribute, +/ member).

WHAT THE MAP SAYS TODAY, and the shape of it is the point:

  = and +=      all six shapes true. Assignment and add-into already navigate every way
                a target can be named.

  ++ and --     true on a bare name, on an argument, AND THROUGH A DOT -- but not through
                a subscript or a star. That is not arbitrary: a prefix unary binds to the
                NAME before a subscript and to the RESULT after a dot, so `++bag["kid"]`
                bumps the BAG while `++bag.kid` bumps the member. The two halves have
                different mechanisms and meet at the same operator.

  ⚠ AND THE SUBSCRIPT CASE IS NOT A NO-OP, IT IS A WRITE TO THE WRONG NODE. `++bag["kid"]`
  stamps 1 onto the container, because the bag carries no data and ++ takes its
  "no data, so start at one" arm. `--bag["kid"]` is worse: the bag has a list, so -- takes
  its POP arm and REMOVES A MEMBER. That is why minusMinusSub reads 0 rather than 7.

  ++ and -- through a star   two prefix unaries meet one name and the slot holds one, so
                the second is dropped and the statement does nothing whatever, silently.

  +%            true on a bare name, an argument and a star; not yet on a container
                reached by subscript, dot, or holder-then-subscript.

  +/            not built. The token is registered with no road, so on a bare or argument
                target it refuses BY NAME, which is correct and is the refusal gate doing
                its job. Four rows are DEFERRED rather than run: with a NAVIGATED target a
                methodless operator exits 139 instead of refusing, and a crash is terminal
                for the RUN where a refusal is only terminal for the ACTION -- so running
                them would delete every row below. They are counted as not-yet-true.

THE FILE IS IN FOUR SECTIONS AND THEY ARE THE POINT. Section 1 is what works; a row
leaves it only by breaking. Section 2 is waiting on WORK -- every row there is the same
singular-slot grammar line, and the fold graduates all nine at once. Section 3 is waiting
on a RULING -- +/ has no road yet. Section 4 is the four that used to exit 139 and now run
silently, kept last because they are likeliest to change shape. Graduation is one move
between sections plus the TPWANT drop, in one commit, naming the rows.

WHY ONE ROW PER ACTION. A refusal is terminal for the ACTION and not for the run: a later
action runs and its stores land, measured. So each row is its own action and a refusing
row costs only itself. Each row also marks itself PENDING BEFORE it runs and clears the
mark only on success, so a row that refuses or dies is counted as pending rather than
vanishing -- an absent row would otherwise read as no row at all.

TWO CHANNELS FOR THE COUNT, deliberately. The slug list is walked from the pending
collector; the number is `tpRows - tpTrue`, kept by two counters that never read that
list. If the walk ever goes quiet the number still reports, and if they disagree the file
is lying and should be distrusted rather than believed.
