search reset stack Grokking;
search Generating UnitTests Utilities list;
register(NotifyT);
define
    np=0;
    nSrc=10;
    nNum=1.5;
    nTxt="abc";
    nOther=3;
    nHold;
    hC listenTo:=nSrc code={ np = np + 1; };
    hN listenTo:=nNum code={ np = np + 1; };
    hT listenTo:=nTxt code={ np = np + 1; };
    hG listenTo:=nHold code={ np = np + 1; };
    inActPlus code={ nSrc += 1; };
    rSrc=1;
    rFired=0;
    rL listenTo:=rSrc code={ rFired = rFired + 1; rSrc = rSrc + 8; };
    qSrc=1;
    qFired=0;
    qL listenTo:=qSrc code={ qFired = qFired + 1; qSrc += 8; };
    jSrc=1;
    jFired=0;
    jL listenTo:=jSrc code={ jFired = jFired + 1; };
    jWrite code={ jSrc = 5; jSrc += 2; jSrc -= 1; ++jSrc; };
    ;
np = 0; nSrc = 22;          cerr "NT fires count =" np:;
np = 0; nSrc += 8;          cerr "NT fires count +=" np:;
np = 0; nSrc *= 2;          cerr "NT fires count *=" np:;
np = 0; nSrc /= 2;          cerr "NT fires count /=" np:;
np = 0; ++nSrc;             cerr "NT fires count ++" np:;
np = 0; --nSrc;             cerr "NT fires count --" np:;
np = 0; inActPlus();        cerr "NT fires count += in an action" np:;
np = 0; nNum = 2.5;         cerr "NT fires number =" np:;
np = 0; nNum += 1.0;        cerr "NT fires number +=" np:;
np = 0; nNum *= 2.0;        cerr "NT fires number *=" np:;
np = 0; nTxt = "xyz";       cerr "NT fires text =" np:;
np = 0; nTxt += "q";        cerr "NT fires text +=" np:;
np = 0; nHold := nOther;    cerr "NT fires holder :=" np:;
np = 0; nHold +% nOther;    cerr "NT quiet attach +%" np:;
np = 0; nSrc :. noPrinT;    cerr "NT quiet flag :." np:;
cerr "NT value nSrc" nSrc " nNum" nNum:;
np = 0; nSrc -= 2;          cerr "NT minus count -= fired" np " value" nSrc:;
rSrc = 22;
cerr "NT reentry = : fired" rFired " value" rSrc:;
rSrc = 40;
cerr "NT reentry = again: fired" rFired " value" rSrc:;
qSrc = 22;
cerr "NT reentry += : fired" qFired " value" qSrc:;
testing(jWrite);
