Start();
include(unitTests);
include(utilities);
search reset stack Grokking;
include(styles);
search cOLOr fONTs;
register(ImageT);
define
    imX = 0;
    imY = 0;
    imAt code={
        px = imX;
        py = imY;
        argument :% copyOf(px);
        argument :% copyOf(py);
        pixelAt(argument);
        };
    imBadFit="stretch";
    imBadReq field source fit;
    imAsk code={
        imBadReq.field := argument;
        imSelf := argument;
        imBadReq.source := *imSelf["image"];
        imBadReq.fit = 0;
        displayImage(imBadReq);
        };
    imAskBad code={
        imBadReq.field := argument;
        imSelf := argument;
        imBadReq.source := *imSelf["image"];
        imBadReq.fit := imBadFit;
        displayImage(imBadReq);
        };
    ;
search ImageT FORMs UnitTests Utilities cOLOr fONTs list;
define
    imTop x=0 y=0 width=340 height=120 fill:=white
        imSquare="Bands, described" image="IncantForms/Images/bands.png" x=10 y=10 width=100 height=100;
        imWide="Bands again" image="IncantForms/Images/bands.png" x=120 y=10 width=100 height=25 border;
        imMissing="No such file" image="IncantForms/Images/noSuchFile.png" x=230 y=10 width=100 height=100 fill:=paleGray;
