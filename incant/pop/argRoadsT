Start();
include(utilities);
include(unitTests);
registry(fILEs);
define
    kantGrammar File='incant/kantGrammar';
    ;
include(kantGrammar);
search reset stack KantGrammar Grokking;
search Utilities UnitTests;
registry(ArgRoadsT);
define
    arReq owner source result rule;
    arNew code={
        arSrc := argument.CodE;
        arReq.owner  := argument;
        arReq.source := arSrc;
        arReq.rule   := KantGrammar["STARt"];
        if compileIn(arReq);
            arBlock = arReq.result;
            *arBlock :. noPrinT;
            argument :. isActioN;
            argument +< *arBlock;
        };
    oMinus code={ x = argument - 1; cerr "AR Minus old x=" x:; };
    nMinus code={ x = argument - 1; cerr "AR Minus new x=" x:; };
    oRight code={ x = 1 + argument; cerr "AR Right old x=" x:; };
    nRight code={ x = 1 + argument; cerr "AR Right new x=" x:; };
    oLt code={ if argument < 1; cerr "AR Lt old yes":; else cerr "AR Lt old no":; };
    nLt code={ if argument < 1; cerr "AR Lt new yes":; else cerr "AR Lt new no":; };
    oCopy code={ y = argument; z = y - 1; cerr "AR Copy old z=" z:; };
    nCopy code={ y = argument; z = y - 1; cerr "AR Copy new z=" z:; };
    oDot code={ k := argument.datA; cerr "AR Dot old kind=" k:; };
    nDot code={ k := argument.datA; cerr "AR Dot new kind=" k:; };
    oRec code={ if argument < 1; return "s"; r = oRec(argument - 1); return r; };
    nRec code={ if argument < 1; return "s"; r = nRec(argument - 1); return r; };
    hold;
    arSrc2=6;
    arList
        arM1=1;
        arM2=2;
    oStarPlain code={ x = *argument - 1; cerr "AR StarPlain old x=" x:; };
    nStarPlain code={ x = *argument - 1; cerr "AR StarPlain new x=" x:; };
    oStarHeld code={ x = *argument - 1; cerr "AR StarHeld old x=" x:; };
    nStarHeld code={ x = *argument - 1; cerr "AR StarHeld new x=" x:; };
    oMid code={ h := arSrc2; oStarHeld(h); };
    nMid code={ h := arSrc2; nStarHeld(h); };
    arN;
    oIterBare code={ arN = 0; iterate cur on argument; while ++cur; arN = arN + 1; cerr "AR IterBare old n=" arN:; };
    nIterBare code={ arN = 0; iterate cur on argument; while ++cur; arN = arN + 1; cerr "AR IterBare new n=" arN:; };
    oIterStar code={ arN = 0; iterate cur on *argument; while ++cur; arN = arN + 1; cerr "AR IterStar old n=" arN:; };
    nIterStar code={ arN = 0; iterate cur on *argument; while ++cur; arN = arN + 1; cerr "AR IterStar new n=" arN:; };
    oRet code={ return argument; };
    nRet code={ return argument; };
    arPlainStar code={ p = 5; if *p; cerr "AR PlainStar yes":; else cerr "AR PlainStar null, no refusal":; };
    nOther code={ hz := arSrc2; x = hz - 1; cerr "AR Other new hz=" x:; };
    nStar code={ hz := arSrc2; w = *hz - 1; cerr "AR Star new hz=" w:; };
    ;
search ArgRoadsT;
arNew(nMinus);
arNew(nRight);
arNew(nLt);
arNew(nCopy);
arNew(nDot);
arNew(nRec);
arNew(nOther);
arNew(nStarPlain);
arNew(nStarHeld);
arNew(nMid);
arNew(nIterBare);
arNew(nIterStar);
arNew(nRet);
arNew(nStar);
search ArgRoadsT;
oMinus(0);
nMinus(0);
oMinus(3);
nMinus(3);
oRight(0);
nRight(0);
oRight(3);
nRight(3);
oLt(0);
nLt(0);
oLt(3);
nLt(3);
oCopy(0);
nCopy(0);
oCopy(3);
nCopy(3);
oDot(0);
nDot(0);
oDot(3);
nDot(3);
hold = oRec(0);
cerr "AR Rec old 0=" hold:;
hold = nRec(0);
cerr "AR Rec new 0=" hold:;
hold = oRec(3);
cerr "AR Rec old 3=" hold:;
hold = nRec(3);
cerr "AR Rec new 3=" hold:;
nOther();
oStarPlain(3);
nStarPlain(3);
oMid();
nMid();
oIterBare(arList);
nIterBare(arList);
oIterStar(arList);
nIterStar(arList);
hold = oRet(3);
cerr "AR Ret old=" hold:;
hold = nRet(3);
cerr "AR Ret new=" hold:;
arPlainStar();
nStar();
cerr "AR SENTINEL":;
stop();

 argRoadsT: argument is a binding, and bare argument is the spelling on both roads (Tony, 2026-11-05, R1). docs/argumentRecon.md.
