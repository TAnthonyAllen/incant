    wdForm window x=0 y=0 width=200 height=200 fill:=pageFill
        wdA="A" height=50 fill:=green;
        wdB="B" height=50;
        wdBox describe="own text" height=100;
    wdNoBox window x=0 y=0 width=200 height=100 fill:=pageFill
