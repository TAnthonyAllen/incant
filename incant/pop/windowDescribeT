Start();
windows = 2;
show(firstLight);
search FORMs cOLOr fONTs sTYLEs;
register(dESCRIPTIONs);
define
    wdA="The words about A, from the descriptions registry";
    wdC="The words about C";
    ;
register(FORMs);
