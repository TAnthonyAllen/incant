Start();
include(unitTests);
include(utilities);
search reset stack Grokking;
registry(fILEs);
define
    firstLightFile File='IncantForms/Windows/firstLight';
    ;
include(styles);
search cOLOr fONTs sTYLEs;
include(firstLightFile);
registry(sTYLEs);
define
    lcAccent color:=accent;
    ;
register(LookCopyT);
define
    rgX = 0;
    rgY = 0;
    rgAt code={
        px = rgX;
        py = rgY;
        argument :% copyOf(px);
        argument :% copyOf(py);
        };
    rgRead code={
        rgAt(argument);
        pixelAt(argument);
        };
    rgBig x=300 y=450 width=1200 height=600;
    ;
search LookCopyT FORMs UnitTests Utilities cOLOr fONTs sTYLEs list;
define
    lcNight pageFill:=black headingFont:=courierFont bodyFont:=normalFont textColor:=white accent:=red;
    lcDay pageFill:=white headingFont:=courierFont bodyFont:=normalFont textColor:=black accent:=green;
    lcFormN window x=0 y=0 width=300 height=100 down fill:=pageFill font:=bodyFont color:=textColor
        lcTextN="plain {lcAccent: run run run run} end" text;
    lcFormD window x=0 y=0 width=300 height=100 down fill:=pageFill font:=bodyFont color:=textColor
        lcTextD="plain {lcAccent: run run run run} end" text;
    lcPlain window x=0 y=0 width=300 height=100 down fill:=white font:=normalFont color:=black
        lcTextP="plain {lcAccent: run} end" text;
    lcHeldLooks
        standard pageFill:=white accent:=blue;
    lcHeld window x=0 y=0 width=200 height=100 down fill:=pageFill font:=normalFont color:=black looks:=lcHeldLooks
        lcHeldText="held {lcAccent: run} end" text;
    lcHostLooks
        standard pageFill:=wall accent:=red;
        dark pageFill:=black accent:=green;
    lcHostA window x=0 y=0 width=200 height=200 down fill:=pageFill font:=normalFont color:=white looks:=lcHostLooks
        lcTopA="host {lcAccent: run} end" text height=50%;
        lcInA form:=lcHeld height=50%;
    lcHostB window x=0 y=0 width=200 height=200 down fill:=pageFill font:=normalFont color:=white looks:=lcHostLooks
        lcInB form:=lcHeld height=50%;
        lcTopB="host {lcAccent: run} end" text height=50%;
    rqHostA path="/tmp/incantTest.pdf" form:=lcHostA look="dark";
    rqHostB path="/tmp/incantTest.pdf" form:=lcHostB look="dark";
    rqPlain path="/tmp/incantTest.pdf" form:=lcPlain;
    rqNightPdf path="/tmp/incantTest.pdf" form:=lcFormN look:=lcNight;
    wrReq form:=firstLight;
    wrToBig form:=firstLight frame:=rgBig;
    wrOk form:=firstLight px=490 py=230;
    wrOkBig form:=firstLight px=1190 py=230;
    lcReqN form:=lcFormN look:=lcNight;
    lcReqD form:=lcFormD look:=lcDay;
    lcN1 form:=lcFormN;
    lcN2 form:=lcFormN;
    lcN3 form:=lcFormN;
    lcD1 form:=lcFormD;
    lcD2 form:=lcFormD;
    lcNN first:=lcN1 second:=lcN2;
    lcN13 first:=lcN1 second:=lcN3;
    lcDD first:=lcD1 second:=lcD2;
    lcPara code={
        for grup in argument;
            rpWord = *grup;
            rpInk = "field";
            rpAt := *grup["color"];
            rpHeld = *rpAt.isGrouP;
            if rpHeld == 1;     rpInk = ***rpAt.taG;
            print "SPAN" rpWord rpInk:;
        };
    lcSpans code={
        for grup in tsOut;
            lcPara(*grup);
        };
    lcStamp code={
        lsTop := argument;
        lsAt := *lsTop["laidLook"];
        lsIs = *lsAt.isGrouP;
        lsName = string $*lsAt$;
        if lsIs == 1;   lsName = string $**lsAt.taG$;
        lsTag = string $*lsTop.taG$;
        cout "LC-STAMP" lsTag lsName:;
        };
    lcRun code={
        lcLaid := redrawForm(argument);
        lcSpans();
        lcStamp(*lcLaid);
        };
    ;
cout "LC PAGE night":;
windowOffscreen(lcReqN);
readWindow(lcN1);
rgX = 84; rgY = 10; rgRead(lcN1);
cout "LC PAGE day":;
windowOffscreen(lcReqD);
readWindow(lcD1);
rgX = 84; rgY = 10; rgRead(lcD1);
cout "LC PAGE night again":;
readWindow(lcN2);
rgX = 84; rgY = 10; rgRead(lcN2);
displayDiff(lcNN);
cout "LC PAGE third":;
windowOffscreen(wrReq);
windowClick(wrOk);
readWindow(lcD2);
displayDiff(lcDD);
windowResize(wrToBig);
windowClick(wrOkBig);
readWindow(lcN3);
displayDiff(lcN13);
cout "LC PAGE hostA":;      lcRun(rqHostA);
cout "LC PAGE hostB":;      lcRun(rqHostB);
cout "LC PAGE plain":;      lcRun(rqPlain);
cout "LC PAGE nightPdf":;   lcRun(rqNightPdf);
cout "LC PAGE definition":; printDefinition(lcFormN); printDefinition(lcHostA);
cout "LC PAGE end":;
cerr "LOOKCOPYT SENTINEL":;
stop();
