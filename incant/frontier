Start();
include(unitTests);
include(utilities);
search reset stack Grokking UnitTests Utilities list;
register(Frontier);
define
    frDead=0;
    frRan=0;
    frDeclared=6;
    frOk=0;
    frOk2=0;
    frBanner=0;
    frIncomplete=0;
    frMark=987654;
    frWitness=0;
    frTermsSeen=0;
    frLen=0;
    frLen2=0;
    frRule isRule frEntries=ANYstring+ SemI?- code={
        frWitness = frMark;
        frTermsSeen = 0;
        if frEntries.listLengtH;
            for frSum in frEntries;     frTermsSeen = frTermsSeen + 1;
        };
    frDrive code={
        frRule("alpha beta gamma;");
        };
    frStation1 code={
        fixFrontier1Here = 0;
        frRan = frRan + 1;
        cerr :"ANCHOR frontier station 1 -- generate the parse onto a rule that has an action":;
        frLen = frRule.listLengtH;
        parser(frRule);
        frLen2 = frRule.listLengtH;
        cerr "STATION 1 rule list length was " frLen " now " frLen2:;
        frOk = 0;
        if frLen2 > frLen;      frOk = 1;
        if frOk == 1;   cerr "STATION 1 generate: PASS -- the rule grew, so generation attached something":;
        if frOk == 0;
            cerr "STATION 1 generate: FAIL -- the rule did not grow, so generateParse attached nothing":;
            frDead = 1;
        };
    frStation2 code={
        fixFrontier2Here = 0;
        frRan = frRan + 1;
        cerr :"ANCHOR frontier station 2 -- the parse PARKED in builtinParseR":;
        frOk = 0;
        if frRule["builtinParseR"];      frOk = 1;
        frOk2 = 0;
        if frRule["zzzNotAnAttribute"];  frOk2 = 1;
        cerr "STATION 2 carrier reads " frOk " and the miss control reads " frOk2:;
        if frOk2 == 1;      frOk = 0;
        if frOk == 1;   cerr "STATION 2 park: PASS -- builtinParseR is on the rule and the miss control is dark":;
        if frOk == 0;
            cerr "STATION 2 park: FAIL -- no carrier, or the lookup answers everything":;
            frDead = 1;
        };
    frStation3 code={
        fixFrontier3Here = 0;
        frRan = frRan + 1;
        cerr :"ANCHOR frontier station 3 -- the rule KEPT its own action body, now in builtinActoR":;
        frLen = frRule["builtinActoR"].listLengtH;
        cerr "STATION 3 the builtinActoR carrier carries " frLen " members":;
        frOk = 0;
        if frLen > 0;       frOk = 1;
        if frOk == 1;   cerr "STATION 3 preserve: PASS -- the action body survived generation, in its carrier":;
        if frOk == 0;
            cerr "STATION 3 preserve: FAIL -- the carrier is empty, so the action body was lost":;
            frDead = 1;
        };
    frStation4 code={
        fixFrontier4Here = 0;
        frRan = frRan + 1;
        cerr :"ANCHOR frontier station 4 -- FIRE the rule; the witness is the verdict":;
        frWitness = 0;
        frDrive();
        cerr "STATION 4 witness reads " frWitness " and must equal " frMark:;
        frOk = 0;
        if frWitness == frMark;     frOk = 1;
        if frOk == 1;   cerr "STATION 4 fire: PASS -- the rule's own action ran after generation":;
        if frOk == 0;
            cerr "STATION 4 fire: FAIL -- the action RAN WITHOUT ITS TERMS. It is not consumed; the witness is unset because the match never reaches the body. CT-5":;
            frDead = 1;
        };
    frStation5 code={
        fixFrontier5Here = 0;
        frRan = frRan + 1;
        cerr :"ANCHOR frontier station 5 -- the carrier must be RUNNABLE, not just parked":;
        frLen = frRule["builtinParseR"].listLengtH;
        cerr "STATION 5 the carrier carries " frLen " members; a runnable body needs a BlocK":;
        frOk = 0;
        if frLen > 0;       frOk = 1;
        if frOk == 1;   cerr "STATION 5 compile carrier: PASS -- the carrier has a body to run":;
        if frOk == 0;
            cerr "STATION 5 compile carrier: FAIL -- the carrier is TEXT. Nothing compiles it, so the generated parse cannot run and the terms are never matched":;
            frDead = 1;
        };
    frStation6 code={
        fixFrontier6Here = 0;
        frRan = frRan + 1;
        cerr :"ANCHOR frontier station 6 -- the parse fills the label the body is handed":;
        cerr "STATION 6 the body walked " frTermsSeen " terms; the input carried 3":;
        frOk = 0;
        if frTermsSeen == 3;        frOk = 1;
        if frOk == 1;   cerr "STATION 6 populate: PASS -- for frSum in frEntries ran over matched data":;
        if frOk == 0;
            cerr "STATION 6 populate: FAIL -- the body's argument is an empty label, so its terms are still their own definitions":;
            frDead = 1;
        };
    frRun code={
        cerr "=== incant/frontier -- the campaign live edge, six stations, CARRIER ROAD ===":;
        frStation1();
        if frDead == 0;     frStation2();
        if frDead == 0;     frStation3();
        if frDead == 0;     frStation4();
        if frDead == 0;     frStation5();
        if frDead == 0;     frStation6();
        cerr "FRONTIER ran-census: stations that RAN " frRan " of " frDeclared " declared":;
        frOk = 0;
        if frRan == frDeclared;     frOk = 1;
        frBanner = 0;
        if frDead == 0;             frBanner = 1;
        if frOk == 0;               frBanner = 0;
        frIncomplete = 0;
        if frOk == 0;               frIncomplete = 1;
        if frDead == 1;             frIncomplete = 0;
        if frDead == 1;     cerr "=== FRONTIER: STOPPED -- a station returned a NO verdict above. ===":;
        if frIncomplete == 1;   cerr "=== FRONTIER: INCOMPLETE -- a station never RAN. No success is claimed; see the census. ===":;
        if frBanner == 1;   cerr "=== FRONTIER: all six stations RAN and PASSED. ===":;
        cerr "FRONTIER SENTINEL -- the ladder reached its foot":;
        stop();
        };
    ;

frRun();

WHAT THIS FILE IS

incant/frontier is the campaign's live edge, executable. It walks the pipeline one
station at a time and dies at the first thing that does not work yet. That death
is the point: the station that fails is where the campaign currently is.

IT IS ONE FILE, REVISED IN PLACE AT EVERY SEAL, AND NEVER FORKED. There is no
frontier2, no frontierOld. If you are looking at a copy, someone broke the
practice. Each seal re-runs it and names the first failing station.

IT IS NOT A FLEET CITIZEN. It never joins pop.sh -- the fleet measures what holds
and this measures what does not yet. A RED FRONTIER IS THE NORMAL, CORRECT STATE.
It is not a fixit citizen either and never appears in fixitNag's count.

FRONTIER AS OF 2026-09-18: THE CARRIER ROAD. REVISED IN PLACE FROM THE TWIN ROAD.

The nine-station twin ladder that stood here until today measured generate,
store, activate-on-a-twin, compile, harvest, bind, discard, fire. That road is
retired. It was proven on Braced on 2026-08-22, all nine stations green, and the
campaign moved off it: the live road hangs the body on the rule itself, and since
2026-09-18 a rule that already carries an action gets its generated parse parked
in a noPrint builtinParseR attribute instead. The old ladder was still dying at
its own station 5 -- "compile the twin" -- which is a question nobody is asking
any more. An instrument pointing at a retired question reads as a frontier and is
not one. The superseded readings are in docs/frontierHistory.md, unchanged.

THE SUBJECT IS A RULE THIS FILE OWNS, not a grammar rule, and that is new:
frRule is isRule, carries members AND a code body, and lives in the Frontier
registry. It could not have been the subject before 2026-09-18, because parser
resolved its root out of Grokking; it now takes the rule bare, so registry
membership stopped mattering. The rule is `list`'s shape, which is the spec.

WHERE IT DIES TODAY: STATION 5. The carrier is TEXT -- builtinParseR holds the
generated parse as a string and carries no BlocK, so nothing compiles it and
nothing can run it. That is why station 6 reads an empty label: the body cannot
see what was parsed because NOTHING MATCHED ANYTHING. Filling the label is not a
repair to a walk that nearly works; the walk does not exist yet.

THE THREE RULINGS STATION 5 AND 6 WAIT ON are in docs/fixIts.md F-83: does the
carrier get compiled, who runs both bodies and in which order, and which label do
the terms attach into.

WHY EVERY STATION PRINTS EVEN WHEN IT PASSES

Rule H4. A station that only speaks on failure passes the day somebody deletes
the code that would have spoken. So each prints PASS or FAIL with the value it
read, and an empty read is an answer rather than a silence. The first FAIL sets
frDead and every later station is skipped without printing, so the failing line
is the last verdict on screen and nothing buries it.

STATION 2 CARRIES A MISS CONTROL AND IT IS NOT DECORATION. `if frRule["x"];` is
an existence test, and a lookup that answered everything would make the carrier
row pass without a carrier. The control asks the same question of a name that
does not exist and must read 0.

TWO READING TRAPS THIS FILE WALKED INTO WHILE BEING WRITTEN, both on one line:

1. `frCodE <- frRule["CodE"]; frLen = frCodE.listLengtH;` reads ZERO. `<-` MINTS
   a node, so the read is of the holder and not of what was found -- bear-trap
   #35's other half. The chained form `frRule["CodE"].listLengtH` reads 9, which
   is correct. Do not "tidy" the chained reads into rebinds.
2. Every station reads a flag and tests it twice rather than using if/else, per
   the frozen bear-trap #32 shape. That is carried forward deliberately.

HOW TO USE IT IN XCODE

Every station opens with a uniquely-named inert anchor -- fixFrontier1Here
through fixFrontier6Here -- and a cerr naming the station. Set a name-conditioned
breakpoint on any anchor and you land exactly there with everything the previous
stations built still in scope, ready to step.
