define dumpRulePlans immediateAction=dumpRulePlans; ;

/*  CENSUS FIXTURE (Clay SEQ 26). 27 rules — the JSON family, the two ladder
    scaffolds, and a spread of the REAL bootstrap grammar. The ladder targets
    cannot test the classifier (Scaf/ScafA/ScafB reach two kinds of five and
    never carry an unmaterialised term), so this is the classifier's own POP.
    Every term must come back with the same plan node or the same refusal.
    Diff against genLadder/census.target.  */
register(Ladder);
define
    Scaf  isRule "x"-;
    Scaf2 isRule "{"- "}"-;
    ScafA isRule "a"-;
    ScafB isRule ScafA "b"-;
    ;
search reset stack Grokking Ladder UnitTests Utilities list;

/*  A real parse first: rStuff is materialised lazily, so the census must be
    taken against a tree that has actually run, not a freshly-defined one.  */
define
    testJSON argument code={
        clear(listed);
        field = JSONblock(argument);
        };
    ;
testJSON('{"a":"b"}');

