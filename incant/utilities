    /***************************************************************************
        flatten converts the hierarchy of its argument into a list in whatsIt.
        Just a test action for now.
    ***************************************************************************/
    flatten code={
        for grup in argument; members
            if grup.hasMembers; flatten(*grup);
            else
                print "Adding" grup.tag:;
                whatsIt += grup;
        };
    /***************************************************************************
        drawWalk -- forms step 2: draw a form, parent before child, depth first.
        The top field opens the display (makeDisplay hands it down as each
        descendant's display property, step 1), then every field that names a
        fill, or a style for displayFill to resolve, fills into it at page
        coordinates. A field naming neither is skipped, not refused. After its
        fill, a field naming border or a side (topBorder, bottomBorder,
        leftBorder, rightBorder) draws it through displayBorder (forms step 3).
        A top that already holds a context (openPDF's, or a bitmap the caller
        opened) is drawn into as it stands: drawWalk opens no bitmap of its own
        (forms step 4). The capture is `=`, not `:=`: a := capture is a holder,
        and `dwOpen == 0` then reads false on a 0 (measured 2026-11-08; #55's
        family). isPointeR always writes 0 or 1, so `=` carries it.
        drawKids descends where *grup.hasMemberS: grup is the loop's holder, so
        the star is needed (grup.hasMemberS reads nothing; measured 2026-11-08,
        bar 1, every leaf 0).
    ***************************************************************************/
    drawWalk code={
        dwOpen = argument.isPointeR;
        if dwOpen == 0;     makeDisplay(argument);
        drawFill(argument);
        drawImage(argument);
        drawBorder(argument);
        drawText(argument);
        drawKids(argument);
        };
    /***************************************************************************
        drawText -- forms step 5 (Tony, 2026-11-09, SEQ 582). Resolves a field's
        font, color, align (step 5a, SEQ 584), valign (step 5b, SEQ 605) and italic (SEQ 624) in kant and hands displayText one request, textReq,
        written afresh on every call. Each of font and color comes from the
        field's own attribute, else its style's (style:= names the style field),
        else the enclosing field's, walking up to the top (the field holding the
        display). Nothing found leaves the slot at 0: displayText then draws
        Helvetica 12 in black, left-aligned. The text is the field's own string, or, when the
        field holds a group, that group's (*argument, one level). A field with
        no text costs a call and draws nothing (displayText skips it).
    ***************************************************************************/
    /***************************************************************************
        describe is used to supply descriptions in forms by adding it as a form
        attribute with a text value of the field being described. The describe
        text is initialized as either the tag of a field in the form that has
        a corresponding entry with the same tag in the dESCRIPTIONs registry, or
        as whatever descriptive text the form designer wants to show when the
        form first fires. describe is a dynamic attribute with an action
        When a form field is clicked on selection.group is set to the first selectable
        field found after searching up the parent hierarchy starting with the
        field clicked on. And if the selected field has a describe attribute the
        describe action sets the describe.text for the form layout to display.
        
        Moved here from tester (SEQ 608 R6) so a form can find it: forms include utilities.
        drawText does not call it yet -- it shows a field's describe attribute as written (R2);
        no listener or selection is built.

        See the tabs or descriptions forms in IncantForms/Windows for an example
        of how to define a form that uses descriptions.
    ***************************************************************************/
    describe code={
        if selection.isGrouP;   describe = dESCRIPTIONs[*selection.taG];
        or describe.isGrouP;    describe = dESCRIPTIONs[describe];
        };
    textReq field source font color align valign italic;
    drawText code={
        textReq.field := argument;
        dtG = argument.isGrouP;
        if dtG == 1;    textReq.source := *argument;
        else            textReq.source := argument;
        // describeShown a field with a describe attribute shows that attribute's text (SEQ 608 R2)
        dtSelf := argument;
        if *dtSelf["describe"];     textReq.source := *dtSelf["describe"];
        // imageText an image field's text is its description, never drawn over the image (SEQ 608 R2)
        dtDraw = 1;
        if *dtSelf["image"];        dtDraw = 0;
        textReq.font = 0;
        textReq.color = 0;
        textReq.align = 0;
        textReq.valign = 0;
        textReq.italic = 0;
        dtItalic = 0;
        dtFont = 0;
        dtColor = 0;
        dtAlign = 0;
        dtValign = 0;
        dtCur := argument;
        dtHops = 0;
        while dtHops < 32;
            if dtFont == 0;
                if *dtCur["font"];
                    textReq.font := *dtCur["font"];
                    dtFont = 1;
            if dtColor == 0;
                if *dtCur["color"];
                    textReq.color := *dtCur["color"];
                    dtColor = 1;
            if dtAlign == 0;
                if *dtCur["align"];
                    textReq.align := *dtCur["align"];
                    dtAlign = 1;
            if dtValign == 0;
                if *dtCur["valign"];
                    textReq.valign := *dtCur["valign"];
                    dtValign = 1;
            // italicInherits a text property (SEQ 624): the nearest field naming italic decides, its own attribute before its style's
            if dtItalic == 0;
                if *dtCur["italic"];
                    textReq.italic := *dtCur["italic"];
                    dtItalic = 1;
            if *dtCur["style"];
                dtStyle := *dtCur["style"];
                if dtItalic == 0;
                    if **dtStyle["italic"];
                        textReq.italic := **dtStyle["italic"];
                        dtItalic = 1;
                if dtFont == 0;
                    if **dtStyle["font"];
                        textReq.font := **dtStyle["font"];
                        dtFont = 1;
                if dtColor == 0;
                    if **dtStyle["color"];
                        textReq.color := **dtStyle["color"];
                        dtColor = 1;
                if dtAlign == 0;
                    if **dtStyle["align"];
                        textReq.align := **dtStyle["align"];
                        dtAlign = 1;
                if dtValign == 0;
                    if **dtStyle["valign"];
                        textReq.valign := **dtStyle["valign"];
                        dtValign = 1;
            dtTop = *dtCur.isPointeR;
            if dtTop == 1;      dtHops = 32;
            if dtFont == 1;
                if dtColor == 1;
                    if dtAlign == 1;
                        if dtValign == 1;
                            if dtItalic == 1;   dtHops = 32;
            // climbUp the walk goes on to the enclosing field (style is scoped to the subtree, 2026-11-03)
            dtCur := *dtCur.parenT;
            dtHops += 1;
        if dtDraw == 1;     displayText(textReq);
        };
    /***************************************************************************
        drawImage -- forms step 8 (Tony, 2026-11-10, SEQ 609). A field with an
        image attribute hands displayImage one request, imageReq, written afresh
        on every call: the field, and the image attribute as the source (its
        text is the file's path). fit stays 0, which the floor reads as fill:
        no attribute names a fit yet. Drawn after the fill and before the
        border, so the border sits on the image.
    ***************************************************************************/
    imageReq field source fit;
    drawImage code={
        diSelf := argument;
        if *diSelf["image"];
            imageReq.field := argument;
            imageReq.source := *diSelf["image"];
            imageReq.fit = 0;
            displayImage(imageReq);
        };
    drawFill code={
        if argument["fill"];    displayFill(argument);
        or argument["style"];   displayFill(argument);
        };
    drawBorder code={
        if argument["border"];          displayBorder(argument);
        or argument["topBorder"];       displayBorder(argument);
        or argument["bottomBorder"];    displayBorder(argument);
        or argument["leftBorder"];      displayBorder(argument);
        or argument["rightBorder"];     displayBorder(argument);
        };
    drawKids code={
        for grup in argument; members
            drawFill(*grup);
            drawImage(*grup);
            drawBorder(*grup);
            drawText(*grup);
            if *grup.hasMemberS;    drawKids(*grup);
        };
    listed;
    /***************************************************************************
        listRules — print a field and its components as tag=value. Note the use
        of listed, which is explicitly not a local field used to control
        recursing and hold off a mad recursing loop
    ***************************************************************************/
    listRules code={
        listed  += argument;
        length  = listLengtH;
        if datA != 0;   print ~$taG "=" argument;
        else            print ~$taG;
        if length > 0;
            print _length:;
            iterate grup on argument;
            while ++grup;
                length  = listLengtH;
                if noPrinT; continue;
                print +;
                if !length || grup IN listed;
                    if datA != 0;   print ~$taG "=" grup:;
                    else            print ~$taG:;
                else
                    listRules(*grup);
                print $-;
        else    print :;
        };
    /***************************************************************************
        print out xml representation of the group passed in. Does not
        handle cdata yet.
    ***************************************************************************/
    toXML code={
        print ~,"<" tag;
        if datA; print ,"=" argument;
        if hasAttributes;
            for grup in argument; attributes
                print _grup.tag;
                if grup.datA print ,"=" grup;
        if hasMembers;
            print ">",:+;
            for grup in argument; members
                ++recurse;
                toXML(*grup);
                --recurse;
                if grup.next    print :;
        else    print "/>";
        if hasMembers;      print ,-"</" tag ">";
        if recurse == 0     print :;
        };
    /***************************************************************************
        fillDownAcross deals with direction framing. The direction can be either
        down or across. When the direction passed in has a value. The value can
        be "*" or a number. The argument passed in has to contain the direction
        attribute (that is down or across respectively).
        
        If the direction value is "*", the argument passed in can have only one
        member (the member may have members); also the member should have its
        target (width or height) specified. If direction value is a number
        (like down=3) the argument can have more than one member, but all members
        should have no target specified. Also, the argument passed in should
        have no data (you can add data after setFrame finishes).
    ***************************************************************************/
    tARGET;
    dIRECTion;
    newStuff isList;
    fillDownAcross code={
        pValue = argument[tARGET];
        direct = argument[dIRECTion];
        memberCount=0;
        for grup in argument; members
            ++memberCount;
            target = *grup[tARGET];
            if target.isPercenT;    target = argument[tARGET] * target / 100;
            if target.datA != 0;    pValue -= target;
        if direct == "*";
            if memberCount > 1; print taG "can only have one member when" $dIRECTion "=*":;
            valueCount = 0;
            valueCount = pValue / target;
            if valueCount * target > pValue;    --valueCount;
        else
            if direct > 0;
                valueCount = direct - 1;
        clear(newStuff);
        for grup in argument; attributes
            newStuff +% *grup;
        for grup in argument; members
            newStuff +/ copyOf(*grup);
        while valueCount > 0;
            --valueCount;
            for grup in argument; members
                newStuff +/ copyOf(*grup);
        clear(argument);
        argument = newStuff;
        };
    /***************************************************************************
        Both directions on one field (Clay's design, Tony 2026-11-06). The number
        goes outside: a new cell holds the members and carries the *, and
        setFrame's recursion does the rest. Both * or both numbers: parked.
    ***************************************************************************/
    bothStuff isList;
    bothDirections code={
        =:argument across down;
        inner = "none";
        if down == "*";
            if across != "*";   inner = "down";
        if across == "*";
            if down != "*";     inner = "across";
        if inner == "none";
            print taG "needs one * and one number to use both down and across":;
            return;
        cellHold := new("dirCell");
        innerAttr := argument[inner];
        *cellHold :% copyOf(*innerAttr);
        for grup in argument; members
            *cellHold +/ copyOf(*grup);
        clear(bothStuff);
        for grup in argument; attributes
            if *grup.taG != inner;
                bothStuff +% *grup;
        bothStuff +/ *cellHold;
        clear(argument);
        argument = bothStuff;
        };
    /***************************************************************************
         frameMembers sets frames for the members of the group passed in. It must
         have x y width and height attributes. It WRITES the group it is handed,
         so only setFrame calls it, and only on a copy.

         Should modify to check for noRoom and bail if there aint none
    ***************************************************************************/
    frameMembers code={
        =:argument across down width height x y;
        if across.datA != 0;
            if down.datA != 0;
                bothDirections(argument);
                =:argument across down;
        sideRoom    = width;
        pWidth      = width;
        headRoom    = height;
        pHeight     = height;
        pX          = x;
        pY          = y;
        upOut       = 0;
        sideOut     = 0;
        if down.datA != 0;
            tARGET="height";
            dIRECTion="down";
            fillDownAcross(argument);
        if across.datA != 0;
            tARGET="width";
            dIRECTion="across";
            fillDownAcross(argument);
   /***************************************************************************
                 Create frame and set width and height
    ***************************************************************************/
        for grup in argument; members
            =:grup width height;
            if width.isPercenT;
                width = pWidth * width / 100;
                *grup :% copyOf(width);
            if height.isPercenT;
                height = pHeight * height / 100;
                *grup :% copyOf(height);
            if width.datA != 0;
                sideRoom    -= width;
            or across.datA == 0;
                width = pWidth;
                *grup :% copyOf(width);
            else
                sideOut     +/ *grup;
                ++sideOut;
            if height.datA != 0;
                headRoom    -= height;
            or across.datA != 0;
                height = pHeight;
                *grup :% copyOf(height);
            else
                upOut       +/ *grup;
                ++upOut;
        if upOut > 0;
            shareN = 0;
            shareUsed = 0;
            shareEdge = 0;
            for grup in upOut;
                ++shareN;
                shareEdge = headRoom * shareN / upOut;
                height = shareEdge - shareUsed;
                shareUsed = shareEdge;
                *grup :% copyOf(height);
        if sideOut > 0;
            shareN = 0;
            shareUsed = 0;
            shareEdge = 0;
            for grup in sideOut;
                ++shareN;
                shareEdge = sideRoom * shareN / sideOut;
                width = shareEdge - shareUsed;
                shareUsed = shareEdge;
                *grup :% copyOf(width);
        headRoom    = 0;
        sideRoom    = 0;
    /***************************************************************************
             Set x and y in frame
    ***************************************************************************/
        for grup in argument; members
            =:grup width height x y;
            y = pY;
            *grup :% copyOf(y);
            x = pX;
            *grup :% copyOf(x);
            if across.datA == 0;    pY += height;
            else                    pX += width;
        for grup in argument; members
            if *grup.hasMemberS;
                frameMembers(*grup);
        };
    /***************************************************************************
        setFrame -- forms step 6, stroke 1 (Tony, 2026-11-07 design; SEQ 626).
        ONE argument, a request holding form:= the form. setFrame copies the
        form, lays out the copy and returns it. The form's definition is never
        written, so a declared percent, a down=3 and the member set are all
        still there for the next run, and every run is a fresh run. The caller
        holds the returned copy (laid := setFrame(req)) and draws that; no
        laid-out result is saved anywhere. A request with no form refuses by
        name and returns nothing.
    ***************************************************************************/
    setFrame code={
        sfReq := argument;
        sfHas = 0;
        if *sfReq["form"];      sfHas = 1;
        if sfHas == 0;
            cerr "setFrame: REFUSING" argument.taG "-- its request holds no form; write form:=theForm":;
            return;
        sfForm := *sfReq["form"];
        sfLaid := copyOf(**sfForm);
        frameMembers(*sfLaid);
        return *sfLaid;
        };
    // quoteIfNeeded obituary: never called; set arm exercised by inArmsT, 2026-09-08
    /***************************************************************************
        Convert the hex string in the target passed in to a floating point number
    ***************************************************************************/
    hexToNumber target code={
        while target;
            numDBL  = target.numbeR;
            if numDBL <= 57;    numDBL -= 48;
            or numDBL <= 70;    numDBL -= 55;
            or numDBL <= 102;   numDBL -= 87;
            ++target;
            if num; num *= 16;
            num += numDBL;
        target  = num;
        return target; };
    /***************************************************************************
        Extract the red, green, and blue components of a color group passed
        in as a six character hex string
    ***************************************************************************/
    setHexColor hex code={
        RGBred  = hex - 4;
        hex     +% hexToNumber(RGBred);
        RGBgreen    = hex + 2;
        RGBgreen    -= 2;       // to chop off the blue component
        hex     +% hexToNumber(RGBgreen);
        RGBblue = hex + 4;
        hex     +% hexToNumber(RGBblue);
        dumpContents(hex); };
    /***************************************************************************
        bigifyLayout — build a rows x columns grid of cells as members of the
        bigify block passed in. Templates (regularItem) ride in as fields of the
        block and are scoped out. Each cell merges the template's attributes in
        (two-sided merge: cell opts in via :. mergeON) and is stamped with its
        row, col, and reading-order seq. setFrame paints the result.
        v1: all-regular grid (no big band yet); percent/orientation in v2.
    ***************************************************************************/
    bigifyLayout code={
        print "bigifyLayout building grid for" taG:;
        :argument rows columns bigRows bigColumns regularItem bigItem selRow selCol;
    /***************************************************************************
        Clamp the big-slot origin so the bigRows x bigColumns rectangle fits.
    ***************************************************************************/
        maxRow = rows - bigRows;
        maxCol = columns - bigColumns;
        bOR = selRow;
        if bOR < 0;        bOR = 0;
        if bOR > maxRow;   bOR = maxRow;
        bOC = selCol;
        if bOC < 0;        bOC = 0;
        if bOC > maxCol;   bOC = maxCol;
        rowPct = 100 / rows;
        colPct = 100 / columns;
        bigRowSpan = 100 * bigRows;
        bigHpct = bigRowSpan / rows;
        bigColSpan = 100 * bigColumns;
        bigWpct = bigColSpan / columns;
    /***************************************************************************
        Build bands top to bottom. A row inside [bOR, bOR+bigRows) becomes the
        big band; every other row is a full-width regular row.
    ***************************************************************************/
        r = 0;
        while r < rows;
            if r == bOR;
            /***************************************************************
                The big band, bigRows tall: left-strip columns, the enlarged
                cell, then right-strip columns, left to right.
            ***************************************************************/
                bandName = string $"band" r;
                band := argument :+ new(bandName);
                across = 1;
                band +% across;
                height = bigHpct;
                height :. isPercenT;
                band +% copyOf(height);
                c = 0;
                while c < columns;
                    if c == bOC;
                        bigName = string "big" r;
                        big := band :+ new(bigName);
                        big :. mergeON;
                        big +% bigItem;
                        width = bigWpct;
                        width :. isPercenT;
                        big +% copyOf(width);
                        row = bOR;
                        big +% copyOf(row);
                        col = bOC;
                        big +% copyOf(col);
                        c += bigColumns;
                    else
                        colName = string "strip" c;
                        column := band :+ new(colName);
                        width = colPct;
                        width :. isPercenT;
                        column +% copyOf(width);
                        rr = 0;
                        while rr < bigRows;
                            cellRow = bOR + rr;
                            cellName = string "c" cellRow "x" c;
                            cell := column :+ new(cellName);
                            cell :. mergeON;
                            cell +% regularItem;
                            row = cellRow;
                            cell +% copyOf(row);
                            col = c;
                            cell +% copyOf(col);
                            rr += 1;
                        c += 1;
                r += bigRows;
            else
            /***************************************************************
                A full-width regular row.
            ***************************************************************/
                rowName = string "row" r;
                rowBlock := argument :+ new(rowName);
                across = 1;
                rowBlock +% across;
                height = rowPct;
                height :. isPercenT;
                rowBlock +% copyOf(height);
                c = 0;
                while c < columns;
                    cellName = string "c" r "x" c$;
                    cell := rowBlock :+ new(cellName);
                    cell :. mergeON;
                    cell +% regularItem;
                    width = colPct;
                    width :. isPercenT;
                    cell +% copyOf(width);
                    row = r;
                    cell +% copyOf(row);
                    col = c;
                    cell +% copyOf(col);
                    c += 1;
                r += 1;
        };
    ;

