register(Utilities);
define
    /***************************************************************************
        tell -- the one door into a field's grammar: tell("thermo set 5").
        The first word names the target field, the rest of the line is the
        message. aCTionTell (GroupActions.rtn) drives the target with the
        input floor and returns a verdict: matched, consumed, length,
        stoppedAt, known, and reply (a copy of the parked label). Read it
        inside an action as  v := tell("..."); vc := *v["consumed"];
    ***************************************************************************/
    tell isRule target=[a-zA-Z0-9]+ message?=[^\n]+ ruleMethod=aCTionTell;
    /***************************************************************************
        dumpField — print a field as tag=value, then an indented list of the
        child tags (or a no-list note). Incant-side cousin of dumpContents.
    ***************************************************************************/
    dumpField code={
        if datA != 0;   print $taG "=" argument:;
        else            print $taG:;
        if argument.listLengtH;
            for grup in argument;
                if datA != 0;   print `$taG "=" grup:;
                else            print `$taG:;
        else print ``"(no list)":;
        };
    /***************************************************************************
        JSON rules invoked as JSONblock("json string or json file name"); These
        rules are work in process.
        
        Note: true and false are added as rule options to JSONtoken as
        quoted literals so they get picked up instead of the true=1 and false=0
        fields in the pROPERTIEs base registry (which are probably fine for
        incant purposes but look strange on print out since they print as
        numbers 1 and 0 and not the names true and false.

        FORWARD DECLARATIONS (2026-08-02). JSONtoken and JSONvalue reference
        JSONblock and JSONarray, which are defined BELOW them -- and a reference
        term resolves by sharing the definer's child list, so a name that does
        not exist yet mints an empty stub that never becomes a reference.
        Naming them first, then fleshing them out below, is the trodden path.
    ***************************************************************************/
    JSONblock isRule;
    JSONarray isRule;

    JSONtoken isRule
        JSONblock;
        "false";
        "true";
        GrouP;
        NumbeR;
    JSONvalue isRule
        JSONblock;
        JSONarray;
        JSONtoken;
    JSONfield isRule JSONtoken ":"- JSONvalue ","?- code={
        jfOut := new(*JSONtoken);
        *jfOut = *JSONvalue;
        return *jfOut;
        };
    JSONitem isRule JSONtoken@ ","?-;
    JSONlist isRule JSONitem+;
    JSONarray isRule "["- JSONlist? "]"- code={
        jaOut := new("JSONarray");
        if JSONlist;
            for grup in JSONlist;
                *jaOut +% copyOf(*grup);
        return *jaOut;
        };
    JSONblock isRule fail "{"- JSONfield* "}"-;
    /***************************************************************************
        flatten converts the hierarchy of its argument into a list in whatsIt.
        Just a test action for now.
    ***************************************************************************/
    flatten code={
        for grup in argument; members
            if grup.hasMembers; flatten(*grup);
            else
                print "Adding" grup.tag:;
                whatsIt += grup;
        };
    /***************************************************************************
        drawWalk -- forms step 2: draw a form, parent before child, depth first.
        The top field opens the display (makeDisplay hands it down as each
        descendant's display property, step 1), then every field that names a
        fill, or a style for displayFill to resolve, fills into it at page
        coordinates. A field naming neither is skipped, not refused. After its
        fill, a field naming border or a side (topBorder, bottomBorder,
        leftBorder, rightBorder) draws it through displayBorder (forms step 3).
        A top that already holds a context (openPDF's, or a bitmap the caller
        opened) is drawn into as it stands: drawWalk opens no bitmap of its own
        (forms step 4). The capture is `=`, not `:=`: a := capture is a holder,
        and `dwOpen == 0` then reads false on a 0 (measured 2026-11-08; #55's
        family). isPointeR always writes 0 or 1, so `=` carries it.
        drawKids descends where *grup.hasMemberS: grup is the loop's holder, so
        the star is needed (grup.hasMemberS reads nothing; measured 2026-11-08,
        bar 1, every leaf 0).
    ***************************************************************************/
    drawWalk code={
        dwOpen = argument.isPointeR;
        if dwOpen == 0;     makeDisplay(argument);
        drawFill(argument);
        drawImage(argument);
        drawBorder(argument);
        drawText(argument);
        drawKids(argument);
        };
    /***************************************************************************
        describe is used to supply descriptions in forms by adding it as a form
        attribute with a text value of the field being described. The describe
        text is initialized as either the tag of a field in the form that has
        a corresponding entry with the same tag in the dESCRIPTIONs registry, or
        as whatever descriptive text the form designer wants to show when the
        form first fires. describe is a dynamic attribute with an action
        When a form field is clicked on selection.group is set to the first selectable
        field found after searching up the parent hierarchy starting with the
        field clicked on. And if the selected field has a describe attribute the
        describe action sets the describe.text for the form layout to display.

        See the tabs or descriptions forms in IncantForms/Windows for an example
        of how to define a form that uses descriptions.
    ***************************************************************************/
    describe code={
        if selection.isGrouP;   describe = dESCRIPTIONs[*selection.taG];
        or describe.isGrouP;    describe = dESCRIPTIONs[describe];
        };
    textReq field source font color align valign italic spans runs;
    /***************************************************************************
        typeset -- typesetting T1 (2026-11-12; Clay's pre-pass design, Tony's go).
        The kant pre-pass: it takes a field's text apart into paragraphs and
        spans and resolves each span's style, and the floor (drawSpans) only
        measures, breaks lines and paints. argument is the field whose own
        string is the text; the result is tsOut, a list of para groups, each a
        list of spans, and tsRunCount, the runs opened.
        The text is read by a small grammar, tsText. A tsUnit is one piece (a
        word, {{, an opening {style:, a lone brace, a closing brace) and the
        white space after it, one tsSp a space and one tsLine a line end; two
        line ends or more end the paragraph and every open run with it.
        A span is a copy of tsSpan: its own string is the piece; font, color
        and italic hold what the open runs' styles give, outermost first, or 0
        for the field's own; space is 1 when white space follows the span (a
        run of it is one gap), or holds a style's space, a width in points.
        A gap after a closing mark belongs to the span before the mark; a gap
        after an opening mark is dropped. A closing brace with no run open is
        text. A style name sTYLEs does not hold warns by name and the run
        prints plain.
        T3 (2026-11-13): {name} inserts the text of the form's field of that
        name (the top field or any field under it, first found). The text is
        split at white space, one span a word, each in the style of the runs
        open at the insert; nothing inside it is read as a mark. A name no
        field has warns by name and is left as written. tsFind is the search.
        {registry.name} (Tony, 2026-11-13) inserts that registry's entry and
        looks nowhere else; {name} looks in the form and nowhere else. A
        registry or an entry that is not there warns by name, left as written.
        PASSAGES (IBkant gap 1, Tony 2026-11-13): an insert's text is read as
        text, by the same grammar (tsInner). Its blank lines split paragraphs
        and its marks open and close runs, starting from the runs open at the
        insert. A run it opens ends with it; its closing brace never closes a
        run of the text that holds it. An insert inside inserted text warns by
        name and is left as written. This replaces T3's "nothing inside it is
        read as a mark".
    ***************************************************************************/
    tsSp isRule sp^-=[\t\r ];
    tsNl isRule nl^-=[\n];
    tsLine isRule tsNl^ tsSp^*;
    tsWord isRule word^=[^\t\n\r{} ]+;
    tsLit isRule lit^="{" more^-="{";
    tsOpen isRule open^="{" style^=[a-zA-Z0-9]+ colon^=":";
    tsQual isRule qins^="{" reg^=[a-zA-Z0-9]+ dot^="." name^=[a-zA-Z0-9]+ end^="}";
    tsIns isRule ins^="{" name^=[a-zA-Z0-9]+ end^="}";
    tsBrace isRule brace^="{";
    tsClose isRule close^="}";
    tsPiece isRule
        tsWord^;
        tsLit^;
        tsOpen^;
        tsQual^;
        tsIns^;
        tsBrace^;
        tsClose^;
    tsUnit isRule tsPiece^ tsSp^* tsLine^*;
    tsText isRule tsUnit+;
    tsInner isRule tsUnit+;
    tsWant;
    tsFound;
    tsHit;
    tsFind code={
        for grup in argument; members
            if tsHit == 0;
                tfTag := *grup.taG;
                if *tfTag == *tsWant;
                    tsFound := *grup;
                    tsHit = 1;
            if tsHit == 0;
                if *grup.hasMemberS;    tsFind(*grup);
        };
    tsRun style depth;
    tsBoxNames fill border topBorder bottomBorder leftBorder rightBorder strokeColor rounded shadow opacity;
    tsRunName;
    // boxWarn its own action because a for loop walks an argument's attributes and not a starred holder's (measured, SEQ 655)
    tsBoxWarn code={
        for grup in argument; attributes
            bwTag := *grup.taG;
            bwHit = 0;
            if tsBoxNames[*bwTag];      bwHit = 1;
            if bwHit == 1;
                bwField := *tsWho.taG;
                cerr "drawSpans: WARNING" bwField "-- its text names the style" tsRunName "which holds the box attribute" bwTag "-- a run takes font, color, italic and space only":;
        };
    tsRuns;
    tsSpan space font color italic;
    tsOut;
    tsRunCount;
    tsWho;
    typeset code={
        tyTree := tsText(argument);
        clear(tsOut);
        clear(tsRuns);
        tsRunCount = 0;
        tyOpen = 0;
        tyHave = 0;
        tyInside = 0;
        tyFloor = 0;
        tyUnit := *tyTree.firsT;
        while tyUnit.datA != 0;
            tyPiece := *tyUnit.firsT;
            tyLeaf := *tyPiece.firsT;
            tyKind := *tyLeaf.taG;
            tyGaps = 0;
            tyLines = 0;
            tyG := *tyPiece.nexT;
            while tyG.datA != 0;
                tyGaps = tyGaps + 1;
                if *tyG.taG == "tsLine";    tyLines = tyLines + 1;
                tyG := *tyG.nexT;
            tyIsSpan = 1;
            tyMode = 0;
            // insertFound mode 1: no field of that name, the three pieces print as written; 2: the field's words; 3: a field with no text of its own, nothing
            tyIns = 0;
            if *tyKind == "ins";    tyIns = 1;
            if *tyKind == "qins";   tyIns = 2;
            // noNested inside inserted text an insert is not followed: it warns by name and its pieces print as written
            tyDive = 0;
            if tyInside == 1;
                if tyIns > 0;
                    tyIns = 0;
                    tyMode = 1;
                    tyFt := *tsWho.taG;
                    cerr "drawSpans: WARNING" tyFt "-- inserted text holds an insert of its own; left as written":;
            // registryOnly a qualified insert looks in the named registry and nowhere else (Tony, 2026-11-13); registries holds every registry by name
            if tyIns == 2;
                tyRl := *tyLeaf.nexT;
                tyRg := *tyRl.texT;
                tyDl := *tyRl.nexT;
                tySl := *tyDl.nexT;
                tyNm := *tySl.texT;
                tyMode = 1;
                tsHit = 0;
                tyRegOk = 0;
                if registries[*tyRg];
                    tyRegOk = 1;
                    tyRegH := registries[*tyRg];
                    if *tyRegH[*tyNm];
                        tsFound := *tyRegH[*tyNm];
                        tsHit = 1;
                tyFt := *tsWho.taG;
                if tyRegOk == 0;
                    cerr "drawSpans: WARNING" tyFt "-- its text inserts from" tyRg "-- not a registry; left as written":;
                if tyRegOk == 1;
                    if tsHit == 0;
                        cerr "drawSpans: WARNING" tyFt "-- its text inserts" tyNm "from" tyRg "-- that registry has no such entry; left as written":;
            if tyIns == 1;
                tySl := *tyLeaf.nexT;
                tyNm := *tySl.texT;
                tyMode = 1;
                tyTop := *tsWho;
                tyHops = 0;
                while tyHops < 32;
                    tyIsTop = *tyTop.isPointeR;
                    if tyIsTop == 1;    tyHops = 32;
                    if tyIsTop == 0;    tyTop := *tyTop.parenT;
                    tyHops += 1;
                tsHit = 0;
                tsWant := *tyNm;
                tyTt := *tyTop.taG;
                if *tyTt == *tyNm;
                    tsFound := *tyTop;
                    tsHit = 1;
                if tsHit == 0;
                    if *tyTop.hasMemberS;   tsFind(*tyTop);
                if tsHit == 0;
                    tyFt := *tsWho.taG;
                    cerr "drawSpans: WARNING" tyFt "-- its text inserts" tyNm "-- no field of that name in the form; left as written":;
            if tyIns > 0;
                if tsHit == 1;
                    tyMode = 3;
                    tyFh = *tsFound.datA;
                    tyFg = *tsFound.isGrouP;
                    if tyFg == 1;   tyFh = 0;
                    if tyFh != 0;
                        tyInTree := tsInner(*tsFound);
                        tyInFirst := *tyInTree.firsT;
                        if tyInFirst.datA != 0;     tyMode = 2;
            // dive mode 2: the insert's own units are walked next, by this same loop; tyFloor is the runs open at the insert, which its closing braces cannot close
            if tyMode == 2;
                tyDive = 1;
                tyIsSpan = 0;
                tyOutGaps = tyGaps;
                tyOutLines = tyLines;
                tyFloor = tyOpen;
            if *tyKind == "open";
                tyIsSpan = 0;
                tySl := *tyLeaf.nexT;
                tyNm := *tySl.texT;
                tyOpen = tyOpen + 1;
                tsRunCount = tsRunCount + 1;
                tsRun.depth = tyOpen;
                tsRun.style = 0;
                tyIsStyle = 0;
                if sTYLEs[*tyNm];   tyIsStyle = 1;
                if tyIsStyle == 0;
                    tyFt := *tsWho.taG;
                    cerr "drawSpans: WARNING" tyFt "-- its text names the style" tyNm "-- not a style; that run is printed plain":;
                // runsOwnStyle the run holds its own deep copy of the style, with its placeholders resolved through the look of the last layout (SEQ 655, stroke 4); a box attribute in it is warned by name and does nothing in a run
                if tyIsStyle == 1;
                    tyOwn := copyDeep(sTYLEs[*tyNm]);
                    rlSays = "drawSpans:";
                    resolveLook(*tyOwn);
                    rlSays = "setFrame:";
                    tsRun.style := *tyOwn;
                    tsRunName = *tyNm;
                    tsBoxWarn(*tyOwn);
                // ownEntry copyDeep, never copyOf: copyOf shares the depth attribute, and every entry then reads the last depth written
                tyE := copyDeep(tsRun);
                tsRuns +% *tyE;
            if *tyKind == "close";
                if tyOpen > tyFloor;
                    tyOpen = tyOpen - 1;
                    tyIsSpan = 0;
            if tyIsSpan == 1;
                if tyHave == 0;
                    tyPara := new("para");
                    tsOut +% *tyPara;
                    tyHave = 1;
                tyTxt := *tyLeaf.texT;
                tsSpan = *tyTxt;
                tsSpan.font = 0;
                tsSpan.color = 0;
                tsSpan.italic = 0;
                tsSpan.space = 0;
                tySpace = 0;
                // liveRuns the run open at each depth is the LAST entry written with that depth; the styles apply outermost first, so an inner run starts from its outer one
                tyD = 1;
                while tyD <= tyOpen;
                    tyPos = 0;
                    tyAt = 0;
                    tyE := tsRuns.firsT;
                    while tyE.datA != 0;
                        tyPos = tyPos + 1;
                        tyDp := *tyE["depth"];
                        if *tyDp == tyD;    tyAt = tyPos;
                        tyE := *tyE.nexT;
                    tyPos = 0;
                    tyE := tsRuns.firsT;
                    while tyE.datA != 0;
                        tyPos = tyPos + 1;
                        if tyPos == tyAt;
                            tyEs := *tyE["style"];
                            if **tyEs["font"];      tsSpan.font := **tyEs["font"];
                            if **tyEs["color"];     tsSpan.color := **tyEs["color"];
                            if **tyEs["italic"];    tsSpan.italic := **tyEs["italic"];
                            if **tyEs["space"];     tySpace = tyPos;
                        tyE := *tyE.nexT;
                    tyD = tyD + 1;
                // spaceAfter white space after the span, or after the closing marks that follow it directly
                tySp = 0;
                if tyGaps > 0;      tySp = 1;
                tyK = tyOpen - tyFloor;
                tyLook = 1;
                if tySp == 1;       tyLook = 0;
                tyNxt := *tyUnit.nexT;
                tyOut = 0;
                while tyLook == 1;
                    // lookPastInsert at the end of inserted text the look goes on in the text that holds it: the insert's own gap, then that text's closing marks
                    tyEnd = 0;
                    if tyNxt.datA == 0;     tyEnd = 1;
                    tySwitch = 0;
                    if tyEnd == 1;
                        if tyInside == 1;
                            if tyOut == 0;      tySwitch = 1;
                    if tySwitch == 1;
                        tyOut = 1;
                        tyEnd = 0;
                        tyK = tyFloor;
                        tyNxt := *tyBack.nexT;
                        if tyNxt.datA == 0;     tyEnd = 1;
                        if tyOutGaps > 0;
                            tySp = 1;
                            tyLook = 0;
                    if tyK == 0;            tyLook = 0;
                    if tyEnd == 1;          tyLook = 0;
                    if tyLook == 1;
                        tyNp := *tyNxt.firsT;
                        tyNl := *tyNp.firsT;
                        tyIsClose = 0;
                        if *tyNl.taG == "close";    tyIsClose = 1;
                        if tyIsClose == 0;  tyLook = 0;
                        if tyIsClose == 1;
                            tyK = tyK - 1;
                            tyNg := *tyNp.nexT;
                            if tyNg.datA != 0;
                                tySp = 1;
                                tyLook = 0;
                            tyNxt := *tyNxt.nexT;
                // styleSpace the gap's width comes from the innermost open style that names space (Tony, 2026-11-12)
                tyHasSp = 0;
                if tySpace > 0;
                    tyPos = 0;
                    tyE := tsRuns.firsT;
                    while tyE.datA != 0;
                        tyPos = tyPos + 1;
                        if tyPos == tySpace;
                            tySpEs := *tyE["style"];
                            tyHasSp = 1;
                        tyE := *tyE.nexT;
                // emitSpans one span for a piece; an insert left as written prints its pieces, one span each, the last taking the gap
                tyW := *tyLeaf;
                tyMore = 1;
                if tyMode == 3;     tyMore = 0;
                while tyMore == 1;
                    tyWn := *tyW.nexT;
                    tyLast = 0;
                    if tyWn.datA == 0;  tyLast = 1;
                    if tyMode == 0;     tyLast = 1;
                    tyTxt := *tyW.texT;
                    tyGapOn = 0;
                    if tyLast == 1;     tyGapOn = tySp;
                    tsSpan = *tyTxt;
                    tsSpan.space = tyGapOn;
                    if tyGapOn == 1;
                        if tyHasSp == 1;    tsSpan.space := **tySpEs["space"];
                    // ownSpan copyDeep, never copyOf: copyOf shares the four slots, and every span then reads the last one's
                    tyNew := copyDeep(tsSpan);
                    *tyPara +% *tyNew;
                    if tyLast == 1;     tyMore = 0;
                    if tyLast == 0;     tyW := *tyWn;
            if tyDive == 0;
                if tyLines > 1;
                    tyHave = 0;
                    clear(tsRuns);
                    tyOpen = 0;
                    tyFloor = 0;
                tyUnit := *tyUnit.nexT;
            if tyDive == 1;
                tyBack := *tyUnit;
                tyUnit := *tyInFirst;
                tyInside = 1;
            // surface the inserted text is done: the runs it opened end, and the insert's own blank line, if it had one, ends the paragraph
            if tyInside == 1;
                if tyUnit.datA == 0;
                    tyInside = 0;
                    tyOpen = tyFloor;
                    tyFloor = 0;
                    if tyOutLines > 1;
                        tyHave = 0;
                        clear(tsRuns);
                        tyOpen = 0;
                    tyUnit := *tyBack.nexT;
        };
    /***************************************************************************
        drawText -- forms step 5 (Tony, 2026-11-09, SEQ 582). Resolves a field's
        font, color, align (step 5a, SEQ 584), valign (step 5b, SEQ 605) and italic (SEQ 624) in kant and hands drawSpans one request, textReq,
        written afresh on every call. Each of font and color comes from the
        field's own attribute, else the enclosing field's, walking up to the top
        (the field holding the display). A style is not looked up here: setFrame's
        mergeStyles has already merged every style:= into its field on the copy
        (SEQ 652 R1), so a form drawn without setFrame gets no style's text properties. Nothing found leaves the slot at 0: drawSpans then draws
        Helvetica 12 in black, left-aligned. The text is the field's own string, or, when the
        field holds a group, that group's (*argument, one level). A field with
        no text costs a call and draws nothing (drawSpans skips it).
    ***************************************************************************/
    drawText code={
        textReq.field := argument;
        dtG = argument.isGrouP;
        if dtG == 1;    textReq.source := *argument;
        else            textReq.source := argument;
        // sourceHeld the same choice kept in a local, for the pre-pass below: a slot of textReq cannot be starred through a dot
        if dtG == 1;    dtSrc := *argument;
        else            dtSrc := argument;
        // describeShown a field with a describe attribute shows that attribute's text (SEQ 608 R2)
        dtSelf := argument;
        if *dtSelf["describe"];     textReq.source := *dtSelf["describe"];
        if *dtSelf["describe"];     dtSrc := *dtSelf["describe"];
        // imageText an image field's text is its description, never drawn over the image (SEQ 608 R2)
        dtDraw = 1;
        if *dtSelf["image"];        dtDraw = 0;
        textReq.font = 0;
        textReq.color = 0;
        textReq.align = 0;
        textReq.valign = 0;
        textReq.italic = 0;
        dtItalic = 0;
        dtFont = 0;
        dtColor = 0;
        dtAlign = 0;
        dtValign = 0;
        dtCur := argument;
        dtHops = 0;
        while dtHops < 32;
            if dtFont == 0;
                if *dtCur["font"];
                    textReq.font := *dtCur["font"];
                    dtFont = 1;
            if dtColor == 0;
                if *dtCur["color"];
                    textReq.color := *dtCur["color"];
                    dtColor = 1;
            if dtAlign == 0;
                if *dtCur["align"];
                    textReq.align := *dtCur["align"];
                    dtAlign = 1;
            if dtValign == 0;
                if *dtCur["valign"];
                    textReq.valign := *dtCur["valign"];
                    dtValign = 1;
            // italicInherits a text property (SEQ 624): the nearest field naming italic decides
            if dtItalic == 0;
                if *dtCur["italic"];
                    textReq.italic := *dtCur["italic"];
                    dtItalic = 1;
            dtTop = *dtCur.isPointeR;
            if dtTop == 1;      dtHops = 32;
            if dtFont == 1;
                if dtColor == 1;
                    if dtAlign == 1;
                        if dtValign == 1;
                            if dtItalic == 1;   dtHops = 32;
            // climbUp the walk goes on to the enclosing field (style is scoped to the subtree, 2026-11-03)
            dtCur := *dtCur.parenT;
            dtHops += 1;
        // prePass kant's typeset builds the span list from a source that holds its own string; the floor refuses every other source by name, as it did (typesetting T1, 2026-11-12)
        textReq.spans = 0;
        textReq.runs = 0;
        if dtDraw == 1;
            tsWho := argument;
            dtHas = *dtSrc.datA;
            dtHeld = *dtSrc.isGrouP;
            dtTopText = *dtSrc.isPointeR;
            if dtHeld == 1;     dtHas = 0;
            if dtTopText == 1;  dtHas = 0;
            if dtHas != 0;
                typeset(*dtSrc);
                textReq.spans := tsOut;
                textReq.runs = tsRunCount;
            drawSpans(textReq);
        };
    /***************************************************************************
        drawImage -- forms step 8 (Tony, 2026-11-10, SEQ 609). A field with an
        image attribute hands displayImage one request, imageReq, written afresh
        on every call: the field, and the image attribute as the source (its
        text is the file's path). fit stays 0, which the floor reads as fill:
        no attribute names a fit yet. Drawn after the fill and before the
        border, so the border sits on the image.
    ***************************************************************************/
    imageReq field source fit;
    drawImage code={
        diSelf := argument;
        if *diSelf["image"];
            imageReq.field := argument;
            imageReq.source := *diSelf["image"];
            imageReq.fit = 0;
            displayImage(imageReq);
        };
    drawFill code={
        if argument["fill"];    displayFill(argument);
        or argument["style"];   displayFill(argument);
        };
    drawBorder code={
        if argument["border"];          displayBorder(argument);
        or argument["topBorder"];       displayBorder(argument);
        or argument["bottomBorder"];    displayBorder(argument);
        or argument["leftBorder"];      displayBorder(argument);
        or argument["rightBorder"];     displayBorder(argument);
        };
    drawKids code={
        for grup in argument; members
            // skipsHiddenAndNoRoom neither an isHidden field nor a noRoom one is drawn, nor anything under it (forms step 6)
            dkSkip = *grup.isHiddeN;
            dkGone = *grup.noRooM;
            if dkGone == 1;     dkSkip = 1;
            if dkSkip == 0;
                drawFill(*grup);
                drawImage(*grup);
                drawBorder(*grup);
                drawText(*grup);
                if *grup.hasMemberS;    drawKids(*grup);
        };
    listed;
    /***************************************************************************
        listRules — print a field and its components as tag=value. Note the use
        of listed, which is explicitly not a local field used to control
        recursing and hold off a mad recursing loop
    ***************************************************************************/
    listRules code={
        listed  += argument;
        length  = listLengtH;
        if datA != 0;   print ~$taG "=" argument;
        else            print ~$taG;
        if length > 0;
            print _length:;
            iterate grup on argument;
            while ++grup;
                length  = listLengtH;
                if noPrinT; continue;
                print +;
                if !length || grup IN listed;
                    if datA != 0;   print ~$taG "=" grup:;
                    else            print ~$taG:;
                else
                    listRules(*grup);
                print $-;
        else    print :;
        };
    /***************************************************************************
        print out xml representation of the group passed in. Does not
        handle cdata yet.
    ***************************************************************************/
    toXML code={
        print ~,"<" tag;
        if datA; print ,"=" argument;
        if hasAttributes;
            for grup in argument; attributes
                print _grup.tag;
                if grup.datA print ,"=" grup;
        if hasMembers;
            print ">",:+;
            for grup in argument; members
                ++recurse;
                toXML(*grup);
                --recurse;
                if grup.next    print :;
        else    print "/>";
        if hasMembers;      print ,-"</" tag ">";
        if recurse == 0     print :;
        };
    /***************************************************************************
        fillDownAcross deals with direction framing. The direction can be either
        down or across. When the direction passed in has a value. The value can
        be "*" or a number. The argument passed in has to contain the direction
        attribute (that is down or across respectively).
        
        If the direction value is "*", the argument passed in can have only one
        member (the member may have members); also the member should have its
        target (width or height) specified. If direction value is a number
        (like down=3) the argument can have more than one member, but all members
        should have no target specified. Also, the argument passed in should
        have no data (you can add data after setFrame finishes).
    ***************************************************************************/
    tARGET;
    dIRECTion;
    newStuff isList;
    fillDownAcross code={
        pValue = argument[tARGET];
        direct = argument[dIRECTion];
        memberCount=0;
        for grup in argument; members
            ++memberCount;
            target = *grup[tARGET];
            if target.isPercenT;    target = argument[tARGET] * target / 100;
            if target.datA != 0;    pValue -= target;
        if direct == "*";
            if memberCount > 1; print taG "can only have one member when" $dIRECTion "=*":;
            valueCount = 0;
            valueCount = pValue / target;
            if valueCount * target > pValue;    --valueCount;
        else
            if direct > 0;
                valueCount = direct - 1;
        // repeatInPlace the repeats are deep copies added to the field itself, so every member keeps the field as its parent and each copy owns its children (SEQ 653). A bare down or across adds nothing. The old way rebuilt the list in a scratch field from shallow copies: a member's children climbed to the scratch field, and the copies shared one set of children, all laid out where the last one fell.
        while valueCount > 0;
            --valueCount;
            fdSeen = 0;
            for grup in argument; members
                if fdSeen < memberCount;    argument +/ copyDeep(*grup);
                ++fdSeen;
        };
    /***************************************************************************
        Both directions on one field (Clay's design, Tony 2026-11-06). The number
        goes outside: a new cell holds the members and carries the *, and
        setFrame's recursion does the rest. Both * or both numbers: parked.
    ***************************************************************************/
    bothStuff isList;
    bothDirections code={
        =:argument across down;
        inner = "none";
        if down == "*";
            if across != "*";   inner = "down";
        if across == "*";
            if down != "*";     inner = "across";
        if inner == "none";
            print taG "needs one * and one number to use both down and across":;
            return;
        cellHold := new("dirCell");
        innerAttr := argument[inner];
        *cellHold :% copyOf(*innerAttr);
        for grup in argument; members
            *cellHold +/ copyOf(*grup);
        clear(bothStuff);
        for grup in argument; attributes
            if *grup.taG != inner;
                bothStuff +% *grup;
        bothStuff +/ *cellHold;
        clear(argument);
        argument = bothStuff;
        };
    /***************************************************************************
         frameMembers sets frames for the members of the group passed in. It must
         have x y width and height attributes. It WRITES the group it is handed,
         so only setFrame calls it, and only on a copy.

         isHidden and noRoom (forms step 6, Tony's ruling of 2026-11-07; built
         SEQ 627). Two flags, two facts. isHidden is the author's: a field
         written isHiddeN takes no room, gets no frame, and neither it nor
         anything under it is laid out or drawn. noRoom is layout's and means
         only "does not fit": after a parent's members are placed, a member
         wholly outside the parent's box on either axis (or left with no width
         or no height) is flagged noRooM; it is not drawn and nothing under it
         is laid out. A member partly outside is drawn. Nothing is shrunk and
         layout does not stop. noRoom is written on the laid-out copy only, so
         every run decides it afresh.
    ***************************************************************************/
    frameMembers code={
        =:argument across down overlay width height x y;
        if across.datA != 0;
            if down.datA != 0;
                // warnsBoth until F-157 is fixed: the cell bothDirections builds holds shallow copies in a scratch field
                cerr "setFrame: WARNING" argument.taG "-- it is written both down and across; its members are rebuilt as shallow copies, so a field under one of them may be laid out and inherit wrongly (F-157)":;
                bothDirections(argument);
                =:argument across down;
        sideRoom    = width;
        pWidth      = width;
        headRoom    = height;
        pHeight     = height;
        pX          = x;
        pY          = y;
        boxX        = x;
        boxY        = y;
        boxR        = x + width;
        boxB        = y + height;
        upOut       = 0;
        sideOut     = 0;
        // overlayNamed a parent that names overlay (and neither down nor across) overlays its children: each fills the parent's box unless it declares its own width, height, x or y. A parent naming no direction stacks them, as down does: the old GUI's default, and what descriptions and unitTests' sample rely on (SEQ 626 W3; the default is Tony's to re-rule)
        laysOver    = 0;
        if overlay.datA != 0;
            if across.datA == 0;
                if down.datA == 0;  laysOver = 1;
        if down.datA != 0;
            tARGET="height";
            dIRECTion="down";
            fillDownAcross(argument);
        if across.datA != 0;
            tARGET="width";
            dIRECTion="across";
            fillDownAcross(argument);
   /***************************************************************************
                 Create frame and set width and height
    ***************************************************************************/
        for grup in argument; members
            // hiddenTakesNoRoom an isHidden member is not sized, so it joins no share
            fmHid = *grup.isHiddeN;
            if fmHid == 0;
                =:grup width height;
                if width.isPercenT;
                    width = pWidth * width / 100;
                    *grup :% copyOf(width);
                if height.isPercenT;
                    height = pHeight * height / 100;
                    *grup :% copyOf(height);
                if width.datA != 0;
                    sideRoom    -= width;
                or across.datA == 0;
                    width = pWidth;
                    *grup :% copyOf(width);
                else
                    sideOut     +/ *grup;
                    ++sideOut;
                if height.datA != 0;
                    headRoom    -= height;
                or across.datA != 0;
                    height = pHeight;
                    *grup :% copyOf(height);
                or laysOver == 1;
                    height = pHeight;
                    *grup :% copyOf(height);
                else
                    upOut       +/ *grup;
                    ++upOut;
        if upOut > 0;
            shareN = 0;
            shareUsed = 0;
            shareEdge = 0;
            for grup in upOut;
                ++shareN;
                shareEdge = headRoom * shareN / upOut;
                height = shareEdge - shareUsed;
                shareUsed = shareEdge;
                *grup :% copyOf(height);
        if sideOut > 0;
            shareN = 0;
            shareUsed = 0;
            shareEdge = 0;
            for grup in sideOut;
                ++shareN;
                shareEdge = sideRoom * shareN / sideOut;
                width = shareEdge - shareUsed;
                shareUsed = shareEdge;
                *grup :% copyOf(width);
        headRoom    = 0;
        sideRoom    = 0;
    /***************************************************************************
             Set x and y in frame
    ***************************************************************************/
        // fromTheParent under an overlaying parent a child's declared x and y are measured from the parent's origin (R4); under down or across they are not read, as before
        for grup in argument; members
            fmHid = *grup.isHiddeN;
            if fmHid == 0;
                =:grup width height x y;
                placeY = pY;
                placeX = pX;
                if laysOver == 1;
                    if y.datA != 0;     placeY = pY + y;
                if laysOver == 1;
                    if x.datA != 0;     placeX = pX + x;
                y = placeY;
                *grup :% copyOf(y);
                x = placeX;
                *grup :% copyOf(x);
                // doesNotFit noRoom means only this: wholly outside the parent's box on an axis, or no extent on one (Tony, 2026-11-07). Partly outside is drawn.
                fmRight = placeX + width;
                fmFoot  = placeY + height;
                fmOut   = 0;
                if placeX >= boxR;      fmOut = 1;
                if fmRight <= boxX;     fmOut = 1;
                if placeY >= boxB;      fmOut = 1;
                if fmFoot <= boxY;      fmOut = 1;
                if fmOut == 1;          *grup :. noRooM;
                if laysOver == 0;
                    if across.datA == 0;    pY += height;
                if laysOver == 0;
                    if across.datA != 0;    pX += width;
        for grup in argument; members
            fmSkip = *grup.isHiddeN;
            fmGone = *grup.noRooM;
            if fmGone == 1;     fmSkip = 1;
            if fmSkip == 0;
                // holdsAForm a field written form:=other is filled by that form, laid out in the field's frame (G2 stroke 1b); its own members, if any, are not laid out
                fmHolds = 0;
                fmSelf := *grup;
                if *fmSelf["form"];     fmHolds = 1;
                if fmHolds == 1;        placeForm(*grup);
                if fmHolds == 0;
                    if *grup.hasMemberS;
                        frameMembers(*grup);
        };
    /***************************************************************************
        setFrame -- forms step 6 (Tony's design of 2026-11-07; SEQ 626).
        ONE argument, a request holding form:= the form and, optionally,
        frame:= a field of its own, outside the form, holding x y width height.
        setFrame copies the form, lays out the copy and returns it. The form's
        definition is never written, so a declared percent, a down=3 and the
        member set are all still there for the next run, and every run is a
        fresh run. With a frame the copy's top takes the frame's four values;
        with none it keeps the form's declared four. Only the top is gated:
        every child is laid out from its parent, so a percent follows the new
        size. The caller holds the returned copy (laid := setFrame(req)) and
        draws that; no laid-out result is saved anywhere.
        Refuses by name and returns nothing: a request with no form; a frame
        that lacks any of x y width height (frameWhole).
    ***************************************************************************/
    /***************************************************************************
        placeForm -- a form inside a field (G2 stroke 1b; Tony, 2026-11-13). A
        field written form:=other is the frame for that form: once the field has
        its own x y width height, the form is laid out by setFrame with the
        field as the request's frame, and the laid-out copy becomes the field's
        one member, so drawWalk draws it there with no change. Each field that
        holds a form gets its own copy. setFrame refuses a form that holds
        itself, directly or through other forms (sfChain holds the names of the
        forms being laid out); the field is then left empty.
        The reference may name the form itself (form:=other) or a field of
        its own that holds the form (shown := other; form:=shown). Writing
        that field tells its listeners, so a listener that calls redrawForm
        swaps the form shown in the field (G2 stroke 2).
    ***************************************************************************/
    placeReq form frame look;
    sfChain;
    placeForm code={
        pfHost := argument;
        pfRef := *pfHost["form"];
        // heldThroughAField the reference may name a field of its own that holds the form (shown := aForm); writing that field swaps the form (G2 stroke 2)
        pfTarget := **pfRef;
        pfVia = *pfTarget.isGrouP;
        if pfVia == 1;      pfTarget := **pfTarget;
        placeReq.form := *pfTarget;
        placeReq.frame := argument;
        // lookGoesDown the held form is laid out under its host's look (SEQ 655, stroke 4)
        placeReq.look = 0;
        if lkHas == 1;      placeReq.look := *lkLook;
        pfLaid := setFrame(placeReq);
        pfGot = 0;
        if *pfLaid.listLengtH;      pfGot = 1;
        if pfGot == 1;              argument +/ *pfLaid;
        };
    fwOk = 0;
    frameWhole code={
        =:argument x y width height;
        fwOk = 1;
        if x.datA == 0;         fwOk = 0;
        if y.datA == 0;         fwOk = 0;
        if width.datA == 0;     fwOk = 0;
        if height.datA == 0;    fwOk = 0;
        };
    /***************************************************************************
        mergeStyles -- styles by merge at layout (Tony, 2026-11-14, SEQ 652 R1).
        Run by setFrame on the copy, before frameMembers. Every style:= a field
        holds is merged into that field: a deep copy of the style (R5), by
        GroupItem's merge, which adds an attribute only where the field has
        none of that name. So the field's own attributes always win, wherever
        style:= sits on the line, and of two styles the earlier wins. The
        definition and the style are never written. A style:= inside a style
        is not followed: styles are composed from styles by merge in a define.
    ***************************************************************************/
    lkLook;
    lkHas = 0;
    lkBase;
    lkBaseHas = 0;
    /***************************************************************************
        setLook -- which looks a layout resolves placeholders through (SEQ 654).
        argument is setFrame's request. Its look:= is the first place looked;
        defaultLook (IncantForms/Controls/styles) is the second, when the styles
        file is loaded. mergeStyles reads the four fields this writes.
    ***************************************************************************/
    setLook code={
        slReq := argument;
        lkHas = 0;
        if *slReq["look"];      lkHas = 1;
        if lkHas == 1;
            slLook := *slReq["look"];
            lkLook := **slLook;
        lkBaseHas = 0;
        slBase := sTYLEs["defaultLook"];
        if *slBase.listLengtH;  lkBaseHas = 1;
        if lkBaseHas == 1;      lkBase := *slBase;
        };
    rlSays = "setFrame:";
    /***************************************************************************
        resolveLook -- placeholders through the look (SEQ 652 R2, R3). argument
        is a field on a laid-out copy, or a run's own copy of its style (typeset).
        Its attributes are re-pointed; nothing under it is walked. rlSays is the
        word the refusal opens with: setFrame's, or drawSpans' for a run.
    ***************************************************************************/
    resolveLook code={
        // placeholders an attribute that holds a placeholder (fill:=pageFill) is re-pointed, on the copy, at what the request's look holds under that name, else at what defaultLook holds; found in neither, it is refused by name and left as written (SEQ 652 R2, R3)
        for grup in argument; attributes
            msHolds = *grup.isGrouP;
            // emptyHeldField kant cannot read the virtual flag, so a placeholder is known by what it is: a held field with no value, no list and nothing held. A colour has a value, a font and an action have a list, a holder holds
            msPh = 0;
            if msHolds == 1;
                msPh = 1;
                msData = **grup.datA;
                msList = **grup.listLengtH;
                msVia = **grup.isGrouP;
                if msData != 0;     msPh = 0;
                if msList != 0;     msPh = 0;
                if msVia != 0;      msPh = 0;
            if msPh == 1;
                msName := **grup.taG;
                msDone = 0;
                if lkHas == 1;
                    if *lkLook[*msName];
                        msTo := *lkLook[*msName];
                        *grup := **msTo;
                        msDone = 1;
                if msDone == 0;
                    if lkBaseHas == 1;
                        if *lkBase[*msName];
                            msTo := *lkBase[*msName];
                            *grup := **msTo;
                            msDone = 1;
                if msDone == 0;
                    msAttr = *grup.taG;
                    cerr rlSays "REFUSING" argument.taG "-- its" msAttr "names the placeholder" msName "and no look holds it; name it in the request's look or in defaultLook":;
        };
    mergeStyles code={
        for grup in argument; attributes
            msTag = *grup.taG;
            msIs = 0;
            if msTag == "style";    msIs = 1;
            msHeld = *grup.isGrouP;
            if msHeld == 0;         msIs = 0;
            if msIs == 1;
                msOwn := copyDeep(**grup);
                *msOwn :. mergeON;
                argument :. mergeON;
                argument +% *msOwn;
        resolveLook(argument);
        if hasMemberS;
            for grup in argument; members
                mergeStyles(*grup);
        };
    setFrame code={
        sfReq := argument;
        sfHas = 0;
        if *sfReq["form"];      sfHas = 1;
        if sfHas == 0;
            cerr "setFrame: REFUSING" argument.taG "-- its request holds no form; write form:=theForm":;
            return;
        sfUse = 0;
        if *sfReq["frame"];     sfUse = 1;
        if sfUse == 1;
            sfFrame := *sfReq["frame"];
            frameWhole(**sfFrame);
            if fwOk == 0;
                cerr "setFrame: REFUSING" argument.taG "-- its frame needs x, y, width and height":;
                return;
        sfForm := *sfReq["form"];
        // holdsItself the names of the forms being laid out; one met again is a form inside itself, refused by name and not laid out
        sfName := **sfForm.taG;
        if sfChain[*sfName];
            cerr "setFrame: REFUSING" argument.taG "-- the form" sfName "holds itself, directly or through another form; it is not laid out inside itself":;
            return;
        sfMark := new(*sfName);
        sfChain +% *sfMark;
        // deepCopy copyOf shares bodies below the second level, so a deep form would be written (measured, SEQ 626)
        sfLaid := copyDeep(**sfForm);
        if sfUse == 1;
            *sfLaid :% copyOf(**sfFrame["x"]);
            *sfLaid :% copyOf(**sfFrame["y"]);
            *sfLaid :% copyOf(**sfFrame["width"]);
            *sfLaid :% copyOf(**sfFrame["height"]);
        setLook(argument);
        mergeStyles(*sfLaid);
        frameMembers(*sfLaid);
        sfChain -% *sfMark;
        return *sfLaid;
        };
    /***************************************************************************
        layoutFrame -- the frame Layout hands the form on a resize (stroke 4,
        Tony 2026-11-12). It holds x y width height and is a request's frame:=.
        Layout writes it as ONE whole write, layoutFrame = newFrame, where
        newFrame holds the four values: that one write carries all four and
        tells layoutFrame's listeners once. A form's resize listener
        (listenTo:=layoutFrame) calls redrawForm with its request. Writing one
        of the four on its own (layoutFrame :% ...) tells nobody.
    ***************************************************************************/
    layoutFrame x=0 y=0 width=0 height=0;
    pageReq path form width height;
    /***************************************************************************
        redrawForm -- the first resize, as a plain call (SEQ 626 W2). ONE
        argument, setFrame's own request with a path added: form:=, frame:=
        (optional), path= the PDF to write. It lays the form out afresh through
        setFrame, draws the copy to that PDF and returns the copy. This is what
        Layout calls on a resize, with the new frame in the request, until the
        frame arrives by listening (stroke 4). It keeps nothing: the caller
        holds the returned copy if it wants it. A refused setFrame draws nothing.
    ***************************************************************************/
    redrawForm code={
        rdReq := argument;
        rdLaid := setFrame(argument);
        rdGot = 0;
        if *rdLaid.listLengtH;     rdGot = 1;
        if rdGot == 0;
            cerr "redrawForm: nothing laid out for" argument.taG "-- no PDF written":;
            return;
        pageReq :% copyOf(*rdReq["path"]);
        pageReq :% copyOf(*rdLaid["width"]);
        pageReq :% copyOf(*rdLaid["height"]);
        pageReq.form := *rdLaid;
        openPDF(pageReq);
        drawWalk(*rdLaid);
        closePDF(pageReq);
        return *rdLaid;
        };
    /***************************************************************************
        click -- the mock click (goal G1; G2 stroke 3; Tony, 2026-11-13). ONE
        argument, a request: form:= the form and field= the name of a field in
        it. No point and no window: the field is named. The click selects the
        field (selection), fires the field's own action if it has one, then
        its attribute actions left to right: every attribute that holds an
        action (onClick:=someAction, or any other name). Each is handed the
        field. Nothing here redraws: an action that writes a field with a
        listener (insideForm := another) is redrawn by that listener.
        Refuses by name: a request with no form or no field name; a name the
        form has no field for. Not built: bubbling to the enclosing fields.
    ***************************************************************************/
    ckFn;
    ckNm;
    clickFire code={
        if argument["CodE"];
            cout "=== click" ckFn ckNm "fired its own action ===":;
            argument(argument);
        for grup in argument; attributes
            ckHeld = *grup.isGrouP;
            ckActs = 0;
            if ckHeld == 1;
                if **grup["CodE"];      ckActs = 1;
            // notItself a field with an action holds itself under the name this; that is the own action, already fired
            ckAn := *grup.taG;
            if *ckAn == "this";     ckActs = 0;
            if ckActs == 1;
                ckTo := **grup.taG;
                cout "=== click" ckFn ckNm "fired" ckAn ckTo "===":;
                **grup(argument);
        };
    click code={
        ckReq := argument;
        ckOk = 1;
        if *ckReq["form"];      ckOk = ckOk + 1;
        if *ckReq["field"];     ckOk = ckOk + 1;
        if ckOk != 3;
            cerr "click: REFUSING" argument.taG "-- its request needs form:=theForm and field=theName":;
            return;
        ckForm := *ckReq["form"];
        ckAttr := *ckReq["field"];
        ckNm := *ckAttr.texT;
        ckFn := **ckForm.taG;
        tsHit = 0;
        tsWant := *ckNm;
        if *ckFn == *ckNm;
            tsFound := **ckForm;
            tsHit = 1;
        if tsHit == 0;      tsFind(**ckForm);
        if tsHit == 0;
            cerr "click: REFUSING" argument.taG "-- the form" ckFn "has no field named" ckNm:;
            return;
        // ownHolder the field is kept in a local: an action fired below may redraw, and the redraw's own search writes tsFound
        ckField := *tsFound;
        selection := *ckField;
        cout "=== click" ckFn ckNm "selected ===":;
        clickFire(*ckField);
        };
    // quoteIfNeeded obituary: never called; set arm exercised by inArmsT, 2026-09-08
    /***************************************************************************
        Convert the hex string in the target passed in to a floating point number
    ***************************************************************************/
    hexToNumber target code={
        while target;
            numDBL  = target.numbeR;
            if numDBL <= 57;    numDBL -= 48;
            or numDBL <= 70;    numDBL -= 55;
            or numDBL <= 102;   numDBL -= 87;
            ++target;
            if num; num *= 16;
            num += numDBL;
        target  = num;
        return target; };
    /***************************************************************************
        Extract the red, green, and blue components of a color group passed
        in as a six character hex string
    ***************************************************************************/
    setHexColor hex code={
        RGBred  = hex - 4;
        hex     +% hexToNumber(RGBred);
        RGBgreen    = hex + 2;
        RGBgreen    -= 2;       // to chop off the blue component
        hex     +% hexToNumber(RGBgreen);
        RGBblue = hex + 4;
        hex     +% hexToNumber(RGBblue);
        dumpContents(hex); };
    /***************************************************************************
        bigifyLayout — build a rows x columns grid of cells as members of the
        bigify block passed in. Templates (regularItem) ride in as fields of the
        block and are scoped out. Each cell merges the template's attributes in
        (two-sided merge: cell opts in via :. mergeON) and is stamped with its
        row, col, and reading-order seq. setFrame paints the result.
        v1: all-regular grid (no big band yet); percent/orientation in v2.
    ***************************************************************************/
    bigifyLayout code={
        print "bigifyLayout building grid for" taG:;
        :argument rows columns bigRows bigColumns regularItem bigItem selRow selCol;
    /***************************************************************************
        Clamp the big-slot origin so the bigRows x bigColumns rectangle fits.
    ***************************************************************************/
        maxRow = rows - bigRows;
        maxCol = columns - bigColumns;
        bOR = selRow;
        if bOR < 0;        bOR = 0;
        if bOR > maxRow;   bOR = maxRow;
        bOC = selCol;
        if bOC < 0;        bOC = 0;
        if bOC > maxCol;   bOC = maxCol;
        rowPct = 100 / rows;
        colPct = 100 / columns;
        bigRowSpan = 100 * bigRows;
        bigHpct = bigRowSpan / rows;
        bigColSpan = 100 * bigColumns;
        bigWpct = bigColSpan / columns;
    /***************************************************************************
        Build bands top to bottom. A row inside [bOR, bOR+bigRows) becomes the
        big band; every other row is a full-width regular row.
    ***************************************************************************/
        r = 0;
        while r < rows;
            if r == bOR;
            /***************************************************************
                The big band, bigRows tall: left-strip columns, the enlarged
                cell, then right-strip columns, left to right.
            ***************************************************************/
                bandName = string $"band" r;
                band := argument :+ new(bandName);
                across = 1;
                band +% across;
                height = bigHpct;
                height :. isPercenT;
                band +% copyOf(height);
                c = 0;
                while c < columns;
                    if c == bOC;
                        bigName = string "big" r;
                        big := band :+ new(bigName);
                        big :. mergeON;
                        big +% bigItem;
                        width = bigWpct;
                        width :. isPercenT;
                        big +% copyOf(width);
                        row = bOR;
                        big +% copyOf(row);
                        col = bOC;
                        big +% copyOf(col);
                        c += bigColumns;
                    else
                        colName = string "strip" c;
                        column := band :+ new(colName);
                        width = colPct;
                        width :. isPercenT;
                        column +% copyOf(width);
                        rr = 0;
                        while rr < bigRows;
                            cellRow = bOR + rr;
                            cellName = string "c" cellRow "x" c;
                            cell := column :+ new(cellName);
                            cell :. mergeON;
                            cell +% regularItem;
                            row = cellRow;
                            cell +% copyOf(row);
                            col = c;
                            cell +% copyOf(col);
                            rr += 1;
                        c += 1;
                r += bigRows;
            else
            /***************************************************************
                A full-width regular row.
            ***************************************************************/
                rowName = string "row" r;
                rowBlock := argument :+ new(rowName);
                across = 1;
                rowBlock +% across;
                height = rowPct;
                height :. isPercenT;
                rowBlock +% copyOf(height);
                c = 0;
                while c < columns;
                    cellName = string "c" r "x" c$;
                    cell := rowBlock :+ new(cellName);
                    cell :. mergeON;
                    cell +% regularItem;
                    width = colPct;
                    width :. isPercenT;
                    cell +% copyOf(width);
                    row = r;
                    cell +% copyOf(row);
                    col = c;
                    cell +% copyOf(col);
                    c += 1;
                r += 1;
        };
    ;

