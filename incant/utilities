register(Utilities);
define
    /***************************************************************************
        tell -- the one door into a field's grammar: tell("thermo set 5").
        The first word names the target field, the rest of the line is the
        message. aCTionTell (GroupActions.rtn) drives the target with the
        input floor and returns a verdict: matched, consumed, length,
        stoppedAt, known, and reply (a copy of the parked label). Read it
        inside an action as  v := tell("..."); vc := *v["consumed"];
    ***************************************************************************/
    tell isRule target=[a-zA-Z0-9]+ message?=[^\n]+ ruleMethod=aCTionTell;
    listed;
    /***************************************************************************
        dumpField — print a field as tag=value, then an indented list of the
        child tags (or a no-list note). Incant-side cousin of dumpContents.
    ***************************************************************************/
    dumpField code={
        if datA != 0;   print $taG "=" argument:;
        else            print $taG:;
        if argument.listLengtH;
            for grup in argument;
                if datA != 0;   print `$taG "=" grup:;
                else            print `$taG:;
        else print ``"(no list)":;
        };
    /***************************************************************************
        listRules — print a field and its components as tag=value. Note the use
        of listed, which is explicitly not a local field used to control
        recursing and hold off a mad recursing loop
    ***************************************************************************/
    listRules code={
        listed  += argument;
        length  = listLengtH;
        if datA != 0;   print ~$taG "=" argument;
        else            print ~$taG;
        if length > 0;
            print _length:;
            iterate grup on argument;
            while ++grup;
                length  = listLengtH;
                if noPrinT; continue;
                print +;
                if !length || grup IN listed;
                    if datA != 0;   print ~$taG "=" grup:;
                    else            print ~$taG:;
                else
                    listRules(*grup);
                print $-;
        else    print :;
        };
    /***************************************************************************
        JSON rules invoked as JSONblock("json string or json file name"); These
        rules are work in process.
        
        Note: true and false are added as rule options to JSONtoken as
        quoted literals so they get picked up instead of the true=1 and false=0
        fields in the pROPERTIEs base registry (which are probably fine for
        incant purposes but look strange on print out since they print as
        numbers 1 and 0 and not the names true and false.

        FORWARD DECLARATIONS (2026-08-02). JSONtoken and JSONvalue reference
        JSONblock and JSONarray, which are defined BELOW them -- and a reference
        term resolves by sharing the definer's child list, so a name that does
        not exist yet mints an empty stub that never becomes a reference.
        Naming them first, then fleshing them out below, is the trodden path.
    ***************************************************************************/
    JSONblock isRule;
    JSONarray isRule;

    JSONtoken isRule
        JSONblock;
        "false";
        "true";
        GrouP;
        NumbeR;
    JSONvalue isRule
        JSONblock;
        JSONarray;
        JSONtoken;
    JSONfield isRule JSONtoken ":"- JSONvalue ","?- code={
        jfOut := new(*JSONtoken);
        *jfOut = *JSONvalue;
        return *jfOut;
        };
    JSONitem isRule JSONtoken@ ","?-;
    JSONlist isRule JSONitem+;
    JSONarray isRule "["- JSONlist? "]"- code={
        jaOut := new("JSONarray");
        if JSONlist;
            for grup in JSONlist;
                *jaOut +% copyOf(*grup);
        return *jaOut;
        };
    JSONblock isRule fail "{"- JSONfield* "}"-;
    tARGET;
    dIRECTion;
    placeReq form frame look;
    sfChain;
    fwOk = 0;
    /***************************************************************************
        fillDownAcross deals with direction framing. The direction can be either
        down or across. When the direction passed in has a value. The value can
        be "*" or a number. The argument passed in has to contain the direction
        attribute (that is down or across respectively).
        
        If the direction value is "*", the argument passed in can have only one
        member (the member may have members); also the member should have its
        target (width or height) specified. If direction value is a number
        (like down=3) the argument can have more than one member, but all members
        should have no target specified. Also, the argument passed in should
        have no data (you can add data after setFrame finishes).
    ***************************************************************************/
    fillDownAcross code={
        pValue = argument[tARGET];
        direct = argument[dIRECTion];
        memberCount=0;
        for grup in argument; members
            ++memberCount;
            target = *grup[tARGET];
            if target.isPercenT;    target = argument[tARGET] * target / 100;
            if target.datA != 0;    pValue -= target;
        // bareHasNoCount a bare down or across holds no number: its value reads as its own name, and comparing that with 0 printed a warning for every such field at every layout (tester's 16 lines a run; SEQ 745). The count is compared only when the direction holds one, and "*" only when it does not
        fdDirAt := argument[dIRECTion];
        fdDirKind = *fdDirAt.datA;
        fdCounts = 0;
        if fdDirKind == 5;      fdCounts = 1;
        if fdDirKind == 9;      fdCounts = 1;
        // starIsNotACount and a counted direction (down=3) is not compared with "*": that is the same warning from the other side
        fdStar = 0;
        if fdCounts == 0;
            if direct == "*";   fdStar = 1;
        if fdStar == 1;
            if memberCount > 1; print taG "can only have one member when" $dIRECTion "=*":;
            valueCount = 0;
            fdStep = target;
            if dIRECTion == "down";
                if argument["gap"];     fdStep = target + argument["gap"];
            valueCount = pValue / fdStep;
            if valueCount * fdStep > pValue;    --valueCount;
            // pourCount a poured field repeats its template once per member of its registry, whatever fits (P1); the copies are marked after the repeat
            fdPour = 0;
            if argument["pour"];    fdPour = 1;
            if fdPour == 1;
                psN = 0;
                psOk = 0;
                pourOpen(argument);
                if psOk == 1;   valueCount = psN - 1;
                // refusedPour the template row stays single: it is not repeated to fit
                if psOk == 0;   valueCount = 0;
                if psOk == 0;   fdPour = 0;
        else
            if fdCounts == 1;
                if direct > 0;
                    valueCount = direct - 1;
        // repeatInPlace the repeats are deep copies added to the field itself, so every member keeps the field as its parent and each copy owns its children (SEQ 653). A bare down or across adds nothing. The old way rebuilt the list in a scratch field from shallow copies: a member's children climbed to the scratch field, and the copies shared one set of children, all laid out where the last one fell.
        while valueCount > 0;
            --valueCount;
            fdSeen = 0;
            for grup in argument; members
                if fdSeen < memberCount;    argument +/ copyDeep(*grup);
                ++fdSeen;
        if fdPour == 1;
            psField := argument;
            psI = 0;
            pourStamp(*psReg);
        };
    /***************************************************************************
        pour -- data poured into a form (Tony's first draft, 2026-11-22; SEQ 741).
        A field written  down="*" pour:=aRegistry  holds ONE template row; on the
        laid-out copy fillDownAcross repeats the row once per member of the
        registry, in order (P1), and each copy is marked with the member it is
        for: an attribute each holding that member. Under a copy, each stands
        for its member (P2): fill:=each (any attribute holding each) is
        re-pointed at the member, and typeset's inserts read it -- {each} the
        member's value, {each.taG} its name, {aRegistry.each} that registry's
        entry of the member's name, nothing when it has none. color:=contrast
        (P3) is pourContrast, below. The definition is never written.
        Refused by name: pour on a field that is not down="*" (frameMembers);
        a pour that holds no registry, or an empty one; each outside a poured
        field (resolveLook, and typeset for an insert). A registry not on the
        search list is refused at define, as any := is.
    ***************************************************************************/
    psField;
    psReg;
    psMember;
    psN = 0;
    psI = 0;
    psJ = 0;
    psOk = 0;
    psDepth = 0;
    pourOpen code={
        poA := argument["pour"];
        poIs = *poA.isGrouP;
        if poIs == 0;
            cerr "setFrame: REFUSING" argument.taG "-- its pour holds no registry; write pour:=aRegistry":;
            return;
        psReg := **poA;
        poRn = string $**poA.taG$;
        poLen = *psReg.listLengtH;
        if poLen > 0;   pourCount(*psReg);
        if psN == 0;
            cerr "setFrame: REFUSING" argument.taG "-- its pour registry" poRn "has no members; the template row is left as written":;
            return;
        psOk = 1;
        };
    pourCount code={
        for grup in argument; members
            psN += 1;
        };
    pourStamp code={
        for grup in argument; members
            psMember := *grup;
            psJ = 0;
            pourRowAt(*psField);
            psI += 1;
        };
    pourRowAt code={
        for grup in argument; members
            if psJ == psI;  pourMark(*grup);
            psJ += 1;
        };
    pourMark code={
        pmE := new("each");
        *pmE := *psMember;
        argument :% *pmE;
        pourResolve(argument);
        };
    pourResolve code={
        // leafHasNoList a field with no attribute and no member has no list to walk
        prLen = 0;
        if argument.listLengtH;     prLen = 1;
        if prLen == 0;      return;
        for grup in argument; attributes
            prHeld = *grup.isGrouP;
            prIs = 0;
            if prHeld == 1;
                prTo = string $**grup.taG$;
                prAt = string $*grup.taG$;
                if prTo == "each";      prIs = 1;
                if prAt == "each";      prIs = 0;
            if prIs == 1;   *grup := *psMember;
        pourContrast(argument);
        if hasMemberS;
            for grup in argument; members
                pourResolve(*grup);
        };
    /***************************************************************************
        pour, stage 2 (Tony ruled D1-D6, 2026-11-22; SEQ 742) -- rows derived from
        what is poured. pourPlan walks the copy before the styles are merged.
        A down="*" pour:=aRegistry field with NO member has its rows built here,
        one a member, three cells: the member's name; a show-me chosen by what
        the member IS; and dESCRIPTIONs' entry of the member's name (keyed by
        name, as it is by field name), nothing when it has none. What a member is, by
        value (pourKind): a value starting # is a colour (a swatch printing the
        value, contrast text, a lineColor outline); a family is a font (sample
        text set in it); in sTYLEs with attributes, a style (sample text with
        the style); empty in sTYLEs, a placeholder, read as what the look gives
        it and shown through the placeholder, so a look switch shows; anything
        else shows its own text. A rule or an action is never read for text:
        reading one would fire it. A written template row is the override: the
        field keeps it and fillDownAcross repeats it (stage 1). Either way a
        poured field records what its rows need (pourNeeds: the rows and the
        gaps between them), which is what height=fit adds up; the field itself
        still takes its share of the room.
        A derived field stops being poured on the copy: pour is taken off it
        and it stacks its rows as a plain down.
    ***************************************************************************/
    pdField;
    pdM;
    pdTo;
    pdWords;
    pdHasWords = 0;
    pdKind = 0;
    pdVia = 0;
    pdRow;
    pdCell;
    pdRowH = 24;
    pdTotal = 0;
    pdCount = 0;
    pdSample = "Sample text 123";
    fitCap = 792;
    pourPlan code={
        ppIs = 0;
        if argument.listLengtH;
            if argument["pour"];    ppIs = 1;
        if ppIs == 1;   pourPlanOne(argument);
        // ownMembers read off argument: a bare hasMemberS reads what was referenced last
        ppWalk = argument.hasMemberS;
        if ppWalk == 1;
            for grup in argument; members
                pourPlan(*grup);
        };
    pourPlanOne code={
        poA := argument["pour"];
        poIs = *poA.isGrouP;
        if poIs == 0;   return;
        psReg := **poA;
        psN = 0;
        poLen = *psReg.listLengtH;
        if poLen > 0;   pourCount(*psReg);
        if psN == 0;    return;
        ppDown = 0;
        if argument["down"];
            ppD = string $argument["down"]$;
            if ppD == "*";  ppDown = 1;
        if ppDown == 0;     return;
        ppGap = 0;
        if argument["gap"];     ppGap = argument["gap"];
        ppKids = argument.hasMemberS;
        pdTotal = 0;
        if ppKids == 1;
            // templateRow the one row's own height, once a member
            pdRowH = 0;
            pourRowHeight(argument);
            pdTotal = psN * pdRowH;
        if ppKids == 0;
            pdField := argument;
            // describedByName a row's description is dESCRIPTIONs' entry of the member's name (Tony, 2026-11-22: no registry of its own, no attribute); no such registry yet, no descriptions
            pdHasWords = 0;
            if registries["dESCRIPTIONs"];
                pdWords := registries["dESCRIPTIONs"];
                pdHasWords = 1;
            pourDerive(*psReg);
            argument -% *poA;
            ppDn := argument["down"];
            argument -% *ppDn;
            argument :% new("down");
        ppGaps = psN - 1;
        ppGaps = ppGaps * ppGap;
        pdTotal = pdTotal + ppGaps;
        // needsNotHeight what the rows need is kept beside the field, not as its height: the field still takes its share of the room, so a row past it is noRoom as any is, and fitHeight adds this up
        ppH := new("pourNeeds");
        *ppH = pdTotal;
        argument :% *ppH;
        };
    pourRowHeight code={
        for grup in argument; members
            prhHas = 0;
            if *grup["height"];     prhHas = 1;
            if prhHas == 1;         pdRowH = *grup["height"];
        };
    pourDerive code={
        for grup in argument; members
            pdM := *grup;
            pourRowBuild();
        };
    // kindByValue what the member pdM holds is; pdTo is the member, or what the look gives a placeholder (Tony ruled by value, 2026-11-22)
    pourKind code={
        pdKind = 4;
        pdVia = 0;
        pdTo := *pdM;
        pkReg := *pdM.registrY;
        pkRi = pkReg.isGrouP;
        pkRn = string $"none"$;
        if pkRi == 1;       pkRn = string $*pkReg.taG$;
        pkD = *pdM.datA;
        pkL = *pdM.listLengtH;
        pkEmpty = 0;
        if pkD == 0;
            if pkL == 0;    pkEmpty = 1;
        if pkEmpty == 1;
            if pkRn == "sTYLEs";    pourThroughLook();
        pourKindOfTo();
        if pdKind == 4;
            if pdVia == 0;
                if pkRn == "sTYLEs";
                    if pkL > 0;     pdKind = 3;
        };
    pourThroughLook code={
        ptlN = string $*pdM.taG$;
        ptlDone = 0;
        if lkHas == 1;
            if *lkLook[ptlN];
                ptlTo := *lkLook[ptlN];
                pdTo := **ptlTo;
                ptlDone = 1;
        if ptlDone == 0;
            if lkBaseHas == 1;
                if *lkBase[ptlN];
                    ptlTo := *lkBase[ptlN];
                    pdTo := **ptlTo;
                    ptlDone = 1;
        if ptlDone == 1;    pdVia = 1;
        };
    pourKindOfTo code={
        pktD = *pdTo.datA;
        pktL = *pdTo.listLengtH;
        pktStr = 0;
        if pktD == 13;      pktStr = 1;
        if pktD == 14;      pktStr = 1;
        if pktStr == 1;
            pktC = *pdTo.numbeR;
            if pktC == 35;  pdKind = 1;
        if pktL > 0;
            if *pdTo["family"];     pdKind = 2;
        };
    // valueThenAttributes a cell's text is written before any attribute: writing a field's value drops the attributes it already has (measured, SEQ 742: a width added first was gone, and the cell took a share)
    pourCell code={
        pcl := new(argument);
        *pdRow +/ *pcl;
        // heldNotReturned the cell is handed back in pdCell: a returned field is a copy, and what is written to it never reaches the row
        pdCell := *pcl;
        };
    pourCentre code={
        pcv := new("valign");
        *pcv = "center";
        *pdCell :% *pcv;
        };
    pourWide code={
        pcw := new("width");
        *pcw = argument;
        *pcw :. isPercenT;
        *pdCell :% *pcw;
        };
    pourRowBuild code={
        prbName = string $*pdM.taG$;
        pourKind();
        pdRow := new("pourRow");
        *pdRow :% new("across");
        prbRowH = 24;
        // roomForTheFont a font's own row is as tall as its sample needs
        if pdKind == 2;
            prbSz = 0;
            if *pdTo["size"];   prbSz = *pdTo["size"];
            prbNeed = prbSz + 12;
            if prbNeed > prbRowH;   prbRowH = prbNeed;
        prbH := new("height");
        *prbH = prbRowH;
        *pdRow :% *prbH;
        pdTotal = pdTotal + prbRowH;
        pourCell("pourName");
        *pdCell = prbName;
        pourCentre();
        pourWide(30);
        pourCell("pourShow");
        prbS := *pdCell;
        if pdKind == 1;     *prbS = string $*pdTo$;
        if pdKind == 2;     *prbS = pdSample;
        if pdKind == 3;     *prbS = pdSample;
        if pdKind == 4;
            // neverFire a rule or an action is not read for its text: reading one would fire it
            prbSafe = 1;
            prbRule = *pdM.isRulE;
            prbAct = *pdM.actionTypE;
            prbMeth = *pdM.isMethoD;
            if prbRule != 0;    prbSafe = 0;
            if prbAct != 0;     prbSafe = 0;
            if prbMeth != 0;    prbSafe = 0;
            prbD = *pdM.datA;
            if prbD == 0;       prbSafe = 0;
            if prbSafe == 1;    *prbS = string $*pdM$;
        pourCentre();
        pourWide(25);
        prbSa := new("align");
        *prbSa = "center";
        *prbS :% *prbSa;
        if pdKind == 1;
            prbF := new("fill");
            if pdVia == 0;  *prbF := *pdTo;
            if pdVia == 1;  *prbF := *pdM;
            *prbS :% *prbF;
            prbC := new("color");
            *prbC := sTYLEs["contrast"];
            *prbS :% *prbC;
            *prbS :% new("border");
            prbK := new("strokeColor");
            *prbK := sTYLEs["lineColor"];
            *prbS :% *prbK;
        if pdKind == 2;
            prbFo := new("font");
            if pdVia == 0;  *prbFo := *pdTo;
            if pdVia == 1;  *prbFo := *pdM;
            *prbS :% *prbFo;
        if pdKind == 3;
            prbSt := new("style");
            *prbSt := *pdM;
            *prbS :% *prbSt;
        pourCell("pourWhat");
        if pdHasWords == 1;
            prbWl = *pdWords.listLengtH;
            if prbWl > 0;
                if *pdWords[prbName];
                    prbWe := *pdWords[prbName];
                    *pdCell = string $*prbWe$;
        pourCentre();
        *pdField +/ *pdRow;
        };
    /***************************************************************************
        fitHeight -- height=fit on the top field (D5): the form takes the height
        its members need -- their heights, the gaps between them and its margin
        twice -- capped at fitCap (792, a Letter page; a window stroke sets it
        from the display). A member with no height of its own cannot be added
        up: the cap is used and that is said by name. Past the cap the rows
        that do not fit are noRoom, as today.
    ***************************************************************************/
    fhSum = 0;
    fhOpen = 0;
    fhN = 0;
    fitHeight code={
        fhIs = 0;
        if argument["height"];
            fhT = string $argument["height"]$;
            if fhT == "fit";    fhIs = 1;
        if fhIs == 0;       return;
        fhSum = 0;
        fhOpen = 0;
        fhN = 0;
        fitAdd(argument);
        fhM = 0;
        if argument["margin"];  fhM = argument["margin"];
        fhGap = 0;
        if argument["gap"];     fhGap = argument["gap"];
        fhGaps = fhN - 1;
        fhGaps = fhGaps * fhGap;
        fhM2 = fhM * 2;
        fhWant = fhSum + fhGaps;
        fhWant = fhWant + fhM2;
        if fhOpen > 0;
            cerr "setFrame:" argument.taG "names height=fit and" fhOpen "of its members name no height of their own; it takes the cap," fitCap:;
            fhWant = fitCap;
        if fhWant > fitCap;     fhWant = fitCap;
        // freshNumber the height is replaced, not written: the old one holds the word fit, and a number written into it stays a string to the arithmetic below
        fhNew := new("height");
        *fhNew = fhWant;
        argument :% *fhNew;
        };
    fitAdd code={
        for grup in argument; members
            faHid = *grup.isHiddeN;
            if faHid == 0;
                fhN += 1;
                faHas = 0;
                faL = *grup.listLengtH;
                if faL > 0;
                    if *grup["height"];     faHas = 1;
                faNum = 0;
                if faHas == 1;
                    faH := *grup["height"];
                    faD = *faH.datA;
                    faP = *faH.isPercenT;
                    if faD == 5;    faNum = 1;
                    if faD == 9;    faNum = 1;
                    if faP != 0;    faNum = 0;
                // pouredNeeds a poured field with no height of its own counts what its rows need (pourPlan)
                faNeeds = 0;
                if faNum == 0;
                    if faL > 0;
                        if *grup["pourNeeds"];  faNeeds = 1;
                if faNeeds == 1;
                    faH := *grup["pourNeeds"];
                    faNum = 1;
                if faNum == 1;  fhSum = fhSum + *faH;
                if faNum == 0;  fhOpen += 1;
        };
    /***************************************************************************
        pourContrast -- color:=contrast (P3; Tony ruled the rule 2026-11-22): a
        field whose color holds contrast gets black or white text from its own
        fill. Brightness is 0.2126 R*R + 0.7152 G*G + 0.0722 B*B as a share of
        white's; at 17.9% or more the text is black, below it white (the point
        where black and white text contrast equally). One step a statement:
        kant has no precedence and the sums are near a count's limit. A field
        with no fill, or a fill that is not #rrggbb, loses the color attribute,
        so it takes the text colour in effect. A fill still holding each waits
        for its copy to be marked (pourResolve calls this again).
    ***************************************************************************/
    pourContrast code={
        pcHas = 0;
        if argument.listLengtH;
            if argument["color"];   pcHas = 1;
        if pcHas == 0;      return;
        pcCol := argument["color"];
        pcIs = *pcCol.isGrouP;
        if pcIs == 0;       return;
        pcName = string $**pcCol.taG$;
        if pcName != "contrast";    return;
        pcFillHas = 0;
        if argument["fill"];    pcFillHas = 1;
        if pcFillHas == 0;
            argument -% *pcCol;
            return;
        pcFill := argument["fill"];
        pcHeld = *pcFill.isGrouP;
        pcHex = string $*pcFill$;
        if pcHeld == 1;
            pcFn = string $**pcFill.taG$;
            if pcFn == "each";      return;
            pcHex = string $**pcFill$;
        pcLead = pcHex.numbeR;
        pcOk = 1;
        if pcLead != 35;    pcOk = 0;
        if pcOk == 0;
            argument -% *pcCol;
            return;
        pcR = string $pcHex$;
        ++pcR;
        pcR -= 4;
        pcG = string $pcHex$;
        ++pcG; ++pcG; ++pcG;
        pcG -= 2;
        pcB = string $pcHex$;
        ++pcB; ++pcB; ++pcB; ++pcB; ++pcB;
        pcRn = hexToNumber(pcR);
        pcGn = hexToNumber(pcG);
        pcBn = hexToNumber(pcB);
        pcR2 = pcRn * pcRn;
        pcG2 = pcGn * pcGn;
        pcB2 = pcBn * pcBn;
        pcSa = 2126 * pcR2;
        pcSb = 7152 * pcG2;
        pcSc = 722 * pcB2;
        pcSum = pcSa + pcSb;
        pcSum = pcSum + pcSc;
        // threshold 17.9% of white's 10000 * 255 * 255
        pcPick = string $"white"$;
        if pcSum >= 116394750;      pcPick = string $"black"$;
        pcReg := registries["cOLOr"];
        *pcCol := *pcReg[pcPick];
        };
    /***************************************************************************
         frameMembers sets frames for the members of the group passed in. It must
         have x y width and height attributes. It WRITES the group it is handed,
         so only setFrame calls it, and only on a copy.

         isHidden and noRoom (forms step 6, Tony's ruling of 2026-11-07; built
         SEQ 627). Two flags, two facts. isHidden is the author's: a field
         written isHiddeN takes no room, gets no frame, and neither it nor
         anything under it is laid out or drawn. noRoom is layout's and means
         only "does not fit": after a parent's members are placed, a member
         wholly outside the parent's box on either axis (or left with no width
         or no height) is flagged noRooM; it is not drawn and nothing under it
         is laid out. A member partly outside is drawn. Nothing is shrunk and
         layout does not stop. noRoom is written on the laid-out copy only, so
         every run decides it afresh.
    ***************************************************************************/
    frameMembers code={
        =:argument across down overlay width height x y;
        // oneDirection a field names down or across, never both (G3 item 1, Tony 2026-11-21): refused by name, its members are not laid out. A grid is a row level: down on the field, across on the one row it holds, the height on the row
        fmBoth = 0;
        if across.datA != 0;
            if down.datA != 0;  fmBoth = 1;
        if fmBoth == 1;
            cerr "setFrame: REFUSING" argument.taG "-- it names both down and across; a field takes one direction, so write the grid as rows (down on the field, across on a row it holds); its members are not laid out":;
            return;
        sideRoom    = width;
        pWidth      = width;
        headRoom    = height;
        pHeight     = height;
        pX          = x;
        pY          = y;
        boxX        = x;
        boxY        = y;
        boxR        = x + width;
        boxB        = y + height;
        upOut       = 0;
        sideOut     = 0;
        // marginIn margin=N: the content stands N points in from the field's edges (D3); the box that decides noRoom stays the field's own
        fmM = 0;
        if argument["margin"];  fmM = argument["margin"];
        if fmM > 0;
            fmM2 = fmM * 2;
            pX += fmM;
            pY += fmM;
            pWidth -= fmM2;
            pHeight -= fmM2;
            sideRoom -= fmM2;
            headRoom -= fmM2;
        // gapBetween gap=N on a field that stacks its members down: N points between one member and the next (D4)
        fmGap = 0;
        if argument["gap"];     fmGap = argument["gap"];
        fmGapN = 0;
        // overlayNamed a parent that names overlay (and neither down nor across) overlays its children: each fills the parent's box unless it declares its own width, height, x or y. A parent naming no direction stacks them, as down does: the old GUI's default, and what descriptions and unitTests' sample rely on (SEQ 626 W3; the default is Tony's to re-rule)
        laysOver    = 0;
        if overlay.datA != 0;
            if across.datA == 0;
                if down.datA == 0;  laysOver = 1;
        // pourNeedsStar pour repeats a template, and only down="*" has one (P1): anything else is refused by name and laid out as written
        fmPour = 0;
        if argument["pour"];    fmPour = 1;
        fmStar = 0;
        if fmPour == 1;
            fmDown = string $down$;
            if fmDown == "*";   fmStar = 1;
        if fmPour == 1;
            if fmStar == 0;     cerr "setFrame: REFUSING" argument.taG "-- it names pour and is not down=\"*\"; pour repeats one template row, so write down=\"*\" pour:=aRegistry; laid out as written":;
        if down.datA != 0;
            tARGET="height";
            dIRECTion="down";
            fillDownAcross(argument);
        if across.datA != 0;
            tARGET="width";
            dIRECTion="across";
            fillDownAcross(argument);
   /***************************************************************************
                 Create frame and set width and height
    ***************************************************************************/
        for grup in argument; members
            // hiddenTakesNoRoom an isHidden member is not sized, so it joins no share
            fmHid = *grup.isHiddeN;
            if fmHid == 0;
                =:grup width height;
                if width.isPercenT;
                    width = pWidth * width / 100;
                    *grup :% copyOf(width);
                if height.isPercenT;
                    height = pHeight * height / 100;
                    *grup :% copyOf(height);
                if width.datA != 0;
                    sideRoom    -= width;
                or across.datA == 0;
                    width = pWidth;
                    *grup :% copyOf(width);
                else
                    sideOut     +/ *grup;
                    ++sideOut;
                // gapTakesRoom every member after the first costs one gap of the room shared below
                if fmGap > 0;
                    if across.datA == 0;
                        if fmGapN > 0;      headRoom -= fmGap;
                        fmGapN += 1;
                if height.datA != 0;
                    headRoom    -= height;
                or across.datA != 0;
                    height = pHeight;
                    *grup :% copyOf(height);
                or laysOver == 1;
                    height = pHeight;
                    *grup :% copyOf(height);
                else
                    upOut       +/ *grup;
                    ++upOut;
        if upOut > 0;
            shareN = 0;
            shareUsed = 0;
            shareEdge = 0;
            for grup in upOut;
                ++shareN;
                shareEdge = headRoom * shareN / upOut;
                height = shareEdge - shareUsed;
                shareUsed = shareEdge;
                *grup :% copyOf(height);
        if sideOut > 0;
            shareN = 0;
            shareUsed = 0;
            shareEdge = 0;
            for grup in sideOut;
                ++shareN;
                shareEdge = sideRoom * shareN / sideOut;
                width = shareEdge - shareUsed;
                shareUsed = shareEdge;
                *grup :% copyOf(width);
        headRoom    = 0;
        sideRoom    = 0;
    /***************************************************************************
             Set x and y in frame
    ***************************************************************************/
        // fromTheParent under an overlaying parent a child's declared x and y are measured from the parent's origin (R4); under down or across they are not read, as before
        for grup in argument; members
            fmHid = *grup.isHiddeN;
            if fmHid == 0;
                =:grup width height x y;
                placeY = pY;
                placeX = pX;
                if laysOver == 1;
                    if y.datA != 0;     placeY = pY + y;
                if laysOver == 1;
                    if x.datA != 0;     placeX = pX + x;
                y = placeY;
                *grup :% copyOf(y);
                x = placeX;
                *grup :% copyOf(x);
                // doesNotFit noRoom means only this: wholly outside the parent's box on an axis, or no extent on one (Tony, 2026-11-07). Partly outside is drawn.
                fmRight = placeX + width;
                fmFoot  = placeY + height;
                fmOut   = 0;
                if placeX >= boxR;      fmOut = 1;
                if fmRight <= boxX;     fmOut = 1;
                if placeY >= boxB;      fmOut = 1;
                if fmFoot <= boxY;      fmOut = 1;
                if fmOut == 1;          *grup :. noRooM;
                if laysOver == 0;
                    if across.datA == 0;    pY += height;
                    if across.datA == 0;    pY += fmGap;
                if laysOver == 0;
                    if across.datA != 0;    pX += width;
        for grup in argument; members
            fmSkip = *grup.isHiddeN;
            fmGone = *grup.noRooM;
            if fmGone == 1;     fmSkip = 1;
            if fmSkip == 0;
                // holdsAForm a field written form:=other is filled by that form, laid out in the field's frame (G2 stroke 1b); its own members, if any, are not laid out
                fmHolds = 0;
                fmSelf := *grup;
                if *fmSelf["form"];     fmHolds = 1;
                if fmHolds == 1;        placeForm(*grup);
                if fmHolds == 0;
                    if *grup.hasMemberS;
                        frameMembers(*grup);
        };
    /***************************************************************************
        placeForm -- a form inside a field (G2 stroke 1b; Tony, 2026-11-13). A
        field written form:=other is the frame for that form: once the field has
        its own x y width height, the form is laid out by setFrame with the
        field as the request's frame, and the laid-out copy becomes the field's
        one member, so drawWalk draws it there with no change. Each field that
        holds a form gets its own copy. setFrame refuses a form that holds
        itself, directly or through other forms (sfChain holds the names of the
        forms being laid out); the field is then left empty.
        The reference may name the form itself (form:=other) or a field of
        its own that holds the form (shown := other; form:=shown). Writing
        that field tells its listeners, so a listener that calls redrawForm
        swaps the form shown in the field (G2 stroke 2).
    ***************************************************************************/
    placeForm code={
        pfHost := argument;
        pfRef := *pfHost["form"];
        // heldThroughAField the reference may name a field of its own that holds the form (shown := aForm); writing that field swaps the form (G2 stroke 2)
        pfTarget := **pfRef;
        pfVia = *pfTarget.isGrouP;
        if pfVia == 1;      pfTarget := **pfTarget;
        placeReq.form := *pfTarget;
        placeReq.frame := argument;
        // lookGoesDown the held form is laid out under its host's look (SEQ 655, stroke 4)
        placeReq.look = 0;
        if lkHas == 1;      placeReq.look := *lkLook;
        // hostLookKept the held form may take a look of its own (SEQ 723 R4), so the host's is kept and put back after it is laid out
        pfHas = lkHas;
        pfNamed = lkNamed;
        pfKeep := *lkLook;
        lkHeld = 1;
        if lkNamed == 1;    lkHeld = 2;
        // heldLayout tells the setFrame called next that its form is held in a field: it writes heldIn on its copy's top (the copy handed back here is a copy of that top, and the fields under it climb to the one setFrame made)
        sfHeldNext = 1;
        pfLaid := setFrame(placeReq);
        sfHeldNext = 0;
        lkHas = pfHas;
        lkNamed = pfNamed;
        if pfHas == 1;      lkLook := *pfKeep;
        pfGot = 0;
        if *pfLaid.listLengtH;      pfGot = 1;
        if pfGot == 1;              argument +/ *pfLaid;
        };
    frameWhole code={
        =:argument x y width height;
        fwOk = 1;
        if x.datA == 0;         fwOk = 0;
        if y.datA == 0;         fwOk = 0;
        if width.datA == 0;     fwOk = 0;
        if height.datA == 0;    fwOk = 0;
        };
    /***************************************************************************
        setFrame -- forms step 6 (Tony's design of 2026-11-07; SEQ 626).
        ONE argument, a request holding form:= the form and, optionally,
        frame:= a field of its own, outside the form, holding x y width height.
        setFrame copies the form, lays out the copy and returns it. The form's
        definition is never written, so a declared percent, a down=3 and the
        member set are all still there for the next run, and every run is a
        fresh run. With a frame the copy's top takes the frame's four values;
        with none it keeps the form's declared four. Only the top is gated:
        every child is laid out from its parent, so a percent follows the new
        size. The caller holds the returned copy (laid := setFrame(req)) and
        draws that; no laid-out result is saved anywhere.
        A request with no frame takes its form's entry in formFrames, if any,
        for the top field, then clears it (G3 item 2, Tony 2026-11-21): a part
        the entry lacks keeps the declared value. A request's own frame comes
        first, so a held form (placeForm names its host field) never reads it.
        Refuses by name and returns nothing: a request with no form; a frame
        that lacks any of x y width height (frameWhole).
    ***************************************************************************/
    setFrame code={
        // heldRead placeForm's word that this layout is of a held form: read and cleared FIRST, ahead of every refusal's return below -- left set by a refused layout it made the next plain layout write heldIn from a frame it did not have, and that refused the whole layout (found by formNestT NF-5, SEQ 764)
        sfHeldBy = sfHeldNext;
        sfHeldNext = 0;
        sfReq := argument;
        sfHas = 0;
        if *sfReq["form"];      sfHas = 1;
        if sfHas == 0;
            cerr "setFrame: REFUSING" argument.taG "-- its request holds no form; write form:=theForm":;
            return;
        sfUse = 0;
        if *sfReq["frame"];     sfUse = 1;
        if sfUse == 1;
            sfFrame := *sfReq["frame"];
            frameWhole(**sfFrame);
            if fwOk == 0;
                cerr "setFrame: REFUSING" argument.taG "-- its frame needs x, y, width and height":;
                return;
        sfForm := *sfReq["form"];
        // holdsItself the names of the forms being laid out; one met again is a form inside itself, refused by name and not laid out
        sfName := **sfForm.taG;
        if sfChain[*sfName];
            cerr "setFrame: REFUSING" argument.taG "-- the form" sfName "holds itself, directly or through another form; it is not laid out inside itself":;
            return;
        // topForm the name of the form this layout is for: the first one on sfChain, so a form held inside it is laid out under the same name. selectionPick and describePick read the selection kept under it (popups stroke 1)
        sfDeep = sfChain.listLengtH;
        if sfDeep == 0;     slTop = string $*sfName$;
        sfMark := new(*sfName);
        sfChain +% *sfMark;
        // deepCopy copyOf shares bodies below the second level, so a deep form would be written (measured, SEQ 626)
        sfLaid := copyDeep(**sfForm);
        if sfUse == 1;
            *sfLaid :% copyOf(**sfFrame["x"]);
            *sfLaid :% copyOf(**sfFrame["y"]);
            *sfLaid :% copyOf(**sfFrame["width"]);
            *sfLaid :% copyOf(**sfFrame["height"]);
        // frameStore (G3 item 2) with no frame in the request, the top field takes its form's entry in formFrames, read once and cleared; a part the entry lacks keeps the declared value. A held form never reads it: placeForm always hands it its host field as frame:= (measured SEQ 729: a depth test beside this guarded nothing)
        sfStore = 0;
        if sfUse == 0;
            if formFrames[*sfName];     sfStore = 1;
        // entOutsideArm bound at the top level: a := made inside an if arm holds nothing after it (measured SEQ 687)
        sfEnt := formFrames[*sfName];
        if sfStore == 1;
            fpFrom := *sfEnt;
            fpTo := *sfLaid;
            framePart("x");
            framePart("y");
            framePart("width");
            framePart("height");
            formFrames -% *sfEnt;
        setLook(argument);
        // lookRefused a look asked for by name that the form's looks list lacks (SEQ 723 R2): refused by name in setLookByName, nothing laid out
        if lkRefused == 1;
            sfChain -% *sfMark;
            return;
        // pourPlan before the styles are merged: derived rows are built, and every poured field with no height takes the height its rows need, so height=fit can add them up (pour stage 2)
        pourPlan(*sfLaid);
        fitHeight(*sfLaid);
        mergeStyles(*sfLaid);
        cardsPick(*sfLaid);
        selectionPick(*sfLaid);
        describePick(*sfLaid);
        // lookOnTheCopy the copy's top keeps the look this layout resolved through, as laidLook: a holder to the look, or the word none (popups stroke 0, F-158; Tony, 2026-11-23). typeset reads it at draw (tsLookFind). Written after mergeStyles, which would read an empty look as a placeholder, and before frameMembers, where a held form's layout moves the shared look fields
        sfLk := new("laidLook");
        if lkHas == 1;      *sfLk := *lkLook;
        if lkHas == 0;      *sfLk = "none";
        *sfLaid :% *sfLk;
        // formOnTheCopy the copy's top also keeps the name of the form this layout is for (slTop), a held form's top its host's: a click reads it to know which form's selection it is (popups stroke 1)
        // heldInItsHost a held form's top keeps a holder to the field that holds it, the request's frame. The fields under it climb to this top, which reads as no member and has no parent, so a click's climb crosses into the host through heldIn (clickUp; Tony, 2026-11-23)
        if sfUse == 0;      sfHeldBy = 0;
        if sfHeldBy == 1;
            sfIn := new("heldIn");
            *sfIn := **sfFrame;
            *sfLaid :% *sfIn;
        sfLf := new("laidForm");
        *sfLf = string $slTop$;
        *sfLaid :% *sfLf;
        frameMembers(*sfLaid);
        sfChain -% *sfMark;
        return *sfLaid;
        };
    lkLook;
    lkHas = 0;
    lkBase;
    lkBaseHas = 0;
    lkNamed = 0;
    lkHeld = 0;
    lkRefused = 0;
    lnHeld = 0;
    lnFirst = 0;
    rlSays = "setFrame:";
    /***************************************************************************
        setLook -- which looks a layout resolves placeholders through (SEQ 654).
        argument is setFrame's request. Its look:= is the first place looked;
        defaultLook (IncantForms/Controls/styles) is the second, when the styles
        file is loaded. mergeStyles reads the four fields this writes.
    ***************************************************************************/
    setLook code={
        slReq := argument;
        // heldOnce placeForm raises lkHeld for the one setFrame it calls: 1 the host's look is a look field, 2 it was picked by name from the host's list (SEQ 723 R4)
        slHeld = lkHeld;
        lkHeld = 0;
        lkRefused = 0;
        slForm := *slReq["form"];
        slF := **slForm;
        slHasList = 0;
        if *slF["looks"];       slHasList = 1;
        slAsk = 0;
        if *slReq["look"];      slAsk = 1;
        slLook := *slReq["look"];
        slByName = 0;
        if slHasList == 1;      slByName = 1;
        if slHeld == 2;         slByName = 1;
        lkHas = 0;
        lkNamed = 0;
        if slByName == 0;
            if slAsk == 1;      lkHas = 1;
            if slAsk == 1;      lkLook := **slLook;
        lnHeld = slHeld;
        if slByName == 1;   setLookByName(*slReq);
        lkBaseHas = 0;
        slBase := sTYLEs["defaultLook"];
        if *slBase.listLengtH;  lkBaseHas = 1;
        if lkBaseHas == 1;      lkBase := *slBase;
        };
    // firstIsDefault a looks list's first member is its default (R2); its own action, since a local bound inside an if arm holds nothing after it (SEQ 687)
    lookFirst code={
        for grup in argument; members
            if lnFirst == 0;    lkLook := *grup;
            lnFirst = 1;
        };
    /***************************************************************************
        setLookByName -- looks by name (Tony, 2026-11-20, SEQ 723 R2-R4).
        argument is setFrame's request; setLook calls this when the form
        carries looks:=aList or is held under a look picked by name. A look
        is asked for by name: look="dark" (a list member is on no search
        list, so look:=dark is refused at define), or by a held look field,
        matched by its tag. Its list's first member is the default.
        Top level: a name not in the list refuses by name (lkRefused) and
        setFrame lays nothing out. Held (R4): it takes its host's look name;
        a name its list lacks gives its own default, the first member, and a
        trace line says so; with no list at all it uses defaultLook silently.
    ***************************************************************************/
    setLookByName code={
        lnReq := argument;
        lnForm := *lnReq["form"];
        lnFName := **lnForm.taG;
        lnF := **lnForm;
        lnList := *lnF["looks"];
        lnHasList = 0;
        if *lnF["looks"];       lnHasList = 1;
        lnAsk = 0;
        if *lnReq["look"];      lnAsk = 1;
        lnLook := *lnReq["look"];
        lnVia = 0;
        if lnAsk == 1;          lnVia = *lnLook.isGrouP;
        lnName = "none";
        if lnAsk == 1;
            if lnVia == 1;      lnName = string $**lnLook.taG$;
            if lnVia == 0;      lnName = string $*lnLook$;
        lnHit = 0;
        if lnAsk == 1;
            if lnHasList == 1;
                if **lnList[lnName];    lnHit = 1;
        if lnHit == 1;
            lkLook := **lnList[lnName];
            lkHas = 1;
            lkNamed = 1;
        // byListOrder no hit: the list's first member is the default, else defaultLook (lkHas stays 0)
        lnFirst = 0;
        if lnHit == 0;
            if lnHasList == 1;
                lookFirst(**lnList);
        if lnFirst == 1;
            lkHas = 1;
            lkNamed = 1;
        lnMiss = 0;
        if lnAsk == 1;
            if lnHit == 0;      lnMiss = 1;
        if lnMiss == 1;
            if lnHeld == 0;     lkRefused = 1;
            if lnHeld == 0;     cerr "setFrame: REFUSING" lnFName "-- the request asks for the look" lnName "and its looks list holds no look by that name; nothing is laid out":;
            // listLacksIt the trace is for a held form whose list lacks the name; one with no list uses defaultLook silently, which is R1, not a fallback (ruled 2026-11-20)
            if lnHeld != 0;
                lnDef = "none";
                if lnFirst == 1;    lnDef = string $*lkLook.taG$;
                if lnFirst == 1;    cout "setFrame:" lnFName "is held under the look" lnName "and its looks list has none by that name; it uses its own default," lnDef:;
        };
    /***************************************************************************
        resolveLook -- placeholders through the look (SEQ 652 R2, R3). argument
        is a field on a laid-out copy, or a run's own copy of its style (typeset).
        Its attributes are re-pointed; nothing under it is walked. rlSays is the
        word the refusal opens with: setFrame's, or drawSpans' for a run.
    ***************************************************************************/
    resolveLook code={
        // placeholders an attribute that holds a placeholder (fill:=pageFill) is re-pointed, on the copy, at what the request's look holds under that name, else at what defaultLook holds; found in neither, it is refused by name and left as written (SEQ 652 R2, R3)
        for grup in argument; attributes
            msHolds = *grup.isGrouP;
            // emptyHeldField kant cannot read the virtual flag, so a placeholder is known by what it is: a held field with no value, no list and nothing held. A colour has a value, a font and an action have a list, a holder holds
            msPh = 0;
            if msHolds == 1;
                msPh = 1;
                msData = **grup.datA;
                msList = **grup.listLengtH;
                msVia = **grup.isGrouP;
                if msData != 0;     msPh = 0;
                if msList != 0;     msPh = 0;
                if msVia != 0;      msPh = 0;
            // eachAndContrast each is resolved per poured copy and contrast from the field's own fill (pour, pourContrast), never through a look; each outside a poured field is refused by name
            if msPh == 1;
                msPn = string $**grup.taG$;
                msAn = string $*grup.taG$;
                // pourHoldsARegistry an empty registry is a held field with nothing in it, as a placeholder is: pour's own refusal names it
                if msAn == "pour";      msPh = 0;
                if msPn == "contrast";  msPh = 0;
                if msPn == "each";
                    msPh = 0;
                    if psDepth == 0;
                        msAttr = *grup.taG;
                        cerr rlSays "REFUSING" argument.taG "-- its" msAttr "names each outside a poured field; each stands for a member only under down=\"*\" pour:=aRegistry":;
            if msPh == 1;
                msName := **grup.taG;
                msDone = 0;
                if lkHas == 1;
                    if *lkLook[*msName];
                        msTo := *lkLook[*msName];
                        *grup := **msTo;
                        msDone = 1;
                if msDone == 0;
                    if lkBaseHas == 1;
                        if *lkBase[*msName];
                            msTo := *lkBase[*msName];
                            *grup := **msTo;
                            msDone = 1;
                if msDone == 0;
                    msAttr = *grup.taG;
                    cerr rlSays "REFUSING" argument.taG "-- its" msAttr "names the placeholder" msName "and no look holds it; name it in the request's look or in defaultLook":;
        pourContrast(argument);
        };
    /***************************************************************************
        mergeStyles -- styles by merge at layout (Tony, 2026-11-14, SEQ 652 R1).
        Run by setFrame on the copy, before frameMembers. Every style:= a field
        holds is merged into that field: a deep copy of the style (R5), by
        GroupItem's merge, which adds an attribute only where the field has
        none of that name. So the field's own attributes always win, wherever
        style:= sits on the line, and of two styles the earlier wins. The
        definition and the style are never written. A style:= inside a style
        is not followed: styles are composed from styles by merge in a define.
    ***************************************************************************/
    mergeStyles code={
        for grup in argument; attributes
            msTag = *grup.taG;
            msIs = 0;
            if msTag == "style";    msIs = 1;
            msHeld = *grup.isGrouP;
            // notHeld style:= is the only spelling (SEQ 624 R0): a quoted or copied style name is refused by name, here since F-156 took the floor's own style read away, and the field has no style
            if msIs == 1;
                if msHeld == 0;
                    cerr "styleOf: REFUSING" argument.taG "-- its style is not held; write style:=name (a quoted or copied style name is retired)":;
            if msHeld == 0;         msIs = 0;
            if msIs == 1;
                msOwn := copyDeep(**grup);
                *msOwn :. mergeON;
                argument :. mergeON;
                argument +% *msOwn;
        resolveLook(argument);
        // pourDepth the fields under a poured field are its template: each is lawful there (resolveLook reads psDepth)
        msPoured = 0;
        if argument.listLengtH;
            if argument["pour"];    msPoured = 1;
        if msPoured == 1;   psDepth += 1;
        if hasMemberS;
            for grup in argument; members
                mergeStyles(*grup);
        msPoured = 0;
        if argument.listLengtH;
            if argument["pour"];    msPoured = 1;
        if msPoured == 1;   psDepth -= 1;
        };
    /***************************************************************************
        Convert the hex string in the target passed in to a floating point number
    ***************************************************************************/
    hexToNumber code={
        // ruledSpellings the walk tests data (a step past the last character leaves no value) and numbeR reads a character's code (SEQ 737); it walks a copy, since ++ on argument steps the caller's own string
        num = 0;
        hxWalk = argument;
        while hxWalk.datA;
            numDBL  = hxWalk.numbeR;
            if numDBL <= 57;    numDBL -= 48;
            or numDBL <= 70;    numDBL -= 55;
            or numDBL <= 102;   numDBL -= 87;
            ++hxWalk;
            num *= 16;
            num += numDBL;
        return num; };
    cpWant;
    cpTab;
    cpTabName;
    cpHits = 0;
    cpBars code={
        for grup in argument; members
            cbIs = 0;
            // listFirst a subscript on a field with no list says "does not contain a list"
            cbL = *grup.listLengtH;
            if cbL > 0;
                if *grup["tabs"];   cbIs = 1;
            if cbIs == 1;           cpBar(*grup);
            if *grup.hasMemberS;    cpBars(*grup);
        };
    cpBar code={
        cbHold := argument["tabs"];
        cbSel := **cbHold;
        // holdsTheTab the field holds the selected tab (tabSelected := tabThree); holding 0 it is nothing selected -- 0, not empty: an empty held field reads as a look placeholder (resolveLook)
        cbName = string $"none"$;
        cbIsTab = *cbSel.isGrouP;
        if cbIsTab == 1;
            cbTabIs := *cbSel;
            cbName = string $**cbTabIs.taG$;
        cbFound = 0;
        for grup in argument; members
            cbT = string $*grup.taG$;
            if cbFound == 0;
                if cbName == "none";    cbFound = 1;
                if cbT == cbName;       cbFound = 1;
                if cbFound == 1;        cpTab := *grup;
                if cbFound == 1;        cpTabName = string $cbT$;
        if cbFound == 0;
            cerr "setFrame: REFUSING the tab" cbName "-- the tab bar" argument.taG "has no tab by that name; the cards show their first":;
            return;
        cbHas = 0;
        cbTL = *cpTab.listLengtH;
        // selectFill the selected tab is filled with what its selectFill holds; the look has resolved both by now, and this is the copy (tabs stroke 3)
        cbSF = 0;
        if cbTL > 0;
            if *cpTab["selectFill"];    cbSF = cbSF + 1;
            if *cpTab["fill"];          cbSF = cbSF + 1;
        if cbSF == 2;
            cbFrom := *cpTab["selectFill"];
            cbTo := *cpTab["fill"];
            *cbTo := **cbFrom;
        if cbTL > 0;
            if *cpTab["card"];      cbHas = 1;
        if cbHas == 0;
            cerr "setFrame: REFUSING the tab" cpTabName "-- it names no card (card:=); the cards show their first":;
            return;
        cbCard := *cpTab["card"];
        cpWant = string $**cbCard.taG$;
        };
    cpCards code={
        for grup in argument; members
            ccIs = 0;
            ccL = *grup.listLengtH;
            if ccL > 0;
                if *grup["cards"];  ccIs = 1;
            if ccIs == 1;           cpOne(*grup);
            if *grup.hasMemberS;    cpCards(*grup);
        };
    cpOne code={
        coHas = 0;
        for grup in argument; members
            coN = string $*grup.taG$;
            if coN == cpWant;   coHas = 1;
        if coHas == 1;      cpHits += 1;
        coFirst = 1;
        for grup in argument; members
            coN = string $*grup.taG$;
            coShow = 0;
            if coHas == 1;
                if coN == cpWant;   coShow = 1;
            if coHas == 0;
                if coFirst == 1;    coShow = 1;
            coFirst = 0;
            if coShow == 0;     *grup :. isHiddeN;
        };
    /***************************************************************************
        cardsPick -- tabs and cards (tabs stroke 2, Tony's rulings of
        2026-11-18). setFrame calls it on the laid-out copy, never on the
        definition. A field written cards shows ONE member; the rest are
        isHiddeN on the copy, so they take no room and the shown one gets the
        cards field's whole box. Which one: a tab bar is a field with
        tabs:=someField, a field OUTSIDE the form (ruling 3) that holds the
        selected tab (tabSelected := tabThree); holding 0, the bar's first
        tab is the selected one (0, not empty: an empty held field reads as a
        look placeholder). The tab is matched by name on the copy. The selected tab names its card with card:=; the cards
        field that has a member of that name shows it. A cards field no tab
        points into shows its first member. A selected tab whose card is in
        no cards field, or a selected name the bar has no tab for, refuses by
        name, and every cards field then shows its first member.
        The selected tab is filled with what its selectFill holds (tabs
        stroke 3); every other tab keeps its own fill.
    ***************************************************************************/
    cardsPick code={
        cpWant = string $"none"$;
        cpHits = 0;
        cpBars(argument);
        cpCards(argument);
        if cpWant != "none";
            if cpHits == 0;
                cerr "setFrame: REFUSING the tab" cpTabName "-- its card" cpWant "is in no cards field; the cards show their first":;
        };
    /***************************************************************************
        formFrames -- G3 item 2 (Tony ruled 2026-11-21): frames kept by form name,
        for one run. An entry is a field named for the form holding any of x y
        width height. setFrame reads its own form's entry for the top field, then
        clears it; keepFrame writes one (a close, a resize, a redraw of an open
        window). Nothing goes to disk: a fresh run starts empty. The one place
        this state is defined.
    ***************************************************************************/
    formFrames;
    /***************************************************************************
        keepFrame -- ONE argument, a request: form:= the form and frame:= a
        field holding any of x y width height (a window's frame, or a new one).
        Writes the form's entry in formFrames, replacing an old one. A close is
        this alone. Refuses by name a request with no form or no frame.
    ***************************************************************************/
    // framePart copies the part named by argument (x, y, width, height) from fpFrom to fpTo when fpFrom has it. Presence is read from datA, not from the value: an attribute holding 0 tests false (measured, SEQ 766)
    fpFrom;
    fpTo;
    framePart code={
        fpName = string $argument$;
        fpA := *fpFrom[fpName];
        fpD = 0;
        fpD = *fpA.datA;
        if fpD > 0;     *fpTo :% copyOf(*fpFrom[fpName]);
        };
    keepFrame code={
        kfReq := argument;
        kfOk = 1;
        if *kfReq["form"];      kfOk = kfOk + 1;
        if *kfReq["frame"];     kfOk = kfOk + 1;
        if kfOk != 3;
            cerr "keepFrame: REFUSING" argument.taG "-- its request needs form:=theForm and frame:=aFrame":;
            return;
        kfForm := *kfReq["form"];
        kfName := **kfForm.taG;
        kfFrame := *kfReq["frame"];
        kfOld := formFrames[*kfName];
        kfHad = 0;
        if formFrames[*kfName];     kfHad = 1;
        if kfHad == 1;              formFrames -% *kfOld;
        kfEnt := new(*kfName);
        // zeroIsAPart a part is kept when it is THERE, a 0 included (framePart; until SEQ 766 a part holding 0 tested false and was dropped, so a frame at the screen's left edge or top lost its x or y)
        fpFrom := **kfFrame;
        fpTo := *kfEnt;
        framePart("x");
        framePart("y");
        framePart("width");
        framePart("height");
        formFrames +% *kfEnt;
        };
    tsSp isRule sp^-=[\t\r ];
    tsNl isRule nl^-=[\n];
    tsLine isRule tsNl^ tsSp^*;
    tsWord isRule word^=[^\t\n\r{} ]+;
    tsLit isRule lit^="{" more^-="{";
    tsOpen isRule open^="{" style^=[a-zA-Z0-9]+ colon^=":";
    tsQual isRule qins^="{" reg^=[a-zA-Z0-9]+ dot^="." name^=[a-zA-Z0-9]+ end^="}";
    tsIns isRule ins^="{" name^=[a-zA-Z0-9]+ end^="}";
    tsBrace isRule brace^="{";
    tsClose isRule close^="}";
    tsPiece isRule
        tsWord^;
        tsLit^;
        tsOpen^;
        tsQual^;
        tsIns^;
        tsBrace^;
        tsClose^;
    tsUnit isRule tsPiece^ tsSp^* tsLine^*;
    tsText isRule tsUnit+;
    tsInner isRule tsUnit+;
    tsWant;
    tsFound;
    tsHit;
    tsRun style depth;
    tsBoxNames fill border topBorder bottomBorder leftBorder rightBorder strokeColor rounded shadow opacity;
    tsRunName;
    tsRuns;
    tsSpan space font color italic;
    tsOut;
    tsRunCount;
    tsWho;
    tsEach;
    tsEachHit = 0;
    tsEachTag;
    // eachOf the member a poured copy is for: the nearest field at or above the one handed in that carries each (pourMark put it there); the climb stops at the top, which holds the drawing context
    tsEachFind code={
        tsEachHit = 0;
        teAt := argument;
        teHops = 0;
        while teHops < 32;
            teLen = *teAt.listLengtH;
            teHas = 0;
            if teLen > 0;
                if *teAt["each"];   teHas = 1;
            if teHas == 1;
                tsEach := *teAt["each"];
                tsEachHit = 1;
                teHops = 32;
            teTop = *teAt.isPointeR;
            if teTop == 1;      teHops = 32;
            if teHops < 32;     teAt := *teAt.parenT;
            teHops += 1;
        };
    tsLkHit = 0;
    tsLkAt;
    // lookOf the look a field was laid out under: the laidLook of the nearest field at or above the one handed in (setFrame put it on each laid-out copy's top, a held form's too); the climb stops at the top, which holds the drawing context. None found: a form drawn without setFrame
    tsLookFind code={
        tsLkHit = 0;
        tlAt := argument;
        tlHops = 0;
        while tlHops < 32;
            tlLen = *tlAt.listLengtH;
            tlHas = 0;
            if tlLen > 0;
                if *tlAt["laidLook"];   tlHas = 1;
            if tlHas == 1;
                tsLkAt := *tlAt["laidLook"];
                tsLkHit = 1;
                tlHops = 32;
            tlTop = *tlAt.isPointeR;
            if tlTop == 1;      tlHops = 32;
            if tlHops < 32;     tlAt := *tlAt.parenT;
            tlHops += 1;
        };
    tsFind code={
        for grup in argument; members
            if tsHit == 0;
                tfTag := *grup.taG;
                if *tfTag == *tsWant;
                    tsFound := *grup;
                    tsHit = 1;
            if tsHit == 0;
                if *grup.hasMemberS;    tsFind(*grup);
        };
    // boxWarn its own action because a for loop walks an argument's attributes and not a starred holder's (measured, SEQ 655)
    tsBoxWarn code={
        for grup in argument; attributes
            bwTag := *grup.taG;
            bwHit = 0;
            if tsBoxNames[*bwTag];      bwHit = 1;
            if bwHit == 1;
                bwField := *tsWho.taG;
                cerr "drawSpans: WARNING" bwField "-- its text names the style" tsRunName "which holds the box attribute" bwTag "-- a run takes font, color, italic and space only":;
        };
    /***************************************************************************
        typeset -- typesetting T1 (2026-11-12; Clay's pre-pass design, Tony's go).
        The kant pre-pass: it takes a field's text apart into paragraphs and
        spans and resolves each span's style, and the floor (drawSpans) only
        measures, breaks lines and paints. argument is the field whose own
        string is the text; the result is tsOut, a list of para groups, each a
        list of spans, and tsRunCount, the runs opened.
        The text is read by a small grammar, tsText. A tsUnit is one piece (a
        word, {{, an opening {style:, a lone brace, a closing brace) and the
        white space after it, one tsSp a space and one tsLine a line end; two
        line ends or more end the paragraph and every open run with it.
        A span is a copy of tsSpan: its own string is the piece; font, color
        and italic hold what the open runs' styles give, outermost first, or 0
        for the field's own; space is 1 when white space follows the span (a
        run of it is one gap), or holds a style's space, a width in points.
        A gap after a closing mark belongs to the span before the mark; a gap
        after an opening mark is dropped. A closing brace with no run open is
        text. A style name sTYLEs does not hold warns by name and the run
        prints plain.
        T3 (2026-11-13): {name} inserts the text of the form's field of that
        name (the top field or any field under it, first found). The text is
        split at white space, one span a word, each in the style of the runs
        open at the insert; nothing inside it is read as a mark. A name no
        field has warns by name and is left as written. tsFind is the search.
        {registry.name} (Tony, 2026-11-13) inserts that registry's entry and
        looks nowhere else; {name} looks in the form and nowhere else. A
        registry or an entry that is not there warns by name, left as written.
        PASSAGES (IBkant gap 1, Tony 2026-11-13): an insert's text is read as
        text, by the same grammar (tsInner). Its blank lines split paragraphs
        and its marks open and close runs, starting from the runs open at the
        insert. A run it opens ends with it; its closing brace never closes a
        run of the text that holds it. An insert inside inserted text warns by
        name and is left as written. This replaces T3's "nothing inside it is
        read as a mark".
    ***************************************************************************/
    typeset code={
        tyTree := tsText(argument);
        clear(tsOut);
        clear(tsRuns);
        tsRunCount = 0;
        tyOpen = 0;
        tyHave = 0;
        tyInside = 0;
        tyFloor = 0;
        tyUnit := *tyTree.firsT;
        while tyUnit.datA != 0;
            tyPiece := *tyUnit.firsT;
            tyLeaf := *tyPiece.firsT;
            tyKind := *tyLeaf.taG;
            tyGaps = 0;
            tyLines = 0;
            tyG := *tyPiece.nexT;
            while tyG.datA != 0;
                tyGaps = tyGaps + 1;
                if *tyG.taG == "tsLine";    tyLines = tyLines + 1;
                tyG := *tyG.nexT;
            tyIsSpan = 1;
            tyMode = 0;
            // insertFound mode 1: no field of that name, the three pieces print as written; 2: the field's words; 3: a field with no text of its own, nothing
            tyIns = 0;
            tyQuiet = 0;
            if *tyKind == "ins";    tyIns = 1;
            if *tyKind == "qins";   tyIns = 2;
            // noNested inside inserted text an insert is not followed: it warns by name and its pieces print as written
            tyDive = 0;
            if tyInside == 1;
                if tyIns > 0;
                    tyIns = 0;
                    tyMode = 1;
                    tyFt := *tsWho.taG;
                    cerr "drawSpans: WARNING" tyFt "-- inserted text holds an insert of its own; left as written":;
            // registryOnly a qualified insert looks in the named registry and nowhere else (Tony, 2026-11-13); registries holds every registry by name
            if tyIns == 2;
                tyRl := *tyLeaf.nexT;
                tyRg := *tyRl.texT;
                tyDl := *tyRl.nexT;
                tySl := *tyDl.nexT;
                tyNm := *tySl.texT;
                tyMode = 1;
                tsHit = 0;
                tyRegOk = 0;
                // eachInAnInsert {each.taG} is the poured member's name; {aRegistry.each} is that registry's entry of the member's name, and nothing when it has none (P2; it must not print its tag)
                tyEach = 0;
                if *tyRg == "each";     tyEach = 1;
                if *tyNm == "each";     tyEach = 2;
                if tyEach > 0;          tsEachFind(*tsWho);
                tyEachBad = 0;
                if tyEach > 0;
                    if tsEachHit == 0;  tyEachBad = 1;
                tyFt := *tsWho.taG;
                if tyEachBad == 1;
                    tyEach = 0;
                    tyRegOk = 2;
                    cerr "drawSpans: REFUSING" tyFt "-- its text names each outside a poured field; left as written":;
                if tyEach == 1;
                    tyRegOk = 2;
                    tyNmS = string $*tyNm$;
                    if tyNmS == "taG";
                        tsEachTag = string $**tsEach.taG$;
                        tsFound := tsEachTag;
                        tsHit = 1;
                    if tyNmS != "taG";
                        cerr "drawSpans: WARNING" tyFt "-- its text inserts each." tyNm "-- only each.taG is read; left as written":;
                if tyEach == 2;
                    tyEachNm = string $**tsEach.taG$;
                    tyQuiet = 1;
                if tyRegOk == 0;
                    if registries[*tyRg];
                        tyRegOk = 1;
                        tyRegH := registries[*tyRg];
                        if tyEach == 0;
                            if *tyRegH[*tyNm];
                                tsFound := *tyRegH[*tyNm];
                                tsHit = 1;
                        if tyEach == 2;
                            if *tyRegH[tyEachNm];
                                tsFound := *tyRegH[tyEachNm];
                                tsHit = 1;
                if tyRegOk == 0;
                    cerr "drawSpans: WARNING" tyFt "-- its text inserts from" tyRg "-- not a registry; left as written":;
                if tyRegOk == 1;
                    if tsHit == 0;
                        if tyQuiet == 0;    cerr "drawSpans: WARNING" tyFt "-- its text inserts" tyNm "from" tyRg "-- that registry has no such entry; left as written":;
            if tyIns == 1;
                tySl := *tyLeaf.nexT;
                tyNm := *tySl.texT;
                tyMode = 1;
                tyTop := *tsWho;
                tyHops = 0;
                while tyHops < 32;
                    tyIsTop = *tyTop.isPointeR;
                    if tyIsTop == 1;    tyHops = 32;
                    if tyIsTop == 0;    tyTop := *tyTop.parenT;
                    tyHops += 1;
                tsHit = 0;
                tsWant := *tyNm;
                // eachInsert {each} is the poured member itself, so its value is what is inserted (P2); outside a poured field it is refused by name
                tyEach = 0;
                if *tyNm == "each";     tyEach = 3;
                if tyEach == 3;
                    tsEachFind(*tsWho);
                    if tsEachHit == 1;
                        tsFound := **tsEach;
                        tsHit = 1;
                    if tsEachHit == 0;
                        tyFt := *tsWho.taG;
                        cerr "drawSpans: REFUSING" tyFt "-- its text names each outside a poured field; left as written":;
                tyTt := *tyTop.taG;
                if tyEach == 0;
                    if *tyTt == *tyNm;
                        tsFound := *tyTop;
                        tsHit = 1;
                    if tsHit == 0;
                        if *tyTop.hasMemberS;   tsFind(*tyTop);
                    if tsHit == 0;
                        tyFt := *tsWho.taG;
                        cerr "drawSpans: WARNING" tyFt "-- its text inserts" tyNm "-- no field of that name in the form; left as written":;
            // quietMiss a poured member with no entry in the qualified registry shows nothing
            if tyIns > 0;
                if tsHit == 0;
                    if tyQuiet == 1;    tyMode = 3;
            if tyIns > 0;
                if tsHit == 1;
                    tyMode = 3;
                    tyFh = *tsFound.datA;
                    tyFg = *tsFound.isGrouP;
                    if tyFg == 1;   tyFh = 0;
                    if tyFh != 0;
                        tyInTree := tsInner(*tsFound);
                        tyInFirst := *tyInTree.firsT;
                        if tyInFirst.datA != 0;     tyMode = 2;
            // dive mode 2: the insert's own units are walked next, by this same loop; tyFloor is the runs open at the insert, which its closing braces cannot close
            if tyMode == 2;
                tyDive = 1;
                tyIsSpan = 0;
                tyOutGaps = tyGaps;
                tyOutLines = tyLines;
                tyFloor = tyOpen;
            if *tyKind == "open";
                tyIsSpan = 0;
                tySl := *tyLeaf.nexT;
                tyNm := *tySl.texT;
                tyOpen = tyOpen + 1;
                tsRunCount = tsRunCount + 1;
                tsRun.depth = tyOpen;
                tsRun.style = 0;
                tyIsStyle = 0;
                if sTYLEs[*tyNm];   tyIsStyle = 1;
                if tyIsStyle == 0;
                    tyFt := *tsWho.taG;
                    cerr "drawSpans: WARNING" tyFt "-- its text names the style" tyNm "-- not a style; that run is printed plain":;
                // runsOwnStyle the run holds its own deep copy of the style, with its placeholders resolved through the look its form was laid out under (ownLayoutsLook, below; until SEQ 762 the look of the last layout) (SEQ 655, stroke 4); a box attribute in it is warned by name and does nothing in a run
                if tyIsStyle == 1;
                    tyOwn := copyDeep(sTYLEs[*tyNm]);
                    rlSays = "drawSpans:";
                    // ownLayoutsLook the run is resolved through the look its own form was laid out under, read from the copy (tsLookFind), not through the look of whichever layout ran last; the shared look fields are put back after (popups stroke 0, F-158)
                    tsLookFind(*tsWho);
                    tyLkWasHas = lkHas;
                    tyLkWas := *lkLook;
                    if tsLkHit == 1;
                        tyLkIs = *tsLkAt.isGrouP;
                        lkHas = 0;
                        if tyLkIs == 1;     lkLook := **tsLkAt;
                        if tyLkIs == 1;     lkHas = 1;
                    resolveLook(*tyOwn);
                    lkHas = tyLkWasHas;
                    if tyLkWasHas == 1;     lkLook := *tyLkWas;
                    rlSays = "setFrame:";
                    tsRun.style := *tyOwn;
                    tsRunName = *tyNm;
                    tsBoxWarn(*tyOwn);
                // ownEntry copyDeep, never copyOf: copyOf shares the depth attribute, and every entry then reads the last depth written
                tyE := copyDeep(tsRun);
                tsRuns +% *tyE;
            if *tyKind == "close";
                if tyOpen > tyFloor;
                    tyOpen = tyOpen - 1;
                    tyIsSpan = 0;
            if tyIsSpan == 1;
                if tyHave == 0;
                    tyPara := new("para");
                    tsOut +% *tyPara;
                    tyHave = 1;
                tyTxt := *tyLeaf.texT;
                tsSpan = *tyTxt;
                tsSpan.font = 0;
                tsSpan.color = 0;
                tsSpan.italic = 0;
                tsSpan.space = 0;
                tySpace = 0;
                // liveRuns the run open at each depth is the LAST entry written with that depth; the styles apply outermost first, so an inner run starts from its outer one
                tyD = 1;
                while tyD <= tyOpen;
                    tyPos = 0;
                    tyAt = 0;
                    tyE := tsRuns.firsT;
                    while tyE.datA != 0;
                        tyPos = tyPos + 1;
                        tyDp := *tyE["depth"];
                        if *tyDp == tyD;    tyAt = tyPos;
                        tyE := *tyE.nexT;
                    tyPos = 0;
                    tyE := tsRuns.firsT;
                    while tyE.datA != 0;
                        tyPos = tyPos + 1;
                        if tyPos == tyAt;
                            tyEs := *tyE["style"];
                            if **tyEs["font"];      tsSpan.font := **tyEs["font"];
                            if **tyEs["color"];     tsSpan.color := **tyEs["color"];
                            if **tyEs["italic"];    tsSpan.italic := **tyEs["italic"];
                            if **tyEs["space"];     tySpace = tyPos;
                        tyE := *tyE.nexT;
                    tyD = tyD + 1;
                // spaceAfter white space after the span, or after the closing marks that follow it directly
                tySp = 0;
                if tyGaps > 0;      tySp = 1;
                tyK = tyOpen - tyFloor;
                tyLook = 1;
                if tySp == 1;       tyLook = 0;
                tyNxt := *tyUnit.nexT;
                tyOut = 0;
                while tyLook == 1;
                    // lookPastInsert at the end of inserted text the look goes on in the text that holds it: the insert's own gap, then that text's closing marks
                    tyEnd = 0;
                    if tyNxt.datA == 0;     tyEnd = 1;
                    tySwitch = 0;
                    if tyEnd == 1;
                        if tyInside == 1;
                            if tyOut == 0;      tySwitch = 1;
                    if tySwitch == 1;
                        tyOut = 1;
                        tyEnd = 0;
                        tyK = tyFloor;
                        tyNxt := *tyBack.nexT;
                        if tyNxt.datA == 0;     tyEnd = 1;
                        if tyOutGaps > 0;
                            tySp = 1;
                            tyLook = 0;
                    if tyK == 0;            tyLook = 0;
                    if tyEnd == 1;          tyLook = 0;
                    if tyLook == 1;
                        tyNp := *tyNxt.firsT;
                        tyNl := *tyNp.firsT;
                        tyIsClose = 0;
                        if *tyNl.taG == "close";    tyIsClose = 1;
                        if tyIsClose == 0;  tyLook = 0;
                        if tyIsClose == 1;
                            tyK = tyK - 1;
                            tyNg := *tyNp.nexT;
                            if tyNg.datA != 0;
                                tySp = 1;
                                tyLook = 0;
                            tyNxt := *tyNxt.nexT;
                // styleSpace the gap's width comes from the innermost open style that names space (Tony, 2026-11-12)
                tyHasSp = 0;
                if tySpace > 0;
                    tyPos = 0;
                    tyE := tsRuns.firsT;
                    while tyE.datA != 0;
                        tyPos = tyPos + 1;
                        if tyPos == tySpace;
                            tySpEs := *tyE["style"];
                            tyHasSp = 1;
                        tyE := *tyE.nexT;
                // emitSpans one span for a piece; an insert left as written prints its pieces, one span each, the last taking the gap
                tyW := *tyLeaf;
                tyMore = 1;
                if tyMode == 3;     tyMore = 0;
                while tyMore == 1;
                    tyWn := *tyW.nexT;
                    tyLast = 0;
                    if tyWn.datA == 0;  tyLast = 1;
                    if tyMode == 0;     tyLast = 1;
                    tyTxt := *tyW.texT;
                    tyGapOn = 0;
                    if tyLast == 1;     tyGapOn = tySp;
                    tsSpan = *tyTxt;
                    tsSpan.space = tyGapOn;
                    if tyGapOn == 1;
                        if tyHasSp == 1;    tsSpan.space := **tySpEs["space"];
                    // ownSpan copyDeep, never copyOf: copyOf shares the four slots, and every span then reads the last one's
                    tyNew := copyDeep(tsSpan);
                    *tyPara +% *tyNew;
                    if tyLast == 1;     tyMore = 0;
                    if tyLast == 0;     tyW := *tyWn;
            if tyDive == 0;
                if tyLines > 1;
                    tyHave = 0;
                    clear(tsRuns);
                    tyOpen = 0;
                    tyFloor = 0;
                tyUnit := *tyUnit.nexT;
            if tyDive == 1;
                tyBack := *tyUnit;
                tyUnit := *tyInFirst;
                tyInside = 1;
            // surface the inserted text is done: the runs it opened end, and the insert's own blank line, if it had one, ends the paragraph
            if tyInside == 1;
                if tyUnit.datA == 0;
                    tyInside = 0;
                    tyOpen = tyFloor;
                    tyFloor = 0;
                    if tyOutLines > 1;
                        tyHave = 0;
                        clear(tsRuns);
                        tyOpen = 0;
                    tyUnit := *tyBack.nexT;
        };
    textReq field source font color align valign italic spans runs;
    imageReq field source fit;
    /***************************************************************************
        drawWalk -- forms step 2: draw a form, parent before child, depth first.
        The top field opens the display (makeDisplay hands it down as each
        descendant's display property, step 1), then every field that names a
        fill, or a style for displayFill to resolve, fills into it at page
        coordinates. A field naming neither is skipped, not refused. After its
        fill, a field naming border or a side (topBorder, bottomBorder,
        leftBorder, rightBorder) draws it through displayBorder (forms step 3).
        A top that already holds a context (openPDF's, or a bitmap the caller
        opened) is drawn into as it stands: drawWalk opens no bitmap of its own
        (forms step 4). The capture is `=`, not `:=`: a := capture is a holder,
        and `dwOpen == 0` then reads false on a 0 (measured 2026-11-08; #55's
        family). isPointeR always writes 0 or 1, so `=` carries it.
        drawKids descends where *grup.hasMemberS: grup is the loop's holder, so
        the star is needed (grup.hasMemberS reads nothing; measured 2026-11-08,
        bar 1, every leaf 0).
    ***************************************************************************/
    drawWalk code={
        dwOpen = argument.isPointeR;
        if dwOpen == 0;     makeDisplay(argument);
        drawFill(argument);
        drawImage(argument);
        drawBorder(argument);
        drawText(argument);
        drawKids(argument);
        };
    /***************************************************************************
        drawText -- forms step 5 (Tony, 2026-11-09, SEQ 582). Resolves a field's
        font, color, align (step 5a, SEQ 584), valign (step 5b, SEQ 605) and italic (SEQ 624) in kant and hands drawSpans one request, textReq,
        written afresh on every call. Each of font and color comes from the
        field's own attribute, else the enclosing field's, walking up to the top
        (the field holding the display). A style is not looked up here: setFrame's
        mergeStyles has already merged every style:= into its field on the copy
        (SEQ 652 R1), so a form drawn without setFrame gets no style's text properties. Nothing found leaves the slot at 0: drawSpans then draws
        Helvetica 12 in black, left-aligned. The text is the field's own string, or, when the
        field holds a group, that group's (*argument, one level). A field with
        no text costs a call and draws nothing (drawSpans skips it).
    ***************************************************************************/
    drawText code={
        textReq.field := argument;
        dtG = argument.isGrouP;
        if dtG == 1;    textReq.source := *argument;
        else            textReq.source := argument;
        // sourceHeld the same choice kept in a local, for the pre-pass below: a slot of textReq cannot be starred through a dot
        if dtG == 1;    dtSrc := *argument;
        else            dtSrc := argument;
        // describeShown a field with a describe attribute shows that attribute's text (SEQ 608 R2)
        dtSelf := argument;
        if *dtSelf["describe"];     textReq.source := *dtSelf["describe"];
        if *dtSelf["describe"];     dtSrc := *dtSelf["describe"];
        // imageText an image field's text is its description, never drawn over the image (SEQ 608 R2)
        dtDraw = 1;
        if *dtSelf["image"];        dtDraw = 0;
        textReq.font = 0;
        textReq.color = 0;
        textReq.align = 0;
        textReq.valign = 0;
        textReq.italic = 0;
        dtItalic = 0;
        dtFont = 0;
        dtColor = 0;
        dtAlign = 0;
        dtValign = 0;
        dtCur := argument;
        dtHops = 0;
        while dtHops < 32;
            if dtFont == 0;
                if *dtCur["font"];
                    textReq.font := *dtCur["font"];
                    dtFont = 1;
            if dtColor == 0;
                if *dtCur["color"];
                    textReq.color := *dtCur["color"];
                    dtColor = 1;
            if dtAlign == 0;
                if *dtCur["align"];
                    textReq.align := *dtCur["align"];
                    dtAlign = 1;
            if dtValign == 0;
                if *dtCur["valign"];
                    textReq.valign := *dtCur["valign"];
                    dtValign = 1;
            // italicInherits a text property (SEQ 624): the nearest field naming italic decides
            if dtItalic == 0;
                if *dtCur["italic"];
                    textReq.italic := *dtCur["italic"];
                    dtItalic = 1;
            dtTop = *dtCur.isPointeR;
            if dtTop == 1;      dtHops = 32;
            if dtFont == 1;
                if dtColor == 1;
                    if dtAlign == 1;
                        if dtValign == 1;
                            if dtItalic == 1;   dtHops = 32;
            // climbUp the walk goes on to the enclosing field (style is scoped to the subtree, 2026-11-03)
            dtCur := *dtCur.parenT;
            dtHops += 1;
        // prePass kant's typeset builds the span list from a source that holds its own string; the floor refuses every other source by name, as it did (typesetting T1, 2026-11-12)
        textReq.spans = 0;
        textReq.runs = 0;
        if dtDraw == 1;
            tsWho := argument;
            dtHas = *dtSrc.datA;
            dtHeld = *dtSrc.isGrouP;
            dtTopText = *dtSrc.isPointeR;
            if dtHeld == 1;     dtHas = 0;
            if dtTopText == 1;  dtHas = 0;
            if dtHas != 0;
                typeset(*dtSrc);
                textReq.spans := tsOut;
                textReq.runs = tsRunCount;
            drawSpans(textReq);
        };
    /***************************************************************************
        drawImage -- forms step 8 (Tony, 2026-11-10, SEQ 609). A field with an
        image attribute hands displayImage one request, imageReq, written afresh
        on every call: the field, and the image attribute as the source (its
        text is the file's path). fit stays 0, which the floor reads as fill:
        no attribute names a fit yet. Drawn after the fill and before the
        border, so the border sits on the image.
    ***************************************************************************/
    drawImage code={
        diSelf := argument;
        if *diSelf["image"];
            imageReq.field := argument;
            imageReq.source := *diSelf["image"];
            imageReq.fit = 0;
            displayImage(imageReq);
        };
    drawFill code={
        if argument["fill"];    displayFill(argument);
        };
    drawBorder code={
        if argument["border"];          displayBorder(argument);
        or argument["topBorder"];       displayBorder(argument);
        or argument["bottomBorder"];    displayBorder(argument);
        or argument["leftBorder"];      displayBorder(argument);
        or argument["rightBorder"];     displayBorder(argument);
        };
    drawKids code={
        for grup in argument; members
            // skipsHiddenAndNoRoom neither an isHidden field nor a noRoom one is drawn, nor anything under it (forms step 6)
            dkSkip = *grup.isHiddeN;
            dkGone = *grup.noRooM;
            if dkGone == 1;     dkSkip = 1;
            if dkSkip == 0;
                drawFill(*grup);
                drawImage(*grup);
                drawBorder(*grup);
                drawText(*grup);
                if *grup.hasMemberS;    drawKids(*grup);
                // outlineOverHeld a selected field that holds a form is outlined again after the held form is drawn, so the outline is over it and not under its fill (Tony, 2026-11-23; spPaint marks the field outlineOver)
                if *grup.hasMemberS;    drawOver(*grup);
        };
    drawOver code={
        if argument["outlineOver"];     drawBorder(argument);
        };
    windowReq path form look;
    layReq form look;
    // displaySize the display less menu bar and dock, in points; 0 until a window is laid out (guiHost.mm displayPublish writes it)
    displaySize width=0 height=0;
    pageReq path form width height;
    /***************************************************************************
        selectionPick -- the selected field shows (windows stroke 2; W3, Tony
        2026-11-22). setFrame calls it on the laid-out copy, after cardsPick.
        SELECTION IS PER FORM (popups stroke 1; Tony, 2026-11-23): selections
        keeps, by the name of the form a click was made in, the name of the
        field selected there (selectKeep), and a layout reads the entry of the
        form it is laying out (slTop; a form held inside it reads the same
        one). So two open forms each keep their own selection, and a field of
        the same name in another form is not outlined. `selection` itself still
        holds the field clicked last, in any form, for actions that read it.
        When the form has a selection, the copy's first field of that name
        (the top, then depth first) is OUTLINED in a selectFill (it was filled
        with it until 2026-11-23; the placeholder keeps its name): its own, when
        it names one (as a tab does), else the one the look holds (the
        request's look, then defaultLook). No selectFill anywhere: the field
        is drawn as it was, and nothing is said. The definition is never
        written. The field is matched by NAME, as a tab is: selection may be
        the definition's field (the mock click) or a field of an earlier copy
        (a click from a point), and neither is in this copy.
    ***************************************************************************/
    selectionPick code={
        spHit = 0;
        spN = selections.listLengtH;
        spHas = 0;
        if spN > 0;
            if selections[slTop];   spHas = 1;
        if spHas == 0;      return;
        spEnt := selections[slTop];
        spName = string $*spEnt$;
        spTopName = string $argument.taG$;
        if spTopName == spName;
            spField := argument;
            spHit = 1;
        if spHit == 0;      spFind(argument);
        if spHit == 0;      return;
        spOwn = 0;
        spHasFill = 0;
        spL = *spField.listLengtH;
        if spL > 0;
            if *spField["selectFill"];  spOwn = 1;
            if *spField["fill"];        spHasFill = 1;
        spVia = 0;
        if spOwn == 0;
            if lkHas == 1;
                if *lkLook["selectFill"];   spVia = 1;
        spBase = 0;
        if spOwn == 0;
            if spVia == 0;
                if lkBaseHas == 1;
                    if *lkBase["selectFill"];   spBase = 1;
        if spOwn == 1;      spPaint(*spField["selectFill"]);
        if spVia == 1;      spPaint(*lkLook["selectFill"]);
        if spBase == 1;     spPaint(*lkBase["selectFill"]);
        };
    /***************************************************************************
        describePick -- describe on select (Tony, 2026-11-23; windows stroke B).
        setFrame calls it on the laid-out copy, after selectionPick. The form's
        HELP BOX is the copy's first field carrying a describe attribute (depth
        first); a form with none: nothing. When the selected field is in this
        copy (selectionPick found it) and dESCRIPTIONs holds an entry of its
        name, the help box's describe text, on the copy, becomes that entry's,
        and drawText shows it. A field with no entry: the box is left with its
        own text. Selecting the help box itself changes nothing: the box goes
        on showing what it described last (describedNames, kept by the form's
        name since popups stroke 1, so two open forms each remember their own).
        The definition is never written: every layout starts from the box's
        own text.
    ***************************************************************************/
    describePick code={
        if spHit == 0;      return;
        dpHit = 0;
        dpFind(argument);
        if dpHit == 0;      return;
        dpBoxName = string $*dpBox.taG$;
        dpName = string $spName$;
        dpIsBox = 0;
        if dpName == dpBoxName;     dpIsBox = 1;
        // describedPerForm what a form's help box described last is kept by the form's name, as its selection is (popups stroke 1)
        dpN = describedNames.listLengtH;
        dpHadWas = 0;
        if dpN > 0;
            if describedNames[slTop];   dpHadWas = 1;
        dpOld := describedNames[slTop];
        dpWas = "none";
        if dpHadWas == 1;   dpWas = string $*dpOld$;
        if dpIsBox == 1;    dpName = string $dpWas$;
        if dpIsBox == 0;
            if dpHadWas == 1;   describedNames -% *dpOld;
            dpNew := new(slTop);
            *dpNew = string $spName$;
            describedNames +% *dpNew;
        dpHas = 0;
        if registries["dESCRIPTIONs"];
            dpWords := registries["dESCRIPTIONs"];
            if *dpWords[dpName];    dpHas = 1;
        if dpHas == 0;      return;
        dpEnt := *dpWords[dpName];
        dpTo := *dpBox["describe"];
        *dpTo = *dpEnt;
        cout "=== describe" dpBoxName "shows the description of" dpName "===":;
        };
    dpFind code={
        for grup in argument; members
            if dpHit == 0;
                dfL = *grup.listLengtH;
                dfHas = 0;
                if dfL > 0;
                    if *grup["describe"];   dfHas = 1;
                if dfHas == 1;
                    dpBox := *grup;
                    dpHit = 1;
            if dpHit == 0;
                if *grup.hasMemberS;    dpFind(*grup);
        };
    spFind code={
        for grup in argument; members
            if spHit == 0;
                sfT = string $*grup.taG$;
                if sfT == spName;
                    spField := *grup;
                    spHit = 1;
            if spHit == 0;
                if *grup.hasMemberS;    spFind(*grup);
        };
    // spPaint argument is the attribute holding the selection colour. The selected field is OUTLINED in it, on the copy, and its fill is left alone, so its text is never hidden (Tony, 2026-11-23; it was a fill). The outline is the field's border, two points wide, in that colour: displayBorder draws a border inside the frame and layout reads no border, so nothing moves. A field naming sides (bottomBorder ...) is given all four, since named sides are the only ones drawn; any other field a plain border, which follows rounded corners.
    spPaint code={
        spSrc := argument;
        spSides = 0;
        if *spField["topBorder"];       spSides = 1;
        if *spField["bottomBorder"];    spSides = 1;
        if *spField["leftBorder"];      spSides = 1;
        if *spField["rightBorder"];     spSides = 1;
        if spSides == 0;    spEdge("border");
        if spSides == 1;
            spEdge("topBorder");
            spEdge("bottomBorder");
            spEdge("leftBorder");
            spEdge("rightBorder");
        spHasStroke = 0;
        if *spField["strokeColor"];     spHasStroke = 1;
        if spHasStroke == 1;
            spTo := *spField["strokeColor"];
            *spTo := **spSrc;
        if spHasStroke == 0;
            spNew := new("strokeColor");
            *spNew := **spSrc;
            *spField +% *spNew;
        // overTheHeldForm a selected field that holds a form is marked, on the copy, to have its border drawn once more after its members (drawKids, drawOver): the held form's fill covers the first one
        spHolds = 0;
        if *spField["form"];    spHolds = 1;
        if spHolds == 1;
            spOv := new("outlineOver");
            *spOv = 1;
            *spField +% *spOv;
        };
    // spEdge the named border of the selected field becomes two points wide, made if the field has none
    spEdge code={
        seName = string $argument$;
        seHas = 0;
        if *spField[seName];    seHas = 1;
        if seHas == 1;
            seTo := *spField[seName];
            *seTo = 2;
        if seHas == 0;
            seNew := new(seName);
            *seNew = 2;
            *spField +% *seNew;
        };
    showPath path="IncantForms/PDF/output.pdf";
    showReq path form look;
    ckFn;
    ckNm;
    // clickFired clickFire writes it when it fires an action, clickField's climb reads it (declared: more than one action touches it)
    ckFired = 0;
    spName;
    spHit = 0;
    dpHit = 0;
    dpBox;
    dpWords;
    // describedNames by form name, the name that form's help box described last, so selecting the help box itself changes nothing (popups stroke 1; it was one describedName for the run)
    describedNames;
    // selections by form name, the name of the field selected in that form (selectKeep writes, selectionPick reads; popups stroke 1). slTop is the form a layout is for; skForm and skField are what a click hands selectKeep
    selections;
    sfHeldNext = 0;
    slTop = "none";
    skForm = "none";
    skField = "none";
    /***************************************************************************
        selectable -- which fields a click can select (Tony, 2026-11-23, windows
        TO DO 1; narrows 2026-11-04's "a click always selects first"). ONE
        argument, a field on a laid-out copy. A field that is only room is not
        selectable. It is selectable when it has any of: text of its own; an
        image; an action of its own or an attribute holding one (onClick:=);
        a describe attribute (a help box); a selectFill of its own (a tab); an
        entry of its name in dESCRIPTIONs. The answer is selCan, 1 or 0, and
        selWhy says which, the first found in that order.
    ***************************************************************************/
    selCan = 0;
    selWhy = "room";
    selectable code={
        selCan = 0;
        selWhy = "room";
        sbData = argument.datA;
        sbHeld = argument.isGrouP;
        if sbHeld == 1;     sbData = 0;
        if sbData != 0;
            selCan = 1;
            selWhy = "text";
        sbL = argument.listLengtH;
        if sbL > 0;
            if selCan == 0;
                if argument["image"];       selWhy = "image";
                if argument["image"];       selCan = 1;
            if selCan == 0;
                if argument["CodE"];        selWhy = "action";
                if argument["CodE"];        selCan = 1;
            if selCan == 0;     selectableAttr(argument);
            if selCan == 0;
                if argument["describe"];    selWhy = "describe";
                if argument["describe"];    selCan = 1;
            if selCan == 0;
                if argument["selectFill"];  selWhy = "selectFill";
                if argument["selectFill"];  selCan = 1;
        if selCan == 0;
            sbName = string $argument.taG$;
            if registries["dESCRIPTIONs"];
                sbWords := registries["dESCRIPTIONs"];
                if *sbWords[sbName];    selWhy = "description";
                if *sbWords[sbName];    selCan = 1;
        };
    // selectableAttr an attribute holding an action, as clickFire finds one; its own loop, since a for inside an if arm is not written anywhere here
    selectableAttr code={
        for grup in argument; attributes
            saHeld = *grup.isGrouP;
            saActs = 0;
            if saHeld == 1;
                if **grup["CodE"];      saActs = 1;
            saAn := *grup.taG;
            if *saAn == "this";     saActs = 0;
            if *saAn == "heldIn";   saActs = 0;
            if saActs == 1;
                selCan = 1;
                selWhy = "action";
        };
    selectKeep code={
        skF = string $skForm$;
        skN = selections.listLengtH;
        skHad = 0;
        if skN > 0;
            if selections[skF];     skHad = 1;
        skOld := selections[skF];
        if skHad == 1;      selections -% *skOld;
        skEnt := new(skF);
        *skEnt = string $skField$;
        selections +% *skEnt;
        };
    // windowShut a window's close (guiHost.mm windowClosed calls it): ONE argument, the window's request, form:= and frame:=. The frame is kept for the form's next opening (keepFrame alone is a close, G3), and the form's selection goes: a form reopened starts with nothing selected and its help box with its own text (Tony, 2026-11-23)
    windowShut code={
        keepFrame(argument);
        wxReq := argument;
        wxHas = 0;
        if *wxReq["form"];      wxHas = 1;
        wxForm := *wxReq["form"];
        if wxHas == 1;      unselect(**wxForm);
        // popupForgets a popup that closes forgets what it was opened on (popupTargets, by the popup form's name)
        if wxHas == 1;
            popName = string $**wxForm.taG$;
            popupForget();
        };
    /***************************************************************************
        popup -- popups stroke 2 (Tony, 2026-11-23; docs/popupsRecon.md, rulings
        1, 2 and 4). ONE argument, a request: form:= the popup form and on:= the
        field it is opened on, a field of a laid-out copy in a window (what a
        click action is handed, or selection). The popup form opens in a window
        of its own AT THAT FIELD, every time: its top left under the field's
        bottom left, in the screen points the field's frame is already in. Its
        size is its own (declared, or height=fit). Open already, it is closed
        and opened again at the new field, so one popup form is one window.
        IT REMEMBERS WHAT IT WAS OPENED ON in popupTargets, by the popup
        form's name: form= the name of the form the window it was opened from
        shows (laidForm), field= the field's name, and each= the poured member's
        name when the field is in a poured row. NAMES, not the field: the copy
        that was clicked is thrown away at the next layout, and a value goes
        back by name (ruling 4). By the popup form, because a popup form has one
        window. In kant, beside selections and formFrames, so OK and Cancel
        (kant actions) read it with no door into the window code. The entry is
        removed when the popup closes (windowShut).
        windows = 1 shows it; windows = 2, or INCANT_NOVIEW set, makes the
        window and does not show it; windows = 0 refuses by name: a popup has
        no PDF. Refuses by name: a request lacking form:= or on:=; a field with
        no frame (not on a laid-out copy).
        IT BELONGS TO ITS FORM (stroke 4): see itsOwner, below.
    ***************************************************************************/
    popupTargets;
    popWin form look frame owner;
    popName = "none";
    popupForget code={
        pfN = popupTargets.listLengtH;
        pfHad = 0;
        if pfN > 0;
            if popupTargets[popName];   pfHad = 1;
        pfOld := popupTargets[popName];
        if pfHad == 1;      popupTargets -% *pfOld;
        };
    popup code={
        poReq := argument;
        poOk = 1;
        if *poReq["form"];      poOk = poOk + 1;
        if *poReq["on"];        poOk = poOk + 1;
        if poOk != 3;
            cerr "popup: REFUSING" argument.taG "-- its request needs form:=thePopupForm and on:=theField it is opened on":;
            return;
        poFa := *poReq["form"];
        poOa := *poReq["on"];
        poForm = string $**poFa.taG$;
        poField = string $**poOa.taG$;
        poWa := **poOa["width"];
        poHa := **poOa["height"];
        poWd = 0;
        poWd = *poWa.datA;
        poHd = 0;
        poHd = *poHa.datA;
        poFramed = 0;
        if poWd > 0;
            if poHd > 0;    poFramed = 1;
        if poFramed == 0;
            cerr "popup: REFUSING" argument.taG "-- the field" poField "has no frame; on:= names a field of a laid-out copy in a window":;
            return;
        if windows == 0;
            cerr "popup: REFUSING" argument.taG "-- windows are off (windows = 0); a popup has no PDF":;
            return;
        poX = **poOa["x"];
        poY = **poOa["y"];
        poH = **poOa["height"];
        poY = poY + poH;
        // itsForm the form the field's window shows: laidForm on the nearest laid-out copy's top (setFrame), else that top's own name
        poAt := **poOa;
        poHops = 0;
        while poHops < 32;
            poM = *poAt.isMembeR;
            if poM == 0;        poHops = 32;
            if poHops < 32;     poAt := *poAt.parenT;
            poHops += 1;
        poIn = string $*poAt.taG$;
        poL = *poAt.listLengtH;
        poHasF = 0;
        if poL > 0;
            if *poAt["laidForm"];   poHasF = 1;
        poLf := *poAt["laidForm"];
        if poHasF == 1;     poIn = string $*poLf$;
        // itsMember the poured member the field stands for, when it is in a poured row
        tsEachFind(**poOa);
        poEach = "none";
        if tsEachHit == 1;      poEach = string $**tsEach.taG$;
        // oneWindow open already (it has a target): closed first, so it opens at the new field; the close clears the old target
        popWin.form := **poFa;
        popWin.look = 0;
        popWin.frame = 0;
        poN = popupTargets.listLengtH;
        poOpen = 0;
        if poN > 0;
            if popupTargets[poForm];    poOpen = 1;
        if poOpen == 1;     windowClose(popWin);
        poEnt := new(poForm);
        poE1 := new("form");
        *poE1 = string $poIn$;
        *poEnt +% *poE1;
        poE2 := new("field");
        *poE2 = string $poField$;
        *poEnt +% *poE2;
        poE3 := new("each");
        *poE3 = string $poEach$;
        *poEnt +% *poE3;
        popupTargets +% *poEnt;
        // atTheField a frame of x and y only: the popup form's own width and height stand (keepFrame keeps the parts a frame has)
        poFr := new("popupFrame");
        poXa := new("x");
        *poXa = poX;
        *poFr +% *poXa;
        poYa := new("y");
        *poYa = poY;
        *poFr +% *poYa;
        popWin.frame := *poFr;
        poLooks = 0;
        if **poFa["look"];      poLooks = 1;
        if poLooks == 1;
            poLk := **poFa["look"];
            popWin.look := **poLk;
        // itsOwner the popup belongs to the form it was opened from (popups stroke 4; ruling 5): the window is handed that form as owner:=, found by name in FORMs. The window closes with its owner's, sits above it, has no resize, and a popup form carrying modal=1 stops its owner's clicks while it is open (guiHost.mm). Not in FORMs: owner holds nothing and the popup is tied to no window
        popWin.owner = 0;
        pfmName = string $poIn$;
        popForm();
        if pfmHit == 1;     popWin.owner := *pfmFound;
        // noOwnerSaysSo the popup still opens, unowned, and says so (Tony, 2026-11-24): it will not close with the form, and OK will find no form to write
        if pfmHit == 0;
            poWho = string $"popup " poForm ": no owner form"$;
            cerr poWho "-- FORMs has no form named" poIn "; it opens tied to no window":;
        cout "=== popup" poForm "opened on" poIn poField "each" poEach "at" poX poY "===":;
        poHide = 0;
        if windows == 2;    poHide = 1;
        if poHide == 0;
            poEnv = string $"[ -n \"$INCANT_NOVIEW\" ]"$;
            if system(poEnv);   poHide = 1;
        if poHide == 0;     openWindow(popWin);
        if poHide == 1;     windowOffscreen(popWin);
        };
    /***************************************************************************
        popupPick, popupOk, popupCancel -- popups stroke 3 (Tony, 2026-11-23;
        docs/popupsRecon.md, ruling 4). The shared actions a popup form uses by
        name, as click actions: onClick:=popupOk. Each is handed the field that
        was clicked, and knows its popup from that field: the form its window
        shows (laidForm on the copy's top), which is popupTargets' key.
        popupPick   the clicked field's text becomes the value OK will write. It
                    is kept in the popup's target entry (value=), so it goes
                    when the popup closes. A later pick replaces it.
        popupOk     writes the value, BY NAME, as the text of the field the
                    popup was opened on: the field named field= in the form
                    named form= (found in FORMs), in the DEFINITION -- the copy
                    that was clicked is gone at the next layout. Then the popup
                    is closed, and the window showing that form is laid out
                    again where it is (windowRedraw: not moved, not raised).
                    Nothing picked: nothing is written, and it says so.
        popupCancel closes the popup. Nothing is written. The popup's close
                    button does the same.
        Each refuses by name a field that is in no open popup. popupOk refuses
        the write by name when FORMs has no such form, or the form no such
        field; the popup still closes. popupPick refuses a field with no text.
        NOT BUILT: a write to the poured member (each=); a value that is not a
        field's text (a colour, an attribute).
    ***************************************************************************/
    popHas = 0;
    popOwn form;
    pfmHit = 0;
    pfmName = "none";
    pfmFound;
    // popupOf the popup a clicked field is in: popName, from laidForm on the nearest copy's top (that top's own name when it carries none), and popHas, 1 when that form is an open popup
    popupOf code={
        pwAt := argument;
        pwHops = 0;
        while pwHops < 32;
            pwM = *pwAt.isMembeR;
            if pwM == 0;        pwHops = 32;
            if pwHops < 32;     pwAt := *pwAt.parenT;
            pwHops += 1;
        popName = string $*pwAt.taG$;
        pwL = *pwAt.listLengtH;
        pwHasF = 0;
        if pwL > 0;
            if *pwAt["laidForm"];   pwHasF = 1;
        pwLf := *pwAt["laidForm"];
        if pwHasF == 1;     popName = string $*pwLf$;
        popHas = 0;
        pwN = popupTargets.listLengtH;
        if pwN > 0;
            if popupTargets[popName];   popHas = 1;
        };
    // popForm the form named pfmName, looked up in FORMs: pfmHit 1 and pfmFound holding it, else pfmHit 0
    popForm code={
        pfmHit = 0;
        pfmHasR = 0;
        if registries["FORMs"];     pfmHasR = 1;
        if pfmHasR == 1;
            pfmReg := registries["FORMs"];
            if *pfmReg[pfmName];    pfmHit = 1;
        if pfmHit == 1;     pfmFound := *pfmReg[pfmName];
        };
    // popupShut closes the popup named popName, as its close button does (windowShut then forgets its target)
    popupShut code={
        pfmName = string $popName$;
        popForm();
        if pfmHit == 0;
            cerr "popup: REFUSING to close" popName "-- FORMs has no form of that name":;
            return;
        popWin.form := *pfmFound;
        popWin.look = 0;
        popWin.frame = 0;
        windowClose(popWin);
        };
    popupPick code={
        popupOf(argument);
        if popHas == 0;
            cerr "popupPick: REFUSING" argument.taG "-- it is in no open popup; popupPick is a click action of a popup form's field":;
            return;
        ppkD = argument.datA;
        ppkHeld = argument.isGrouP;
        if ppkHeld == 1;    ppkD = 0;
        if ppkD == 0;
            cerr "popupPick: REFUSING" argument.taG "-- the field has no text to pick":;
            return;
        // wholeEntry the target entry is replaced whole, value= added: an entry is tested by its name, never an attribute by its value (F-168)
        ppkE := popupTargets[popName];
        ppkF = string $*ppkE["form"]$;
        ppkN = string $*ppkE["field"]$;
        ppkM = string $*ppkE["each"]$;
        ppkV = string $argument$;
        popupForget();
        ppkNew := new(popName);
        ppk1 := new("form");
        *ppk1 = string $ppkF$;
        *ppkNew +% *ppk1;
        ppk2 := new("field");
        *ppk2 = string $ppkN$;
        *ppkNew +% *ppk2;
        ppk3 := new("each");
        *ppk3 = string $ppkM$;
        *ppkNew +% *ppk3;
        ppk4 := new("value");
        *ppk4 = string $ppkV$;
        *ppkNew +% *ppk4;
        popupTargets +% *ppkNew;
        cout "=== popupPick" popName "value" ppkV "===":;
        };
    popupOk code={
        popupOf(argument);
        if popHas == 0;
            cerr "popupOk: REFUSING" argument.taG "-- it is in no open popup; popupOk is a click action of a popup form's field":;
            return;
        pkPop = string $popName$;
        pkE := popupTargets[popName];
        pkForm = string $*pkE["form"]$;
        pkField = string $*pkE["field"]$;
        pkL = *pkE.listLengtH;
        pkWrote = 0;
        pkOwns = 0;
        pfmName = string $pkForm$;
        popForm();
        if pfmHit == 1;
            pkOwner := *pfmFound;
            pkOwns = 1;
        if pkL < 4;     cout "=== popupOk" pkPop "nothing picked, nothing written ===":;
        if pkL > 3;
            pkValue = string $*pkE["value"]$;
            if pkOwns == 0;     cerr "popupOk: REFUSING the write from" pkPop "-- FORMs has no form named" pkForm:;
            if pkOwns == 1;
                tsHit = 0;
                tsWant := pkField;
                if pkForm == pkField;
                    tsFound := *pkOwner;
                    tsHit = 1;
                if tsHit == 0;      tsFind(*pkOwner);
                if tsHit == 0;      cerr "popupOk: REFUSING the write from" pkPop "-- the form" pkForm "has no field named" pkField:;
                if tsHit == 1;
                    pkTo := *tsFound;
                    // textOnly the text alone is written: an assignment from a string expression carries that expression's own parts onto the target and the field's attributes (its height) are gone (measured, SEQ 768); from .texT they stay
                    *pkTo = pkValue.texT;
                    pkWrote = 1;
                    cout "=== popupOk" pkPop "wrote" pkValue "to" pkForm pkField "===":;
        popName = string $pkPop$;
        popupShut();
        if pkOwns == 1;
            popOwn.form := *pkOwner;
            windowRedraw(popOwn);
        };
    popupCancel code={
        popupOf(argument);
        if popHas == 0;
            cerr "popupCancel: REFUSING" argument.taG "-- it is in no open popup; popupCancel is a click action of a popup form's field":;
            return;
        cout "=== popupCancel" popName "closed, nothing written ===":;
        popupShut();
        };
    // unselect ONE argument, a form (or its laid-out copy): that form has no selection from here on, and its help box forgets what it described; the other forms keep theirs
    unselect code={
        usF = string $argument.taG$;
        usN = selections.listLengtH;
        usHad = 0;
        if usN > 0;
            if selections[usF];     usHad = 1;
        usOld := selections[usF];
        if usHad == 1;      selections -% *usOld;
        usN = describedNames.listLengtH;
        usHad = 0;
        if usN > 0;
            if describedNames[usF];     usHad = 1;
        usOldD := describedNames[usF];
        if usHad == 1;      describedNames -% *usOldD;
        };
    spField;
    spHasFill = 0;
    // clickDone click writes it, clickShow reads it: 1 when the click found its field, 0 when it refused (two actions touch it, so it is declared)
    ckDone = 0;
    /***************************************************************************
        describe is used to supply descriptions in forms by adding it as a form
        attribute with a text value of the field being described. The describe
        text is initialized as either the tag of a field in the form that has
        a corresponding entry with the same tag in the dESCRIPTIONs registry, or
        as whatever descriptive text the form designer wants to show when the
        form first fires. describe is a dynamic attribute with an action
        When a form field is clicked on selection.group is set to the first selectable
        field found after searching up the parent hierarchy starting with the
        field clicked on. And if the selected field has a describe attribute the
        describe action sets the describe.text for the form layout to display.

        See the tabs or descriptions forms in IncantForms/Windows for an example
        of how to define a form that uses descriptions.
    ***************************************************************************/
    describe code={
        if selection.isGrouP;   describe = dESCRIPTIONs[*selection.taG];
        or describe.isGrouP;    describe = dESCRIPTIONs[describe];
        };
    /***************************************************************************
        redrawWindow -- ONE argument, a request: form:= frame:= (the window's
        frame now) path= and, optionally, look=. A resize, and any redraw of an
        open window (clickShow's kin): keepFrame first, then redrawForm with a
        request that names no frame, so setFrame takes the frame from the store.
        Returns the laid-out copy, as redrawForm does.
    ***************************************************************************/
    redrawWindow code={
        rwReq := argument;
        keepFrame(argument);
        windowReq :% copyOf(*rwReq["path"]);
        rwForm := *rwReq["form"];
        windowReq.form := **rwForm;
        windowReq.look = 0;
        rwLk = 0;
        if *rwReq["look"];      rwLk = 1;
        if rwLk == 1;           windowReq :% copyOf(*rwReq["look"]);
        rwLaid := redrawForm(windowReq);
        return *rwLaid;
        };
    /***************************************************************************
        windowLay -- a window's layout (windows stroke 3). ONE argument, a
        request the window makes: form:= the form, frame:= the window's frame
        now (absent at a first opening that names none), look optional. It is
        redrawWindow with no PDF: a frame is kept in formFrames (keepFrame),
        then setFrame lays the form out with a request naming no frame, so the
        frame comes from the store -- and a first opening with no frame takes
        what the last close kept. The laid-out copy is handed to the window
        through windowTake; a refused layout hands nothing.
    ***************************************************************************/
    windowLay code={
        wlReq := argument;
        wlHas = 0;
        if *wlReq["frame"];     wlHas = 1;
        if wlHas == 1;          keepFrame(argument);
        wlForm := *wlReq["form"];
        layReq.form := **wlForm;
        layReq.look = 0;
        wlLk = 0;
        if *wlReq["look"];      wlLk = 1;
        if wlLk == 1;           layReq :% copyOf(*wlReq["look"]);
        // displayCap a window's height=fit is capped at the display's usable height, which the window publishes in displaySize; fitCap is put back, so a PDF's cap stays a page (Topics/forms, SIZE)
        wlCap = fitCap;
        wlHigh = 0;
        wlHigh = displaySize["height"];
        if wlHigh > 0;          fitCap = wlHigh;
        wlLaid := setFrame(layReq);
        fitCap = wlCap;
        wlGot = 0;
        if *wlLaid.listLengtH;  wlGot = 1;
        if wlGot == 1;          windowTake(*wlLaid);
        };
    /***************************************************************************
        redrawForm -- the first resize, as a plain call (SEQ 626 W2). ONE
        argument, setFrame's own request with a path added: form:=, frame:=
        (optional), path= the PDF to write. It lays the form out afresh through
        setFrame, draws the copy to that PDF and returns the copy. A resize is
        redrawWindow, which keeps the window's frame in formFrames and calls
        this with no frame (G3 item 2). It keeps nothing: the caller holds the
        returned copy if it wants it. A refused setFrame draws nothing.
    ***************************************************************************/
    redrawForm code={
        rdReq := argument;
        rdLaid := setFrame(argument);
        rdGot = 0;
        if *rdLaid.listLengtH;     rdGot = 1;
        if rdGot == 0;
            cerr "redrawForm: nothing laid out for" argument.taG "-- no PDF written":;
            return;
        pageReq :% copyOf(*rdReq["path"]);
        pageReq :% copyOf(*rdLaid["width"]);
        pageReq :% copyOf(*rdLaid["height"]);
        pageReq.form := *rdLaid;
        openPDF(pageReq);
        drawWalk(*rdLaid);
        closePDF(pageReq);
        return *rdLaid;
        };
    // rootedPath showPath's location derives from environment.root (incant/setup; SEQ 724 R4): its path is relative to root, and with root "." the relative path is the location
    showPathRoot code={
        spRel = string $showPath["path"]$;
        spR := environment["root"];
        spRoot = string $*spR$;
        if spRoot != ".";   showPath.path = string $spRoot "/" spRel$;
        };
    /***************************************************************************
        showForm -- the worker behind show (SEQ 687: show is the bootstrap in
        incant/setup, which loads what is missing and calls this; show returns
        nothing, showForm returns the laid-out copy). Was show: fire a form (Tony, 2026-11-14, the show dispatch R2). ONE
        argument, the form: show(firstLight). It builds its own request and
        hands it to redrawForm, so the caller writes no request. The PDF's
        path is the form's own path= attribute; a form with none is written
        to showPath, IncantForms/PDF/output.pdf. A form that names a look
        (look:=nightLook) is laid out under it. Says where it wrote, on one
        line. Returns the laid-out copy, as redrawForm does.
        THE VIEWER (SEQ 686): when it wrote output.pdf and viewer (pROPERTIEs) is 1,
        it opens the PDF in the system's default viewer, in the background:
        `open -g`. The shell's INCANT_NOVIEW, when set, counts as viewer off
        (every script of Clod's sets it). It never opens any other path
        (test.pdf, the captures). A failed open is said by name, not refused;
        the PDF is written either way. It says which: opened, viewer off, or
        could not open.
    ***************************************************************************/
    showForm code={
        // rootAtShow showPath derives from environment.root when a form is shown, not at utilities' foot (SEQ 726 R1)
        showPathRoot();
        shForm := argument;
        shOwn = 0;
        if *shForm["path"];     shOwn = 1;
        if shOwn == 1;      showReq :% copyOf(*shForm["path"]);
        if shOwn == 0;      showReq :% copyOf(showPath["path"]);
        showReq.form := argument;
        showReq.look = 0;
        shLooks = 0;
        if *shForm["look"];     shLooks = 1;
        if shLooks == 1;
            shLook := *shForm["look"];
            showReq.look := **shLook;
        shName := *shForm.taG;
        // showDecides (Tony, 2026-11-22) a form written window opens in a window when windows is switched on (incant/setup), else its PDF as today. windows = 1 shows it, unless INCANT_NOVIEW is set (the fleet): then the PDF. windows = 2 makes the window and does not show it. The window lays the form out itself, from this request.
        shWin = 0;
        if windows != 0;
            shIsW := isWindowForm(argument);
            if *shIsW == 1;         shWin = 1;
        shHide = 0;
        if shWin == 1;
            if windows == 2;        shHide = 1;
        if shWin == 1;
            if shHide == 0;
                shEnvW = string $"[ -n \"$INCANT_NOVIEW\" ]"$;
                if system(shEnvW);  shWin = 0;
        if shWin == 1;
            if shHide == 0;
                cout "=== show" shName "in a window ===":;
                openWindow(showReq);
            if shHide == 1;
                cout "=== show" shName "in a window, not shown ===":;
                windowOffscreen(showReq);
            return;
        shTo := showReq["path"];
        cout "=== show" shName "to" shTo "===":;
        shDone := redrawForm(showReq);
        shWrote = 0;
        if *shDone;     shWrote = 1;
        shP = string $shTo$;
        shOut = string $showPath["path"]$;
        shView = 0;
        if shWrote == 1;
            if shP == shOut;    shView = 1;
        shOn = 0;
        if shView == 1;
            if viewer != 0;     shOn = 1;
            if shOn == 1;
                shEnv = string $"[ -n \"$INCANT_NOVIEW\" ]"$;
                if system(shEnv);   shOn = 0;
            if shOn == 0;       cout "=== show viewer off ===":;
        if shOn == 1;
            shCmd = string $"open -g '" shP "'"$;
            shOpened = 0;
            if system(shCmd);   shOpened = 1;
            if shOpened == 1;   cout "=== show opened" shP "===":;
            if shOpened == 0;   cerr "show: could not open" shP "-- the PDF is written":;
        return *shDone;
        };
    clickFire code={
        if argument["CodE"];
            cout "=== click" ckFn ckNm "fired its own action ===":;
            ckFired = 1;
            argument(argument);
        for grup in argument; attributes
            ckHeld = *grup.isGrouP;
            ckActs = 0;
            if ckHeld == 1;
                if **grup["CodE"];      ckActs = 1;
            // notItself a field with an action holds itself under the name this; that is the own action, already fired
            ckAn := *grup.taG;
            if *ckAn == "this";     ckActs = 0;
            // notItsHost a held form's top holds its host field under heldIn; that is the way up, not an action of this field
            if *ckAn == "heldIn";   ckActs = 0;
            if ckActs == 1;
                ckTo := **grup.taG;
                cout "=== click" ckFn ckNm "fired" ckAn ckTo "===":;
                ckFired = 1;
                **grup(argument);
        };
    /***************************************************************************
        click -- the mock click (goal G1; G2 stroke 3; Tony, 2026-11-13). ONE
        argument, a request: form:= the form and field= the name of a field in
        it. No point and no window: the field is named. The click selects the
        field (selection), fires the field's own action if it has one, then
        its attribute actions left to right: every attribute that holds an
        action (onClick:=someAction, or any other name). Each is handed the
        field. Nothing here redraws: an action that writes a field with a
        listener (insideForm := another) is redrawn by that listener.
        Refuses by name: a request with no form or no field name; a name the
        form has no field for. Not built: bubbling to the enclosing fields.
    ***************************************************************************/
    click code={
        ckReq := argument;
        ckDone = 0;
        ckOk = 1;
        if *ckReq["form"];      ckOk = ckOk + 1;
        if *ckReq["field"];     ckOk = ckOk + 1;
        if ckOk != 3;
            cerr "click: REFUSING" argument.taG "-- its request needs form:=theForm and field=theName":;
            return;
        ckForm := *ckReq["form"];
        ckAttr := *ckReq["field"];
        ckNm := *ckAttr.texT;
        ckFn := **ckForm.taG;
        tsHit = 0;
        tsWant := *ckNm;
        if *ckFn == *ckNm;
            tsFound := **ckForm;
            tsHit = 1;
        if tsHit == 0;      tsFind(**ckForm);
        if tsHit == 0;
            cerr "click: REFUSING" argument.taG "-- the form" ckFn "has no field named" ckNm:;
            return;
        // ownHolder the field is kept in a local: an action fired below may redraw, and the redraw's own search writes tsFound
        ckField := *tsFound;
        selection := *ckField;
        skForm = string $*ckFn$;
        skField = string $*ckNm$;
        selectKeep();
        ckDone = 1;
        cout "=== click" ckFn ckNm "selected ===":;
        clickFire(*ckField);
        };
    /***************************************************************************
        clickField -- a click from a point (windows stroke 2; W2, Tony
        2026-11-22). ONE argument: the field itself, on a laid-out copy -- the
        window finds it under the point (guiHost.mm, windowClickAt) and hands
        it here. It selects the first SELECTABLE field at or above it
        (selectable; only room all the way up: nothing is selected and the
        selection stays as it was), then fires as click does, starting from
        the field that was hit: the field's own action, then its attribute
        actions left to right, each handed the field. BUBBLING: when the field
        fired nothing, its parent on the copy is tried the same way, and so on
        up to the top; the first level that fires anything ends the climb, and
        its actions are handed that level's field. Both climbs cross a held
        form's top into its host (clickUp; Tony, 2026-11-23). Nothing fired at
        any level says so. Nothing here redraws. The mock click by name (click)
        names its field, selects it whatever it is, and does not climb.
    ***************************************************************************/
    clickField code={
        cfHit := argument;
        cfHitName = string $*cfHit.taG$;
        // topIsNoMember the name the click lines print is the nearest laid-out copy's top: the first field on the way up that reads as no member -- the copy's top, or a held form's top (measured 2026-11-23, SEQ 763)
        cfAt := argument;
        cfHops = 0;
        while cfHops < 32;
            cfM = *cfAt.isMembeR;
            if cfM == 0;        cfHops = 32;
            if cfHops < 32;     cfAt := *cfAt.parenT;
            cfHops += 1;
        ckFn := *cfAt.taG;
        // windowsForm the selection is kept under the form the window shows; every copy's top carries laidForm, the form its layout was for (setFrame), a held form's top its host's
        skForm = string $*ckFn$;
        skL = *cfAt.listLengtH;
        skHasF = 0;
        if skL > 0;
            if *cfAt["laidForm"];   skHasF = 1;
        skLf := *cfAt["laidForm"];
        if skHasF == 1;     skForm = string $*skLf$;
        // selectsTheFirstSelectable a field that is only room is not selected: the selection climbs to the first enclosing field that is selectable, through a held form's top into its host; none, nothing is selected and the selection stays as it was (Tony, 2026-11-23)
        clAt := argument;
        clEnd = 0;
        cfSeen = 0;
        cfSel = 0;
        cfHops = 0;
        while cfHops < 64;
            cfSeen += 1;
            selectable(*clAt);
            if selCan == 1;     cfSel = 1;
            if selCan == 1;     cfHops = 64;
            if cfHops < 64;     clickUp();
            if clEnd == 1;      cfHops = 64;
            cfHops += 1;
        if cfSel == 1;
            selection := *clAt;
            cfName = string $*clAt.taG$;
            skField = string $cfName$;
            selectKeep();
            cout "=== click" ckFn cfName "selected ===":;
        if cfSel == 0;      cout "=== click" ckFn cfHitName "selected nothing: only room, on the way up through" cfSeen "fields ===":;
        // firesOnTheWayUp from the field that was hit, whether or not it is selectable (a spacer with an action still fires it); the first level that fires ends the climb; a held form's top is crossed into its host
        ckFired = 0;
        cfDepth = 0;
        clAt := *cfHit;
        clEnd = 0;
        cfHops = 0;
        while cfHops < 64;
            ckNm := *clAt.taG;
            cfDepth += 1;
            clickFire(*clAt);
            if ckFired == 1;    cfHops = 64;
            if cfHops < 64;     clickUp();
            if clEnd == 1;      cfHops = 64;
            cfHops += 1;
        if ckFired == 0;    cout "=== click" ckFn cfHitName "fired nothing, on the way up through" cfDepth "fields ===":;
        };
    // clickUp one step up from clAt: its parent; at a held form's top (no member, heldIn) the field that holds it; at the window's top, clEnd = 1 and clAt stays
    clAt;
    clEnd = 0;
    clickUp code={
        cuM = *clAt.isMembeR;
        cuHeld = 0;
        if cuM == 0;
            cuL = *clAt.listLengtH;
            if cuL > 0;
                if *clAt["heldIn"];     cuHeld = 1;
        cuIn := *clAt["heldIn"];
        if cuM == 0;
            if cuHeld == 0;     clEnd = 1;
        if cuHeld == 1;     clAt := **cuIn;
        if cuM == 1;        clAt := *clAt.parenT;
        };
    /***************************************************************************
        clickShow -- click, then draw (tabs stroke 4, docs/tabsRecon.md item 4a).
        ONE argument, click's own request: form:= the form and field= the name
        of a field in it. It clicks, and when the click found its field it
        draws the form with showForm: the form's path=, else showPath. A
        refused click draws nothing. For a form that does not redraw by
        listening: a form whose click action's write is heard by a listener
        that draws (firstLight, IBkant) would draw twice.
    ***************************************************************************/
    clickShow code={
        csReq := argument;
        click(argument);
        if ckDone == 0;
            cerr "clickShow: nothing drawn for" argument.taG "-- the click refused":;
            return;
        csForm := *csReq["form"];
        csLaid := showForm(**csForm);
        return *csLaid;
        };
    /***************************************************************************
        selectTab -- a tab's click action (tabs stroke 4): onClick:=selectTab on
        each tab of a bar. Handed the clicked tab, it writes the field the
        bar's tabs:= names (outside the form, ruling 3: tabSelected) to hold
        that tab, so the next layout shows the tab's card and fills the tab
        with its selectFill (cardsPick). The form's own definition is not
        written. The write tells that field's listeners. Refuses by name a tab
        whose parent is no tab bar (no tabs:=).
    ***************************************************************************/
    selectTab code={
        stTab := argument;
        stBar := *stTab.parenT;
        stIs = 0;
