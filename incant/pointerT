/*  pointerT -- THE +* CERTIFICATE. Minted 2026-09-01 (SEQ 111).

    `a +% b` adds a COPY of b.  `a +* b` adds a POINTER to b.
    Read either back with a SUBSCRIPT, which STOPS AT THE ELEMENT -- law 2, and
    as of row L4 that is certified by identity rather than inferred. What follows
    the pointer is PRINT (law 1) or a STAR ON A REBOUND CAPTURE (law 4). A star
    written directly on a subscript binds to the BAG instead (law 3) and refuses,
    which is row X.

    ⚠ THIS HEADER SAID THE OPPOSITE UNTIL 2026-09-01 -- "a subscript which already
    follows the pointer" -- and the dead region below records why that was wrong
    and how long its own output had been saying so. A fixture pinned against a
    reading instead of a ruling is a lie the fleet tells, and so is its header.

    ⚠ ROW P IS THE WHOLE ARGUMENT AND ITS TWIN IS NOT OPTIONAL. P1 writes to the
    source after the add and reads the pointer: it must see the NEW value. P2 is
    the identical shape through `+%` and must still see the OLD one. EITHER ROW
    ALONE PROVES NOTHING -- a pointer that reads ORIG and a copy that reads ORIG
    are the same reading, and only the pair separates them. If `+*` ever quietly
    becomes a copy, P1 goes red before anybody ships a body on it.  */

register(PointerT);
define
    ptSrc="ORIG";
    ptSrc2="ORIG2";
    ptOther="OTHER";
    ptA1 aa bb;
    ptA2 cc;
    ptBagP;
    ptBagC;
    ptBagR;
    ptBagL;
    ptBagD;
    ptBagT;
    ptBagN;
    ptInner;
    ptRun code={
        ptBagP +* ptSrc;
        ptBagC +% ptSrc;
        print "pointerT P0 both added   =" ptBagP.listLengtH ptBagC.listLengtH "  want 1 1":;
        print "pointerT P0b before write =" ptBagP["ptSrc"] ptBagC["ptSrc"] "  want ORIG ORIG":;
        ptSrc = "CHANGED";
        print "pointerT P1 pointer      =" ptBagP["ptSrc"] "  want CHANGED -- IT FOLLOWED":;
        print "pointerT P2 copy         =" ptBagC["ptSrc"] "  want CHANGED -- SEE THE NOTE, +% SHARES THE BODY":;

        ptBagR +* ptSrc2;
        ptSrc2 := ptOther;
        print "pointerT R  rebind       =" ptBagR["ptSrc2"] "  want ptOther -- reads the rebound body BY TAG":;

        ptBagL +* ptSrc;
        ptBagL +* ptSrc2;
        ptBagL +* ptOther;
        print "pointerT L  three ptrs   =" ptBagL.listLengtH "  want 3":;
        print "pointerT L1 prints values =" ptBagL["ptSrc"] ptBagL["ptOther"] "  want CHANGED OTHER -- these elements HOLD DATA, no follow involved":;
        ptNamed <- ptBagL["ptSrc"];
        print "pointerT L2 name-then-star =" *ptNamed "  want CHANGED -- LAW 4, the lawful read":;
        ptAssigned = ptBagL["ptSrc"];
        print "pointerT L3 assign-then-star =" *ptAssigned "  want 0 -- name it means <- , NOT =":;

        cerr "pointerT L4 -- LAW 2 ASKED BY IDENTITY. Read the BODY column only.":;
        cerr "  L4 asks question 1 of rule H13 -- same thing through a carrier -- so BODY.":;
        cerr "  H13: name the question BEFORE the column; field is right for question 2 only.":;
        cerr "  L4a source asked once:":;
        addrOf(ptSrc);
        cerr "  L4b SAME source again -- body must REPEAT (column is stable):":;
        addrOf(ptSrc);
        cerr "  L4c a DIFFERENT field -- body must DIFFER (column discriminates):":;
        addrOf(ptOther);
        ptElem <- ptBagL["ptSrc"];
        cerr "  L4d the SUBSCRIPT RESULT -- law 2 says this is NOT the source:":;
        addrOf(ptElem);
        ptFollowed <- *ptElem;
        cerr "  L4e that capture STARRED -- law 4 says THIS is the source:":;
        addrOf(ptFollowed);

        cerr "pointerT L5 -- THE isCopy COLUMN. A NAMED read reads 1; the ELEMENT reads 0.":;
        cerr "  L5a a NAMED field -- isCopy must read 1:":;
        addrOf(ptSrc);
        cerr "  L5b the SUBSCRIPT ELEMENT -- isCopy must read 0:":;
        addrOf(ptElem);
        ptFlagRead = ptSrc.isCopY;
        print "pointerT L5c flag road   =" ptFlagRead "  want ptFlagRead -- UNREADABLE, see the note":;

        cerr "pointerT L6 -- IS `<-` CARRIER-STABLE? Ask the SAME capture twice.":;
        ptCapName <- ptSrc;
        cerr "  L6a a <- capture OF A NAME, first ask:":;
        addrOf(ptCapName);
        cerr "  L6b the SAME capture, second ask -- field must REPEAT:":;
        addrOf(ptCapName);
        cerr "  L6c a <- capture OF A SUBSCRIPT, asked twice -- field must REPEAT:":;
        addrOf(ptElem);
        cerr "  L6d the DEFINE-BLOCK field, asked again -- a FRESH carrier each time:":;
        addrOf(ptSrc);

        ptInner := ptOther;
        ptBagD +* ptInner;
        print "pointerT D  depth        =" ptBagD["ptInner"] "  want 0 flip-OFF, OTHER flip-ON -- a flip tripwire":;

        print "pointerT X  star binds tightest =" *ptBagP["ptSrc"] "  want 0 -- LAW 3, the star took ptBagP":;

        ptBagT +* nosuchFieldAtAll;
        print "pointerT F1 undeclared   =" ptBagT.listLengtH "  want 1 -- NOT a refusal, see the note":;
        ptBagN +* *ptOther;
        print "pointerT F2 null operand =" ptBagN.listLengtH "  want 0 -- REFUSED by name, F-43":;
        };
    ;
ptRun();
print "POINTERT SENTINEL -- reached the foot":;
stop();

⚠⚠ P2 IS PINNED AT `CHANGED`, AND THAT IS A FINDING RATHER THAN A TARGET.

The twin was written expecting ORIG -- `+%` adds a copy, so a later write to the
source should not be visible. IT IS VISIBLE. Measured with the flip BOTH ON AND
OFF, identical in both, so it is not the flip: `+%` ALREADY SHARES THE SOURCE'S
GroupBody. Bytecode.twk:77 says so in as many words -- "the +% attribute shares
the field's GroupBody" -- and nothing in the operator isolates the storage.

SO THE COPY-VERSUS-POINTER DISTINCTION IS NOT WHERE THE CHARTER PUT IT. Both
operators leave the reader seeing later writes. What actually differs is the LINK:
`+*` sets an explicit `gGroup` pointer, `+%` shares the body directly. That is a
real difference -- R and D below only work through `+*` -- but it is not
copy-versus-reference of the contents, and any plan resting on `+%` isolating a
value needs re-reading.

⚠ THE PAIR IS STILL THE RIGHT SHAPE AND STILL EARNS ITS PLACE. It now pins a
measured fact instead of an assumed one, and if `+%` ever DOES start isolating,
P2 goes red and someone reads this note.

⚠ ROW D IS A FLIP TRIPWIRE. It reads 0 with gNoUnwrap OFF and OTHER with it ON,
measured both ways. Pinned at the flip-OFF value because that is the fleet's
baseline; it goes RED at the flip and re-pins to OTHER, exactly like holderT
row 3.

⚠⚠ ROW F2 IS THE REFUSAL TEST F1 IS NOT, AND IT EXISTS BECAUSE THE ARM IT DRIVES
CONTAINED A CRASH THAT NOTHING HAD EVER REACHED (F-43, fixed 2026-09-01).

`opAddPointer` gained a null-operand guard under F-41 so a refused operand would
be reported BY NAME instead of crashing. The guard printed `ptr->groupBody->tag`
with `ptr` still null -- in the tok source it was spelled as a bare `tag`, which
resolves to the LAST-MENTIONED field, and that was `ptr` rather than the operand.
So the guard against a crash was itself a crash: exit 139, no message.

⚠ IT SURVIVED BECAUSE F1 CANNOT REACH IT. `+*` on an undeclared name does not
produce a null -- the name is minted as an action local (bear-trap #39) -- so the
one row in the fleet that looked like a refusal test never was one. F2 uses
`*ptOther`, a star on a bare leaf, which refuses and yields a real null.

    before  exit 139, no `ERROR Operator +*` line, no sentinel
    after   exit 0, `ERROR Operator +* failed on ptBagN and a refused operand`

⚠ THE ERROR IS ASSERTED BY ITS TEXT AND THE ZERO IS NOT ENOUGH ON ITS OWN, same
argument as rows X and L3: a listLengtH of 0 is what an operator that did nothing
at all also produces. The text names WHICH operand was refused and is the only
thing that would go red if the guard regressed to naming the wrong field again.

⚠ ROW F1 IS NOT A REFUSAL TEST, AND THAT IS WHY IT SAYS SO. It was written as
one -- `+*` a field that does not exist -- but there is no such thing in that
position: an undeclared name in an action body is MINTED as an action local
(bear-trap #39), so `nosuchFieldAtAll` exists by the time `+*` sees it and a
pointer to it is duly added. The row is kept because it documents that, and
because a reader will otherwise write the same test and misread the 1.

THE FOLLOW-THROUGH LAWS (Tony, 2026-09-01, SEQ 113). Rows L and X were
re-pinned to these on the day they were ruled, because a fixture pinned against
a reading instead of a ruling is a lie the fleet tells.

    LAW 1  print follows -- a field holding a pointer prints its group.
    LAW 2  subscript stops at the ELEMENT.
    LAW 3  unary binds tightest: `*a[0]` is `(*a)[0]`, and refuses on a +* list.
    LAW 4  the read of a pointer out of a list is NAME IT, THEN STAR IT.

⚠⚠ THE ORIGINAL NOTE HERE WAS WRONG, AND ITS OWN OUTPUT HAD BEEN SAYING SO.
It read "the subscript ALREADY follows it to the source, which is why P1 reads
CHANGED without a star anywhere." THE SUBSCRIPT DOES NOT FOLLOW. Law 2 stops it
at the element and LAW 1 is what followed -- P1 and L1 are in PRINT position, so
print did the work and the subscript got the credit. The values never moved;
only the account of them was wrong, which is exactly the failure a value-pinned
row cannot catch by itself.

⚠ ROW X's REASON WAS WRONG IN A WAY THAT MATTERED, and the witness was sitting
in the output the whole time, unread:

    ERROR unary * on ptBagP -- it holds no group

The star never reached the subscript's result. It bound to `ptBagP` -- law 3,
`(*a)[0]` -- so the refusal is about the BAG, not about a read that had already
happened. pop.sh now asserts that error BY ITS TEXT (H4), because a row pinned
only at 0 would go green the day the star started binding the other way.

⚠⚠ LAW 4's SPELLING IS `<-` AND NOT `=`, MEASURED IN minionWork/probeFollowLaws
AND PINNED AS ROWS L2/L3:

    ptNamed    <- ptBagL["ptSrc"];   then  *ptNamed     ->  CHANGED   works
    ptAssigned  = ptBagL["ptSrc"];   then  *ptAssigned  ->  0         refuses

"NAME IT" MEANS REBIND IT. `=` copies content and the star then has nothing to
follow; `<-` hands back the field and the star follows it. L3 is not decoration
-- it is the row that stops the next reader from writing the natural spelling
and concluding the law is broken.

⚠⚠ LAW 2 IS CERTIFIED AS OF 2026-09-01, BY ROW L4, AND THIS NOTE REPLACES THE
ONE THAT SAID IT WAS NOT. The blocker named here was identity -- `addrOf`, SEQ
113 item 2 -- and addrOf landed in the SAME stroke that wrote this paragraph.
Nobody walked through the open gate for a day; that is the only reason it stood.

MEASURED, ONE RUN, IDENTITY BY THE BODY COLUMN:

    L4a  the source asked once             body=#2
    L4b  the SAME source asked again       body=#2   the column is STABLE
    L4c  a DIFFERENT field                 body=#5   the column DISCRIMINATES
    L4d  the SUBSCRIPT RESULT              body=#7   NOT THE SOURCE -- law 2
    L4e  that same capture, STARRED        body=#2   THE SOURCE -- law 4

⚠ READ THE BODY COLUMN AND NEVER THE FIELD COLUMN. The argument carrier mints a
fresh FIELD on every call -- the source reads field=#1, #3 and #8 across three
asks in this very run while its body stays #2 throughout -- so a field-column
comparison here would be answering a question about the carrier. The body column
asks the identity question THROUGH that defect instead of being voided by it.

⚠ L4b AND L4c ARE THE ANTI-VACUITY PAIR AND NEITHER HALF IS WORTH ANYTHING
ALONE. A column that answered "same" to everything would pass L4b; one that
answered "different" to everything would pass L4c. Only the pair earns L4d's
difference and L4e's match, and the two of them are each other's control: law 2
is the difference, law 4 is the match, and a mechanism that faked either one
would have to break the other.

⚠ AN UNLOOKED-FOR COLUMN, RECORDED AS MEASURED AND NOT EXPLAINED. L4d is the only
subject in the run reading `isCopy=0`; every other row, ORIGINALS INCLUDED, reads
1, because addrOf reports the carrier and the carrier is a copy. So the subscript
element is the one thing here that does not arrive wearing a copy's flag. WHY is
not diagnosed and is not guessed at -- reproduction proves the symptom, never the
cause, and the causal-claim ledger in this codebase is why that split is standing
doctrine.

⚠⚠ ROW L5 -- THE isCopy COLUMN, PROMOTED FROM A FOOTNOTE TO A ROW (SEQ 115).
C20 recorded in passing that L4d was the only subject in the run reading
isCopy=0. That is not a curiosity, it is the second road into the same fact L4
certifies, and it now has rows so the fleet trips if EITHER road changes.

    L5a  a NAMED field        isCopy=1
    L5b  the SUBSCRIPT ELEMENT isCopy=0

⚠ THE PRE-REGISTERED READING, which the rows assert rather than assume: a named
reference arrives through the argument carrier, which MINTS A COPY -- isCopy
true, body shared, which is exactly Tony's definition of a copy of a field -- and
a subscript reaches the ELEMENT ITSELF, which nobody copied. So the 0 is not an
anomaly in the element; it is the ABSENCE of the carrier's copy, and it is the
same fact as law 2 seen through a different column. If a NAMED read of a defined
field ever comes back isCopy=0, L5a is the row that says so.

⚠⚠ L5c IS THE FLAG ROAD AND IT IS PINNED AT ITS OWN ABSENCE, DELIBERATELY.
SEQ 115 asked for the finding asserted "both by flag and by addrOf". The addrOf
road is L5a/L5b. THE FLAG ROAD DOES NOT EXIST TODAY, and that was MEASURED, not
assumed -- minionWork/probeIsCopy: `.isCopY` echoes its own tag on BOTH a named
field and an element, which is bear-trap #26 and not a reading. `isCopy` lives in
GroupItem's `options` (groups.ext:202), not in GroupBody's `flags` where noPrinT
lives, and there is no incant spelling that reaches it.

⚠ SO L5c PRINTS THE TAG-ECHO AND THE FLEET PINS IT. That is presence-with-value
on an absence (H4): the day `.isCopY` becomes readable, L5c goes RED and someone
builds the by-flag half properly. The alternative -- omitting the row and noting
the gap in prose -- is how a gap becomes permanent, because nothing trips when
the road opens.

⚠ AND THE WRITE ROAD IS DEAD TOO, which is a separate question and was asked
separately: `:. isCopY` does not land -- isCopy reads 1 before and after, in
minionWork/probeIsCopyWrite. That is what keeps faceT's options row unbuilt, and
it is a DIFFERENT REASON than the one faceT recorded. See faceT's note.

⚠ ROW L3's REFUSAL IS NOW ASSERTED BY ITS TEXT, AND ITS WORDING IS A FINDING.
L3 was pinned only at 0, which is exactly the weakness row X's own note forbids:
a row pinned only at 0 goes green the day the star binds the other way. The
witness was in the output all along, unread, and it is

    ERROR unary * on ptSrc -- it holds no group

⚠ IT NAMES THE SOURCE, NOT THE ASSIGNEE. `=` is documented to reimprint the
left-hand tag (bear-trap #1), so a reader expects `ptAssigned` here. Attribution
was MEASURED rather than read off the source, in `minionWork/probeL3name`, which
isolates the `=`-then-star shape as the only star in its file: the refusal names
`l3Src`. The wording is recorded and NOT explained, same split as the isCopy
column above.

    ⚠⚠ LAW 1 IS RETIRED (Tony, SEQ 136, 2026-09-02): PRINT DOES NOT FOLLOW.
    A holder prints as the TAG of the field it holds; a writer who wants the
    value says `*`. Cyclic group chains are legal data under pointer semantics
    and nothing in the machine follows gGroup transitively any more.

    ROW R MOVED AND WAS RE-PINNED: it read `OTHER` by following, and now reads
    `ptOther`, the tag of the field the holder points at. ⚠ ITS FORCE IS
    UNCHANGED -- the row asks whether the rebind REPOINTED the body, and a wrong
    answer would name the pre-rebind target, so the tag discriminates exactly as
    the value did. It is a bucket (a) citizen: the `*` respelling rides the
    branch, and until then this asserts identity where it used to assert value.

    ⚠ ROW L1 DID NOT MOVE, AND THE PRE-REGISTRATION EXPECTED IT TO. Its elements
    HOLD DATA rather than a group, so law 1 never applied to them and nothing
    followed. Only its LABEL was wrong -- it said "LAW 1, print follows" while
    printing by value -- and the label is corrected here. A green row citing a
    retired law is the failure this note exists to prevent.
