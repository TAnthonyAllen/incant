/*  jitDrive -- a kant JIT driver STUB. The deliverable is the enumeration, not
    the driver. It walks a real action's statements and, per statement kind,
    names the shim an emitter would need and whether kant can reach it today.

    The dispatch idiom is the two step one, set group as a STATEMENT and then a
    bare test. The condition position form is broken on this binary, see the
    setGroupInit probe, so this file must not use it.

    Reachability is not guessed. A shim counts as reachable only if it is
    registered in incant setup, which is what makes it callable by name.  */
Start();
include(unitTests);
include(generate);
include(utilities);

search reset stack Grokking;
search Generating UnitTests bcOPs Utilities list;

register(JitDrive);
define
    jdTarget code={
        jdLocal = 1;
        if jdLocal > 0;
            jdLocal = jdLocal * 2;
        else
            jdLocal = 7;
        print "jdTarget ran, jdLocal =" jdLocal:;
        return jdLocal;
        };
    jdWalk code={
        blok := argument["BlocK"];
        /*  ⚠ THIS LINE EXECUTES THE BLOCK TODAY -- fixIts F-11, and this is the
            census's only customer tree-wide. jdTarget is called ONCE at the foot
            of this file and prints TWICE; the second firing is this existence
            test. The double print is NOT a jitDrive defect, so do not go hunting
            for one.
            Tony RULED 2026-08-17 that `if` on a BlocK answers presence and never
            executes, so this line becomes correct as written when the fix lands
            and is deliberately NOT rewritten to the listLengtH workaround -- that
            would be churn reverted a week later. Remove this comment then.  */
        if blok;
            print "BlocK found on" argument.taG:;
        else
            print "REFUSE no BlocK on" argument.taG:;
        lines := blok[1];
        if lines;
            print "lines found, length" lines.listLengtH:;
        else
            print "REFUSE no lines under BlocK":;
        iterate jdCur members on lines;
        while ++jdCur;
            jdReport(*jdCur);
        };
    jdReport code={
        print "  stmt" ~taG:;
        };
    ;
print "== jitDrive stub over jdTarget ==":;
jdTarget(0);
jdWalk(jdTarget);
print "JITDRIVE SENTINEL -- run reached the end":;
stop();
