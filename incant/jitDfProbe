search reset stack Grokking;
search Generating UnitTests bcOPs Utilities list;

register(JitDf);
define
    dfLeaf      leafOne leafTwo;
    dfRoot      alpha beta
        dfMid   delta
            dfInner zeta;
        dfBare;
    displayForm argument code={
        length  = listLengtH;
        print ~taG:;
        if length > 0;
            iterate grup attributes on argument;
            while ++grup;
                if noPrinT; continue;
                if isMethoD;    print ~`taG "has method":;
                else            print ~`taG "does not have method":;
            iterate grup members on argument;
            while ++grup;
                print +;
                displayForm(grup);
                print $-;
        };
    dfDrive code={
        displayForm(dfRoot);
        };
    ;

/*  ⚠ JITTED FIRST, ORACLE LAST -- see the ordering hazard in the header.  */
print "== JITTED ==":;
testing(dfDrive);

print "== INTERPRETED (the oracle) ==":;
dfDrive();

print "jitDfProbe SENTINEL -- run reached the end":;
