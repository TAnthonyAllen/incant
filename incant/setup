//Setting up
/*******************************************************************************
    cOMMANDs is a base registry defined on startup with a few commands added
    before bootstrapping. Here it is extended by adding more commands.
    
	Commands fire C++ methods used to set flags, whatever. They have an associated
    method specified by the immediateAction attribute, which is a noPrint attribute.
    noPrint attributes are fire and forget. They change the group being defined but are
    not added as a group attribute once forgotten. For example, the isRule
    command/attribute makes the group it appears in a rule, then it disappears so
    it does not become a rule attribute to be processed when the rule is parsed.
    
    Commands that are not noPrint are designed to be command line methods. They
    are invoked as command(argument).
*******************************************************************************/
registry(cOMMANDs);
define
    include=loadInputFromFile immediateAction;
    virtual immediateAction=processFlags noPrint;
    assign immediateAction=processFlags noPrint;
    audit immediateAction=auditRStuff;
    bin immediateAction=processFlags noPrint;
    bitmap immediateAction=setInternalType noPrint;
    BLOCKing immediateAction=processFlags guard;
    buffer immediateAction=setInternalType noPrint;
    class immediateAction=rEGISTER noPrint;
    clear immediateAction=cLEAR;
    arrondir immediateAction=arrondir;
    closeFile immediateAction;
    compile immediateAction;
    parseClassify immediateAction;
    condition immediateAction=processFlags noPrint;
    copy immediateAction=cOPY;
    copyOf immediateAction;
    debugGuard immediateAction=debugOnGuard noPrint;
    defer immediateAction=processFlags noPrint;
    dumpContents immediateAction;
    exit immediateAction=processFlags;
    fail immediateAction=processFlags noPrint;
    file immediateAction=setInternalType noPrint;
    flushBuffer immediateAction=flushBuffer;
    generateCode immediateAction;
    getFile immediateAction;
    getLine immediateAction=getMarkLineAt;
    getType immediateAction;
    guard immediateAction noPrint;
    index immediateAction=processFlags noPrint;
    isList immediateAction=processFlags noPrint;
    isRule immediateAction=processFlags noPrint;
    /*  THE INSTALL VOCABULARY, promoted from incant/genScratch 2026-08-05 by
        Tony's ruling, and it joins the isRule family deliberately: these are
        define-time fire-and-forget commands and they must be commands WHERE THE
        GRAMMAR IS READ, not only inside the fixture that tests them.
        ⚠ WHAT IT COST TO LEARN: registered only in genScratch, a
        `parseMethod=parseBraced` written into incant/grammar was not a command,
        so it was never fired and consumed -- it was parsed as an ORDINARY TERM.
        Braced went from 3 terms to 5 against a generated method indexing
        rule[1..3], and oneTest died at SIGSEGV. Every Scaf* rule is defined
        inside genScratch itself, so the install route had only ever been
        exercised in the one file that defines the words it needs. */
    parseMethod immediateAction=parseRuleMethod noPrint;
    parseTerms immediateAction=parseTermCount noPrint;
    listenTo immediateAction noPrint;
    window immediateAction=markWindow noPrint;
    load immediateAction=loadDirectory noPrint;
    macro immediateAction=processFlags noPrint;
    merge immediateAction=processFlags noPrint;
    new immediateAction=makeNew;
    printTO immediateAction=printToBuffer;
    quoted  immediateAction;
    regex immediateAction=setInternalType noPrint;
    register immediateAction=rEGISTER noPrint;
    reset immediateAction=resetField;
    runByteFn immediateAction=runByteFn;
    runRuleAction immediateAction;
    interpretBC immediateAction=interpretBC;
    openWindow immediateAction=openWindow;
    setFile immediateAction=setFile;
    setMark immediateAction;
    setParse immediateAction;
    setPointer immediateAction=opPointer noPrint;
    sort immediateAction=processFlags noPrint;
    stack immediateAction=setInternalType noPrint;
    stop=stopParsingInput immediateAction;
    system immediateAction=runSystem;
    showBody immediateAction;
    testing immediateAction;
    jitRefire immediateAction=jitRefire;
    jitFieldMethod immediateAction=jitFieldMethod;
    jitShowRecord immediateAction=jitShowRecord;
    jitTrace immediateAction=jitTrace;
    unary immediateAction=processFlags noPrint;
    unWrap immediateAction;
    writeTempFile immediateAction;
    ;
/*******************************************************************************
	Operators is a base registry defined at startup and extended here. Unlike
    most registries, it is unsorted, however, it is loaded in descending order
    (so when comparing against an input stream, longest match is returned by the parse).
*******************************************************************************/
registry(Operators);
define
    '~='    operateMethod=opMatch;
    '|';
    /*  THE `||` SYMBOL, filled 2026-08-01 (Tony's word). Demand was demonstrated
        by minionA round 2, which hit this and wrote twin sequential guards in
        `spellMany` instead of one disjunction.
        ⚠ THIS IS A REGISTRATION, NOT AN IMPLEMENTATION. Boolean OR already
        existed and was already sound -- `OR operateMethod=opOR` two lines below,
        with opOR in Instruct.rtn and `testOR` exercising it in the unitTests
        baseline. What was missing was only the SYMBOL spelling: `'|'` above is
        registered BARE, with no operateMethod, so `||` matched an inert operator
        and failed the body. `'||'` is registered explicitly rather than relying
        on `'|'` doubling, because the Operators header states the matcher
        returns the LONGEST match -- so the two-character entry wins cleanly and
        `'|'` keeps whatever future single-char meaning it is being held for.  */
    '||'    operateMethod=opOR;
    '^';
    OR      operateMethod=opOR;
    IN      operateMethod=opIN;
    GO;
    AND     operateMethod=opAND;
    modedOP operateMethod=setFileOp;
    negate  unary ruleMethod=opUnaryMinus;
    '?';
    '>>';
    '>='    operateMethod=opGE  interpretMethod=runGE  jitEmitter=jitEmitGE;
    '>'     operateMethod=opGT  interpretMethod=runGT  jitEmitter=jitEmitGT;

    '=='    operateMethod=opEQ  interpretMethod=runEQ  jitEmitter=jitEmitEQ;
    '=['    operateMethod=opGet;
    '=]'    operateMethod=opEnd;
    '=/'    assign operateMethod=opGetMember;
    '=*'    unary ruleMethod=opPointer;
    '=%'    operateMethod=opGetAttribute;
    '='     operateMethod=opAssign;

    '<='    operateMethod=opLE  interpretMethod=runLE  jitEmitter=jitEmitLE;
    '<<';
    '<:'    operateMethod=opSetTag;
    '<-'    assign operateMethod=opRebind;
    '<'     operateMethod=opLT  interpretMethod=runLT  jitEmitter=jitEmitLT;

    ':>';
    ':='    operateMethod=opSetGroup;
    ':<';   // not used
    ':-';   // pop not written yet
    ':+'    operateMethod=opReplaceMember;
    ':%'    operateMethod=opReplaceAttribute;
    '/='    operateMethod=opDivEQ;
    '/'     operateMethod=opDiv  jitEmitter=jitEmitDiv;
    '.'     operateMethod=opDot;
    ':.'    operateMethod=opSetFlag;
    '-='    operateMethod=opMinusEQ;
    '--'    unary ruleMethod=opMinusMinus;

    '**'    unary ruleMethod=opDebug;
    '-'     operateMethod=opMinus  jitEmitter=jitEmitSub;
    '+='    operateMethod=opPlusEQ;
    '++'    unary ruleMethod=opPlusPlus;
    '+*'    operateMethod=opCopyList;
    '+%'    operateMethod=opAddAttribute;
    '+'     operateMethod=opPlus  interpretMethod=runPlus  jitEmitter=jitEmitAdd;
    '*='    operateMethod=opMultiplyEQ;
    /*  `*` IS THE STEP-2 PATHFINDER -- the first op to carry a jitEmitter.
        Three slots, three consumers, one op: operateMethod is the interpreter,
        interpretMethod is the bytecode handler, jitEmitter is the JIT. They sit
        side by side deliberately; installing the third disturbs neither of the
        first two, which is what makes the migration one op at a time.  */
    '*'     operateMethod=opMultiply  interpretMethod=runMultiply  jitEmitter=jitEmitMul;
    '@'     unary ruleMethod=opLastREF;
    '&';
    '%'     operateMethod=opRem;
    '!='    operateMethod=opNotEQ  interpretMethod=runNotEQ  jitEmitter=jitEmitNE;
    '!'     unary ruleMethod=opNOT;
    '+/';
    ;
/*******************************************************************************
	bcOPs — bytecode opcodes (control flow + stack ops). A SEPARATE registry,
	deliberately NOT in Operators: these names are emitted into bcLIST as
	bare-name fields by the generator (emitBC(bcPushLit=tmp), bcBRZ +% target),
	so if they were operator-tokens the emitter source would fail to parse (it
	did — the 2026-05-30 fold experiment). Instead bcOPs is added to the search
	list, so bare references resolve here as names and the emitted op inherits
	its interpretMethod= handler; interpret() then dispatches via grup.interpret like
	everything else.
*******************************************************************************/
registry(bcOPs);
define
    bcBR         interpretMethod=runBR;
    bcBRZ        interpretMethod=runBRZ;
    bcCALL       interpretMethod=runCall;
    bcRET        interpretMethod=runRET;
    bcPushLit    virtual interpretMethod=runPushLit;
    bcPushField  virtual interpretMethod=runPushField setPointer;
    bcStoreField interpretMethod=runStoreField;
    bcForNext    interpretMethod=runForNext;
    bcPrint      interpretMethod=runPrint;
    bcString     interpretMethod=runString;
    ;
/*******************************************************************************
	pROPERTIEs is a base registry defined on startup and extended here
*******************************************************************************/
registry(pROPERTIEs);
define
    atEND;
    branchNum;
    currentPOINT;
    currentFRAME;
    extern noPrint;
    fAIL noPrint;
    gUARD noPrint;
    hexSet=[0-9a-fA-F];
    labelIndex;     // used in bytecode label generate
    null=0;
    notInNameSet=[^a-zA-Z0-9];
    stringBUFFER;
    UnaryOPS bin
        '--';
        '-';
        '++';
        '@';
        '!';
        '**';
        '=*';
        '.';
    ;
/*******************************************************************************
	Keywords is a base registry defined on startup. It contains groups that play
    a role in the grammar. Keywords cannot be used as fields (the NamE rule rejects them);
*******************************************************************************/
registry(Keywords);
