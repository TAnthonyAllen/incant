/*******************************************************************************
	Operators is a base registry defined at startup and extended here. Unlike
    most registries, it is unsorted. It is loaded LONGEST-FIRST: every operator
    that has another operator as a strict prefix is registered above it.
    ⚠ That is a convention, NOT the mechanism -- see OPERATOR ORDER at the foot
    of this file before relying on it either way.
*******************************************************************************/
registry(Operators);
define
    // perKindIR irWIDE= on + - * / is the IR that widens a count operand to a number (step 3c, SEQ 672): an operator that carries it takes a count mixed with a number natively, and / takes two counts
    // perKindIR irCOUNT= and irNUMBER= on an arithmetic or compare operator are DATA: the kant jitter's IR spelling for that operator on that kind (step 3a, SEQ 670). Attributes, never members: a member named <op><kind> is picked as the operator by pickKindOP, on every operator (measured SEQ 670: == and != then build nothing on the new road, and the jit ladder fails on the other eight)
    // notBuilt the ten entries bound to opNotBuilt are RESERVED -- Tony, SEQ 599: using one refuses by name as not built yet and the statement does nothing; when one is built its refusal is replaced by its method
    '~='    operateMethod=opMatch  compareTier;
    '||'    operateMethod=opOR   shortCircuit isOR;
    '|'    operateMethod=opNotBuilt;
    '&&'    operateMethod=opAND  shortCircuit;
    '^'    operateMethod=opNotBuilt;
    IN      operateMethod=opIN  compareTier;
    GO    operateMethod=opNotBuilt;
    modedOP operateMethod=setFileOp;
    negate  unary ruleMethod=opUnaryMinus;
    deref   unary ruleMethod=opDeref;
    printList   unary ruleMethod=opPrintList;
    cerrList    unary ruleMethod=opCerrList;
    coutList    unary ruleMethod=opCoutList;
    stringList  unary ruleMethod=opStringList;
    printShortcut   unary ruleMethod=opPrintShortcut;
    seq     unary ruleMethod=opSeq;
    bodySeq unary ruleMethod=opBodySeq;
    ifThen  unary ruleMethod=opIf;
    breakSignal     unary ruleMethod=opBreakSignal;
    continueSignal  unary ruleMethod=opContinueSignal;
    returnValue     unary ruleMethod=opReturnValue;
    returnSignal    unary ruleMethod=opReturnSignal;
    whileLoop       unary ruleMethod=opWhile  ownsBody;
    doLoop          unary ruleMethod=opDo  ownsBody;
    forLoop         unary ruleMethod=opFor  ownsBody;
    forBack         unary ruleMethod=opForBack  ownsBody;
    forMembers      unary ruleMethod=opForMembers  ownsBody;
    forBackMembers  unary ruleMethod=opForBackMembers  ownsBody;
    forAttrs        unary ruleMethod=opForAttrs  ownsBody;
    forBackAttrs    unary ruleMethod=opForBackAttrs  ownsBody;
    iterateOn       unary ruleMethod=opIterate;
    iterateAttrs    unary ruleMethod=opIterateAttrs;
    iterateMembers  unary ruleMethod=opIterateMembers;
    call            operateMethod=opCallTest  assignTier;
    runRule         unary ruleMethod=opRunRule;
    '?'    operateMethod=opNotBuilt;
    '>>'    operateMethod=opNotBuilt;
    '>='    operateMethod=opGE  jitEmitter=jitEmitGE  compareTier  irCOUNT="icmp sge i32"  irNUMBER="fcmp uge double"  irWIDE="sitofp i32";
    '>'     operateMethod=opGT  jitEmitter=jitEmitGT  compareTier  irCOUNT="icmp sgt i32"  irNUMBER="fcmp ogt double"  irWIDE="sitofp i32";

    '=='    operateMethod=opEQ  jitEmitter=jitEmitEQ  compareTier  irCOUNT="icmp eq i32"  irNUMBER="fcmp ueq double"  irWIDE="sitofp i32";
    '=['    operateMethod=opGet;
    '=/'    operateMethod=opGetMember;
    '=%'    operateMethod=opGetAttribute;
    '=<'    operateMethod=opGetProperty;
    '='     operateMethod=opAssign  assignTier  irCOUNT="call ptr @irSetCount"  irNUMBER="call ptr @irSetNumber"  irWIDE="sitofp i32";

    '<='    operateMethod=opLE  jitEmitter=jitEmitLE  compareTier  irCOUNT="icmp sle i32"  irNUMBER="fcmp ule double"  irWIDE="sitofp i32";
    '<<'    operateMethod=opNotBuilt;
    '<:'    operateMethod=opSetTag  assignTier;
    // arrowRetired <- is RETIRED as an operator (Tony, SEQ 597): it did nothing := cannot. The entry stays as a tombstone because the two characters must still be read together -- with no entry `x <- y` reads as `x < -y`, a comparison, silently, and an entry outside this registry is not read as an operator (both measured). Its method refuses by name and says to write :=. The <- inside a for loop is grammar text, not this entry
    '<-'    operateMethod=opArrowRetired  assignTier;
    '<'     operateMethod=opLT  jitEmitter=jitEmitLT  compareTier  irCOUNT="icmp slt i32"  irNUMBER="fcmp olt double"  irWIDE="sitofp i32";

    ':>'    operateMethod=opNotBuilt;
    ':='    operateMethod=opSetGroup  assignTier;
    ':<'    operateMethod=opNotBuilt;   // not used
    ':-'    operateMethod=opNotBuilt;   // pop not written yet
    ':+'    operateMethod=opReplaceMember  assignTier;
    ':%'    operateMethod=opReplaceAttribute  assignTier;
    '/='    operateMethod=opDivEQ  assignTier;
    '/'     operateMethod=opDiv  jitEmitter=jitEmitDiv  irNUMBER="fdiv double"  irWIDE="sitofp i32";
    '.'     operateMethod=opDot;
    ':.'    operateMethod=opSetFlag  assignTier;
    '-='    operateMethod=opMinusEQ  assignTier;
    '-%'    operateMethod=opRemoveAttribute  assignTier;
    '--'    unary ruleMethod=opMinusMinus  postfixToo;

    '$$'    unary ruleMethod=opDebug;
    '-'     operateMethod=opMinus  jitEmitter=jitEmitSub  irCOUNT="sub i32"  irNUMBER="fsub double"  irWIDE="sitofp i32";
    '+='    operateMethod=opPlusEQ  assignTier;
    '+='    // bear-trap 56: never merge these two mentions -- attributes and members on one mention bind it to its last member (section 9)
        '+=isCOUNT'  operateMethod=opPlusEQisCOUNT;
        '+=isNUMBER' operateMethod=opPlusEQisNUMBER;
        '+=isSTRING' operateMethod=opPlusEQisSTRING;
        '+=isTOKEN'  operateMethod=opPlusEQisSTRING;
        '+=isBUFFER' operateMethod=opPlusEQisBUFFER;
        '+=isSTAK'   operateMethod=opPlusEQisSTAK;
        '+=struct'   operateMethod=opPlusEQstruct;
    '++'    unary ruleMethod=opPlusPlus  postfixToo;
    '+*'    operateMethod=opAddPointer  assignTier;
    '+%'    operateMethod=opAddAttribute  assignTier;
    '+<'    operateMethod=opAddProperty  assignTier;
    '+/'    operateMethod=opAddMember  assignTier;
    '+'     operateMethod=opPlus  jitEmitter=jitEmitAdd  irCOUNT="add i32"  irNUMBER="fadd double"  irWIDE="sitofp i32";
    '*='    operateMethod=opMultiplyEQ  assignTier;
    '*'     operateMethod=opMultiply  jitEmitter=jitEmitMul  accessClass  irCOUNT="mul i32"  irNUMBER="fmul double"  irWIDE="sitofp i32";
    '@'     unary ruleMethod=opLastREF;
    '&'    operateMethod=opNotBuilt;
    '%'     operateMethod=opRem;
    '!='    operateMethod=opNotEQ  jitEmitter=jitEmitNE  compareTier  irCOUNT="icmp ne i32"  irNUMBER="fcmp one double"  irWIDE="sitofp i32";
    '!'     unary ruleMethod=opNOT;
    ;
