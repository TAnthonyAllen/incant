/*  showBoot -- the bootstrap show (SEQ 687; R4 ruled option 1). show(form) works after Start(); alone: it loads what is not loaded
    and draws by continuation, since an include inside an action is read after the action returns. Commentary: section 10 below. */
registry(pROPERTIEs);
/*  environment -- the kant environment, first piece (Topics/features 38; ruled 2026-11-20, SEQ 724). root is the folder incant
    runs from, and every path in the tree is relative to it today; a location derives from root (showPath, incant/utilities).
    paths are the folders searched for files, in order, relative to root: the shipped files only. forShow is show's defaults
    (searchNames, fileNames, stageNames: member names no other field has, since a member named search or show writes onto
    the command of that name); a request's searchNames:= or fileNames:= replaces that member for one call. Not built, kept in view:
    include reading paths (bear-trap #28: include searches no path); the user's folder at the front of paths; the remedy for
    absolute paths already in the tree (Controls/attributes, bigify, db, the descriptions images). Commentary: section 11 below.  */
define
    environment
        root=".";
        paths ".";
        forShow
            searchNames "FORMs" "Utilities" "cOLOr" "fONTs" "sTYLEs";
            fileNames "styles" "utilities" "unitTests";
            stageNames "cOLOr" "fONTs" "sTYLEs";
    ;
define
    // oneWriter only a file's own foot marks it loaded, with no action call (SEQ 726 R1-R2: a call at a foot primes lastREF and hides fixit setFlagTopLevel)
    loadedFiles;
    // onItsWay the files show has queued in this call, a fact of its own (SEQ 726 R2): show never writes loadedFiles
    queuedFiles;
    showPending;
    showSaved;
    showFormNow;
    showSearchUse;
    showFilesUse;
    swBad = 0;
    swMissing = 0;
    // namesAreFiles each name in a files list must be a fILEs entry; one not loaded yet is counted in swMissing
    showCheckFiles code={
        for grup in argument; attributes
            cfN = string $*grup$;
            cfOk = 0;
            if fILEs[cfN];          cfOk = 1;
            if cfOk == 0;           cerr "REFUSED show -- its files list names" cfN "-- not in fILEs; nothing loaded, nothing drawn":;
            if cfOk == 0;           swBad = 1;
            if cfOk == 1;
                if loadedFiles[cfN];    cfOk = 2;
            if cfOk == 1;           swMissing = swMissing + 1;
        };
    // eachOnce a file is included only if not loaded, and marked as it is queued, so a name written twice loads once
    showLoadFiles code={
        clear(queuedFiles);
        for grup in argument; attributes
            lfN = string $*grup$;
            lfGo = 1;
            if loadedFiles[lfN];    lfGo = 0;
            if queuedFiles[lfN];    lfGo = 0;
            lfMark := new(lfN);
            if lfGo == 1;           queuedFiles +% *lfMark;
            lfEnt := fILEs[lfN];
            if lfGo == 1;           include(*lfEnt);
        };
    show code={
        swArg := argument;
        // byRequest a field holding form= is a request: its form names the form; its searchNames:= or fileNames:= replaces that member of environment.forShow for this call (SEQ 724 R2; search:= would write onto the search command)
        swReq = 0;
        if *swArg["form"];      swReq = 1;
        swN = string $argument.taG$;
        swFa := *swArg["form"];
        swVia = 0;
        if swReq == 1;          swVia = *swFa.isGrouP;
        if swReq == 1;
            if swVia == 1;      swN = string $**swFa.taG$;
            if swVia == 0;      swN = string $*swFa$;
        swFs := environment["forShow"];
        showSearchUse := *swFs["searchNames"];
        showFilesUse := *swFs["fileNames"];
        swRs = 0;
        if swReq == 1;
            if *swArg["searchNames"];   swRs = 1;
        swRsA := *swArg["searchNames"];
        if swRs == 1;           showSearchUse := **swRsA;
        swRf = 0;
        if swReq == 1;
            if *swArg["fileNames"];     swRf = 1;
        swRfA := *swArg["fileNames"];
        if swRf == 1;           showFilesUse := **swRfA;
        swBad = 0;
        swMissing = 0;
        showCheckFiles(*showFilesUse);
        if swBad == 1;          return 0;
        // whichForm a form argument is defined when it has a list; a request's held form is defined; a request naming one by text finds it in FORMs
        swDef = 0;
        swLen := argument.listLengtH;
        if swReq == 0;
            if *swLen > 0;      swDef = 1;
            showFormNow := argument;
        if swReq == 1;
            if swVia == 1;      swDef = 1;
            if swVia == 1;      showFormNow := **swFa;
            if swVia == 0;
                if FORMs[swN];      swDef = 1;
                if FORMs[swN];      showFormNow := FORMs[swN];
        swNeed = 1;
        if swMissing == 0;
            if swDef == 1;      swNeed = 0;
        if swNeed == 0;     return showNow(*showFormNow);
        // entOutsideArm the entry is bound here, not inside the arm below: a := made inside an if arm holds nothing after it (measured SEQ 687)
        swEnt := sTASh[swN];
        swHas = 0;
        if sTASh[swN];      swHas = 1;
        if swDef == 0;
            if swHas == 0;
                cerr "REFUSED show" swN "-- not in the stash: it is not defined, and sTASh (incant/stashList) has no entry" swN "; nothing loaded":;
                return 0;
        // pathOutsideArm the same: bound at the top level, read only once the entry is known to be there
        swPath := *swEnt["File"];
        swOk = 0;
        if canOpen(*swEnt);     swOk = 1;
        if swDef == 0;
            if swOk == 0;
                cerr "REFUSED show" swN "-- the stash entry" swN "names" swPath "and no such file opens":;
                return 0;
        showPending = swN;
        showSaved := searchSave(0);
        cout "=== show" swN "deferred: what it needs loads after this statement, then it draws ===":;
        include(showFinishFile);
        if swDef == 0;      include(*swEnt);
        include(showStageFile);
        showLoadFiles(*showFilesUse);
        return 0;
        };
    showNow code={
        snKeep := searchSave(0);
        swBad = 0;
        showSearch();
        if swBad == 1;      searchRestore(*snKeep);
        if swBad == 1;      return 0;
        // byQualifiedName showForm is reached through Utilities, never the search list: a body binds its names when it is first built, with the search list of that moment (SEQ 688)
        snF := Utilities["showForm"];
        snOut := *snF(argument);
        searchRestore(*snKeep);
        return *snOut;
        };
    // fromTheList the search list a form is shown under: environment.forShow's searchNames, or the request's search:= (SEQ 724)
    showSearchKeep;
    // starNotInFor the walk takes its list as argument: for grup in *x reads the star as text (measured SEQ 724)
    // namesAreRegistries a name that is not a registry when the form is drawn is refused by name and nothing is drawn; checked here, since show's own files create the registries
    showAddRegs code={
        for grup in argument; attributes
            arN = string $*grup$;
            arOk = 0;
            if registries[arN];     arOk = 1;
            if arOk == 1;           *showSearchKeep +% registries[arN];
            if arOk == 0;           cerr "REFUSED show -- its search list names" arN "-- not a registry; nothing drawn":;
            if arOk == 0;           swBad = 1;
        };
    showSearch code={
        showSearchKeep := searchSave(0);
        showAddRegs(*showSearchUse);
        searchRestore(*showSearchKeep);
        return 0;
        };
    showStage code={
        showSearchKeep := searchSave(0);
        stFs := environment["forShow"];
        stList := *stFs["stageNames"];
        showAddRegs(*stList);
        searchRestore(*showSearchKeep);
        return 0;
        };
    showFinish code={
        sfN = string $showPending$;
        swBad = 0;
        showSearch();
        sfHas = 0;
        if FORMs[sfN];      sfHas = 1;
        if swBad == 1;      sfHas = 2;
        // formOutsideArm bound here, not inside the arm: a := made inside an if arm holds nothing (measured SEQ 687, again SEQ 688)
        sfF := FORMs[sfN];
        // byQualifiedName as in showNow
        sfShow := Utilities["showForm"];
        if sfHas == 1;      *sfShow(*sfF);
        if sfHas == 0;      cerr "REFUSED show" sfN "-- its file loaded and defines no form" sfN:;
        searchRestore(*showSaved);
        return 0;
        };
    ;
registry(Grokking);

/*******************************************************************************
                    incant/setup -- the commentary

    WHY IT IS DOWN HERE. Tony's ruling, 2026-09-16: the definitions above are a
    reference table and they are read as one, so argument wedged between the rows
    gets in the way of the thing the file is for. The same split the comment
    convention makes inside a method -- MOVE WHAT ARGUES, KEEP WHAT DESCRIBES --
    applied to a registry file. The short slug comments beside individual rows
    stay where they are; what moved is the long-form reasoning, one section per
    topic rather than one per line.

    ⚠ THIS IS NOT incant/directives' SHAPE, AND THE DIFFERENCE IS MEASURED.
    directives ends in bail() and carries its guide in a parse-dead region.
    setup cannot: bail() pops a DIVERTED input, and GroupMain loads setup with
    pushInput at a moment when sourceFILE is still null, so pushInput never
    raises inputDiverted and setup sits at the BOTTOM of the input stack with
    nothing to hand back to. A bail() here is inert -- measured 2026-09-16, prose
    placed under one was parsed and answered with three RunRulE complaints. So
    this region is an ordinary comment and is subject to every comment hazard.

    ⚠ ONE OPEN, ONE CLOSE, AND NO NESTED COMMENT MARKER ANYWHERE INSIDE. Bear-trap
    27: a comment carrying indented code-shaped text can kill the parse, silently,
    at exit 138 with no output -- and this file is read at runtime by every single
    run, so a break here takes down the whole fleet rather than one fixture. Keep
    additions to prose. Quote a spelling inline with backticks, never as an
    indented line of its own.

    1. THE INSTALL VOCABULARY -- setParse, parseClassify

    Promoted from incant/genScratch 2026-08-05 by Tony's ruling: define-time
    commands that must be commands WHERE THE GRAMMAR IS READ. parseMethod and
    parseTerms were its other two words; they retired 2026-09-26 with the C++
    emitter they installed for (SEQ 191).

    2. THE BOOLEAN OPERATORS -- `||`, `&&`, `shortCircuit`, `isOR`

    THE SYMBOL WAS FILLED 2026-08-01 (Tony's word). Demand was demonstrated by
    minionA round 2, which hit this and wrote twin sequential guards in `spellMany`
    instead of one disjunction.

    ⚠ IT WAS A REGISTRATION, NOT AN IMPLEMENTATION. Boolean OR already existed and
    was already sound -- `opOR` lives in Instruct.rtn and `testOR` exercised it in
    the unitTests baseline. What was missing was only the SYMBOL spelling: `'|'` is
    registered BARE, with no operateMethod, so `||` matched an inert operator and
    failed the body. `'||'` is registered explicitly rather than relying on `'|'`
    doubling, because the Operators header states the matcher returns the LONGEST
    match -- so the two-character entry wins cleanly and `'|'` keeps whatever future
    single-character meaning it is being held for.

    ⚠ `shortCircuit` IS A REGISTRATION, NOT A LIST, AND IT REPLACED TWO LISTS RATHER
    THAN ONE -- the tier-3 SELECTION in interpretXP and the SKIP ITSELF inside
    runShortCircuit, which both asked whether the operator's tag was AND or OR. That
    is why `||` did not short-circuit while the word form did, on the same
    operateMethod: measured 2026-09-10 with a side effect, `true OR loud()` fired the
    right arm 0 times and `true || loud()` fired it once. ⚠ AND FIXING ONLY THE
    SELECTION MADE `true || false` READ FALSE, because the second list then sent `||`
    past both skips into the right-arm evaluation. ONE LIST HID ANOTHER.
    `isOR` names WHICH way it short-circuits; the two together are the whole
    contract, and no spelling appears in either action.

    ⚠ THE WORD FORMS ARE RETIRED, 2026-09-10. `AND` and `OR` were registered here
    until the C spellings became correct; they are gone, and the only boolean
    operators in the language are `&&` and `||`. What made the rename possible was
    not the registration -- `||` carried opOR for weeks -- but the two SPELLING LISTS
    becoming registrations, one choosing the tier-3 binding and one choosing the skip
    direction. Until both fell, `||` evaluated its right operand and the word did not.


    3. THE PREFIX UNARIES -- `deref` and `accessClass`

    `deref` is the unary star that replaces auto-unwrapping. It is NAMED rather than
    symbol-spelled, for exactly the reason `negate` is: handleUnary re-points a prefix
    star here so the BINARY star slot (opMultiply, three consumers) is never touched.
    Same two-slot separation, same reason.

    `accessClass` IS A REGISTRATION RATHER THAN A LIST IN THE ACTION. Ruled
    try-and-buy 2026-09-10: a prefix unary is ACCESS class, binding to the PRIMARY
    before the postfix chain, or VALUE class, binding to the chain's RESULT. A
    starred `A.B` is a starred A, then dotted B; a negated `A.B` negates the whole of
    `A.B`. Only the ACCESS class carries the attribute, so the predicate is presence
    and the default is value.

    ⚠ IT GOES ON THE STAR OPERATOR AND NOT ON `deref`, because the class is asked
    BEFORE handleUnary maps the token to its named operator.


    4. THE RETIRED SET-POINTER OPERATOR -- its obituary

    Retired 2026-08-30, ruled by Tony. It was the manual way to set isPointer -- the
    flag that exempts a field from runOP's auto-unwrap. It could never be USED,
    because the unwrap it exempts from runs BEFORE the operator that sets it: the
    mechanism intercepted its own repair. That is what prompted the unary-star ruling.

    Measured 2026-08-30 across 178 fixtures and 29,634 runOP entries: isPointer
    suppressed an unwrap ZERO times, against 5,447 unwraps fired and 2,815 isIterator
    suppressions -- so the not-isPointer clause in all four unwrap lines is a
    never-true condition with no live customers. `deref` is its successor.

    ⚠ `opPointer` THE EXTERN SURVIVED as the `setPointer` definition-time command,
    used by bcPushField -- which retired with the bytecode road (deepClean S4,
    2026-10-02). Whether setPointer has any user left is on docs/cleanupList.md.


    5. THE THREE SLOTS -- operateMethod, interpretMethod, jitEmitter

    The star operator is the step-2 pathfinder, the first op to carry a jitEmitter.
    Three slots, three consumers, one op: operateMethod is the interpreter,
    interpretMethod was the bytecode handler (retired with the bytecode road,
    deepClean S4, 2026-10-02), jitEmitter is the JIT. They sit side by
    side deliberately; installing the third disturbs neither of the first two, which
    is what makes the migration one op at a time.


    6. THE MODIFIER CLASS

    Ruled 2026-09-10: A FLAG DESCRIBES A TERM; A REPETITION CHANGES WHAT THE TERM IS.
    Only the REPETITION class carries `repeatClass`, so the predicate is presence and
    the default is flag -- the same shape `accessClass` uses for the unary split, and
    for the same reason: a class you must not forget to declare is a class that will
    be forgotten.

    ⚠ THE CLASS LIVES IN THE Modifiers REGISTRY AND NOWHERE ELSE. modifyClass asks
    one predicate; there is no list of characters in any action. Adding a modifier is
    an edit to that block.

    ⚠ AND THE CURLY BRACES ARE FLAGS DESPITE LOOKING LIKE A LIMIT. They raise upTo
    and unGuarded -- facts ABOUT the term. The Limit construct is a separate grammar
    term and is repetition; it is handed to setLimits, never to modify.


    7. OPERATOR ORDER -- LONGEST-FIRST IS A CONVENTION, NOT THE MECHANISM

    ⚠ Operators IS CREATED UNSORTED, AND IT IS THE EXCEPTION. getRegistry mints
    every registry with isSorted = 1, which is sortAscending; GroupControl then
    clears it for this one registry alone -- `opFields.isSorted = false`, beside
    `opFields.isOperator = true`. ⚠ THE DEFAULT WOULD INVERT THIS TABLE: ascending
    order puts every PREFIX above its long form, which is exactly the spelling
    this file is written to avoid. So the order below is kept longest-first BY
    HAND, on purpose, and survives only because nothing re-sorts it.

    Twenty-three registered operators (twenty-five from 2026-09-29, with the
    property pair +< and =<) have another registered operator as a strict
    prefix: the vertical-bar pair, the whole plus family, every compare. The table
    is written longest-first throughout, and as of 2026-09-16 it is, with no
    exceptions -- two were found and fixed that day, the vertical-bar pair and the
    add-member operator, which had been sitting below bare plus.

    ⚠ BUT THE ORDER IS NOT WHAT MAKES THE MATCH WORK, AND THE HEADER USED TO SAY IT
    WAS. It read that the table is loaded in descending order SO longest match is
    returned -- a causal claim, and it is false. Measured 2026-09-16, three ways,
    on the two rows that were out of order at the time:

      the two-character bar form answered its whole truth table correctly while
      registered BELOW its one-character sibling;

      the one-character bar and the caret both refused BY NAME in the same run, so
      the channel that would have reported a mis-read was live and reporting;

      the add-member operator answered 3 where a bare-plus read would have answered
      7, while registered eight rows BELOW bare plus.

    So the matcher returns the longest match irrespective of where a row sits.

    ⚠⚠ AND THE MECHANISM WAS READ, NOT INFERRED FROM THE BEHAVIOUR -- 2026-09-16,
    read-only, two functions. IT IS LONGEST-FIT, AND THE FIT IS DECIDED ONE LAYER
    ABOVE THE REGISTRY.

    testContainer (RuleStuff.twk) does a greedy CHARACTER-SET scan to build the
    longest run of characters that could belong to SOME entry -- an UPPER BOUND,
    never the answer, because a set has no notion of where an entry ends -- and
    then BACKS OFF ONE CHARACTER AT A TIME, calling get() on each candidate, until
    one is a real entry. It starts long and shortens, so the first success is the
    LONGEST candidate that exists.

    get() (GroupItem.twk) is a linear walk with an EXACT WHOLE-TAG COMPARE. It
    stops at its first hit, and since tags in a registry are unique that first hit
    is the ONLY hit. So where a row sits changes how many compares happen before
    it is found and NOTHING ELSE.

    ⚠ THEREFORE LONGEST-FIRST ORDER BUYS READABILITY, AND NOT CORRECTNESS OR
    EFFICIENCY. Not correctness: get() finds the unique tag wherever it sits. Not
    efficiency in any useful sense either -- the linear walk's cost depends on
    where the FREQUENTLY-MATCHED entries sit, which is orthogonal to how long they
    are. The convention is worth keeping because it makes a mis-registration
    obvious to a human reading the table. That is the whole of it.

    ⚠ AND THE UPPER-BOUND SCAN IS WHERE THE REAL HAZARD LIVES, not the ordering.
    Any container holding both a symbol and a WORD puts that word's letters into
    the character set, so the scan can build a run that is an entry of nothing:
    `--grup` scanned as `--g` and the whole match failed, until the back-off
    landed on `--`. Tony's finding and ruling, 2026-08-02, recorded at
    testContainer. It is a design flaw of set-based character grouping and not an
    edge case -- and no amount of row ordering touches it.

    ⚠ DO NOT PIN THE ORDER IN A FIXTURE: a row-order pin moves for reasons
    unrelated to correctness, which is rule H3. incant/pop/opPrefixT pins THE
    ANSWER instead, one discriminating row per pair, and it stayed byte-identical
    across the 2026-09-16 reorder -- which is how that reorder was shown to be
    inert rather than assumed to be.


    8. THE STRUCK BYTECODE ROW in fILEs

    Struck 2026-08-28 by Tony's ruling, from trim census phase one. Its file was
    deleted at cc2fd2d and nothing has included it since. A registered includable
    naming a file that is gone fails at exit zero with nothing saying why, which is
    bear-trap 28's fourth row.

    9. THE PLUS-EQUALS MEMBERS HANG OFF A SECOND MENTION OF THE ENTRY

    Plus-equals keeps its own operateMethod on its first line, written plain. Its
    members -- one per data kind, picked per fire by pickKindOP -- hang off a
    SECOND mention of plus-equals directly below it, which restates no attribute.
    Naming an entry again in the same define reopens it; it does not mint a new
    one. The member block ends by DEDENT: the next entry at the outer indent
    follows as usual, and it may carry attributes of its own (the next one,
    plus-plus, does).
    ⚠ MEASURED 2026-09-25, CORRECTING TWO EARLIER VERSIONS OF THIS SECTION FROM THE
    SAME DAY. A member block written under an entry that HAS a name=value
    attribute corrupts that attribute: by the time the define processes the
    entry's own operateMethod, its text reads the MEMBER's value. Plus-equals was
    bound to opPlusEQisCOUNT from the moment its member went under it, and nothing
    showed it -- that method handed every non-count target back to opPlusEQ, and
    its witness sat after the hand-back. Hence the second, attribute-free mention.
    A lone semicolon line after a member block closes the WHOLE define -- which is
    why no such line is written here. The entry does NOT have to be last (Tony,
    measured: mid-block, the entry after it binds its own method). Bear-trap 56.

    10. THE BOOTSTRAP SHOW AND THE STASH (SEQ 687-688)

    show(name) works after Start(); alone. A form not yet defined is looked up in
    sTASh, the stash: a registry of its own, devoted to incantations, loaded here
    from incant/stash. That file is GENERATED by genLadder/stash.sh from the
    hand-kept list incant/stashList, one name a line: the user decides what is
    stashed, and an entry takes its incantation's own name (Tony, 2026-11-17).
    The stash is reached only by qualified name, sTASh[name], as dESCRIPTIONs is:
    it is not a base registry and never on a search list, so after Start(); the
    bare name firstLight is not its entry, and the form file's own define of
    firstLight lands in FORMs. fILEs is files only. A name that is not in the
    stash is refused, "not in the stash", and nothing is loaded, even when a file
    of that name exists. What is missing (the entry's file, styles, utilities)
    loads after show's statement, since an include inside an action is read after
    the action returns; showStage and showFinish carry it on, and showFinish
    draws and puts the search list back.

    11. THE ENVIRONMENT, FIRST PIECE (SEQ 724, ruled 2026-11-20)

    environment states what show used to carry in its code: root, paths, and
    forShow with searchNames, fileNames and stageNames. show reads only from it.
    A request -- a field holding form, by name or held -- names the member it
    replaces for one call, searchNames or fileNames; the rest stay default. The
    member names are new on purpose: a member or a request attribute that
    shares its name with an existing field writes onto that field, and search
    and show are the search command and the show action (measured SEQ 724). The
    loaded files are one list, loadedFiles, with one writer: utilities, styles and
    unitTests each add their own name at their foot, with no action call (an
    action called there primes lastREF and hides fixit setFlagTopLevel; SEQ 726).
    show never writes it: the files it queues in a call go in queuedFiles, so a
    name written twice is queued once. A search name is checked
    when the form is drawn, not before: at the bootstrap the registries do not
    exist until show's own files have loaded. root is the folder incant runs
    from; with root dot a relative path is its own location, which is what
    showPath derives in incant/utilities, showPathRoot.
*******************************************************************************/
