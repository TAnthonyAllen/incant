    currentFRAME;
    extern noPrint;
    fAIL noPrint;
    gUARD noPrint;
    hexSet=[0-9a-fA-F];
    labelIndex;     // used in bytecode label generate
    null=0;
    notInNameSet=[^a-zA-Z0-9];
    stringBUFFER;
    UnaryOPS bin
        '--';
        '-';
        '++';
        '@';
        '!';
        '$$';
        '*';
        '.';
    ;
/*******************************************************************************
    Modifiers -- one registration per character. The REPETITION class carries
    `repeatClass`; everything without it is a flag. See THE MODIFIER CLASS at
    the foot of this file.
*******************************************************************************/
registry(Modifiers);
define
    '+' repeatClass;
    '*' repeatClass;
    '?' repeatClass;
    '!';
    '<';
    '%';
    '&';
    '@';
    '-';
    '_';
    '^';
    '{';
    '}';
    '$';
    ;
/*******************************************************************************
	Keywords is a base registry defined on startup. It contains groups that play
    a role in the grammar. Keywords cannot be used as fields (the NamE rule rejects them);
*******************************************************************************/
registry(Keywords);
