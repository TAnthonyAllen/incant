Start();
include(unitTests);
include(utilities);
search reset stack Grokking UnitTests Utilities list;

register(HasTraits);
define
    htSeen; htAttrs; htTraits; htDisagree; htBoth; htAnchor;
    htProbe code={
        htA := hasAttributeS;
        htB := hasTraitS;
        htMix = 0;
        if htA;             htMix = 1;
        if htB;             htMix = htMix + 1;
        if htMix == 1;      ++htDisagree;
        if htMix == 2;      ++htBoth;
        if htB;             ++htTraits;
        if htA;             ++htAttrs;
        ++htSeen;
        };
    htWalk code={
        iterate htCur members on *argument;
        while ++htCur;
            htProbe(*htCur);
        };
    htRun code={
        htSeen = 0;  htAttrs = 0;  htTraits = 0;  htDisagree = 0;  htBoth = 0;
        htWalk(Grokking);
        cerr "HT-1 rules seen                 = " htSeen:;
        cerr "HT-2 carrying hasAttributeS     = " htAttrs:;
        cerr "HT-3 carrying hasTraitS         = " htTraits:;
        cerr "HT-4 carrying BOTH               = " htBoth:;
        cerr "HT-5 the two flags DISAGREE on  = " htDisagree " rules":;
        htAnchor = 0;
        cerr "fixHasTraitsHere -- HT-5 is the number, and HT-4 is what stops HT-5 being vacuous":;
        };
    ;
htRun();
print "HASTRAITS SENTINEL -- reached the foot":;
stop();

