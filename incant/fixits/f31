        clear(CodE);
        CodE = fbBuffer;
        fbCopy <- copyOf(CodE);
        fbCopy :. noPrinT;
        argument +% fbCopy;
        argument :. isCodeD;
        printTO(0);
        fbCount = fbCount + 1;
        if fbCount == 1;    fbFirst +% argument;
        cerr "INSTALL " fbCount " " ~taG:;
        };
    fbWalk argument code={
        iterate fbCur on argument members;
        while ++fbCur;
            if fbCount >= fbLimit;  continue;
            if noPrinT;             continue;
            if binTypE;             continue;
            if !isRulE;             continue;
            if actionTypE != 0;     continue;
