        iterate fbC on fbFirst;
        while ++fbC;
            cerr "COMPILING " ~taG:;
            compile(fbC);
        fixF31Here = 0;
        cerr "ANCHOR fixF31Here -- the verdict is the failed at line just above":;
        cerr :;
        cerr "READ IT LIKE THIS -- both arms install FORTY TWO bodies":;
        cerr "   arm 0  BlocK in, tokenize OUT   failed at else() AND followedBy()":;
        cerr "                                   the body text IS read":;
        cerr "   arm 1  BlocK OUT, tokenize in   failed at reached end of input":;
        cerr "                                   the body reads EMPTY":;
        cerr "   Same count. One member swapped. Opposite answers.":;
        cerr "   So it is the IDENTITY of the install, not the NUMBER of them.":;
        cerr "   Both pinned 2026-08-20. This run should reproduce its own arm.":;
        cerr :;
        cerr "   VOID, and not a verdict: installed other than 42, or left out":;
