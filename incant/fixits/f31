register(FixF31);
define
    fbBuffer buffer;
    fbOpen="{";
    fbClose="}";
    fbLimit=42;
    fbSkipAt=1;
    fbNever=999;
    fbCount=0;
    fbSkipped=0;
    fbFirst;
    f31Arm=1;
    fixF31Here=0;
    fbSkipIt argument code={
        fbSkipped = fbSkipped + 1;
        fbSkipAt = fbNever;
        cerr "SKIP  leaving this one OUT, and here is its name":;
        cerr "SKIP  " taG argument:;
        showBody(argument);
        };
    fbGen argument code={
        reset(fbBuffer);
        printTO(fbBuffer);
        print fbOpen:;
        if datA != 0;
            printTO(0);
            return;
        if hasAttributeS;   fbJoin = "AND";
        else                fbJoin = "OR";
        print `"if ";
        iterate fbTerm on argument;
        while ++fbTerm;
            print $taG "()";
            if nexT;    print _fbJoin;
            else        print ";";
        @argument;
        print $"return runRuleAction(this);":;
