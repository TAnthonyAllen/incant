        };
    fbRun code={
        cerr "== fixit F-31 -- is it ONE install, or the COUNT of installs ==":;
        if f31Arm == 0;     fbSkipAt = fbNever;
        cerr "-- the suspect BEFORE any installs --":;
        showBody(Grokking["tokenize"]);
        fbWalk(Grokking);
        cerr "== installed " fbCount " bodies, left out " fbSkipped " ==":;
        cerr "-- the suspect AFTER the installs --":;
