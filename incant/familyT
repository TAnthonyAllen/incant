            print + `taG walkR:;
        print "2 the arithmetic-compound ops over a list:";
        numA = 100;
        numA -= 7;
        print + "numA scalar -=7   " numA:;
        numB = 100;
        numB -= 1 2 3;
        print + "numB list  -=1 2 3" numB:;
        numC = 100;
        numC *= 2 3;
        print + "numC list  *=2 3  " numC:;
        numD = 100;
        numD /= 2 5;
        print + "numD list  /=2 5  " numD:;
        numE += 1 2 3;
        print + "numE FRESH -- no data, list +=" numE:;
        print "3 += over a list on a FRESH target (the non-iterating arm):";
        freshA += "p" "q" "r";
        print + "freshA = [" freshA "]":;
        };
    ;

runFam();
print "FT SENTINEL":;
