dumpRuleTerms('ScafB');
dumpRuleTerms('JSONblock');
dumpRuleTerms('JSONfield');
dumpRuleTerms('JSONvalue');
dumpRuleTerms('JSONtoken');
dumpRuleTerms('JSONitem');
