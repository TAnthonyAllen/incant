register(UnitTests);
define
    atBare      = 0;
    atCapt      = 0;
    atTotal     = 0;
    atDisagree  = 0;
    atAbsurd    = 0;
    atAfter     = 0;
    atWalk argument code={
        atBare      = 0;
        atCapt      = 0;
        atTotal     = 0;
        atDisagree  = 0;
        atAbsurd    = 0;
        atAfter     = 0;
        iterate atCur members on *argument;
        while ++atCur;
            ++atTotal;
            if actionTypE == 0;         ++atBare;
            if actionTypE == 999;       ++atAbsurd;
            atLocal := atCur.actionTypE;
            if atLocal == 0;            ++atCapt;
            if atLocal != 0;            ++atDisagree;
            if actionTypE == 0;         ++atAfter;
        };
    atReport code={
        atWalk(Grokking);
        print "ATYPE population walked      " atTotal:;
        print "ATYPE bare     if actionTypE == 0  " atBare:;
        print "ATYPE captured atLocal      == 0   " atCapt:;
        print "ATYPE captured NON-zero (anti-vacuity, must be > 0) " atDisagree:;
        print "ATYPE CONTROL  bare if actionTypE == 999      " atAbsurd:;
        print "ATYPE bare AGAIN, after a cursor mention          " atAfter:;
        };
    ;

atReport();
cerr "ATYPE SENTINEL -- both readings printed":;
stop();

