search reset stack Grokking UnitTests Utilities list;

/*  MEASUREMENT ONLY (genParseShape S1.5). What does rule[i] actually hold —
    does a `fail` modifier or a code={} tail occupy a slot? Read it off the
    tree; do not reason about it.  */
registry(cOMMANDs);
define dumpRuleTerms immediateAction=dumpRuleTerms; ;

registry(cOMMANDs);
define parseMethod immediateAction=parseRuleMethod noPrint; ;

/*  Scaf is defined WITH its binding attribute, to answer a second question:
    does a noPrint definition attribute PERSIST in the rule's own list? If it
    does, a sibling attribute is a usable place to carry the emitted term count
    (Clay SEQ 26 §3) with no layout change.  */
register(Ladder);
define
    Scaf isRule "x"- parseMethod=parseScaf;
    Scaf2 isRule "{"- "}"-;
    ;
search reset stack Grokking Ladder UnitTests Utilities list;

/*  Dump AFTER a real parse has run: rule-reference terms showed no isGROUP at
    define time, and getWhatFollows (which populates rStuff.onGroup) gates on
    isGROUP — so the question is what parseR would actually see at RUNTIME.  */
define
    testJSON code={
        clear(listed);
        field = JSONblock(argument);
        if field    print "  ok  :" argument:;
        else        print "  FAIL:" argument:;
        };
    ;
testJSON('{"a":"b"}');

/*  §4.2 CENSUS. The JSON family is the ladder's target; the bootstrap grammar
    rules are the REAL language, and they are what exercise the rows the JSON
    family never reaches (sets, upTo, macros, parseAction, noSkip, repetition).
    A census restricted to the JSON family would report a much tidier table
    than the tree actually holds.  */
dumpRuleTerms('Scaf');
dumpRuleTerms('Scaf2');
dumpRuleTerms('JSONblock');
dumpRuleTerms('JSONfield');
dumpRuleTerms('JSONvalue');
