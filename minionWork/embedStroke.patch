+/***************************************************************************
+    embed -- THE ONE LEGITIMATE COPY OF AN EMBEDDED RULE, AND THE SOLE WRITER
+    OF isEmbedded.   GroupItem.embed
+***************************************************************************/
+void embed(GroupItem g)
+{
+GroupItem   copy;
+    if !g || !g.isRule  setGroup(g);
+    else {
+        copy            = new(g);
+        copy.parent     = this;
+        copy.isEmbedded = true;
+        setGroup(copy); }
+}
