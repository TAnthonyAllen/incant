register(F31PreRegWalk);
define
    fpCount=0;
    fpKids=0;
    fpWalk argument code={
        iterate fpCur on argument;
        while ++fpCur;
            fpCount = fpCount + 1;
            cerr "SECTION " ~taG:;
            if listLengtH;
                iterate fpKid on fpCur;
                while ++fpKid;
                    fpKids = fpKids + 1;
                    cerr "   ENTRY " ~taG:;
        };
    fpRun argument code={
        fpWalk(argument);
        cerr "PREREG sections " fpCount:;
        cerr "PREREG entries " fpKids:;
        cerr "F31PREREG SENTINEL -- the pre-registration parsed and walked":;
        stop();
