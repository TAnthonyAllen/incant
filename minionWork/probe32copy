Start();
include(unitTests);
include(utilities);
search reset stack Grokking UnitTests Utilities list;
register(Frontier);
define
    frAny=0;
    frDead=0;
    frOk=0;
    frOk2=0;
    frOk3=0;
    frBuf buffer;
    frOpen="{";
    frClose="}";
    frMark=987654;
    StorE;
    frSample width=1 height=2;
    frTwin;
    frLive;
    frRan=0;
    frDeclared=9;
    frBanner=0;
    frIncomplete=0;
    frLiveLen=0;
    frLiveLen2=0;
    frTwinLen=0;
    frTwinLen2=0;
    frWitness=0;

    frBodyMarker code={
        reset(frBuf);
        printTO(frBuf);
        print frOpen:;
        print $"if  leftBrace() AND ExpressioN() AND rightBrace();      frWitness = " frMark ";":;
        print $"return runRuleAction(this);":;
        print `frClose:;
        printTO(0);
        clear(StorE);
        StorE = frBuf;
        };
    frBodyTrigger code={
        reset(frBuf);
        printTO(frBuf);
        print frOpen:;
        print $"frSample[width] = 251;":;
        print `frClose:;
        printTO(0);
        clear(StorE);
        StorE = frBuf;
        };
    frHang argument code={
        frCopy <- copyOf(StorE);
        frCopy :. noPrinT;
        argument +% frCopy;
        };

    frStation1 code={
        fixFrontier1Here = 0;
        frRan = frRan + 1;
        cerr "ANCHOR frontier station 1 -- generate one body":;
        frBodyMarker();
        frOk = 0;
        if StorE.datA;      frOk = 1;
        if frOk == 1;
            cerr "STATION 1 generate body: PASS -- body text follows":;
            cerr StorE:;
        else
            cerr "STATION 1 generate body: FAIL -- expected non-empty body text, read empty":;
            frDead = 1;
        };
    frStation2 code={
        fixFrontier2Here = 0;
        frRan = frRan + 1;
        cerr "ANCHOR frontier station 2 -- mint the twin, BEFORE anything is hung on the live rule":;
        frTwin <- copyOf(Grokking["Braced"]);
        frLive <- Grokking["Braced"];
        frLiveLen = frLive.listLengtH;
        frTwinLen = frTwin.listLengtH;
        cerr "STATION 2 live list length " frLiveLen " twin list length " frTwinLen:;
        frOk = 0;
        if frTwinLen == frLiveLen;      frOk = 1;
        if frTwinLen == 0;              frOk = 0;
        if frOk == 1;            cerr "STATION 2 mint twin: PASS -- twin is a faithful, unfired copy":;
        else
            cerr "STATION 2 mint twin: FAIL -- twin list length does not match the live rule, or is empty":;
            frDead = 1;
        };
    frStation3 code={
        fixFrontier3Here = 0;
        frRan = frRan + 1;
        cerr "ANCHOR frontier station 3 -- hang the body on the LIVE rule and store it":;
        frHang(Grokking["Braced"]);
        storeBody(Grokking["Braced"]);
        frLive <- Grokking["Braced"];
        frLiveLen2 = frLive.listLengtH;
        cerr "STATION 3 live list length was " frLiveLen " now " frLiveLen2:;
        frOk = 0;
        if frLiveLen2 > frLiveLen;      frOk = 1;
        if frOk == 1;            cerr "STATION 3 store body: PASS -- body hung on the live rule; census follows, pending must read 1":;
        else
            cerr "STATION 3 store body: FAIL -- the live rule did not grow, so nothing was hung":;
            frDead = 1;
        bodyCensus(frAny);
        };
    frStation4 code={
        fixFrontier4Here = 0;
        frRan = frRan + 1;
        cerr "ANCHOR frontier station 4 -- install on the twin via activateBody, then READ IT BACK":;
        activateBody(frTwin);
        frCode <- frTwin["CodE"];
        frTwinLen2 = frTwin.listLengtH;
        cerr "STATION 4 twin list length was " frTwinLen " now " frTwinLen2:;
        frOk = 0;
        if frTwinLen2 > frTwinLen;      frOk = 1;
        frOk2 = 0;
        if frCode;                      frOk2 = 1;
        if frOk2 == 0;                  frOk = 0;
        if frOk == 1;
            cerr "STATION 4 install on twin: PASS -- read-back follows":;
            cerr frCode:;
        else
            cerr "STATION 4 install on twin: FAIL -- expected the twin to grow and to carry a CodE":;
            frDead = 1;
        };
    frStation5 code={
        fixFrontier5Here = 0;
        frRan = frRan + 1;
        cerr "ANCHOR frontier station 5 -- compile the twin":;
        frLive <- frTwin;
        frTwinLen = frLive.listLengtH;
        compile(frTwin);
        frLive <- frTwin;
        frTwinLen2 = frLive.listLengtH;
        cerr "STATION 5 twin list length was " frTwinLen " now " frTwinLen2:;
        frOk = 0;
        if frTwinLen2 > frTwinLen;      frOk = 1;
        if frOk == 1;            cerr "STATION 5 compile twin: PASS -- the twin grew a BlocK":;
        else
            cerr "STATION 5 compile twin: FAIL -- no BlocK on the twin, so the parse did not land; texture is above this line":;
            frDead = 1;
        };
    frStation6 code={
        fixFrontier6Here = 0;
        frRan = frRan + 1;
        cerr "ANCHOR frontier station 6 -- harvest the BlocK onto the original rule":;
        frArt <- frTwin["BlocK"];
        frCod <- frTwin["CodE"];
        frLive <- Grokking["Braced"];
        frLiveLen = frLive.listLengtH;
        Grokking["Braced"] +% copyOf(frCod);
        Grokking["Braced"] +% copyOf(frArt);
        Grokking["Braced"] :. isActioN;
        frLive <- Grokking["Braced"];
        frLiveLen2 = frLive.listLengtH;
        frOk2 = 0;
        if frLive.isActioN;      frOk2 = 1;
        cerr "STATION 6 live list length was " frLiveLen " now " frLiveLen2 " -- isActioN reads back " frOk2:;
        frOk = 0;
        if frLiveLen2 > frLiveLen;      frOk = 1;
        if frOk2 == 0;      frOk = 0;
        if frOk == 1;            cerr "STATION 6 harvest: PASS -- artifact grew onto the live rule AND isActioN verified set":;
        else
            cerr "STATION 6 harvest: FAIL -- need BOTH the live rule to grow and isActioN reading back set":;
            frDead = 1;
        };
    frStation7 code={
        fixFrontier7Here = 0;
        frRan = frRan + 1;
        cerr "ANCHOR frontier station 7 -- BIND the live rule's parse path to the artifact":;
        setParse(Grokking["Braced"]);
        cerr "STATION 7 parseClassify follows; it must read  PC parseRule Braced":;
        parseClassify(Grokking["Braced"]);
        frOk = 0;
        frLive <- Grokking["Braced"];
        if frLive.hasActioN;     frOk = 1;
        cerr "STATION 7 actionMethod now bound " frOk " (setParse moves gMethod into it)":;
        if frOk == 1;            cerr "STATION 7 bind: PASS -- parse path routed; the census line above is the evidence":;
        else
            cerr "STATION 7 bind: FAIL -- setParse left actionMethod empty, so nothing was routed":;
            frDead = 1;
        };
    frStation8 code={
        fixFrontier8Here = 0;
        frRan = frRan + 1;
        cerr "ANCHOR frontier station 8 -- discard the twin":;
        clear(frTwin);
        cerr "STATION 8 discard twin: PASS -- twin cleared; census follows, stray must read 0":;
        bodyCensus(frAny);
        };
    frStation9 code={
        fixFrontier9Here = 0;
        frRan = frRan + 1;
        cerr "ANCHOR frontier station 9 -- run the original; the witness is the verdict":;
        cerr "STATION 9 expects the witness to read " frMark " if the commissioned artifact executed":;
        frBodyTrigger();
        frHang(Grokking["QuotE"]);
        storeBody(Grokking["QuotE"]);
        frWitness = 0;
        frFire := compileStored(Grokking["QuotE"]);
        frOk = 0;
        if frFire;          frOk = 1;
        frOk2 = 0;
        if frWitness == frMark;     frOk2 = 1;
        cerr "STATION 9 trigger parsed " frOk " -- witness reads " frWitness " and must equal " frMark:;
        if frOk == 0;       frDead = 1;
        if frOk2 == 0;      frDead = 1;
        if frOk == 0;       cerr "STATION 9 run original: FAIL -- the trigger itself would not parse, so the witness proves nothing":;
        if frOk2 == 1;      cerr "STATION 9 run original: PASS -- the commissioned artifact EXECUTED on trigger":;
        else      cerr "STATION 9 run original: FAIL -- the commissioned artifact did NOT execute; the two values above are the evidence":;
        };

    frRun code={
        cerr "=== incant/frontier -- the campaign live edge, nine stations ===":;
        frStation1();
        if frDead == 0;     frStation2();
        if frDead == 0;     frStation3();
        if frDead == 0;     frStation4();
        if frDead == 0;     frStation5();
        if frDead == 0;     frStation6();
        if frDead == 0;     frStation7();
        if frDead == 0;     frStation8();
        if frDead == 0;     frStation9();
        cerr "FRONTIER ran-census: stations that RAN " frRan " of " frDeclared " declared":;
        frOk = 0;
        if frRan == frDeclared;     frOk = 1;
        frBanner = 0;
        if frDead == 0;             frBanner = 1;
        if frOk == 0;               frBanner = 0;
        frIncomplete = 0;
        if frOk == 0;               frIncomplete = 1;
        if frDead == 1;             frIncomplete = 0;
        if frDead == 1;     cerr "=== FRONTIER: STOPPED -- a station returned a NO verdict above. ===":;
        if frIncomplete == 1;   cerr "=== FRONTIER: INCOMPLETE -- a station never RAN. No success is claimed; see the census. ===":;
        if frBanner == 1;   cerr "=== FRONTIER: all nine stations RAN and PASSED. ===":;
        cerr "FRONTIER SENTINEL -- the ladder reached its foot":;
        stop();
        };
    ;
frRun();

WHAT THIS FILE IS

incant/frontier is the campaign's live edge, executable. It walks the pipeline
one station at a time and dies at the first thing that does not work yet. That
death is the point: the station that fails is where the campaign currently is.

IT IS ONE FILE, REVISED IN PLACE AT EVERY SEAL, AND NEVER FORKED. There is no
frontier2, no frontierOld. If you are looking at a copy, someone broke the
practice. Each seal updates the dated line below and re-runs the file, and the
seal names the first failing station.

FRONTIER AS OF 2026-08-22 (SEQ 83): compile-of-a-stored-body, pending the
portability verdict. Subject is Braced. The day this file runs all eight
stations green with tokenize as the subject instead of Braced is the day the
campaign is over.

IT IS NOT A FLEET CITIZEN. It never joins pop.sh -- the fleet measures what
holds, and this measures what does not yet. It is not a fixit citizen either
and never appears in fixitNag's count.

HOW TO USE IT IN XCODE

Every station opens with a uniquely-named inert anchor -- fixFrontier1Here
through fixFrontier8Here -- and a cerr naming the station. Set a name
conditioned breakpoint on any anchor and you land exactly at that station with
everything the previous stations built still in scope, ready to step.

WHY EVERY STATION PRINTS EVEN WHEN IT PASSES

Rule H4. A station that only speaks on failure passes the day somebody deletes
the code that would have spoken. So each prints PASS or FAIL with the value it
read, and an empty read is an answer rather than a silence. The first FAIL sets
frDead and every later station is skipped without printing, so the failing line
is the last verdict on screen and nothing buries it.


