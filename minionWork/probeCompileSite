Start();
include(unitTests);
include(utilities);
search reset stack Grokking UnitTests Utilities list;
register(VS5);
define
    vsAny=0;
    vsBuf buffer;
    vsOpen="{";
    vsClose="}";
    StorE;
    vsRun code={
        reset(vsBuf);
        printTO(vsBuf);
        print vsOpen:;
        print $"return runRuleAction(this);":;
        print `vsClose:;
        printTO(0);
        clear(StorE);
        StorE = vsBuf;
        vsCopy <- copyOf(StorE);
        vsCopy :. noPrinT;
        vsTarget <- Grokking["Braced"];
        vsTarget +% vsCopy;
        storeBody(vsTarget);
        cerr "-- A: compileStored (entry), live slot untouched --":;
        vsA := compileStored(vsTarget);
        if vsA;  cerr "   A COMPILED ok":;
        else     cerr "   A refused/failed":;
        bodyCensus(vsAny);
        cerr "-- B: activateBody then compile the RULE (SEQ 78 proven path) --":;
        activateBody(vsTarget);
        vsB := compile(vsTarget);
        if vsB;  cerr "   B COMPILED ok":;
        else     cerr "   B refused/failed":;
        cerr "VS5 SENTINEL":;
        stop();
        };
    ;
vsRun();
