Start();
include(unitTests);
include(utilities);
search reset stack Grokking UnitTests Utilities list;
register(ProbeR);
define
    dOk=0;
    dBuf buffer;
    dOpen="{";
    dClose="}";
    dMark=987654;
    StorE;
    dTwin;
    dSample width=1 height=2;
    dWitness=0;
    dBody code={
        reset(dBuf);
        printTO(dBuf);
        print dOpen:;
        print $"dWitness = " dMark ";":;
        print `dClose:;
        printTO(0);
        clear(StorE);
        StorE = dBuf;
        };
    dHang code={
        dCopy <- copyOf(StorE);
        dCopy :. noPrinT;
        argument +% dCopy;
        };
    dRun code={
        cerr "=== DECISIVE -- operate on the REAL node throughout (no <- on the subject) ===":;
        dBody();
        dTwin <- copyOf(Grokking["Braced"]);
        dHang(Grokking["Braced"]);
        storeBody(Grokking["Braced"]);
        activateBody(dTwin);
        compile(dTwin);
        dArt <- dTwin["BlocK"];
        dCod <- dTwin["CodE"];
        Grokking["Braced"] +% copyOf(dCod);
        Grokking["Braced"] +% copyOf(dArt);
        Grokking["Braced"] :. isActioN;
        cerr "-- commissioned on the REAL node; now bind it":;
        setParse(Grokking["Braced"]);
        parseClassify(Grokking["Braced"]);
        canonOf(Grokking["Braced"]);
        cerr "-- fire the trigger":;
        traceParse(Grokking["Braced"]);
        reset(dBuf);
        printTO(dBuf);
        print dOpen:;
        print $"dSample[width] = 251;":;
        print `dClose:;
        printTO(0);
        clear(StorE);
        StorE = dBuf;
        dHang(Grokking["QuotE"]);
        storeBody(Grokking["QuotE"]);
        dWitness = 0;
        dFire := compileStored(Grokking["QuotE"]);
        dOk = 0;
        if dFire;   dOk = 1;
        cerr "   trigger parsed " dOk:;
        cerr "   WITNESS reads " dWitness " and must read " dMark:;
        cerr "DECISIVE SENTINEL":;
        stop();
        };
    ;
dRun();
