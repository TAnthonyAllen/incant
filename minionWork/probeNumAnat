Start();
include(unitTests);
include(utilities);
search reset stack Grokking UnitTests Utilities list;
register(NumAnat);
define
    rnI=0; rnL=0; rnD=0;
    rnItem argument code={
        rnI = rnI + 1;
        rnL = argument.listLengtH;
        rnD = 0;
        if argument.datA != 0;      rnD = 1;
        cerr "     [" rnI "] " ~taG " list=" rnL " data=" rnD:;
        };
    rnWalk argument code={
        cerr "  ATTRIBUTES of " ~taG ":":;
        rnI = 0;
        iterate rnA on argument attributes;
        while ++rnA;
            rnItem(rnA);
        cerr "  MEMBERS of " ~taG ":":;
        rnI = 0;
        iterate rnM on argument members;
        while ++rnM;
            rnItem(rnM);
        };
    rnHead argument code={
        rnL = argument.listLengtH;
        rnD = 0;
        if argument.datA != 0;      rnD = 1;
        cerr "RULE " ~taG " list=" rnL " data=" rnD:;
        canonOf(argument);
        showBody(argument);
        };
    rnRun code={
        cerr "=== R1/R2: the governing NumbeR, direct-subscript road ===":;
        rnHead(Grokking["NumbeR"]);
        rnWalk(Grokking["NumbeR"]);
        cerr :;
        cerr "=== controls: a rule we have mapped before, and the orphan ===":;
        rnHead(Grokking["NamE"]);
        rnWalk(Grokking["NamE"]);
        cerr :;
        rnHead(Grokking["HeX"]);
        rnWalk(Grokking["HeX"]);
        cerr :;
        rnHead(Grokking["FloaT"]);
        cerr "NUMANAT SENTINEL -- reached the foot":;
        stop();
        };
    ;
rnRun();
