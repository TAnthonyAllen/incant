register(JitArcWalk);
define
    jaCount=0;
    jaKids=0;
    jaWalk code={
        iterate jaCur on *argument;
        while ++jaCur;
            jaCount = jaCount + 1;
            cerr "SECTION " ~taG:;
            if listLengtH;
                iterate jaKid on jaCur;
                while ++jaKid;
                    jaKids = jaKids + 1;
                    cerr "   ENTRY " ~taG:;
        };
    jaRun code={
        jaWalk(argument);
        cerr "JITARC top-level entries" jaCount:;
        cerr "JITARC child attributes " jaKids:;
        cerr "JITARCPHASE1 SENTINEL -- the report parsed and walked":;
        stop();
        };
    ;
jaRun(JitArcPhase1);
