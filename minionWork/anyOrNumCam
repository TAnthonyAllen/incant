    ruleText="maybe a test;";
    generateParse argument code={
        cerr "generating parse for " argument.taG:;
        cerr "CAM (i) generateParse receives/installs on":;
        addrOf(argument);
        reset(codeBuffer);
        printTO(codeBuffer);
        print openBrace:;
