        if datA != 0;
            if listLengtH; print "rules should not have data and a list; one or the other":;
            cerr "leaf " taG:;
            printTO(0);
            return;
        if hasTraitS;       conjunct = "AND";
        else                conjunct = "OR";
        print `"if ";
        iterate grup on argument;
        while ++grup;
            if noPrinT;     continue;
            if notFirstTimeThru > 0;    print _conjunct;
            ++notFirstTimeThru;
            if activating != 0;     setParse(grup);
            print $taG "()";
        print ";";
        @argument;
        print $"return runRuleAction(this);":;
        print `closeBrace:;
        clear(CodE);
        CodE = codeBuffer;
        codeCopy <- copyOf(CodE);
        codeCopy :. noPrinT;
        argument +% codeCopy;
        argument :. isCodeD;
        printTO(0);
        @CodE;
        print taG "=" CodE:;
        };
    walkRules argument code={
        if actionTypE == 0;
            length  = listLengtH;
            generateParse(argument);
            if argument["CodE"];    compile(argument);
            else    cerr taG "has no CodE":;
            if length > 0;
                iterate grup on argument;
                while ++grup;
                    if noPrinT;     continue;
                    if binTypE;     continue;
                    if isRule;      walkRules(grup);
        else    cerr taG "already has code so no parse generated":;
        };
    parser argument code={
        walkRules(argument);
        cerr "PARSER SENTINEL -- walk complete":;
        compiledHere = 0;
        if argument.hasNewParsE;     compiledHere = 1;
        cerr "WITNESS compiled " compiledHere " -- 1 = compile ran on this rule, 0 = it did not":;
        cerr "CAM (ii) the field argument(ruleText) invokes":;
        addrOf(argument);
        if argument["builtinParsE"];    cerr "CAM mirror   builtinParsE PRESENT":;
        else                            cerr "CAM mirror   builtinParsE ABSENT":;
        parseAnswer = argument(ruleText);
        cerr "CAM (iii) what came back from the invocation":;
        addrOf(parseAnswer);
        camDirect := argument(ruleText);
        cerr "CAM (iii-b) same call captured by rebind":;
        addrOf(camDirect);
        print ~"PARSE " argument.taG " <- " ruleText:;
        print `"ANSWER " parseAnswer:;
        cerr "VERIFY SENTINEL -- answer reported":;
        stop();
        };
    ;

