
/*******************************************************************************
	This is a wrapper for returning a parse result (mostly to provide a
    common place to add a success/failure directive
*******************************************************************************/
extern GroupItem exitFromParse(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
    if sukcess {
        if lastRule != field
            if lastRule && lastRule.rStuff != parentStuff {
                parentStuff = lastRule.rStuff;
                if parentStuff && parentLabel != parentStuff.label  parentLabel = parentStuff.label; }
        if noAdvance    atRuleMark = hereAt;
        fireLabelMethod(ruleStuff);
        if sukcess {
            if label && !noLabel {
                if parentLabel && parentLabel != label
                    if label.isGROUP && max > 1 {
                        parentLabel     +% label.group;
                        label.clear(); }
                    else {
                        parentLabel +% label;
                        label   = new(tag); }
                return label; }
            else    return trueResult; }}
    atRuleMark  = hereAt;
    return 0;
}

/*******************************************************************************
	Process a parseAction
*******************************************************************************/
extern GroupItem parseAction(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
    sukcess = false;
    if parseACTION || !label
        { if label = field.method(field)    sukcess = true; }
    or label = field.method(label)          sukcess = true;
    if label    label.clear();
    return exitFromParse(field);
}

/*******************************************************************************
	Run a wild card test on this group against current input
*******************************************************************************/
extern GroupItem parseAny(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
int         counter;
int         more;
    sukcess = false;
    if checkInput() {
        while *atRuleMark {
            if counter >= max { more = true; break; }
            counter++;
            atRuleMark++;
            if !*atRuleMark break; }
        if more && max > 1 && !limitsSet   reportMaxLimit(field);
        or counter && counter >= min {
            if label    label.setToken(hereAt,counter);
            sukcess     = true; }}
    if label    label.clear();
    return exitFromParse(field);
}

/*******************************************************************************
	Run a character test on this group against current input
*******************************************************************************/
extern GroupItem parseCharacter(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
int         counter;
int         more;
    sukcess = false;
    if checkInput() {
        while *atRuleMark == character {
            if counter >= max { more = true; break; }
            counter++;
            atRuleMark++;
            if !*atRuleMark break; }
        if more && max > 1 && !limitsSet   reportMaxLimit(field);
        or counter && counter >= min {
            if label    label.setToken(hereAt,counter);
            sukcess     = true; }}
    if label    label.clear();
    return exitFromParse(field);
}

/*******************************************************************************
	Process a condition
*******************************************************************************/
extern GroupItem parseCondition(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
    if min  sukcess = true;
    else    sukcess = false;
    return exitFromParse(field);
}

/*******************************************************************************
    Registry and Container test looks for a field entry that matches the input stream.
*******************************************************************************/
extern GroupItem parseContainer(GroupItem field)
{
GroupRules  ruler = groupRules;
PLGset      inSet = characterSet;
String      atInput = atRuleMark;
int         advance;
Buffer      buffer = stringBUFFER;
RuleStuff   ruleStuff = rStuff;
GroupItem   grup;
use field
    sukcess = false;
    if checkInput() {
        reset();
        atInput = atRuleMark;
        while *atInput
            if contains(*atInput)   { buffer += *atInput; atInput++; }
            else break;
        while advance = length() {
            if grup = get(string()) {
                if !noAdvance   atRuleMark += advance;
                if label    label.group = grup;
                sukcess     = true; }
            shorten(1); }}
    if label    label.clear();
    return exitFromParse(field);
}

/*******************************************************************************
	Process a loop (max > 1)
*******************************************************************************/
extern GroupItem parseLoop(GroupItem field)
{
    if lastRule     field = lastRule.get(field.tag);
RuleStuff   ruleStuff = rStuff;
    kount = 0;
    while kount < max
        if !parseMethod(field) break;
        else kount++;
    if sukcess  return trueResult;
    return 0;
}

/*****************************************************************************
     Parse a rule. Assumes processCode was run on field already.
        See bareFieldRepoint DesignDocs entry
*****************************************************************************/
extern GroupItem parseRule(GroupItem field)
{
GroupRules  ruler = groupRules;
GroupItem   code = field[CodE],
            result,
            grup,
            myLabel,
            into,
            saveLastRule,
            ruleArg;
GroupItem   priorMETHOD;
use field
    if lastRule     field = lastRule.get(field.tag);
RuleStuff   ruleStuff = rStuff;
    measureParentProbe(field);
    // bareFieldRepoint the use lines below are load bearing
    if lastRule {
        saveLastRule    = lastRule;
        if lastRule && lastRule.rStuff != parentStuff {
            parentStuff = lastRule.rStuff;
            if parentStuff && parentLabel != parentStuff.label  parentLabel = parentStuff.label; }}
    lastRule = field;
use ruleStuff
    sukcess = false;
    if checkInput() {
use grup
        if field.isAction {
            while grup = code.nextAttribute(grup)
                if isLocal && !isRule && !noPrint && groupBody != field.groupBody clear();
            // intoRidesArgument a FRESH MINT per invocation, one slot cannot survive recursion
            into    = parentLabel;
            myLabel = new(field.tag);
            measureLabelMint(field,myLabel,into);
            /*****************************************************************
                Add argument to the field. See argumentBind and bindTheBodysOwnSlot DesignDocs entries
            *****************************************************************/
            ruleArg = code["argument"];
            if !ruleArg     ruleArg = field["argument"];
            if !ruleArg     ruleArg = field += "argument";
            ruleArg.isArgument = true;

            saveLocalFields(field);
            ruleArg.group = myLabel;
            priorMETHOD     = currentMETHOD;
            currentMETHOD   = field;
            /*****************************************************************
                here the parse action in method gets run
            *****************************************************************/
            if result = field["BlocK"] {
                result = result.gMethod(result);
                if result   result.isBranch = 0; }
            currentMETHOD = priorMETHOD;
            restoreLocalFields(field); }
        else        reportNoBody(field);
checkSuccess:   // this is just a marker for directives
        if result   sukcess = true;
        }
    if saveLastRule lastRule = saveLastRule;
    else            lastRule = 0;
    return exitFromParse(field);
}

/*******************************************************************************
	Run a character set test on this group against current input
*******************************************************************************/
extern GroupItem parseSet(GroupItem field)
{
PLGset      set = characterSet;
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
int         counter;
int         more;
    sukcess = false;
    if checkInput() {
        while set.contains(*atRuleMark) {
            if counter >= max { more = true; break; }
            counter++;
            atRuleMark++;
            if !*atRuleMark break; }
        if more && max > 1 && !limitsSet   reportMaxLimit(field);
        or counter && counter >= min {
            if label    label.setToken(hereAt,counter);
            sukcess     = true; }}
    if label    label.clear();
    return exitFromParse(field);
}

/***************************************************************************
	Parse method for a field w/data = isSTRING or isTOKEN
***************************************************************************/
extern GroupItem parseString(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
    sukcess = false;
    if checkInput() {
        String  matchedString = rule.matches(atRuleMark);
        if matchedString {
            if label    label.text  = matchedString;
            sukcess     = true; }}
    if label    label.clear();
    return exitFromParse(field);
}

/*******************************************************************************
	Process an up to match
*******************************************************************************/
extern GroupItem parseUpTo(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
    sukcess = false;
    if checkInput()
        if testUpTo(field)  sukcess = true;
    if label    label.clear();
    return exitFromParse(field);
}

/*******************************************************************************
	Set parseMethod and label for the field passed in. For now does not handle macros
*******************************************************************************/
extern GroupItem setParse(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
    if !ruleStuff   return refuse(field,"setParse: the field passed in has no rStuff");
    /***************************************************************************
        Set the parseMethod
    ***************************************************************************/
    // walkGuard the grammar is cyclic -- StatemenT contains BlocK contains StatemenT -- so the internalized walk below cannot terminate without its OWN mark. NOT hasNewParse: parkParse is that flag's other writer   Generate.setParse.walkGuard
    if parseWalked  return refuse(field,"setParse: RE-ENTRY -- this node was already walked");
    parseWalked = true;
    actionMethod = method;
    if upTo || upToOver     parseMethod = parseUpTo;
    or isBIN || isREGISTRY  parseMethod = parseContainer;
    or isCondition          parseMethod = parseCondition;
    or parseACTION          parseMethod = parseAction;
    or groupList            parseMethod = parseRule;
    or data switch(data) {
        case isANY:         parseMethod = parseAny;
        case isCHAR:        parseMethod = parseCharacter;
        case isSET:         parseMethod = parseSet;
        case isGROUP:       parseMethod = null;
        default:            parseMethod = parseString; }
    or method               parseMethod = parseAction;
    else                    parseMethod = parseString;
    if hasTraits || hasMembers {
        GroupItem grup;
        while grup = field.next(grup) {
            parent  = field;    // if field is a copy grup.parent is not field
            if grup.noPrint continue;
            else setParse(grup); }}
    if max > 1 && (!data || data > 3) field.method = parseLoop;
    else    field.method = parseMethod;
    // flagFollowsInstall hasNewParse says A METHOD IS THERE TO FIRE, so it is raised HERE and never at entry: parseMethod is null for the isGROUP case and the head cannot know   Generate.setParse.flagFollowsInstall
    if field.gMethod    field.hasNewParse = true;
    return null;
}
