
/*******************************************************************************
	Process a parseAction
*******************************************************************************/
extern GroupItem parseAction(GroupItem field)
{
    if label
        if field.method(label)  return parseSetLabel(field);
        else    label.clear();
    or field.method(field)      return trueResult;
    atRuleMark  = hereAt;
    return 0;
}

/*******************************************************************************
	Run a wild card test on this group against current input
*******************************************************************************/
/*****************************************************************************
    ⚠ THE LABEL WRITE IS GUARDED IN ALL FOUR OF THESE, and until 2026-08-18 it
    was guarded in only one. parseSet had `if label` and parseAny,
    parseCharacter and parseString wrote through it bare, so a rule matched
    with no label in its frame stored into a null and took the process down.

    IT HAD NEVER FIRED because nothing in an ordinary run binds a parse method
    at all, so these four are reached only once a generation walk has called
    setParse. The first walk that did reached parseString on the `if` keyword
    and died in setText with a null receiver -- same family as F-18 one layer
    down, and found the same way, by a backtrace after the F-18 repair did not
    stop the crash.

    parseSet is the model and it was already correct. Copy the working sibling
    rather than inventing a fifth spelling.
*****************************************************************************/
extern GroupItem parseAny(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
int         counter;
    if checkInput()
        while counter++ < max
            if counter && counter >= min {
                if label   label.setToken(hereAt,counter);
                return parseSetLabel(field); }
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
	Run a character test on this group against current input
*******************************************************************************/
extern GroupItem parseCharacter(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
int         counter;
    if checkInput()
        while *atRuleMark == character && counter++ < max {
            if label   label.setToken(hereAt,counter);
            return parseSetLabel(field); }
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
	Process a condition
*******************************************************************************/
extern GroupItem parseCondition(GroupItem field)
{
RuleStuff   ruleStuff = field.rStuff;
    if min  return trueResult;
    return  0;
}

/*******************************************************************************
    Registry and Container test looks for a field entry that matches the input stream.
*******************************************************************************/
extern GroupItem parseContainer(GroupItem field)
{
GroupItem   grup;
use field
GroupRules  ruler   = groupRules;
RuleStuff   ruleStuff = rStuff;
PLGset      inSet   = characterSet;
String      atInput = atRuleMark;
int         advance;
Buffer      buffer  = stringBUFFER;
    if checkInput() {
        reset();
        while *atInput
            if contains(*atInput)   { buffer += *atInput; atInput++; }
            else break;
        while advance = length() {
            if grup = get(string()) {
                if !noAdvance   atRuleMark += advance;
                if label    label.group = grup;
                return parseSetLabel(field); }
            shorten(1); }}
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*****************************************************************************
     Parse a rule.
*****************************************************************************/
extern GroupItem parseRule(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
GroupItem   code = field[CodE],
            grup,
            result;
    /*  ⚠ THERE IS NO FALLBACK ARM, AND THERE CANNOT BE ONE. Tony ruled this
        2026-08-18, closing F-18, and the comment is rewritten with the code
        because the OLD comment said the opposite and that is how a repair gets
        undone years later. It read "bail to the existing field parse if no
        parse code provided", and the line under it did not do that: it read
        `result = parse(ruleStuff)` where a bare name binds to the
        last-mentioned field, which was `result`, still null. So the bail arm
        dereferenced a null and took the process down.

        AND THE OBVIOUS REPAIR IS NOT A REPAIR. Spelling it against the rule
        instead re-enters the parse method fork, which dispatches straight back
        into this function -- a crash traded for infinite recursion. Once a
        parse method is bound there is no route back to the interpretive walk,
        so the bail this line was written to provide is not merely unwritten,
        it is unreachable by construction.

        THEREFORE: REFUSE, LOUDLY. Report through the named home and return the
        ordinary rule-failure result, which is what the tail below already
        does. R-2 ruling 1 -- no fallback arm at all -- arriving as mechanics
        rather than as a preference.

        ⚠ THE CONSEQUENCE IS A SCHEDULING CONSTRAINT, not just a code shape:
        binding a parse method anywhere near a generation walk is gated until
        the activation phase exists, because until then every rule bound and
        not yet compiled lands here. Off-rule storage inherits it -- activation
        is complete, and it is last.  */
    // assumes processCode was run on field already
    if field.isAction {
use grup
        while grup = code.nextAttribute(grup)
            if isLocal && !isRule && groupBody != field.groupBody clear();
        // here the parse action in method gets run
        if result = field["BlocK"]     result = result.gMethod(result); }
    else        reportNoBody(field);
    if result   return result;
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
	Run a character set test on this group against current input
*******************************************************************************/
extern GroupItem parseSet(GroupItem field)
{
PLGset      set = characterSet;
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
int         counter;
    if checkInput()
        while set.contains(*atRuleMark) && counter++ < max {
            if label   label.setToken(hereAt,counter);
            return parseSetLabel(field); }
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
	On rule success deal w/label setting and return true
*******************************************************************************/
extern GroupItem parseSetLabel(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
    if noAdvance    atRuleMark = hereAt;
    if label {
        if rule.actionMethod  label = rule.actionMethod(label);
        if label && parentLabel parentLabel +% label;
        return label; }
    return trueResult;
}

/***************************************************************************
	Parse method for a field w/data = isSTRING or isTOKEN
***************************************************************************/
extern GroupItem parseString(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
int         counter;
    while counter++ < max
        if checkInput() {
            String  matchedString = rule.matches(atRuleMark);
            if label   label.text  = matchedString;
            return parseSetLabel(field); }
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
	Process an up to match
*******************************************************************************/
extern GroupItem parseUpTo(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
    if testUpTo(field)  return parseSetLabel(field);
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
	runRuleAction checks to see if there is a method parked in actionMethod.
    If there is, and there is a rule label, it runs actionMethod.
*******************************************************************************/
extern GroupItem runRuleAction(GroupItem field)
{
RuleStuff   ruleStuff = field.rStuff;
    if label
        if actionMethod     return label = actionMethod(label);
        else                return label;
    return  trueResult;
}

/*******************************************************************************
	Set parseMethod. For now does not handle macros
*******************************************************************************/
extern GroupItem setParse(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
    if !ruleStuff   cerr "setParse: ERROR field passed in",tag,"has no rStuff":;
    or !parseMethod {
        actionMethod = method;
        if upTo || upToOver     parseMethod = parseUpTo;
        or isBIN || isREGISTRY  parseMethod = parseContainer;
        or isCondition          parseMethod = parseCondition;
        or parseACTION          parseMethod = parseAction;
        or groupList            parseMethod = parseRule;
        else switch(data) {
            case isANY:     parseMethod = parseAny;
            case isCHAR:    parseMethod = parseCharacter;
            case isSET:     parseMethod = parseSet;
            case isGROUP:   parseMethod = null;
            default:        parseMethod = parseString; }}
    return null;
}
