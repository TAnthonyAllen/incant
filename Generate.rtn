
// clearWalked clear the per-walk mark over a subtree -- it descends only into a node it just unmarked, so the cyclic grammar terminates
extern void clearWalked(GroupItem field)
{
GroupItem   grup;
    if !field                       return;
    if !field.parseWalked           return;
    field.parseWalked = false;
    if field.hasTraits || field.hasMembers
        while grup = field.next(grup)
            clearWalked(grup);
}

// exitFromParse the common exit every parse method returns through: sync, fire the label method, attach; a min-zero miss owes a success
extern GroupItem exitFromParse(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
    if sukcess {
        // parentLabelSync parentStuff IS the enclosing rule's stuff, so only the label sync is owed here
        if parentStuff && parentLabel != parentStuff.label  parentLabel = parentStuff.label;
        if noAdvance    atRuleMark = hereAt;
        fireLabelMethod(ruleStuff);
        if sukcess {
            if label && !noLabel {
                // oneAttach ONE ATTACH, through attachLabel, and the promote value is 1 -- promote=0 cannot RETAG here, and the retag is the half a members rule needs
                attachLabel(ruleStuff,parentStuff,1);
                // oneBitReturn a successful term returns its TRUTH, never its label -- the label is already attached above, and a label carrying a matched 0 read as a failed alternative in a || chain (Tony, 2026-09-23, restoring ruling c')
                return trueResult; }
            else    return trueResult; }}
    atRuleMark  = hereAt;
    // minZeroIsSatisfied a term whose MINIMUM IS ZERO is satisfied by not matching, so it owes the chain a success and not a null -- parseLoop owns max>1, this owns the max=1 optional that never enters it
    if max <= 1 && !min && !field.isCondition   return trueResult;
    return 0;
}

// installParseMethod park the face's parseMethod on its defining rule; min and max stay on the face, only the method is a fact of the shape
extern void installParseMethod(GroupItem field)
{
GroupItem   definer = field.definingRule();
RuleStuff   faceStuff = field.rStuff,
            defStuff;
    if !definer || definer == field     return;
    defStuff = definer.rStuff;
    if defStuff && faceStuff    defStuff.parseMethod = faceStuff.parseMethod;
}

// parseAction run the rule's action as its parse -- handed the field for a parseACTION rule or when there is no label, else the label
extern GroupItem parseAction(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
    // ownSlot read actionMethod, never gMethod -- on a parseACTION node gMethod IS parseAction and the call recurses forever
    sukcess = false;
    // noNullActor the old spelling read gMethod, which setParseWalk always fills; actionMethod can be empty, and calling it would trade the self-recursion for a null call
    if !actionMethod    return refuse(field,"parseAction: no actionMethod is installed for this rule");
    if parseACTION || !label
        { if label = ruleStuff.actionMethod(field)  sukcess = true; }
    or label = ruleStuff.actionMethod(label)        sukcess = true;
    if label    label.clear();
    return exitFromParse(field);
}

// parseAny the leaves are the generated-path twins of RuleStuff's testMacro: tester loop, advance, then ONE min gate -- copy the template
extern GroupItem parseAny(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
int         counter;
int         more;
    sukcess = false;
    if checkInput() {
        // gateIsNotAMatch checkInput leaves sukcess TRUE on a guard pass; a leaf is a success only when it MATCHES (F-114)
        sukcess = false;
        while *atRuleMark {
            if counter >= max { more = true; break; }
            counter++;
            atRuleMark++;
            if !*atRuleMark break; }
        if more && max > 1 && !limitsSet   reportMaxLimit(field);
        or counter && counter >= min {
            if label    label.setToken(hereAt,counter);
            sukcess     = true; }}
    // keepTheMatch clear only on failure, as parseContainer -- a success clearing here handed every action an empty term label (F-114 site 2)
    if label && !sukcess    label.clear();
    return exitFromParse(field);
}

// parseCharacter match a run of one character against the current input
extern GroupItem parseCharacter(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
int         counter;
int         more;
    sukcess = false;
    if checkInput() {
        // gateIsNotAMatch checkInput leaves sukcess TRUE on a guard pass; a leaf is a success only when it MATCHES (F-114)
        sukcess = false;
        while *atRuleMark == character {
            if counter >= max { more = true; break; }
            counter++;
            atRuleMark++;
            if !*atRuleMark break; }
        if more && max > 1 && !limitsSet   reportMaxLimit(field);
        or counter && counter >= min {
            if label    label.setToken(hereAt,counter);
            sukcess     = true; }}
    // keepTheMatch clear only on failure, as parseContainer -- a success clearing here handed every action an empty term label (F-114 site 2)
    if label && !sukcess    label.clear();
    return exitFromParse(field);
}

// parseCondition a condition succeeds exactly when min is set
extern GroupItem parseCondition(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
    if min  sukcess = true;
    else    sukcess = false;
    return exitFromParse(field);
}

// parseContainer match the longest input prefix that names an entry of this bin or registry
extern GroupItem parseContainer(GroupItem field)
{
GroupRules  ruler = groupRules;
PLGset      inSet = characterSet;
String      atInput = atRuleMark;
int         advance;
Buffer      buffer = stringBUFFER;
RuleStuff   ruleStuff = rStuff;
GroupItem   grup;
String      entryMark = atRuleMark;
int         matched;
use field
    // faceReresolve a bin or registry reached BY NAME is re-resolved to the calling rule's own face, as parseRule does -- the face carries the term's rStuff (its modifiers and label slot)
    if currentMETHOD && currentMETHOD.get(field.tag)    field = currentMETHOD.get(field.tag);
    ruleStuff   = field.rStuff;
use field
    // noStuffLawfulSkip a registry has no rStuff: match with default limits and exit WITHOUT exitFromParse -- never refuse, never mint onto it
    if !ruleStuff {
        buffer.reset();
        entryMark = ruler.atRuleMark;
        atInput   = ruler.atRuleMark;
        while *atInput
            if inSet.contains(*atInput)  { buffer += *atInput; atInput++; }
            else break;
        while advance = buffer.length() {
            if grup = field.get(buffer.string()) {
                // longestHitOnly the first hit is the longest -- stop, or shorten(1) finds its prefix (= after ==) and advances again (F-124)
                ruler.atRuleMark += advance;
                matched = 1;
                break; }
            buffer.shorten(1); }
        if matched  return trueResult;
        ruler.atRuleMark = entryMark;
        return 0; }
    // binParentRepair a bin is reached from runOP, never through parseRule, so nothing else gives it the asker's stuff and attachLabel would drop its label at !pStuff
    if currentMETHOD && currentMETHOD.rStuff != ruleStuff.parentStuff {
        ruleStuff.parentStuff = currentMETHOD.rStuff;
        if ruleStuff.parentStuff && ruleStuff.parentLabel != ruleStuff.parentStuff.label  ruleStuff.parentLabel = ruleStuff.parentStuff.label; }
    sukcess = false;
    if checkInput() {
        // gateIsNotAMatch checkInput leaves sukcess TRUE on a guard pass; a leaf is a success only when it MATCHES (F-114)
        sukcess = false;
        reset();
        atInput = atRuleMark;
        while *atInput
            if contains(*atInput)   { buffer += *atInput; atInput++; }
            else break;
        while advance = length() {
            if grup = get(string()) {
                // longestHitOnly the first hit is the longest -- stop, or shorten(1) finds its prefix (= after ==), advances again and relabels (F-124)
                if !noAdvance   atRuleMark += advance;
                if label    label.group = grup;
                sukcess     = true;
                break; }
            shorten(1); }}
    // keepTheMatch clear only on failure -- on success the label carries the matched entry to attachLabel, and clearing it first handed TokenXP an empty unary
    if label && !ruleStuff.sukcess  label.clear();
    return exitFromParse(field);
}

// parseLoop run a repeating term up to max; the verdict is the COUNT against min, never the success flag
extern GroupItem parseLoop(GroupItem field)
{
    // enclosingRule re-resolve to the enclosing rule's own face, tested on the lookup so an unfound tag never overwrites field with null
    if currentMETHOD && currentMETHOD.get(field.tag)    field = currentMETHOD.get(field.tag);
RuleStuff   ruleStuff = rStuff;
    kount = 0;
    while kount < max
        if !runLeafParse(field) break;
        else kount++;
    // countNotFlag the verdict is the COUNT, never the flag -- the last attempt is the failing one that ends the run, and a stale flag would pass a short run; the flag read is removed (Tony, 2026-09-24; SEQ 195)
    measureLoopVerdict(field);
    if kount >= min     return trueResult;
    return 0;
}

// parseRule run a rule's generated body; a new declaration here re-points every bare field below it (bear-trap #42)
extern GroupItem parseRule(GroupItem field)
{
GroupRules  ruler = groupRules;
GroupItem   code = field.parseBody(),
            result,
            grup,
            myLabel,
            into;
GroupItem   priorMETHOD;
use field
    // enclosingRule re-resolve to the enclosing rule's own face, tested on the lookup so an unfound tag never overwrites field with null (the old `if lastRule` guard missed that)
    if currentMETHOD && currentMETHOD.get(field.tag)    field = currentMETHOD.get(field.tag);
RuleStuff   ruleStuff = rStuff;
    // callBracket lift this call's own rStuff state into C++ locals -- the C++ stack is the frame stack, and a nested call of the same rule would otherwise overwrite it (Tony, 2026-09-24; F-114). Passthrough, so tok sees no declaration (bear-trap #42)
    -%
    GroupItem *callLabel = ruleStuff ? ruleStuff->label : 0, *callParentLabel = ruleStuff ? ruleStuff->parentLabel : 0;
    RuleStuff *callParentStuff = ruleStuff ? ruleStuff->parentStuff : 0;
    char *callHereAt = ruleStuff ? ruleStuff->hereAt : 0;
    int callKount = ruleStuff ? ruleStuff->kount : 0;
    int callSukcess = ruleStuff ? ruleStuff->sukcess : 0;
    ParseActivation callActive = { ruleStuff, gParseActive, 0 };
    gParseActive = &callActive;
    %-
    measureParentProbe(field);
    // parentRepair re-point parentStuff at the ENCLOSING rule's stuff and sync parentLabel, sourced from currentMETHOD (measured to track lastRule exactly)
    if currentMETHOD && currentMETHOD.rStuff != parentStuff {
        parentStuff = currentMETHOD.rStuff;
        if parentStuff && parentLabel != parentStuff.label  parentLabel = parentStuff.label; }
    // bareFieldRepoint the use lines below are load bearing -- a new declaration re-points every bare field under it
use ruleStuff
    sukcess = false;
    if checkInput() {
use grup
        if field.isAction {
            while grup = code.nextAttribute(grup)
                if isLocal && !isRule && !noPrint && groupBody != field.groupBody clear();
            // noArgumentOnARule a rule carries no argument slot (Tony, 2026-09-20; F-94) -- the return carries one bit
            // labelReachesNothing myLabel is minted and goes nowhere until CT-5 gives it a channel
            into    = parentLabel;
            myLabel = new(field.tag);
            measureLabelMint(field,myLabel,into);

            saveLocalFields(field);
            priorMETHOD     = currentMETHOD;
            currentMETHOD   = field;
            // here the parse action in method gets run
            if result = field.parseBlocK() {
                // probeDoor armed only inside jitProbeDrive: fire the COMPILED body in place of this BlocK, nothing else changes
                -%
                if ( gJitProbeCarrier && field->get((char*)"builtinParseR") == gJitProbeCarrier ) {
                    ++gProbeRuleFires;
                    if ( gJitProbeFn )  result = gJitProbeFn(::jitBodyField(gJitProbeCarrier)) ? ruler->trueResult : ruler->falseResult;
                    else                result = result->groupBody->gMethod(result);
                    if ( ::truthOf(result) )    ++gProbeRuleTrue; }
                else
                    result = result->groupBody->gMethod(result);
                %-
                if result   result.isBranch = 0; }
            currentMETHOD = priorMETHOD;
            restoreLocalFields(field); }
        else        reportNoBody(field);
checkSuccess:   // this is just a marker for directives
        // resultSeat the rule, the returned node and its truthOf -- a standing callout (measure-callout ruling)
        measureParseResult(field,result);
        // chainTruth the rule succeeds when its chain is TRUE, not when it returned something (F-95, Tony 2026-09-22)
        sukcess = truthOf(result);
        }
    // markSeat1 SEQ 166 point 1 -- the last seat with visibility before the trace goes silent
    measureMarkPoint("1-parseRule-exit");
    result = exitFromParse(field);
    // activeList pop this call's activation -- AFTER exitFromParse, so its own fire saw itself on top and skipped it
    -% gParseActive = callActive.prev; %-
    // callBracket put the lifted state back AFTER exitFromParse has fired and attached with this call's values -- the only return is below, so no exit path skips it; sukcess joined 2026-09-24 (F-121): a failed inner call wrote 0 into an rStuff an old-road caller was holding, and no post-return reader decides on it (census)
    -%
    if ( ruleStuff ) {
        ruleStuff->label = callLabel;  ruleStuff->parentLabel = callParentLabel;  ruleStuff->parentStuff = callParentStuff;
        ruleStuff->hereAt = callHereAt;  ruleStuff->kount = callKount;  ruleStuff->sukcess = callSukcess; }
    %-
    return result;
}

// parseSet match a run of characters from this rule's character set
extern GroupItem parseSet(GroupItem field)
{
PLGset      set = characterSet;
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
int         counter;
int         more;
    sukcess = false;
    if checkInput() {
        // gateIsNotAMatch checkInput leaves sukcess TRUE on a guard pass; a leaf is a success only when it MATCHES (F-114)
        sukcess = false;
        while set.contains(*atRuleMark) {
            if counter >= max { more = true; break; }
            counter++;
            atRuleMark++;
            if !*atRuleMark break; }
        if more && max > 1 && !limitsSet   reportMaxLimit(field);
        or counter && counter >= min {
            if label    label.setToken(hereAt,counter);
            sukcess     = true; }}
    // keepTheMatch clear only on failure, as parseContainer -- a success clearing here handed every action an empty term label (F-114 site 2)
    if label && !sukcess    label.clear();
    return exitFromParse(field);
}

// parseString match this rule's string or token text at the current input
extern GroupItem parseString(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
    sukcess = false;
    if checkInput() {
        // gateIsNotAMatch checkInput leaves sukcess TRUE on a guard pass; a leaf is a success only when it MATCHES (F-114)
        sukcess = false;
        String  matchedString = rule.matches(atRuleMark);
        if matchedString {
            if label    label.text  = matchedString;
            sukcess     = true; }}
    // keepTheMatch clear only on failure, as parseContainer -- a success clearing here handed every action an empty term label (F-114 site 2)
    if label && !sukcess    label.clear();
    return exitFromParse(field);
}

// parseUpTo match everything up to (or over) the rule's terminator, through testUpTo
extern GroupItem parseUpTo(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
    sukcess = false;
    if checkInput() {
        // gateIsNotAMatch as the other leaves
        sukcess = false;
        if testUpTo(field)  sukcess = true; }
    // keepTheMatch clear only on failure, as parseContainer -- a success clearing here handed every action an empty term label (F-114 site 2)
    if label && !sukcess    label.clear();
    return exitFromParse(field);
}

// runLeafParse fire a leaf's parse method through its defining rule; a missing method is a named refusal, never a call
extern GroupItem runLeafParse(GroupItem field)
{
GroupItem   definer = field.definingRule();
RuleStuff   defStuff;
    if definer      defStuff = definer.rStuff;
    if defStuff && defStuff.parseMethod     return defStuff.parseMethod(field);
    return refuse(field,"parseLoop: no parse method is installed on the defining rule");
}

// setParse the top-level entry, and the only one incant calls: reset the per-walk mark, then walk
extern GroupItem setParse(GroupItem field)
{
    // perWalkNotPerProcess the mark breaks the grammar's cycle WITHIN one walk; outliving it refuses a second root over shared nodes
    clearWalked(field);
    return setParseWalk(field);
}

// setParseWalk classify each face's parse method; recurses into itself, never back through setParse
extern GroupItem setParseWalk(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
    // tokenSkip a member with isRule 0 is a token -- matched, never entered; isRule 1 with no rStuff is a wound and refuses
    if !ruleStuff {
        if !isRule {
            if groupRules.debugAllRules     cerr "setParseWalk: token " tag ", not entered":;
            return null; }
        return refuse(field,"setParse: the field passed in has no rStuff"); }
    // newRoadTarget every face with rStuff, before the installed and re-entry exits -- isTarget is what promotes and RETAGS a member's label (09-22 retag ruling, SEQ 192)
    setTargetFlag(ruleStuff);
    // installedIsDone an rStuff carrying hasNewParse is installed, and the walk leaves it alone
    if hasNewParse {
        if groupRules.debugAllRules     cerr "setParseWalk: already installed " tag ", leaving it alone":;
        return null; }
    // silentReEntry the grammar is a DAG, so re-entry is routine -- return without descending, never refuse
    if parseWalked {
        if groupRules.debugAllRules     cerr "setParseWalk: re-entry on " tag ", not descending":;
        return null; }
    parseWalked = true;
    // actionMethodRemoved the walk writes gMethod and parseMethod and NOTHING ELSE -- actionMethod is set at definition
    // realTermNotAList a FIELD with nothing but noPrint artifacts is a DATA rule: hasTraits and hasMembers ignore artifacts, groupList does not. The CONVERSION predicate is NOT this test -- it still asks the group's real groupList.
    if upTo || upToOver     parseMethod = parseUpTo;
    or isBIN || isREGISTRY  parseMethod = parseContainer;
    or isCondition          parseMethod = parseCondition;
    or parseACTION          parseMethod = parseAction;
    or hasTraits || hasMembers  parseMethod = parseRule;
    or data switch(data) {
        case isANY:         parseMethod = parseAny;
        case isCHAR:        parseMethod = parseCharacter;
        case isSET:         parseMethod = parseSet;
        case isGROUP:       parseMethod = null;
        default:            parseMethod = parseString; }
    or method               parseMethod = parseAction;
    else                    parseMethod = parseString;
    installParseMethod(field);
    measureParseClass(field);
    if hasTraits || hasMembers {
        GroupItem grup;
        while grup = field.next(grup) {
            parent  = field;    // if field is a copy grup.parent is not field
            if grup.noPrint continue;
            else setParseWalk(grup); }}
    if max > 1 && (!data || data > 3) field.method = parseLoop;
    else    field.method = parseMethod;
    // flagFollowsInstall hasNewParse says a method is there to fire, so it is raised here and never at entry -- isGROUP installs null
    if field.gMethod    field.hasNewParse = true;
    return null;
}

// setTargetFlag the new road's isTarget and nothing else -- getWhatFollows' target rule, run over every face at generation
extern void setTargetFlag(RuleStuff stuff)
{
    -%
    if ( !stuff || !stuff->rule ) return;
    GroupItem *r = stuff->rule;
    int computed = 0;
    if ( isMember(r->options.affiliation) && r->parent && !r->parent->groupBody->flags.binType )
        computed = 1;
    else if ( isEmbedded(r->options.affiliation) )
        { if ( (r->groupBody->flags.data && r->groupBody->flags.data < 4) || stuff->max == 1 ) computed = 1; }
    ::measureTargetAgree(stuff, computed);
    if ( computed ) stuff->isTarget = 1;
    %-
}
