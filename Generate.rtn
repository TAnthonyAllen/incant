
/*******************************************************************************
	Process a parseAction
*******************************************************************************/
extern GroupItem parseAction(GroupItem field)
{
    if parseACTION || !label
        { if field.method(field)    return trueResult; }
    or label && field.method(label) return parseSetLabel(field);
    if label    label.clear();
    atRuleMark  = hereAt;
    return 0;
}

/*******************************************************************************
	Run a wild card test on this group against current input
*******************************************************************************/
extern GroupItem parseAny(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
int         counter;
int         more;
    if checkInput() {
        while *atRuleMark {
            if counter >= max { more = true; break; }
            counter++;
            atRuleMark++;
            if !*atRuleMark break; }
        if more && max > 1 && !limitsSet   reportMaxLimit(field);
        or counter && counter >= min {
            if label   label.setToken(hereAt,counter);
            return parseSetLabel(field); }}
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
	Run a character test on this group against current input
*******************************************************************************/
extern GroupItem parseCharacter(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
int         counter;
int         more;
    if checkInput() {
        while *atRuleMark == character {
            if counter >= max { more = true; break; }
            counter++;
            atRuleMark++;
            if !*atRuleMark break; }
        if more && max > 1 && !limitsSet   reportMaxLimit(field);
        or counter && counter >= min {
            if label   label.setToken(hereAt,counter);
            return parseSetLabel(field); }}
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
	Process a condition
*******************************************************************************/
extern GroupItem parseCondition(GroupItem field)
{
RuleStuff   ruleStuff = field.rStuff;
    if min  return trueResult;
    return  0;
}

/*******************************************************************************
    Registry and Container test looks for a field entry that matches the input stream.
*******************************************************************************/
extern GroupItem parseContainer(GroupItem field)
{
GroupItem   grup;
use field
GroupRules  ruler   = groupRules;
RuleStuff   ruleStuff = rStuff;
PLGset      inSet   = characterSet;
String      atInput = atRuleMark;
int         advance;
Buffer      buffer  = stringBUFFER;
    if checkInput() {
        reset();
        atInput = atRuleMark;
        while *atInput
            if contains(*atInput)   { buffer += *atInput; atInput++; }
            else break;
        while advance = length() {
            if grup = get(string()) {
                if !noAdvance   atRuleMark += advance;
                if label    label.group = grup;
                return parseSetLabel(field); }
            shorten(1); }}
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*****************************************************************************
     Parse a rule.
*****************************************************************************/
extern GroupItem parseRule(GroupItem field)
{
GroupRules  ruler = groupRules;
GroupItem   pMethod = field["builtinParsE"],
            code = field[CodE],
            result,
            grup;
RuleStuff   ruleStuff = pMethod.rStuff;
    // assumes processCode was run on field already
    if checkInput() {
        if field.isAction {
            while grup = code.nextAttribute(grup)
                if isLocal && !isRule && !noPrint && groupBody != field.groupBody clear();
            // here the parse action in method gets run
            if result = field["BlocK"] {
                result = result.gMethod(result);
                if result   result.isBranch = 0; }
        else        reportNoBody(field); }
        if result   return result; }
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
	Run a character set test on this group against current input
*******************************************************************************/
extern GroupItem parseSet(GroupItem field)
{
PLGset      set = characterSet;
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
int         counter;
int         more;
    if checkInput() {
        while set.contains(*atRuleMark) {
            if counter >= max { more = true; break; }
            counter++;
            atRuleMark++;
            if !*atRuleMark break; }
        if more && max > 1 && !limitsSet   reportMaxLimit(field);
        or counter && counter >= min {
            if label   label.setToken(hereAt,counter);
            return parseSetLabel(field); }}
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
	On rule success deal w/label setting and return true
*******************************************************************************/
extern GroupItem parseSetLabel(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
    if noAdvance    atRuleMark = hereAt;
    if label {
        if label && parentLabel parentLabel +% label;
        return label; }
    return trueResult;
}

/***************************************************************************
	Parse method for a field w/data = isSTRING or isTOKEN
***************************************************************************/
extern GroupItem parseString(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
    if checkInput() {
        String  matchedString = rule.matches(atRuleMark);
        if matchedString {
            if label   label.text  = matchedString;
            return parseSetLabel(field); }}
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
	Process an up to match
*******************************************************************************/
extern GroupItem parseUpTo(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
    if checkInput()
        if testUpTo(field)  return parseSetLabel(field);
    if label    label.clear();
    atRuleMark = hereAt;
    return 0;
}

/*******************************************************************************
    labelMinters -- HOW MANY OF THIS RULE'S SUB-TERMS WILL MINT A LABEL.
*******************************************************************************/
extern int labelMinters(GroupItem rule)
{
GroupItem   grup;
RuleStuff   termStuff;
int         minters = 0;
    if !rule    return 0;
    while grup = rule.next(grup) {
        if grup.noPrint     continue;
        termStuff = grup.rStuff;
        if termStuff && termStuff.noLabel   continue;
        if grup.isRule && grup.hasMembers && !grup.binType  continue;
        minters++; }
    return minters;
}

/*******************************************************************************
	runRuleAction checks to see if there is a method parked in actionMethod.
    If there is, and there is a rule label, it runs actionMethod.

    THE CAPTURE GATE IS STRUCTURAL NOW, AND THAT IS THE WHOLE POINT.
    It asks pMethod -- does THIS FIELD carry a builtinParsE -- where it used to
    ask gNewParseInFlight, a file scope C++ global raised by parseRule around
    the generated body and read back through a -% pocket.

    Both spellings answer the same question, "are we inside a new parse", but
    they answer it about different subjects. The global answered it about TIME:
    it was true for whatever ran while parseRule's frame was live, so its
    correctness depended on every road that reaches here either being under
    that frame or being excluded by hand. aCTionBrancH and runOP are two roads
    that are not, which is why the global existed at all. pMethod answers it
    about the FIELD, and a field either carries a generated parse or it does
    not, on every road, with nothing to save and nothing to restore.

    So this is the escape pocket doctrine's first payment: a temporal guard,
    unspellable in kant and therefore written in C++ inside this function, is
    replaced by an ordinary read of a node the function already had in a local.
    Tony objected to the -% spelling before anyone noticed the gate could be
    structural; the objection was the better instinct and this is where it led.

    ⚠ AND IT IS NOT A BEHAVIOUR CHANGE TODAY, which is worth saying so nobody
    reads the fleet staying still as the edit not landing. In an ordinary run
    setParse never fires, so no field carries builtinParsE and this arm is dead
    either way -- exactly as it was dead under the global, which nothing raised
    once parseRule's set was removed. The gate becomes live the first time a
    generated parse runs, which is the campaign.
*******************************************************************************/
extern GroupItem runRuleAction(GroupItem field)
{
GroupItem   pMethod = field["builtinParsE"],
            aMethod = field["builtinActoR"];
RuleStuff   ruleStuff = field.rStuff;
int         minters = 0;
    if pMethod      ruleStuff = pMethod.rStuff;
    if !ruleStuff   return trueResult;
    if pMethod && label {
        minters = labelMinters(field);
        if parseTrace   cerr "  CENSUS " field.tag " labelMinters=" minters:;
        if minters == 0     field.captureSpan(ruleStuff); }
    if label {
        if aMethod  label = aMethod.method(label);
        return label; }
    return  trueResult;
}

/*******************************************************************************
    evictAction -- THE EVICTION, AND IT REFUSES RATHER THAN SUBSTITUTES.

    Tony's design, 2026-08-29. Step 3 of the earlier brief -- install the parse
    INTO gMethod -- is dead, killed by the parseAction finding: gMethod is read
    as THE ACTION by nine sites, one of which is a parse executor that would
    then call itself. The replacement is bear-trap 34's retirement clause.
    VACATE gMethod and install NOTHING. With the slot empty and isMethod
    retracted by the symmetric setter, runOP arm two stops claiming the rule,
    and a bare `QuotE()` in a generated body falls through to the isRule arm,
    into runRule, into builtinParsE. The new parse wins by having no
    competitor rather than by taking the old channel.

    ⚠ RELOCATE-THEN-NULL IS STRUCTURAL HERE, NOT REMEMBERED. The whole reason
    this is one extern rather than two statements in the driver is that the
    null must be unreachable until the relocation is VERIFIED. setParse already
    parks actionMethod for every rule it claims, so the relocation has usually
    happened -- but "usually" is what the brief said not to trust, and a rule
    that reached dual-flag by any road other than setParse is the burn case:
    null its gMethod and the action is gone with nothing holding a copy.

    ⚠ IT REPORTS A VALUE ON EVERY RULE, NOT A MESSAGE ON FAILURE (rule H4).
    An eviction pass that printed only its refusals would go quiet the day it
    stopped evicting anything, and quiet would read as success. Every rule
    prints its outcome by name, so the driver can count them and a zero is
    visible as a zero.

    The passthrough reads two function pointers and compares them. There is no
    kant spelling for that -- parseClassify above is the house precedent, and
    the comparison is all that sits inside the escape.
*******************************************************************************/
extern GroupItem evictAction(GroupItem field)
{
RuleStuff   ruleStuff = field.rStuff;
String      outcome = "no-rstuff";
int         doEvict = 0;
    if ruleStuff {
        -%
        GroupItem *(*am)(GroupItem *) = ruleStuff->actionMethod;
        GroupItem *(*gm)(GroupItem *) = field->groupBody->gMethod;
        if      ( !gm )        outcome = (char *)"already-vacant";
        else if ( !am )        outcome = (char *)"REFUSED-unparked";
        else if ( am != gm )   outcome = (char *)"REFUSED-mismatch";
        else                 { outcome = (char *)"evicted"; doEvict = 1; }
        %- }
    cerr "EVICT " field.tag " " outcome:;
    if doEvict  field.method = 0;
    return field;
}

/*******************************************************************************
	Set parseMethod. For now does not handle macros

    THE ACTOR IS GATED ON THE EXECUTOR, ruled by Tony 2026-08-29. An isGROUP
    alias takes actionMethod above the switch and then the isGROUP case sets
    parseMethod to null, so before this gate it came away with an actor and no
    executor. That half installed executor broke every later parse of any
    grammar the alias could be reached from, and there are three of them:
    ANYtoken, NewGroup and ShortcuT. The three arm suppression probe that
    attributes it, and the arm by arm table, are in designDocs ProblemRecords
    isGroupActorPoison.

    THE PARKED POINTER STAYS. Arm two measured the persisted actionMethod
    harmless, so it is still written for every rule setParse claims. It is
    wanted the day an alias gains a real executor, and gating the write rather
    than the attachment would throw that away for nothing.
*******************************************************************************/
extern GroupItem setParse(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
    if isREGISTRY   return null;
    if !ruleStuff {
        cerr "setParse: ERROR field passed in",tag,"has no rStuff":;
        return null; }
    or !parseMethod {
        actionMethod = method;
        if upTo || upToOver     parseMethod = parseUpTo;
        or isBIN || isREGISTRY  parseMethod = parseContainer;
        or isCondition          parseMethod = parseCondition;
        or parseACTION          parseMethod = parseAction;
        or groupList            parseMethod = parseRule;
        or data switch(data) {
            case isANY:     parseMethod = parseAny;
            case isCHAR:    parseMethod = parseCharacter;
            case isSET:     parseMethod = parseSet;
            case isGROUP:   parseMethod = null;
            default:        parseMethod = parseString; }
        or method               parseMethod = parseAction;
        else                    parseMethod = parseString; }
    if parseMethod {
        GroupItem builtinParsE = field += "builtinParsE";
        rStuff  = ruleStuff;
        noPrint = true;
        method  = parseMethod; }
    if actionMethod && parseMethod {
        GroupItem builtinActoR = field += "builtinActoR";
        rStuff  = ruleStuff;
        noPrint  = true;
        method = actionMethod; }
    field.updateContentFlags();
    return null;
}
