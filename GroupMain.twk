include groupIncludes

class GroupMain
{
GroupItem   grok;
/*******************************************************************************
	Constructor
*******************************************************************************/
GroupMain()
{
    groupController = new(10000);
GroupRules  ruler = groupRules;
    setBaseRegistries();
    searchList      = getRegistry("SearchList");
    grokking        = getRegistry("Grokking");
    grokking.isRule = true;
    grok            = grokking;
    searchList      += grokking;
    searchList.isSorted = false;
}

/*****************************************************************************
	bootCommands loads commands needed for bootstrapping
*****************************************************************************/
void bootCommands(GroupItem commands)
{
GroupItem   item;
    /*************************************************************************
        We will need the parseAction command
    *************************************************************************/
    item = new("parseAction");
    commands            += item;
    method              = setRuleAction;
    immediateACTION     = true;
    isMethod            = true;
    noPrint             = true;
    /*************************************************************************
        and the ruleMethod and operateMethod commands
    *************************************************************************/
    item = new("ruleMethod");
    commands            += item;
    method              = ruleMethod;
    immediateACTION     = true;
    isMethod            = true;
    noPrint             = true;

    item = new("operateMethod");
    commands            += item;
    method              = ruleMethod;
    immediateACTION     = true;
    isMethod            = true;
    noPrint             = true;

    item = new("interpretMethod");
    commands            += item;
    method              = interpretMethod;
    immediateACTION     = true;
    isMethod            = true;
    noPrint             = true;

    item = new("jitEmitter");
    commands            += item;
    method              = jitEmitter;
    immediateACTION     = true;
    isMethod            = true;
    noPrint             = true;
   /**************************************************************************
        and the registry command
    *************************************************************************/
    item = new("registry");
    commands            += item;
    method              = rEGISTER;
    immediateACTION     = true;
    isMethod            = true;
    noPrint             = true;
}

/*****************************************************************************
	bootstrapper creates rules and groups incant needs to define and run a rule.
	The bootstrap rule definitions are shown in the grammar listing.
*****************************************************************************/
GroupItem bootstrapper()
{
GroupItem   dStuff;
GroupItem   item;
GroupItem   stuff,
            member;
GroupItem   strap;
GroupRules  ruler = groupRules;

    bootCommands(commands);
    ruleSkipSet         = new("ruleSkipSet");
    skipSet             = new(" \n\r\t/");
    ruleSkipSet.characterSet = skipSet;
    properties          += ruleSkipSet;
    currentRegistry     = grok;
    member = new("MEMBERs");
    member.method       = processFlags;
    member.parseACTION  = true;
    member.isMethod     = true;
    member.unGuarded    = true;
   /**************************************************************************
        Define the setupFILE declared in GroupRules. It gets loaded at the
        end of this bootstrapper method.
    *************************************************************************/
    setupFILE       = new("setup");
    item            = setupFILE += "File";
    item.text       = "incant/setup";
    /*************************************************************************
        bootstrap character sets. Do these need to be in Grokking?
    *************************************************************************/
    strap           = new("counter");
    setRuleStuff();
    characterSet    = new("0-9");
    item            = grok += strap;
    strap           = new("nameSet");
    setRuleStuff();
    characterSet    = nameSet;
    grok            += strap;
    strap           = new("numberSet");
    setRuleStuff();
    characterSet    = new("0-9");
    grok            += strap;
    strap           = new("delimiter");
    setRuleStuff();
    text            = "#)";
    properties      += strap;
    /*************************************************************************
        bootstrap rule definition rules.
    *************************************************************************/
    strap           = new("Modifier");
    setRuleStuff();
    strap           = grok += strap;
    characterSet    = new("-~+?!%&|*@_<^{}$");

    strap           = new("Limit");
    setRuleStuff();
    strap           = grok += strap;
    item            = strap +% new("[");
    item.setRuleStuff();
    item            = new("min");
    item            = strap +% item;
    item.setRuleStuff();
    item.group      = grok/counter;
    item            = item.group;
    modify(item,"+");
    item            = new("max");
    item            = strap +% item;
    item.setRuleStuff();
    item.group      = grok/counter;
    item            = item.group;
    modify(item,"*");
    item            = new("]");
    item.setRuleStuff();
    item            = strap +% item;

    strap           = new("tokenize");
    method          = tokenize;
    unGuarded       = true;
    strap           = grok += strap;
    modify(strap,"^@");

    strap           = grok += new("Any");
    isANY           = true;
    setRuleStuff();
    
    strap           = grok += "PoweR";
    setRuleStuff();
    item            = new("e");
    item.characterSet    = new("eE");
    item            = strap +% item;
    item.setRuleStuff();
    item            = new("sign");
    item.characterSet    = new("-+");
    item            = strap +% item;
    modify(item,"?");
    item            = new("power");
    item.characterSet    = new("0-9");
    item            = strap +% item;
    modify(item,"+");

    strap           = grok += "FloaT";
    setRuleStuff();
    item            = new("point");
    item.character  = '.';
    item            = strap +% item;
    item.setRuleStuff();
    item            = new("decimals");
    item.characterSet    = new("0-9");
    item            = strap +% item;
    modify(item,"+");
    item            = grok/PoweR;
    item            = strap +% item;
    modify(item,"?");

    strap           = grok += "QuotE";
    setRuleStuff();
    method          = aCTionQuotE;
    item            = new("tik");
    item.characterSet    = new("'\"");
    item            = strap +% item;
    item.setRuleStuff();
    item            = new("quoteBody");
    item            = strap +% item;
    modify(item,"}");
    strap           = item;
    item            = new("tik");
    group           = item;
    item            = gGroup;
    modify(item,"$");

    strap           = grok += "NamE";
    setRuleStuff();
    method          = aCTionNamE;
    item            = new("first");
    item.characterSet    = new("a-zA-Z");
    item            = strap +% item;
    modify(item,"-");
    item            = grok["nameSet"];
    item            = strap +% item;
    modify(item,"-^*");
    item            = grok["tokenize"];
    strap           +% item;
    
    strap           = grok += "NumbeR";
    setRuleStuff();
    item            = grok["numberSet"];
    item            = strap +% item;
    modify(item,"+");
    method          = aCTionNumbeR;
    immediateACTION = true;
    item            = grok/FloaT;
    item            = strap +% item;
    modify(item,"?");
    item            = grok["tokenize"];
    strap           +% item;

    strap           = grok += "GrouP";
    setRuleStuff();
    dStuff          = strap;
    item            = strap += grok/NamE;
    item            = strap += grok/QuotE;

    strap           = grok += "SetBrackets";
    setRuleStuff();
    method          = aCTionSetBrackets;
    item            = strap += "[";
    modify(item,"-");
    item            = strap += "]";
    modify(item,"}");

    strap           = grok += new("CodE");
    setRuleStuff();
    method          = aCTionCodE;
    guardSet        = new("{");
    guarded         = true;
    parseACTION     = true;
    isRule          = true;
    item            = strap += "{";
    item.setRuleStuff();
    item            = strap += "}";
    item.setRuleStuff();

    strap           = grok += "DelimText";
    setRuleStuff();
    item            = strap += "(";
    item.setRuleStuff();
    guardSet        = new("(");
    guarded         = true;
    item            = strap += "dtext";
    modify(item,"^");
    item.group      = properties/delimiter;
    item            = item.group;
    modify(item,"}");

    strap           = grok += "DatA";
    setRuleStuff();
    item            = strap += grok/GrouP;
    item            = strap += grok/NumbeR;
    item            = strap += grok/CodE;
    item            = strap += grok/SetBrackets;
    item            = strap += grok/DelimText;
    item            = new("NotA");
    item.characterSet    = new("^ \t\r\n;");
    item            = strap += item;
    modify(item,"+");

    strap           = grok += "TraiTdata";
    setRuleStuff();
    method          = aCTionTraiTdata;
    immediateACTION = true;
    item            = strap += "=";
    modify(item,"-");
    item            = grok/DatA;
    item            = strap +% item;
    item            = grok/Modifier;
    item            = strap +% item;
    modify(item,"*");
    item            = grok/Limit;
    item            = strap +% item;
    modify(item,"?");
    
    /*************************************************************************
        DefinE stub to be added to a little further down
    *************************************************************************/
    stuff           = grok += "DefinE";
    stuff.setRuleStuff();
    stuff.method    = aCTionDefinE;

    strap           = grok += "DEFINing";
    setRuleStuff();
    method          = processFlags;
    unGuarded       = true;

    strap           = grok += "TraiT";
    setRuleStuff();
    method          = aCTionTraiT;
    immediateACTION = true;
    item            = grok/GrouP;
    item            = strap +% item;
    item            = grok/Modifier;
    item            = strap +% item;
    modify(item,"*");
    item            = grok/Limit;
    item            = strap +% item;
    modify(item,"?");
    item            = grok/TraiTdata;
    item            = strap +% item;
    modify(item,"?");

    strap           = grok += "NewGroup";
    method          = aCTionNewGroup;
    immediateACTION = true;
    setRuleStuff();
    group           = grok/TraiT;

    strap           = grok += "Attributes";
    setRuleStuff();
    group           = grok/TraiT;
    item            = gGroup;
    modify(item,"+");

    strap           = grok += "MemberS";
    setRuleStuff();
    item            = strap += ":";
    modify(item,"-");
    item            = strap +% member;
    modify(item,"-");
    item            = strap +% stuff;
    modify(item,"+");

    /*************************************************************************
        DefinE gets filled in below. A bit of musical chairs happening
    *************************************************************************/
    strap           = stuff;
    item            = grok/NewGroup;
    item            = strap +% item;
    method          = aCTionDefinE;
    immediateACTION = true;
    item            = grok/Attributes;
    item            = strap +% item;
    modify(item,"?");
    item            = grok/MemberS;
    item            = strap +% item;
    modify(item,"?");
    item            = new("endDefine");
    item.characterSet    = new(";>");
    item            = strap +% item;
    modify(item,"-");

    /*************************************************************************
        The define command (stuff is DefinE at this point).
    *************************************************************************/
    strap           = grok += "define";
    setRuleStuff();
    item            = grok/DEFINing;
    item            = strap +% item;
    item.setRuleStuff();
    item            = new("definitions");
    item            = strap +% item;
    item.setRuleStuff();
    item.group      = stuff;
    item            = item.gGroup;
    modify(item,"+");
    item            = grok/DEFINing;
    item            = strap +% item;
    item.setRuleStuff();
    item            = new(";");
    item            = strap +% item;
    modify(item,"-");

    strap           = grok += "InvokE";
    setRuleStuff();
    item            = new("(");
    item            = strap +% item;
    modify(item,"-");
    item            = grok/GrouP;
    item            = strap +% item;
    modify(item,"?");
    item            = new(")");
    item            = strap +% item;
    modify(item,"-");

    strap           = grok += "RunRulE";
    setRuleStuff();
    method          = aCTionRunRulE;
    immediateACTION = true;
    item            = grok/NamE;
    item            = strap +% item;
    item            = grok/InvokE;
    item            = strap +% item;
    modify(item,"?");
    item            = new(";");
    item            = strap +% item;
    modify(item,"-?");

    strap           = grok += "InitiatE";
    setRuleStuff();
    group           = grok/RunRulE;
    item            = gGroup;
    modify(item,"+");
    item            = grok/InitiatE;
    item            = 0;

    /*************************************************************************
        The hand-built bootstrap rules above never go through aCTionDefinE, so
        they never get its define-time materialisation. Several of them add
        terms with no modify() call at all (Limit's "[" and "]"), which is why
        those terms had no rStuff and genParse refused them. One pass here, over
        the rules built above, before setup is parsed -- rules defined IN setup
        come through aCTionDefinE and are already covered.

        I commented out the following because all rules created in the bootstrap
        now have setRuleStuff() run on them so rStuff is set
        materialiseRegistry(grok);

        What replaces it is the `audit` COMMAND (Commands.rtn), and it is
        deliberately NOT called from here. Tony, 2026-07-29: this point is
        BEFORE setup is parsed, so an audit here sees only the hand-built
        bootstrap slice and is blind to every rule defined in incant source --
        which is most of the board the invariant is about. It runs from
        incant/oneTest instead, after the definitions are all in place.
    *************************************************************************/
    pushInput(getFile(setupFILE));
    if sourceFILE   strap.parse(0);
    popInput();
    /*************************************************************************
        Set the buffer links
    *************************************************************************/
    item            = properties["stringBUFFER"];
    item.setBuffer(stringBUFFER);
    return strap;
}
}
