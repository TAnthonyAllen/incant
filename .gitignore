# Claude Code — per-machine local settings (shared .claude/ config stays trackable)
.claude/settings.local.json

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor swap / backup files
*.swp
*.swo
*~
.*.swp
.*.swo

# Backup / legacy stashes — attic boxes, not source of truth
# (Sessions/ removed from this list — session docs are now tracked
#  as institutional memory, parallel to PLG repo's Sessions/ dir.)
BeforeRefactor/
BeforeSave/
XML/BackupXML/
NewPLG/

# Offline conversion-to-incant workspace (skeleton mirrors XML/; not tracked)
XML-Incant/

# Xcode — user state
**/xcuserdata/
**/*.xcuserstate
**/project.xcworkspace/xcuserdata/

# Xcode — build output
build/
DerivedData/
*.moved-aside
*.hmap

# C/C++ build artifacts
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.exe
*.out
*.app
*.gch
*.pch

# Loose archive / backup files
*.zip
*.save
*.new
*.bak

# Logs / misc
*.log

# Test alias dir — symlinks back to parent sources, not tracked
Tests/

# Personal working scratchpad — clipboard file, not source
XML/WorkingOn/incant++

# Walkie-talkie IPC — Clay<->Clod channel. TRACKED as of 2026-08-10 (Tony's
# ruling): git buys Clay read-reach via clone and buys history. It buys ZERO
# insurance against WT-11's failure mode, which is SILENT vanishing —
# recoverability only pays once someone knows to look. So WT-11's whole-file
# convention is untouched by this, and tracking must never be read as licence
# to relax it. Commits are batched AT SEAL, not per dispatch. See WT-14a–d in
# docs/walkieTalkie.md.
