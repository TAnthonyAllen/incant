
include groupIncludes

// fields RuleStuff is the per-node parse state; parseMethod and jitMethod are LAYOUT -- widening either is groups.ext + tokall (bear-trap #10)
class RuleStuff
{
String      ruleName;       // for debugging
String      hereAt,
            failedAt;
GroupItem   label,
            onFail,
            onGroup,
            parentLabel,
            sourceLine,
            rule;
int         kount,
            max,
            maxRepeat,
            min;
RuleStuff   parentStuff;
int         &testMatch(GroupItem);
GroupItem   &actionMethod(GroupItem);
GroupItem   &parseMethod(GroupItem);
int         &jitMethod(GroupItem);
boolean
    banged
    doNothing
    followed
    guardOK
    guardFAIL
    hasMacro
    inProcess
    isOK
    isOption
    isTarget
    limitsSet
    noAdvance
    noLabel
    noSkip
    notifyFail
    overTo:2[upTo upToOver]
    sukcess
    ;

// RuleStuff constructors -- min and max start at 1; the TraiT action may overwrite them
RuleStuff(GroupItem grup)
{
    rule        = grup;
    ruleName    = tag;
    // min and max may be overwritten by the TraiT rule action
    max         = 1;
    maxRepeat   = 1;
    min         = 1;
    if grup = grup.parent
        if parentStuff = grup.rStuff
            parentLabel = parentStuff.label;
}

RuleStuff(RuleStuff r)
{
    *this = *r;
    label   = null;
    sukcess = 0;
    kount   = 0;
    parentStuff = null;
}

// checkGuard true when the rule is unguarded or the input character is in its guardSet
int checkGuard(GroupItem field)
{
GroupRules  ruler = groupRules;
    if guardInProcess   guarding = 0;
    if !guarding        ensureGuard();
    if unGuarded        return true;
    or guarded && guardSet.contains(*atRuleMark) return true;
    return false;
}

// checkInput skip, set hereAt, pass the guard and mint the label -- true when input is valid
int checkInput()
{
GroupRules  ruler = groupRules;
GroupItem   field = rule;
    guardFAIL   = false;
    if !atRuleMark {
        cerr "checkInput: no input source":;
        goto checkFailed; }
    if *atRuleMark
        if !noSkip && skipSet.contains(*atRuleMark) atRuleMark = checkSkip(atRuleMark);
    // end of input
    if *atRuleMark
        if !noSkip && skipSet.contains(*atRuleMark) atRuleMark = checkSkip(atRuleMark);
    // hereAtFirst set BEFORE the end-of-input exit -- a term failing at end of input is rewound to hereAt, and an unset one wrote a null mark (convLeakT)
    hereAt  = atRuleMark;
    if !*atRuleMark     goto checkFailed;
    // the rule guard, if there is one
    if guardOK {
        guardOK = false;
        sukcess = true; }
    else {
        if guardInProcess   guarding = 0;
        if !guarding        ensureGuard();
        if unGuarded        sukcess = true;
        or guarded && guardSet.contains(*atRuleMark) sukcess = true;
        else    guardFAIL   = true; }
    // the label
    if sukcess
        if noLabel || (hasMembers && !binType)   label = 0;
        else {
            if !label || !label.fLAG {
                label           = new(tag);
                label.isLabel   = true; }
            else {
                // reuseWitness a recycled label that is still parented is still in some tree
                -% ::measureLabelReuse(label); %-
                label.fLAG     = false; }
            if !label.rStuff || ruleName ne tag label.setRStuff(this);
            // enclosingActivation
            if hasNewParse && isMember {
                // driveRoot a generated DRIVE ROOT parks its label on the drive floor, where driveStep reads it
                if !driveFloorLabel(this,label) {
                    if parent && parent.rStuff  parent.rStuff.label = label;
                    else    refuse(field,"checkInput: no enclosing activation to take the label"); } } }
checkFailed:
    return sukcess;
}

// followingMember the next member after this rule in its parent list -- getWhatFollows' onFail
GroupItem followingMember()
{
    if parent
        {
        GroupItem   grup = rule;
        while grup = grup.nextInParent
            if grup.isMember    break;
        return grup;
        }
    return null;
}

// getWhatFollows sets the RuleStuff fields once, lazily, the first time a rule is needed
void getWhatFollows()
{
GroupItem   grup;
use rule
    followed    = true;
    if isGROUP {
        grup    = group;
        if grup.isMacro     hasMacro = true;
        else    onGroup     = grup; }
    if isMember && !parent.binType {
        isTarget    = true;
        if grup = followingMember() onFail = grup; }
    or isEmbedded {
        if (data && data < 4) || max == 1 isTarget = true; }
    // promotionRetired the parent-min promotion is RETIRED -- do not reintroduce it; an optional term must not make its whole rule optional
    if !testMatch   setTestMatch();
}

// setTestMatch picks the old road's test for this rule's shape
void setTestMatch()
{
    if upTo || upToOver     testMatch = testUpTo;
    or isBIN || isREGISTRY  testMatch = testContainer;
    or data
        switch(data)
            {
            case isANY:     testMatch = testAny;
            case isCHAR:    testMatch = testCharacter;
            case isSET:     testMatch = testSet;
            case isGROUP:   testMatch = null;
            default:        testMatch = testString;
            }
    or isMacro              testMatch = setMacroValue;
    or isCondition          testMatch = testCondition;
    or parseACTION          testMatch = testAction;
    or !contents()
        if !isMethod        testMatch = testString;
}
}

// parseR parse a term into a given label: a throwaway RuleStuff whose label is into, so parse() attaches there -- driveStep's no-data arm
extern GroupItem parseR(GroupItem term, GroupItem into)
{
GroupRules  ruler = groupRules;
RuleStuff   bridge;
GroupItem   got;
    if !term    return null;
    // traceGate identity-printing only, behind parseTrace -- a bare node prints an attribute count that reads like an answer
    if parseTrace {
        cerr "  parseR term=",term.tag," into=",into.tag:; }
    bridge          = new(term);
    bridge.label    = into;
    got = term.parse(bridge);
    if parseTrace {
        if got  cerr "  parseR term=",term.tag," -> attached as ",got.tag," under ",into.tag:;
        else    cerr "  parseR term=",term.tag," -> NULL (no attachment)":; }
    return got;
}

// setMacroValue copy into the macro the data of the nearest ancestor label with the same tag
extern int setMacroValue(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
GroupItem   grup,
            macro = group;
GroupItem   ancestor;
    if parentStuff  ancestor = parentStuff.label;
    if ancestor
        while grup = ancestor.next(grup)
            if macro.tag eq grup.tag {
                macro.copyData(grup);
                return true; }
    cerr "setMacroValue: could not find macro for",field.tag:;
    return false;
}

// limitAtTop the ceiling is tested at the TOP of the loop so a cut at max is reportable; tester is substituted exactly once (bear-trap #18)
#testMacro(tester)-
int         counter;
int         more;
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
    isOK = false;
    if *atRuleMark {
        while tester {
            if counter >= max { more = true; break; }
            counter++;
            atRuleMark++;
            if !*atRuleMark break; }
        if more && max > 1 && !limitsSet   return reportMaxLimit(field);
        if counter && counter >= min {
            if noAdvance    atRuleMark = hereAt;
            if label        label.setToken(hereAt,counter);
            isOK    = true; }}
    if isOK return true;
    return  false;-

// testAction the old road's test for a parseAction rule -- an installed rule runs its leaf
extern int testAction(GroupItem field)
{
    // installedIsTheParse an installed rule runs its LEAF; hasNewParse is copied and rStuff is not, so the guard asks both
    if hasNewParse && rStuff && parseMethod
        if parseMethod(field)   return true;
        else                    return false;
    if actionMethod
        if parseACTION || !label
            if actionMethod(field)      return true;
        or label && actionMethod(label) return true;
    else    cerr "testAction: " tag "has no actionMethod":;
    return  false;
}

// testAny a wild-card run against the current input
extern int testAny(GroupItem field)
{
use field
testMacro(*atRuleMark);
}

// testAttributes parse each attribute in turn; true only when all succeed
extern int testAttributes(RuleStuff stuff)
{
GroupItem   grup;
int         result = true;
    while grup = rule.nextAttribute(grup)
        if noPrint  continue;
        or parse(stuff) result = true;
        else {
            result = false;
            break; }
    return  result;
}

// testCharacter a run of one character against the current input
extern int testCharacter(GroupItem field)
{
use field
testMacro(*atRuleMark == character);
}

// testCondition a condition succeeds exactly when min is set
extern int testCondition(GroupItem field)
{
RuleStuff   ruleStuff = field.rStuff;
    if min  return true;
    return  false;
}

// longestEntry the longest input prefix that IS an entry of this bin or registry -- the greedy scan is only an upper bound
extern int testContainer(GroupItem field)
{
GroupItem   grup;
use field
GroupRules  ruler   = groupRules;
RuleStuff   ruleStuff = rStuff;
PLGset      inSet   = characterSet;
String      atInput = atRuleMark;
int         advance;
Buffer      buffer  = stringBUFFER;
    reset();
    while *atInput
        if contains(*atInput) { buffer += *atInput; atInput++; }
        else break;
    while advance = length() {
        if grup = get(string()) {
            if !noAdvance   atRuleMark += advance;
            if label        label.group = grup;
            return true; }
        shorten(1); }
    return false;
}

// testOptions parse the first member that passes its guard
extern int testOptions(RuleStuff stuff)
{
GroupItem   grup;
    while grup = rule.nextMember(grup) {
        if checkGuard(grup) {
            grup.guardOK = true;
            if parse(stuff) return true; }}
    return  false;
}

// testSet a run of characters from this rule's set
extern int testSet(GroupItem field)
{
use field
PLGset  set = characterSet;
testMacro(set.contains(*atRuleMark));
}

// testString this rule's text at the current input
extern int testString(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
String      matchedString = rule.matches(atRuleMark);
    if matchedString {
        if noAdvance    atRuleMark = hereAt;
        if label        label.text = matchedString;
        return true; }
    return false;
}

// testUpTo capture input up to (or over) the terminator: the rule's set, its string, or a comma
extern int testUpTo(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff   = field.rStuff;
String      atText      = atRuleMark;
String      endString;
int         counter     = 1,
            lngth,
            matched,
            matchLength = 1,
            skipping;
Buffer      buffer = stringBUFFER;
GroupItem   grup = field.isGROUP ? field.group : field;
    reset();
    endString = text;
    matchLength = (int)strlen(endString);
use field
    if noLabel && grup.isCOUNT {
        counter = count;
        skipping = true; }
    grup = 0;
    while counter-- {
        /********************************************************************
            Advance atText until the rule matches
        ********************************************************************/
        for (; *atText; atText++ lngth++) {
            if isSET && characterSet.contains(*atText)  matched++;
            or matchLength == 1 {
                if *atText == '\\' {
                    atText++;
                    switch(*atText) {
                        case 'r':   *atText = '\r';
                        case 't':   *atText = '\t';
                        case 'n':   *atText = '\n'; }}
                or *atText == *endString matched++; }
            or !compareToStream(endString,atText) matched++;
            if matched  break;
            or *atText  buffer += *atText; }
        if skipping {
            atText  += matchLength;
            lngth   += matchLength;
            if counter > 0  continue;
            else atRuleMark  += lngth; }
        /********************************************************************
            If succeeds, update rule label and advance atRuleMark
        ********************************************************************/
        if matched {
            if lngth {
                if label {
                    label.text = buffer.toString();
                    if grup     label +% grup; }
                atRuleMark      = atText; }
            if upToOver     atRuleMark += matchLength;
            return true; }}
    return false;
}
