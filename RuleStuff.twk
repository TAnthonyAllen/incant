
include groupIncludes

// fields RuleStuff is the per-node parse state; parseMethod and jitMethod are LAYOUT -- widening either is groups.ext + tokall (bear-trap #10)
class RuleStuff
{
String      ruleName;       // sourceRuleByIntent a debugging aid only, which rule this RuleStuff refers to -- on a copy it names the SOURCE rule, by intent; no engine code reads it, do not "fix" it
GroupItem   onGroup;
int         max,
            maxRepeat,
            min;
int         &testMatch(GroupItem);
GroupItem   &parseMethod(GroupItem);
int         &jitMethod(GroupItem);
boolean
    followed
    isTarget
    modPercent
    modPointer
    modUnGuarded
    noAdvance
    noLabel
    noSkip
    notifyFail
    overTo:2[upTo upToOver]
    ruleTerm
    ;

// RuleStuff constructors -- min and max start at 1; the TraiT action may overwrite them
RuleStuff(GroupItem grup)
{
    ruleName    = tag;
    // min and max may be overwritten by the TraiT rule action
    max         = 1;
    maxRepeat   = 1;
    min         = 1;
}

RuleStuff(RuleStuff r)
{
    *this = *r;
}

// checkGuard true when the rule is unguarded or the input character is in its guardSet
int checkGuard(GroupItem field)
{
GroupRules  ruler = groupRules;
    if field.isUnGuarded()  return true;
    if guardInProcess   guarding = 0;
    if !guarding        ensureGuard();
    if unGuarded        return true;
    or guarded && guardSet.contains(*atRuleMark) return true;
    return false;
}

// inputAt skip to the input a term starts at and hand the mark back -- null only when there is no input at all (SEQ 301, 1.2c)
String inputAt()
{
GroupRules  ruler = groupRules;
    if !atRuleMark {
        cerr "checkInput: no input source":;
        return null; }
    if *atRuleMark
        if !noSkip && skipSet.contains(*atRuleMark) atRuleMark = checkSkip(atRuleMark);
    // end of input
    if *atRuleMark
        if !noSkip && skipSet.contains(*atRuleMark) atRuleMark = checkSkip(atRuleMark);
    return atRuleMark;
}

// mintLabel the label of a term that passed its guard, or null for noLabel and a members rule -- always a FRESH mint: the fLAG recycle ended with 1.2f, an allocation saving and no more (SEQ 306 R1)
GroupItem mintLabel(GroupItem field)
{
GroupItem   lab;
    if noLabel || (field.hasMembers && !field.binType)   return null;
    lab             = new(field.tag);
    lab.isLabel     = true;
    // labelOf the rule this label was minted for -- written here once, never rewritten (stroke 5.6a)
    lab.labelOf     = field;
    // askTheRule this stuff's rule is field itself, so the identity test asks field for its stuff -- ruleName is Tony's debug aid (ruleName stroke)
    if !lab.rStuff || field.rStuff != this  lab.setRStuff(this);
    // enclosingActivation
    if field.hasNewParse && field.isMember {
        // driveRoot a generated DRIVE ROOT parks its label on the drive floor, where driveStep reads it
        // parentRecord otherwise the parent's RECORD takes it when one is live; with none, nothing reads it and it is dropped (1.2f, SEQ 306 R1)
        if !driveFloorLabel(this,lab) {
            if field.parent && field.parent.rStuff  parkInRecord(field.parent.rStuff,lab);
            else    refuse(field,"checkInput: no enclosing activation to take the label"); } }
    return lab;
}

// checkInput skip, set hereAt, pass the guard and mint the label -- true when input is valid; field is the node the caller runs, never RuleStuff.owner (stroke 5.4a). The old road and parseRule keep their values on this stuff until 1.2d-f; a new-road leaf calls inputAt, checkGuard and mintLabel itself and keeps them in locals (SEQ 301)
int checkInput(GroupItem field, int guardPassed, String inAt)
{
int         inOK = 0;
    // hereAtFirst the CALLER holds the start mark (inputAt, before this) -- a term failing at end of input is rewound to it, and an unset one wrote a null mark (convLeakT); hereAt left RuleStuff in 1.2e (SEQ 303)
    if !inAt    return 0;
    if !*inAt   return 0;
    // verdictReturned the guard's verdict is RETURNED, never stored -- sukcess left RuleStuff in 1.2d (SEQ 302)
    if guardPassed  inOK = true;
    or checkGuard(field)    inOK = true;
    // labelByCaller the caller mints into its OWN record -- RuleStuff.label retired in 1.2f (SEQ 306)
    return inOK;
}

// getWhatFollows sets the RuleStuff fields once, lazily, the first time a rule is needed
void getWhatFollows(GroupItem field)
{
use field
    followed    = true;
    if isGROUP
        onGroup     = group;
    if isMember && !parent.binType {
        isTarget    = true; }
    or isEmbedded {
        if (data && data < 4) || max == 1 isTarget = true; }
    // promotionRetired the parent-min promotion is RETIRED -- do not reintroduce it; an optional term must not make its whole rule optional
    if !testMatch   setTestMatch(field);
}

// setTestMatch picks the old road's test for this rule's shape
void setTestMatch(GroupItem field)
{
use field
    if upTo || upToOver     testMatch = testUpTo;
    or isBIN || isREGISTRY  testMatch = testContainer;
    or data
        switch(data)
            {
            case isANY:     testMatch = testAny;
            case isCHAR:    testMatch = testCharacter;
            case isSET:     testMatch = testSet;
            case isGROUP:   testMatch = null;
            default:        testMatch = testString;
            }
    or isCondition          testMatch = testCondition;
    or parseACTION          testMatch = testAction;
    or !contents()
        if !isMethod        testMatch = testString;
}
}

// parseR parse a term into a given label: into is an ARGUMENT to parse(), never a throwaway RuleStuff (stroke 1.1 site 2) -- driveStep's no-data arm
extern GroupItem parseR(GroupItem term, GroupItem into)
{
GroupRules  ruler = groupRules;
GroupItem   got;
    if !term    return null;
    // traceGate identity-printing only, behind parseTrace -- a bare node prints an attribute count that reads like an answer
    if parseTrace {
        cerr "  parseR term=",term.tag," into=",into.tag:; }
    got = term.parse(null,0,into);
    if parseTrace {
        if got  cerr "  parseR term=",term.tag," -> attached as ",got.tag," under ",into.tag:;
        else    cerr "  parseR term=",term.tag," -> NULL (no attachment)":; }
    return got;
}

// limitAtTop the ceiling is tested at the TOP of the loop so a cut at max is reportable; tester is substituted exactly once (bear-trap #18)
#testMacro(tester)-
int         counter;
int         more;
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
String      testAt = atRuleMark;
    if *atRuleMark {
        while tester {
            if counter >= max { more = true; break; }
            counter++;
            atRuleMark++;
            if !*atRuleMark break; }
        if more && max > 1  return reportMaxLimit(field);
        if counter && counter >= min {
            // testAtIsHereAt parse() calls a leaf test right after checkInput with nothing moving the input between, so the entry mark IS the start mark (1.2e, SEQ 303)
            if noAdvance    atRuleMark = testAt;
            // topRecord the label is the calling parse()'s record, on top of the list (1.2f, SEQ 306)
            if ruler.gParseActive.label     ruler.gParseActive.label.setToken(testAt,counter);
            return true; }}
    return  false;-

// testAction the old road's test for a parseAction rule -- an installed rule runs its leaf
extern int testAction(GroupItem field)
{
    // installedIsTheParse an installed rule runs its LEAF; hasNewParse is copied and rStuff is not, so the guard asks both
    if hasNewParse && rStuff && parseMethod
        if parseMethod(field)   return true;
        else                    return false;
    // topRecord the label is the calling parse()'s record (1.2f, SEQ 306)
    // askTheActor the action is the rule's builtinActoR -- the RuleStuff cache retired (SEQ 205 R3)
    GroupItem   testActor = getProperty("builtinActoR");
    // useField the local above would capture the bare names below (bear-trap #42)
use field
    if testActor && testActor.method
        if parseACTION || !groupRules.gParseActive.label
            if testActor.method(field)      return true;
        or groupRules.gParseActive.label && testActor.method(groupRules.gParseActive.label)   return true;
    else    cerr "testAction: " tag "has no action":;
    return  false;
}

// testAny a wild-card run against the current input
extern int testAny(GroupItem field)
{
use field
testMacro(*atRuleMark);
}

// testAttributes parse each attribute in turn; true only when all succeed
extern int testAttributes(RuleStuff stuff, GroupItem field)
{
GroupItem   grup;
int         result = true;
    while grup = field.nextAttribute(grup)
        if noPrint  continue;
        or parse(stuff,0,null)   result = true;
        else {
            result = false;
            break; }
    return  result;
}

// testCharacter a run of one character against the current input
extern int testCharacter(GroupItem field)
{
use field
testMacro(*atRuleMark == character);
}

// testCondition a condition succeeds exactly when min is set
extern int testCondition(GroupItem field)
{
RuleStuff   ruleStuff = field.rStuff;
    if min  return true;
    return  false;
}

// longestEntry the longest input prefix that IS an entry of this bin or registry -- the greedy scan is only an upper bound
extern int testContainer(GroupItem field)
{
GroupItem   grup;
use field
GroupRules  ruler   = groupRules;
RuleStuff   ruleStuff = rStuff;
PLGset      inSet   = characterSet;
String      atInput = atRuleMark;
int         advance;
Buffer      buffer  = stringBUFFER;
    reset();
    while *atInput
        if contains(*atInput) { buffer += *atInput; atInput++; }
        else break;
    while advance = length() {
        if grup = get(string()) {
            if !noAdvance   atRuleMark += advance;
            // topRecord the calling parse()'s record (1.2f, SEQ 306)
            if ruler.gParseActive.label     ruler.gParseActive.label.group = grup;
            return true; }
        shorten(1); }
    return false;
}

// testOptions parse the first member that passes its guard
extern int testOptions(RuleStuff stuff, GroupItem field)
{
GroupItem   grup;
    while grup = field.nextMember(grup) {
        if checkGuard(grup) {
            if grup.parse(stuff,1,null)  return true; }}
    return  false;
}

// testSet a run of characters from this rule's set
extern int testSet(GroupItem field)
{
use field
PLGset  set = characterSet;
testMacro(set.contains(*atRuleMark));
}

// testString this rule's text at the current input
extern int testString(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
String      testAt = atRuleMark;
String      matchedString = field.matches(atRuleMark);
    // nodeInHand the match reads the field it was handed, never RuleStuff.owner (stroke 5.2)
    if matchedString {
        // testAtIsHereAt the entry mark is the start mark, as testMacro's (1.2e, SEQ 303)
        if noAdvance    atRuleMark = testAt;
        // topRecord the calling parse()'s record (1.2f, SEQ 306)
        if ruler.gParseActive.label     ruler.gParseActive.label.text = matchedString;
        return true; }
    return false;
}

// testUpTo capture input up to (or over) the terminator: the rule's set, its string, or a comma
extern int testUpTo(GroupItem field)
{
    // topRecord the old road's label is the calling parse()'s record (1.2f); a new-road leaf hands its own to upToMatch (SEQ 301)
    if groupRules.gParseActive  return upToMatch(field,groupRules.gParseActive.label);
    return upToMatch(field,null);
}

// upToMatch testUpTo's match, handed the label to fill -- it reads no label off the stuff (SEQ 301, 1.2c)
extern int upToMatch(GroupItem field, GroupItem upLab)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff   = field.rStuff;
String      atText      = atRuleMark;
String      endString;
int         counter     = 1,
            lngth,
            matched,
            matchLength = 1,
            skipping;
Buffer      buffer = stringBUFFER;
GroupItem   grup = field.isGROUP ? field.group : field;
    reset();
    endString = text;
    matchLength = (int)strlen(endString);
use field
    if noLabel && grup.isCOUNT {
        counter = count;
        skipping = true; }
    grup = 0;
    while counter-- {
        /********************************************************************
            Advance atText until the rule matches
        ********************************************************************/
        for (; *atText; atText++ lngth++) {
            if isSET && characterSet.contains(*atText)  matched++;
            or matchLength == 1 {
                if *atText == '\\' {
                    atText++;
                    switch(*atText) {
                        case 'r':   *atText = '\r';
                        case 't':   *atText = '\t';
                        case 'n':   *atText = '\n'; }}
                or *atText == *endString matched++; }
            or !compareToStream(endString,atText) matched++;
            if matched  break;
            or *atText  buffer += *atText; }
        if skipping {
            atText  += matchLength;
            lngth   += matchLength;
            if counter > 0  continue;
            else atRuleMark  += lngth; }
        /********************************************************************
            If succeeds, update rule label and advance atRuleMark
        ********************************************************************/
        if matched {
            if lngth {
                if upLab {
                    upLab.text = buffer.toString();
                    if grup     upLab +% grup; }
                atRuleMark      = atText; }
            if upToOver     atRuleMark += matchLength;
            return true; }}
    return false;
}
