
include groupIncludes

/*******************************************************************************
	RuleStuff is used to stash data used by the parse

    parentLabel (genParseShape S1.2) -- the `into` a generated parse method
    attaches to, made direct and named. NOT new state: parse() already reached
    the same value two hops away through parentStuff.label in its attachment
    block. The single writer is parse()'s S1.3 fork, which writes it on the
    callee's OWN rStuff immediately before calling; the callee lifts it into a
    stack local at ENTRY, before descending, which is what closes the recursion
    window (same reasoning as genParseRuleAccess S1.5's act()).

    parseMethod (genParseShape S1.1) -- ONE argument, and it is the rule. kant
    methods take one argument, so a two-argument parse method could never
    survive the kant handover; `into` is derived from parentLabel instead of
    passed. Widening or narrowing this signature is a LAYOUT change (bear-trap
    #10: groups.ext sync + tokall + rebuild), not an edit.
*******************************************************************************/
class RuleStuff
{
String      ruleName;       // for debugging
String      hereAt,
            failedAt;
GroupItem   label,
            onFail,
            onGroup,
            parentLabel,
            sourceLine,
            rule;
int         kount,
            max,
            min;
RuleStuff   parentStuff;
int         &testMatch(GroupItem);
GroupItem   &parseMethod(GroupItem);
boolean
    banged
    doNothing
    followed
    guardOK
    guardFAIL
    hasMacro
    inProcess
    isOK
    isOption
    isTarget
    limitsSet
    noAdvance
    noLabel
    noSkip
    notifyFail
    overTo:2[upTo upToOver]
    sukcess
    ;

/*******************************************************************************
	RuleStuff constructors.
*******************************************************************************/
RuleStuff(GroupItem grup)
{
    rule        = grup;
    ruleName    = tag;
    // min and max may be overwritten by the TraiT rule action
    max         = 1;
    min         = 1;
}

RuleStuff(RuleStuff r)
{
    *this = *r;
    label   = null;
    sukcess = 0;
    kount   = 0;
    parentStuff = null;
}

/*******************************************************************************
	checkGuard returns true if rule is unGuarded or input pointer is in guardSet
*******************************************************************************/
int checkGuard(GroupItem field)
{
GroupRules  ruler = groupRules;
    if guardInProcess   guarding = 0;
    if !guarding        getGuard();
    if unGuarded        return true;
    or guarded && guardSet.contains(*atRuleMark) return true;
    return false;
}

/*******************************************************************************
	checkInput sets hereAt and atRuleMark, handles input diversion, and returns
    true if current input is valid. Called by GroupItem match()
*******************************************************************************/
int checkInput()
{
GroupRules  ruler = groupRules;
GroupItem   field = rule;
    guardFAIL   = false;
    if !atRuleMark {
        cerr "checkInput: no input source":;
        goto checkFailed; }
    if *atRuleMark
        if !noSkip && skipSet.contains(*atRuleMark) atRuleMark = checkSkip(atRuleMark);
    /***************************************************************************
        Check for end of input
    ***************************************************************************/
    if *atRuleMark
        if !noSkip && skipSet.contains(*atRuleMark) atRuleMark = checkSkip(atRuleMark);
    if !*atRuleMark     goto checkFailed;
    /***************************************************************************
        Check the rule guard if there is one
    ***************************************************************************/
    hereAt  = atRuleMark;
    if guardOK {
        guardOK = false;
        sukcess = true; }
    else {
        if guardInProcess   guarding = 0;
        if !guarding        getGuard();
        if unGuarded        sukcess = true;
        or guarded && guardSet.contains(*atRuleMark) sukcess = true;
        else    guardFAIL   = true; }
    /***************************************************************************
        Set the label
    ***************************************************************************/
    if sukcess
        if noLabel || (isRule && hasMembers && !binType)    label = 0;
        else {
            if !label || !label.fLAG {
                label           = new(tag);
                label.isLabel   = true; }
            else label.fLAG     = false;
            if !label.rStuff    label.setRStuff(this); }
checkFailed:
    return sukcess;
}

/*****************************************************************************
    Return the member following this group in the parent list
    Called by getWhatFollows() in RuleStuff
*****************************************************************************/
GroupItem followingMember()
{
    if parent
        {
        GroupItem   grup = rule;
        while grup = grup.nextInParent
            if grup.isMember    break;
        return grup;
        }
    return null;
}

/*******************************************************************************
	Sets the fields of RuleStuff.
*******************************************************************************/
void getWhatFollows()
{
GroupItem   grup;
use rule
    followed    = true;
    if isGROUP {
        grup    = group;
        if grup.isMacro     hasMacro = true;
        else    onGroup     = grup; }
    if isMember && !parent.binType {
        isTarget    = true;
        if grup = followingMember() onFail = grup; }
    or isEmbedded {
        if (data && data < 4) || max == 1 isTarget = true;
        if !min && parent.min && parent.allAttributesOptional()   parent.min = 0; }
    if !testMatch   setTestMatch();
}

/*******************************************************************************
	Set testMatch
*******************************************************************************/
void setTestMatch()
{
    if upTo || upToOver     testMatch = testUpTo;
    or isBIN || isREGISTRY  testMatch = testContainer;
    or data
        switch(data)
            {
            case isANY:     testMatch = testAny;
            case isCHAR:    testMatch = testCharacter;
            case isSET:     testMatch = testSet;
            case isGROUP:   testMatch = null;
            default:        testMatch = testString;
            }
    or isMacro              testMatch = setMacroValue;
    or isCondition          testMatch = testCondition;
    or parseACTION          testMatch = testAction;
    or !contents()
        if !isMethod        testMatch = testString;
}
}

/*******************************************************************************
	This sets the data of rule to the value of a previously processed label
    with the same name as rule
*******************************************************************************/
extern int setMacroValue(GroupItem field)
{
RuleStuff   ruleStuff = rStuff;
GroupItem   grup,
            macro = group;
GroupItem   ancestor;
    if parentStuff  ancestor = parentStuff.label;
    if ancestor
        while grup = ancestor.next(grup)
            if macro.tag eq grup.tag {
                macro.copyData(grup);
                return true; }
    cerr "setMacroValue: could not find macro for",field.tag:;
    return false;
}

#testMacro(tester)-
int         counter;
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
    isOK = false;
    if *atRuleMark {
        while tester {
            counter++;
            atRuleMark++;
            if !*atRuleMark || counter >= max break; }
        if counter && counter >= min {
            if noAdvance    atRuleMark = hereAt;
            if label        label.setToken(hereAt,counter);
            isOK    = true; }}
    if isOK return true;
    return  false;-

/*******************************************************************************
	Run a wild card test on this group against current input
*******************************************************************************/
extern int testAny(GroupItem field)
{
use field
testMacro(counter < max);
}

/*******************************************************************************
	Run a character test on this group against current input
*******************************************************************************/
extern int testCharacter(GroupItem field)
{
use field
testMacro(*atRuleMark == character && counter < max);
}

/*******************************************************************************
	Run a character set test on this group against current input
*******************************************************************************/
extern int testSet(GroupItem field)
{
use field
PLGset  set = characterSet;
testMacro(set.contains(*atRuleMark));
}

/*******************************************************************************
	Process a parseAction
*******************************************************************************/
extern int testAction(GroupItem field)
{
    if parseACTION || !label
        { if field.method(field)    return true; }
    or label && field.method(label) return true;
    return false;
}

/*******************************************************************************
	Parse field attributes and return true if they all succeed
*******************************************************************************/
extern int testAttributes(RuleStuff stuff)
{
GroupItem   grup;
int         result;
    while grup = rule.nextAttribute(grup)
        if noPrint  continue;
        or parse(stuff) result = true;
        else {
            result = false;
            break; }
    return  result;
}

/*******************************************************************************
	Process a condition
*******************************************************************************/
extern int testCondition(GroupItem field)
{
RuleStuff   ruleStuff = field.rStuff;
    if min  return true;
    return  false;
}

/*******************************************************************************
    Registry and Container test looks for an entry that matches the input stream.
*******************************************************************************/
extern int testContainer(GroupItem field)
{
GroupItem   grup;
use field
GroupRules  ruler   = groupRules;
RuleStuff   ruleStuff = rStuff;
PLGset      inSet   = characterSet;
String      atInput = atRuleMark;
int         advance;
Buffer      buffer  = stringBUFFER;
    reset();
    while *atInput
        if contains(*atInput) { buffer += *atInput; atInput++; }
        else break;
    if advance = length()
        if grup = get(string()) {
            if !noAdvance   atRuleMark += advance;
            if label        label.group = grup;
            return true; }
    return false;
}

/*******************************************************************************
	Process the first field member that passes its guard
*******************************************************************************/
extern int testOptions(RuleStuff stuff)
{
GroupItem   grup;
    while grup = rule.nextMember(grup) {
        if checkGuard(grup) {
            grup.guardOK = true;
            if parse(stuff) return true; }}
    return  false;
}

/*******************************************************************************
	Run a string test on this group against current input
*******************************************************************************/
extern int testString(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
String      matchedString = rule.matches(atRuleMark);
    if matchedString {
        if noAdvance    atRuleMark = hereAt;
        if label        label.text = matchedString;
        return true; }
    return false;
}
    
/***************************************************************************
	Capture input until it gets a match. It returns a token and the input
    stream is left pointing at the match if upTo or after the match if upToOver.
    If the current rule is a set, the set is matched against.
    If the current rule isSTRING its text is matched against. Otherwise
    the default match is against a comma.
***************************************************************************/
extern int testUpTo(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff   = field.rStuff;
String      atText      = atRuleMark;
String      endString;
int         counter     = 1,
            lngth,
            matched,
            matchLength = 1,
            skipping;
Buffer      buffer = stringBUFFER;
GroupItem   grup = field.isGROUP ? field.group : field;
    reset();
    endString = text;
    matchLength = (int)strlen(endString);
use field
    if noLabel && grup.isCOUNT {
        counter = count;
        skipping = true; }
    grup = 0;
    while counter-- {
        /*******************************************************************
            Advance atText until the rule matches
        *******************************************************************/
        for (; *atText; atText++ lngth++) {
            if isSET && characterSet.contains(*atText)  matched++;
            or groupList {
                while grup = field.next(grup)
                    if !compareToStream(grup.tag,atText) {
                        matchLength = (int)strlen(grup.tag);
                        matched++;
                        goto gotMatch; }}
            or matchLength == 1 {
                if *atText == '\\' {
                    atText++;
                    switch(*atText) {
                        case 'r':   *atText = '\r';
                        case 't':   *atText = '\t';
                        case 'n':   *atText = '\n'; }}
                or *atText == *endString matched++; }
            or !compareToStream(endString,atText) matched++;
            if matched  break;
            or *atText  buffer += *atText; }
        /*******************************************************************
            Fields w/o label are skips. The number of fields skipped is
            determined by the counter set above from the field count
        *******************************************************************/
gotMatch:
        if skipping {
            atText  += matchLength;
            lngth   += matchLength;
            if counter > 0  continue;
            else atRuleMark  += lngth; }
        /*******************************************************************
            If succeeds, update rule label and advance atRuleMark
        *******************************************************************/
        if matched {
            if lngth {
                if label {
                    label.text = buffer.toString();
                    if grup     label +% grup; }
                atRuleMark      = atText; }
            if upToOver     atRuleMark += matchLength;
            return true; }}
    return false;
}

/*******************************************************************************
    genParse Step 1/2 prototype (docs/genParseSpec.md S3/S5): hand-written
    support library + the seven JSONblock methods + entry wrapper. No tok
    macros -- every primitive below is a real function, so &&/|| composition
    works natively.
*******************************************************************************/

/*******************************************************************************
    Match a literal string at atRuleMark (skip-set pass first). No label --
    for "-"/noLabel attribute terms (JSONblock's "{"-/"}"-,  JSONfield's ":"-,
    JSONitem's ","?-).
*******************************************************************************/
extern int lit(GroupItem field, String str)
{
GroupRules  ruler = groupRules;
String      atText, matchStr;
    if skipSet.contains(*atRuleMark)   atRuleMark = checkSkip(atRuleMark);
    atText      = atRuleMark;
    matchStr    = str;
    while *matchStr
        if *atText == *matchStr { atText++; matchStr++; }
        else return false;
    atRuleMark = atText;
    return true;
}

/*******************************************************************************
    Match a literal string as an alternation MEMBER (JSONtoken's "false"/
    "true"). A plain literal member is not noLabel, so on success this
    creates a label tagged with the literal text and attaches it into `into`
    directly -- leaveAlt is label-transparent by design, so literal options
    must attach themselves (rule-reference options attach via their own
    leaveRule against the same `into`).
*******************************************************************************/
extern int litOption(GroupItem field, GroupItem into, String str)
{
GroupRules  ruler = groupRules;
GroupItem   fresh;
String      atText, matchStr;
    if skipSet.contains(*atRuleMark)   atRuleMark = checkSkip(atRuleMark);
    atText      = atRuleMark;
    matchStr    = str;
    while *matchStr
        if *atText == *matchStr { atText++; matchStr++; }
        else return false;
    atRuleMark = atText;
    fresh       = new(str);
    into +% fresh;
    return true;
}

/*******************************************************************************
    True if ch is one of the characters in chars -- a guard test for baked
    guard sets. PLGset stays the default for larger sets (banked, S5.2); this
    covers the single/small-explicit-set cases in the JSONblock family.
*******************************************************************************/
extern int inGuard(GroupItem field, String chars, char ch)
{
    while *chars
        if *chars == ch     return true;
        else chars++;
    return false;
}

/*******************************************************************************
    Sequence exit -- Invariant R lives here and in leaveAlt, nowhere else.
    On success: attach label into `into`'s list, return true. On failure:
    rewind atRuleMark to `from`, return false (label is simply not attached;
    GC reclaims it, same as parse()'s own comment on label leaks).
*******************************************************************************/
extern GroupItem leaveRule(GroupItem field, GroupItem into, GroupItem label, String from, int ok)
{
GroupRules  ruler = groupRules;
    if ok {
        into +% label;
        return label; }
    atRuleMark = from;
    return null;
}

/*******************************************************************************
    Alternation exit. No label of its own (S2.4) -- the winning option has
    already attached (rule-reference options attach via their own leaveRule
    against the same `into`; literal options attach via litOption). Only
    handles the rewind-on-failure half of Invariant R.
*******************************************************************************/
extern GroupItem leaveAlt(GroupItem field, String from, int ok)
{
GroupRules  ruler = groupRules;
    if ok   return trueResult;
    atRuleMark = from;
    return null;
}

/*******************************************************************************
    Generated per-term iteration helper for JSONblock's `JSONfield*` (min 0).
    Same treatment S5.2 already gives character-level accumulators, extended
    to group-reference iteration -- one small function per loop site rather
    than a reusable macro (S2.5).
*******************************************************************************/
extern int manyJSONblockFields(GroupItem label)
{
GroupRules  ruler = groupRules;
String      from = atRuleMark;
int         kount;
    while parseJSONfield(label)     kount++;
    if kount >= 0   return true;
    atRuleMark = from;
    return false;
}

/*******************************************************************************
    Generated per-term iteration helper for JSONlist's `JSONitem+` (min 1).
*******************************************************************************/
extern int manyJSONlistItems(GroupItem label)
{
GroupRules  ruler = groupRules;
String      from = atRuleMark;
int         kount;
    while parseJSONitem(label)      kount++;
    if kount >= 1   return true;
    atRuleMark = from;
    return false;
}

/*******************************************************************************
    JSONblock isRule fail "{"- JSONfield* "}"-;
*******************************************************************************/
extern GroupItem parseJSONblock(GroupItem into)
{
GroupItem   label = new("JSONblock");
GroupItem   rule  = locate("JSONblock");
GroupRules  ruler = groupRules;
String      from  = atRuleMark;
int         ok;
    ok = lit(rule,"{") && manyJSONblockFields(label) && lit(rule,"}");
    return leaveRule(rule,into,label,from,ok);
}

/*******************************************************************************
    JSONfield isRule JSONtoken ":"- JSONvalue ","?- code={
        token <: JSONtoken; token = JSONvalue; return token; };

    RETAGGING NOTE (Clod, 2026-07-25): parseJSONtoken/parseJSONvalue attach
    their result tagged by whatever their OWN winning internal path produced
    (e.g. "GrouP", from JSONtoken's alternation resolving through GrouP's
    label-transparent alternation down to QuotE) -- NOT retagged to the
    ATTRIBUTE'S OWN NAME the way the generic parse() driver retags an
    attribute term to its own tag via isTarget handling. The tail action
    looks children up BY the attribute name ("JSONtoken"/"JSONvalue"), so
    each sub(R)-style attach here must be retagged explicitly. This is a gap
    in genParseSpec's sub(R) semantics generally (S2.1/S4.1 don't mention
    retagging), not specific to JSONfield -- found empirically via this
    exact bug (the action received two children both tagged "GrouP" and
    could find neither "JSONtoken" nor "JSONvalue", so it silently returned
    null and the whole field's content was discarded).
*******************************************************************************/
extern GroupItem parseJSONfield(GroupItem into)
{
GroupItem   label = new("JSONfield");
GroupItem   rule  = locate("JSONfield");
GroupItem   tokenChild, valueChild;
GroupRules  ruler = groupRules;
RuleStuff   freshStuff;
String      from  = atRuleMark;
int         ok;
    if !label.rStuff   { freshStuff = new(rule); label.setRStuff(freshStuff); }
    ok = parseJSONtoken(label) != 0;
    if ok   { tokenChild = label.next(tokenChild); tokenChild.tag = "JSONtoken"; }
    ok = ok && lit(rule,":");
    ok = ok && parseJSONvalue(label);
    if ok   { valueChild = label.next(tokenChild); valueChild.tag = "JSONvalue"; }
    ok = ok && (lit(rule,",") || true);
    if ok   { ruleSTUFF = label.rStuff; label = rule.method(label); }
    return leaveRule(rule,into,label,from, ok && label );
}

/*******************************************************************************
    JSONvalue isRule JSONblock; JSONarray; JSONtoken;
*******************************************************************************/
extern GroupItem parseJSONvalue(GroupItem into)
{
GroupItem   rule = locate("JSONvalue");
GroupRules  ruler = groupRules;
String      from = atRuleMark;
    return leaveAlt(rule,from,
                (inGuard(rule,"{",*atRuleMark) && parseJSONblock(into))
             || (inGuard(rule,"[",*atRuleMark) && parseJSONarray(into))
             || parseJSONtoken(into) );
}

/*******************************************************************************
    JSONtoken isRule JSONblock; "false"; "true"; GrouP; NumbeR;
*******************************************************************************/
extern GroupItem parseJSONtoken(GroupItem into)
{
GroupItem   rule = locate("JSONtoken");
GroupRules  ruler = groupRules;
String      from = atRuleMark;
    return leaveAlt(rule,from,
                (inGuard(rule,"{",*atRuleMark) && parseJSONblock(into))
             || litOption(rule,into,"false")
             || litOption(rule,into,"true")
             || parseGeneric(into,"GrouP")
             || parseGeneric(into,"NumbeR") );
}

/*******************************************************************************
    Bridge to the GENERIC driver for rules genParse hasn't converted yet
    (GrouP, NumbeR -- pre-existing bootstrap rules, out of scope for this
    prototype). Builds a throwaway RuleStuff whose .label IS `into`, so
    parse()'s own attach logic (`pStuff.label +% label;`) appends directly
    where a converted callee's leaveRule/leaveAlt would have. Generated
    methods and the generic driver coexist rule by rule (S0) -- this is the
    seam.
*******************************************************************************/
extern GroupItem parseGeneric(GroupItem into, String ruleName)
{
GroupItem   rule = locate(ruleName);
RuleStuff   bridge = new(rule);
    bridge.label = into;
    return rule.parse(bridge);
}

/*******************************************************************************
    JSONitem isRule JSONtoken@ ","?-;
    @ (isTarget/promote): the child's label becomes JSONitem's own result,
    retagged. No fresh label of its own and no leaveRule call -- JSONtoken's
    own leaveAlt/leaveRule already rewinds on failure (Invariant R), so
    promotion needs nothing extra on the failure path.
*******************************************************************************/
extern GroupItem parseJSONitem(GroupItem into)
{
GroupItem   rule = locate("JSONitem");
GroupRules  ruler = groupRules;
    if !parseJSONtoken(into)   return null;
    into.tag = "JSONitem";
    lit(rule,",");
    return trueResult;
}

/*******************************************************************************
    JSONlist isRule JSONitem+;
*******************************************************************************/
extern GroupItem parseJSONlist(GroupItem into)
{
GroupItem   label = new("JSONlist");
GroupItem   rule  = locate("JSONlist");
GroupRules  ruler = groupRules;
String      from  = atRuleMark;
    return leaveRule(rule,into,label,from, manyJSONlistItems(label) );
}

/*******************************************************************************
    JSONarray isRule "["- JSONlist? "]"- code={
        if JSONlist; for grup in JSONlist; grup <: grup; };
*******************************************************************************/
extern GroupItem parseJSONarray(GroupItem into)
{
GroupItem   label = new("JSONarray");
GroupItem   rule  = locate("JSONarray");
GroupRules  ruler = groupRules;
RuleStuff   freshStuff;
String      from  = atRuleMark;
int         ok;
    if !label.rStuff   { freshStuff = new(rule); label.setRStuff(freshStuff); }
    ok = lit(rule,"[") && (parseJSONlist(label) || true) && lit(rule,"]");
    if ok   { ruleSTUFF = label.rStuff; label = rule.method(label); }
    return leaveRule(rule,into,label,from, ok && label );
}

/*******************************************************************************
    runJSONblock (the incant-callable entry wrapper, genParseSpec S5.3) lives
    in Commands.rtn, not here -- Clay's structural hypothesis (2026-07-25):
    no incant-callable command has ever lived in a standalone class file like
    RuleStuff.twk; every one lives in a .rtn included INTO GroupRules.twk, and
    the extern-count evidence (152->154, not ~166, after adding ~14 externs
    here) suggests the immediateAction binding mechanism only resolves names
    against GroupRules' own extern space. parseJSONblock/etc. above stay here
    and are called normally as ordinary cross-file C++ from Commands.rtn.
*******************************************************************************/
