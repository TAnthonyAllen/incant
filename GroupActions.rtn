


// aCTionTell the tell rule's action, the one door into a field's grammar: drive the target with the message and return a verdict; an unknown target is a verdict, never a refuse()
extern GroupItem aCTionTell(GroupItem input)
{
GroupRules  ruler = groupRules;
GroupItem   target:,
            message:,
            who,
            said,
            raw,
            got,
            result,
            replyFrom,
            reply,
            verdict = new("verdict");
int         matched = 0,
            known = 0,
            msgLen = 0,
            markAt = -1,
            failAt = -1,
            consumed = 0,
            stoppedAt = 0;
    if target   who = locate(target.getText());
    if who      known = 1;
    if who && message {
        said        = new("message");
        said.text   = message.getText();
        raw         = new("driveReport");
        result      = driveStep(said,who,raw);
        if got = raw["length"]      msgLen = got.count;
        if got = raw["mark"]        markAt = got.count;
        if got = raw["failedAt"]    failAt = got.count;
        if result && result != falseResult  matched = 1;
        if matched && markAt > 0    consumed = markAt;
        if matched                  stoppedAt = consumed;
        or failAt > 0               stoppedAt = failAt; }
    verdictCount(verdict,"matched",matched);
    verdictCount(verdict,"consumed",consumed);
    verdictCount(verdict,"length",msgLen);
    verdictCount(verdict,"stoppedAt",stoppedAt);
    verdictCount(verdict,"known",known);
    // replyFromFloor driveStep hands back a generated root's label from the drive floor -- the reply reads that, never the root's slot, which the call bracket has restored
    replyFrom = result;
    if matched && replyFrom && replyFrom != labelNO && replyFrom != trueResult {
        reply       = new("reply");
        reply.group = copyOf(replyFrom);
        verdict.addAttribute(reply); }
    return verdict;
}


// appendGroup print the field passed in to the buffer passed in, or run its print shortcuts
extern GroupItem appendGroup(GroupItem input,GroupItem FormaT,Buffer buffer)
{
String      atText;
GroupRules  ruler = groupRules;
String      format;
int         indenting;
GroupItem   grup,
            field;
    field = input;
    // nullIsRefusal a refusing operator hands this a NULL and its error is already named -- skip the item quietly, never dereference it (F-36)
    if !field   return null;
    if FormaT {
        format = FormaT.text;
        *format = '%'; }
    if !field.isShortcut
        if field.isLIST
            if field.reversePrint
                while grup = field.next(grup)
                    printField(grup,format,buffer);
            else
                while grup = field.prior(grup)
                    printField(grup,format,buffer);
        else    printField(field,format,buffer);
    else {
        // shortcuts the field text is a string of print shortcuts, each processed in turn
        for (atText = text; *atText; atText++)
            switch(*atText) {
                case '~':   indenting++;
                case '$':   useDefaultSpace = !useDefaultSpace;
                case '_':   append(' ');
                case ':':   append('\n');
                case '+':   inDENT.gCount++;
                case '-':   if inDENT.gCount > 0    inDENT.gCount--;
                case '`':   append('\t');
                case ',':   grup = 0; }
        if indenting && inDENT.gCount > 0   tabRight(inDENT.gCount); }
    return field;
}


// assignFieldCore BOTH ROADS CALL THIS -- the interpreted = from opAssign, the emitted = through jitAssignNodeRT -- one spelling, so they cannot drift
extern int assignFieldCore(GroupItem source,GroupItem target)
{
    -%
    if ( !target )  return 0;
    if ( !source ) {
        ::fprintf(stderr,"ERROR = on %s -- nothing on the right; stores nothing\n",
            target->groupBody->tag);
        return 0;
        }
    if ( isGROUP(source->groupBody->flags.data) ) {
        ::fprintf(stderr,"ERROR = on %s -- holds a group; say *\n",
            target->groupBody->tag);
        return 0;
        }
    target->setContent(source);
    return 1;
    %-
}


// closeFile close the buffer's file; with no file set, the field's tag is the filename
extern int closeFile(GroupItem bufField)
{
    if bufField.isBUFFER {
        if !bufField.buffer.file    bufField.buffer.setFile(bufField.tag);
        return bufField.buffer.closeFile(); }
    return 0;
}


// definersOf every occurrence of a rule -- the registry entry and each term carrying its tag -- and whether definingRule() answers the REGISTRY's entry, as the shared-children invariant says it must (SEQ 216); prints the counts unconditionally
extern GroupItem definersOf(GroupItem input)
{
GroupRules  ruler = groupRules;
    -%
    const char *want = input ? input->groupBody->tag : 0;
    int seen = 0, toRegistry = 0;
    GroupItem *reg = GroupControl::groupController->getRegistry((char*)"Grokking");
    GroupItem *regEntry = (want && reg) ? reg->get((char*)want) : 0;
    GroupItem *r = 0;
    while ( want && regEntry && (r = reg->next(r)) ) {
        GroupItem *t = 0;
        if ( ::strcmp(r->groupBody->tag,want) == 0 ) { seen++; if ( r->definingRule() == regEntry ) toRegistry++;
            else ::fprintf(stderr,"  DEFINER %s registry entry answers %p, not itself\n",want,r->definingRule()); }
        while ( (t = r->next(t)) )
            if ( ::strcmp(t->groupBody->tag,want) == 0 ) {
                seen++;
                GroupItem *d = t->definingRule();
                if ( d == regEntry ) toRegistry++;
                else ::fprintf(stderr,"  DEFINER %s term of rule %s answers %s@%p (parent %s), not the registry's\n",want,r->groupBody->tag,
                    d ? d->groupBody->tag : "-",d,(d && d->parent) ? d->parent->groupBody->tag : "-"); }
        }
    ::fprintf(stderr,"DEFINERS %s occurrences=%d registry=%d others=%d\n",want ? want : "(none)",seen,toRegistry,seen - toRegistry);
    %-
    return trueResult;
}


// dispatcher run a listener, disguised as a void*, against its notifier -- a stub that says it needs rewriting
extern void dispatcher(void* stuff)
{
GroupItem   grup        = stuff;
GroupItem   notifyLIST  = parent;
    if notifyLIST {
        GroupItem   notifier = parent;
        if notifier cerr "dispatcher: needs to be rewritten":;
        else cerr "dispatcher: ERROR could not get notifier for",grup.tag:; }
}


// driveFloorLabel a generated DRIVE ROOT's label is parked on the drive's floor, the activation just below the root's own -- one writer (checkInput), one reader (driveStep); returns 1 when it took the label (Tony, 2026-09-26, SEQ 185 (i))
extern int driveFloorLabel(RuleStuff stuff, GroupItem label)
{
    -%
    if ( !stuff || !gParseActive || gParseActive->stuff != stuff ) return 0;
    ParseActivation *below = gParseActive->prev;
    if ( !below || !below->floor ) return 0;
    below->label = label;
    return 1;
    %-
}


// driveStep runRule's body and the one drive runRule and tell share: divert input to the field's content, run the rule, and report OFFSETS into the message, never addresses (H3)
extern GroupItem driveStep(GroupItem field,GroupItem rule,GroupItem report)
{
GroupRules  ruler = groupRules;
GroupItem   result;
GroupItem   intoField;
int         baseStak = 0,
            priorFloor = 0;
String      driveBase;
use rule
    // ruleDoorSeat WHICH DOOR a rule arrived through -- the one question the dispatch fork above cannot answer
    measureRuleDoor(field,rule);
use ruler
    if inputSTAK    baseStak = inputSTAK.length;
    // driveFloor a drive pushes a FLOOR on the new road's activation list; deferredAbove stops there (Tony, 2026-09-24)
    -%
    ParseActivation driveFloor = { 0, gParseActive, 1 };
    int floorPushed = 0;
    int priorIndent = ruler->lastIndent, priorDefining = ruler->defining;
    if ( field && field->groupBody->flags.data ) { gParseActive = &driveFloor; floorPushed = 1; }
    %-
    if field && field.data {
        divertToRule    = true;
        pushInput(field);
        driveBase       = atRuleMark;
        // inputFloor the message is the floor for the whole drive; a nested drive raises it and restores it
        priorFloor      = inputFloor;
        inputFloor      = inputSTAK.length;
        // markSeat SEQ 166 -- record the drive string's extent so every later point can ask
        // markSeat whether the mark is still inside it
        measureMarkArm(field);
        measureMarkPoint("2a-after-push"); }
    // frameSeat the rule, the field, and the stuff/label chain the fork below is about to read
    measureFrameProbe(field,rule);
    // unwrapTheHolder THIS LINE IS THE SINGLE DEREFERENCE OF THE CARRIER -- never add a second one below the fork
    intoField = field;
    if intoField && intoField.isGROUP   intoField = intoField.gGroup;
    // gateOnlyNeverGenerate runRule GATES on hasNewParse and NEVER installs a parse -- generation is explicit, through parser
    if rule.hasNewParse {
        // noSilentFallthrough NEVER fall through to the old parse here -- it trades a loud crash for a quiet wrong answer
        if !rule.gMethod    result = refuse(rule,"runRule: hasNewParse is set but no method is installed to fire");
        else                result = rule.method(rule); }
    else {
        // noDataMeansLabel a non-null field with NO DATA is the label to attach into, never an input to divert
        if intoField && !intoField.data     result = parseR(rule,intoField);
        else {
            // oldRoadAttach an old-road rule called from INSIDE a new-road activation attaches into that activation -- with parse(0) attachLabel dropped its label, and every print shortcut vanished (F-120, F-116); a real drive has pushed its floor, so it still passes 0
            -% result = rule->parse((gParseActive && !gParseActive->floor) ? gParseActive->stuff : 0); %-
            } }
    // floorLabel a generated root that SUCCEEDED hands back the label its floor holds (trueResult when it parked none); a failure hands back what the fire did
    -% if ( floorPushed && rule->groupBody->flags.hasNewParse && result && result != ruler->falseResult && driveFloor.label ) result = driveFloor.label; %-
use ruler
    // markSeat2 SEQ 166 point 2 -- THE KEY PAIR, either side of the pop
    if field && field.data  measureMarkPoint("2b-before-pop");
    // reportSeat the ONE moment consumed is readable -- after the parse, before the pop below puts the mark back in the sender
    if report && driveBase  reportDrive(report,rule,driveBase);
use ruler
    if field && field.data  inputFloor = priorFloor;
    // driveOwnsIndent a drive's message is its own input: its indentation and an unterminated define end with it -- restore the caller's lastIndent and defining (F-125; each alone leaked)
    -%
    if ( field && field->groupBody->flags.data ) { ruler->lastIndent = priorIndent; ruler->defining = priorDefining; }
    %-
    while field && field.data && inputSTAK && inputSTAK.length > baseStak
        popInput();
    if field && field.data  measureMarkPoint("2c-after-pop");
    // driveFloor pop the floor before the single return
    -% if ( floorPushed ) gParseActive = driveFloor.prev; %-
    return result;
}


// fAIL bind the fail method named in the FAIL attribute's text
extern GroupItem fAIL(GroupItem input)
{
String      name = text;
use input
    if fLAG
        if name {
            method = dlsym(RTLD_SELF,name);
            if !method  cerr "FAIL: could not find method:",name:;
            else {
                pointer     = (void*)0;
                isMethod    = true; }}
        else cerr "FAIL: no fail method argument provided":;
    else cerr "FAIL: should be a rule attribute":;
    return trueResult;
}


// followArgument argument is a BINDING, not a field: an isArgument operand holding a group yields what it holds
extern GroupItem followArgument(GroupItem operand)
{
    -%
    if ( operand && operand->groupBody->flags.isArgument && isGROUP(operand->groupBody->flags.data) )
        return operand->getGroup();
    return operand;
    %-
}


// frameFind read-only twin of frameStak -- null when no frame child exists, so restore can tell never saved from saved nothing without minting one
extern GroupItem frameFind(GroupItem action)
{
    return action["frameSTAK"];
}


// frameStak the frame bracket's save-stack lives on a noPrint CHILD, never in the action's own data slot, which may hold the field's VALUE
extern GroupItem frameStak(GroupItem action)
{
GroupItem   frame = action["frameSTAK"];
    if frame    return frame;
    frame = action += "frameSTAK";
    frame.noPrint = true;
    return frame;
}


// grammarHolds report every grammar rule, and every term of one, holding a child tagged like the argument -- an action body's name must never land there (SEQ 214, ownerT); prints the count unconditionally
extern GroupItem grammarHolds(GroupItem input)
{
GroupRules  ruler = groupRules;
    -%
    const char *want = input ? input->groupBody->tag : 0;
    int held = 0;
    GroupItem *reg = GroupControl::groupController->getRegistry((char*)"Grokking");
    GroupItem *r = 0;
    while ( want && reg && (r = reg->next(r)) ) {
        if ( r->get((char*)want) ) { held++; ::fprintf(stderr,"  GRAMMARHOLDS %s under rule %s\n",want,r->groupBody->tag); }
        GroupItem *t = 0;
        while ( (t = r->next(t)) )
            if ( t->get((char*)want) ) { held++; ::fprintf(stderr,"  GRAMMARHOLDS %s under term %s of rule %s\n",want,t->groupBody->tag,r->groupBody->tag); }
        }
    ::fprintf(stderr,"GRAMMARHOLDS %s = %d\n",want ? want : "(none)",held);
    %-
    return trueResult;
}


// hasRepeatClass 1 when any character of the modifier is in the repetition class
extern int hasRepeatClass(String modifier)
{
    -%
    char one[2];
    one[1] = 0;
    for ( char *p = modifier; p && *p; p++ ) {
        one[0] = *p;
        if ( ::modifierIsRepeat(one) ) return 1;
        }
    %-
    return 0;
}


// interpretMethod bind a bytecode op's handler on a PERSISTENT interpret child, so interpretBC dispatches it in place; the op's own slots stay clear
extern GroupItem interpretMethod(GroupItem input)
{
String      name = text;
GroupItem   interp;
use input
    if input.fLAG
        if name {
            GroupItem   grup = parent;
            if grup {
                interp = addString("interpret");
                interp.method = dlsym(RTLD_SELF,name); }
            else    cerr "interpretMethod: no parent to attach interpret to":; }
        else    cerr "interpretMethod: expected a handler name in text":;
    else    cerr "interpretMethod: should be invoked as a definition attribute":;
    return group;
}


// jitSeedOperands seed both operands for the emitter -- a literal as a constant, anything else as a field
extern void jitSeedOperands(GroupItem target,GroupItem arg)
{
    -%
    if (target && !target->jitData) {
        if (target->groupBody->flags.isLiteral) jitSeedLiteral(target);
        else                                    jitSeedField(target);
    }
    if (arg && !arg->jitData) {
        if (arg->groupBody->flags.isLiteral)    jitSeedLiteral(arg);
        else                                    jitSeedField(arg);
    }
    %-
}


// jitSlotTaken 1 when a jitting op carries an emitter slot to fire -- counted HERE so no shim can forget; a unary slot refuses out loud and runs interpreted
extern int jitSlotTaken(GroupItem op)
{
    -%
    if ( !GroupControl::groupController->groupRules->jitting || !op->groupBody->gJitEmitter ) return 0;
    if ( op->groupBody->flags.isUnary ) {
        ++gJitSlotUnaryRefused;
        ::fprintf(stderr,
            "=== JIT SLOT REFUSED #%d: unary op '%s' carries a jitEmitter, "
            "but the unary specimen has not landed -- running INTERPRETED ===\n",
            gJitSlotUnaryRefused, op->groupBody->tag ? op->groupBody->tag : "(unnamed)");
        ::fflush(stderr);
        return 0;
        }
    ++gJitSlotCount;
    return 1;
    %-
}


// limitWriteCheck after the write: a bad maxLimit or repeatLimit is refused and the prior count put back (F-27)
extern void limitWriteCheck(GroupItem target,int priorLimit)
{
GroupRules  ruler = groupRules;
    if target.groupBody == repeatLimit.groupBody {
        if (repeatLimit.isCOUNT || repeatLimit.isNUMBER) && repeatLimit.count > 0   return;
        cerr "REFUSED repeatLimit write: " repeatLimit.text " is not a usable limit":;
        cerr "    keeping repeatLimit " toStringFromInt(priorLimit):;
        cerr "    limits already stamped are unchanged":;
        repeatLimit.count = priorLimit;
        return; }
    if (maxLimit.isCOUNT || maxLimit.isNUMBER) && maxLimit.count > 0    return;
    cerr "REFUSED maxLimit write: " maxLimit.text " is not a usable limit":;
    cerr "    keeping maxLimit " toStringFromInt(priorLimit):;
    cerr "    limits already stamped are unchanged":;
    maxLimit.count  = priorLimit;
}


// limitWriteGuard before the write: the prior count when the target is maxLimit or repeatLimit, else 0 -- one int test on every other assignment
extern int limitWriteGuard(GroupItem target)
{
GroupRules  ruler = groupRules;
    if !target                                      return 0;
    if target.groupBody == maxLimit.groupBody       return maxLimit.count;
    if target.groupBody == repeatLimit.groupBody    return repeatLimit.count;
    return 0;
}


// loadRegistryFromString load a registry, creating it if needed, with every run of non-space characters; attributes are not handled
extern void loadRegistryFromString(String name,String content)
{
GroupRules  ruler   = groupRules;
Buffer      buffer  = stringBUFFER;
GroupItem   target  = getRegistry(name);
GroupItem   field;
String      input   = content,
            strung;
PLGset      fieldSet = new("^ \n\r\t");
    print target.tag:;
    while input && *input {
        field   = null;
        if fieldSet.contains(*input) {
            reset();
            while fieldSet.contains(*input) {
                buffer += *input;
                input++; }
            strung  = buffer.toString();
            field   = new(strung);
            //target    += field;
            print `tag:; }
        else input++; }
}


// makeDataType set target to the data type the argument names -- called from setInternalType
extern GroupItem makeDataType(GroupItem target,GroupItem argument)
{
GroupItem   fILE;
String      fileName;
use target
    switch(*argument.tag)
        {
        case 'b':   if argument.tag eq "buffer" {
                        buffer      = new;
                        isBUFFER    = true;
                        if isFile {
                            fILE = target["file"];
                            fileName = fILE ? fILE.text : null;
                            if fileName buffer.setFile(fileName);
                            else cerr "could not set file for buffer " target.tag:; }}
                    else {
                        bitmap  = new;
                        isMAP   = true; }
        case 'f':   isFile      = true;
                    target      +% argument;    // adds a file attribute
                    if isBUFFER {
                        fileName = argument.text;
                        if fileName buffer.setFile(fileName);
                        else cerr "expected a file name in " argument.tag:; }
        case 'r':   isREGEX     = true;
                    if argument.isSTRING    regex = new(argument.text);
                    else cerr argument.tag "must include regex data as text":;
        case 's':   stak        = new;
        default:    cerr argument.tag,"is not a known type":; }
    return target;
}


// materialiseRegistry materialise the rStuff of every rule in a registry; returns how many were made
extern int materialiseRegistry(GroupItem registry)
{
GroupItem   rule;
int         made = 0;
    while rule = registry.next(rule)    made += materialiseTerms(rule);
    return made;
}


// materialiseTerms rStuff at DEFINE TIME, for the rule and each term -- it closes the gap the bootstrapper's hand-built rules leave
extern int materialiseTerms(GroupItem rule)
{
GroupItem   term;
int         i = 1;
int         made = 0;
    if !rule.rStuff {
        rule.setRuleStuff();
        made++; }
    while term = rule[i] {
        if !term.rStuff {
            term.setRuleStuff();
            made++; }
        i++; }
    return made;
}


// modifierIsRepeat THE MODIFIER CLASS PREDICATE: a presence test for repeatClass in the Modifiers registry, default flag -- a hand, not a witness
extern int modifierIsRepeat(String modifier)
{
    -%
    char one[2];
    if ( !modifier || !*modifier ) return 0;
    one[0] = *modifier; one[1] = 0;
    GroupItem *reg = GroupControl::groupController->getRegistry("Modifiers");
    if ( !reg ) return 0;
    GroupItem *entry = reg->get(one);
    if ( !entry ) return 0;
    return entry->get("repeatClass") ? 1 : 0;
    %-
    return 0;
}


// modify process the modifiers for the field passed in, updating its RuleStuff
extern void modify(GroupItem field,String modifier)
{
    setRuleStuff();
    while *modifier
        switch(*modifier++) {
            case '+':   max         = maxLimit.count;
                        maxRepeat   = repeatLimit.count;
            case '*':   min         = 0;
                        max         = maxLimit.count;
                        maxRepeat   = repeatLimit.count;
            case '?':   min     = 0;
            case '!':   banged  = true;
            case '<':   noAdvance   = true;
            case '%':   modPercent  = true;
            case '&':   modPointer  = true;
            case '@':   isTarget    = true;
            case '-':   noLabel     = true;
            case '_':   modUnGuarded = true;
            case '^':   noSkip      = true;
            case '{':   upTo        = true;
                        modUnGuarded = true;
            case '}':   upToOver    = true;
                        modUnGuarded = true;
            case '$':   isMacro     = true; }
}


// modifyClass modify(), filtered to ONE class -- one place knows what a modifier DOES, one place knows what CLASS it is
extern void modifyClass(GroupItem field,String modifier,int wantRepeat)
{
    -%
    char one[2];
    one[1] = 0;
    for ( char *p = modifier; p && *p; p++ ) {
        one[0] = *p;
        if ( ::modifierIsRepeat(one) == wantRepeat ) ::modify(field,one);
        }
    %-
}


// pickKindOP THE WHOLE += PICK, ONE PLACE, BOTH ROADS -- members keyed on the TARGET; no member for the pick hands back the op, and opPlusEQ refuses by name
// structuralIsMembers structural is hasMembers, NEVER groupList -- attributes live on the list
// tagsBuiltHere the structural and 4a tags are built here, not through getDataType: an empty field and a structural one both read "none"
extern GroupItem pickKindOP(GroupItem op,GroupItem target,GroupItem arg)
{
    if !op || !target               return op;
    if !op.hasMembers               return op;
    -%
    auto member = [&](const char *suffix) -> GroupItem* {
        char name[128];
        ::snprintf(name,sizeof name,"%s%s",op->groupBody->tag,suffix);
        GroupItem *m = op->getMember(name);
        return m ? m : op; };
    GroupBody *tb = target->groupBody;
    if ( tb->flags.binType )                                    return member("struct");
    if ( tb->flags.data )                                       return target->checkOP(op);
    if ( tb->flags.hasMembers )                                 return member("struct");
    if ( !arg )                                                 return op;
    if ( isLIST(arg->groupBody->flags.binType) )                return member("isSTRING");
    if ( arg->groupBody->flags.data )                           return arg->checkOP(op);
    return member("struct");
    %-
}


// printField print the field passed in to the buffer passed in, in its data type's default format
extern void printField(GroupItem field,String format,Buffer buffer)
{
    if isMethod     field = method(field);
    if !field       field = falseResult;
    or isGROUP      field = group;
    switch(data) {
        case isCOUNT:
            if !format  format = "%d";
            print(buffer) gCount;
        case isNUMBER:
            if !format  format = "%.1f";
            print gNumber;
        case isSTRING:
        case isTOKEN:
            if !format  format = "%s";
            print text;
        case 0:
        default:
            if !format  format = "%s";
            print text; }
    if useDefaultSpace  append(' ');
}


// processAction run a cached BlocK for an action, or for a rule with its label's contents bound to its locals; locals are cleared at entry
extern GroupItem processAction(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = ruleSTUFF;
GroupItem   label = field,
            code,
            grup,
            result,
            priorMETHOD = currentMETHOD,
            priorTempField = tempField,
            action = field;
    if isLabel      action = rule;
    currentMETHOD   = action;
    if !action.actionBlocK() && !processCode(action,action.actionHolder())  return null;
    // labelToLocals a rule's locals take the label's contents; isLabel fields are not cleared below
    if isRule {
        code = action.actionBody();
        while result = code.nextAttribute(result) {
            if result.noPrint continue;
            if grup = label[result.tag] {
                result.group    = grup;
                result.isLabel  = true; }
            else    result.clear(); }}
    if result = action.actionBlocK() {
        if isRule   action = code;
use grup
        // argumentExempt the argument is exempt from the entry clear -- runAction bound it before calling here
        while grup = action.nextAttribute(grup)
            if isLocal && !isLabel && !noPrint && !isArgument && groupBody != action.groupBody clear();
        if result = result.gMethod(result)  result.isBranch = 0; }
    currentMETHOD   = priorMETHOD;
    tempField       = priorTempField;
    return result;
}


// processCode parse an action's CodE into a BlocK and attach it; the field is made an action FIRST, or a recursive call would complain
extern int processCode(GroupItem field,GroupItem holder)
{
GroupRules  ruler = groupRules;
GroupItem   blockRULE = grokking/BlocK,
            code,
            result,
            priorMETHOD = currentMETHOD,
            action = field;
int         indenter = lastIndent;
int processing  = processingCode;
use field
    // d2Tripwire an rStuff-less label is WRECKAGE, not a specimen (Ruling D2) -- refuse loud here, where it became visible
    if isLabel && !rStuff {
        cerr "processCode: REFUSING " tag " -- isLabel with no rStuff. Only a live parse mints a label (Ruling D2), so this node is wreckage, not a specimen; look upstream at whatever copied or hand-built it.":;
        return false; }
    if isLabel  field = rule;
    // staleIR re-parsing invalidates the action's IR record -- setText, never clear(), or it reads back as its tag
    -%
    GroupItem   *staleIR = field->get("JiT");
    if (staleIR)    staleIR->setText(::strdup(""));
    %-
    code      = holder.getAttribute("CodE");
    if isRule action = code;
    currentMETHOD   = action;
    lastIndent      = 0;
    processingCode  = true;
    // compileIsADrive the compile is a DRIVE: BlocK's generated parse when it carries one, the old road otherwise, on a floor either way -- a compile after parser() used to refuse (F-128)
    // compileOwner the ONE writer of gCompileOwner: aCTionNamE mints the body's names into this action, never into the grammar face a generated body makes current (SEQ 214)
    -% GroupItem *priorOwner = gCompileOwner; gCompileOwner = action; %-
    result = driveStep(code,blockRULE,null);
    -% gCompileOwner = priorOwner; %-
    if result {
        result.noPrint  = true;
        holder.addAttribute(result);
        field.isAction = true; }
    else    reportCodeFail(field);
    if !processing  processingCode = false;
    lastIndent      = indenter;
    currentMETHOD   = priorMETHOD;
    if result       return true;
    return false;
}


// refuse THE ONE FUNNEL: print the line, arm the unwind, hand back null -- a refusal ends the activation that raised it
extern GroupItem refuse(GroupItem subject,String why)
{
GroupRules  ruler = groupRules;
String      name = "(none)";
    if subject      name = subject.tag;
    // theLine sourceLINE is where the PARSER is, stale for a cached body -- no usable per-statement line exists; do not chase it
    cerr "REFUSED " name " -- " why " [line " toStringFromInt(sourceLINE) "]":;
    ruler.refused = 1;
    return null;
}


// refuseArgRebind a := or <- on the argument refuses by name, tested BEFORE the follow, which destroys the evidence; 1 when it refused
extern int refuseArgRebind(GroupItem op,GroupItem target)
{
    -%
    if ( !op || !target || !target->groupBody->flags.isArgument ) return 0;
    void *gop = (void*)op->groupBody->gOp;
    if ( gop != (void*)&opSetGroup && gop != (void*)&opRebind ) return 0;
    char why[192];
    ::snprintf(why,sizeof(why),
        "`%s` on argument -- argument is a BINDING, not a field; rebind is the caller's job",
        op->groupBody->tag);
    ::refuse(target,why);
    return 1;
    %-
}


// refuseUnknownOperator an operator registered in Operators with no operateMethod refuses by name; a rule, action or value reaching the foot is untouched
extern GroupItem refuseUnknownOperator(GroupItem op,GroupItem target)
{
    -%
    if ( !op || op->groupBody->registry != GroupControl::groupController->groupRules->opFields ) return 0;
    char why[224];
    GroupItem *who = target ? target : op;
    ::snprintf(why,sizeof(why),
        "operator '%s' has no road -- the token is registered in Operators with no operateMethod, so this statement would change nothing",
        op->groupBody->tag ? op->groupBody->tag : "(unnamed)");
    return ::refuse(who,why);
    %-
}


// reportCodeFail WHERE a code body failed to parse -- rule, position and line, on cerr because print may be diverted
extern void reportCodeFail(GroupItem field)
{
GroupRules  ruler = groupRules;
    cerr "ERROR processCode: " field.tag,"parse failed":;
    cerr "    failed at " getDebugText(failedAt, 40):;
    cerr "    on line " toStringFromInt(sourceLINE):;
}


// reportDrive driveStep's report: three counts, offsets into the message
extern void reportDrive(GroupItem report,GroupItem rule,String driveBase)
{
GroupRules  ruler = groupRules;
RuleStuff   stuff = rule.rStuff;
GroupItem   num;
String      failed;
int         driveLen = strlen(driveBase),
            atOffset = -1,
            failOffset = -1;
    if ruler.atRuleMark >= driveBase && ruler.atRuleMark <= driveBase + driveLen    atOffset = (int)(ruler.atRuleMark - driveBase);
    if stuff    failed = stuff.failedAt;
    if failed && failed >= driveBase && failed <= driveBase + driveLen  failOffset = (int)(failed - driveBase);
    num         = new("length");
    num.count   = driveLen;
    report.addAttribute(num);
    num         = new("mark");
    num.count   = atOffset;
    report.addAttribute(num);
    num         = new("failedAt");
    num.count   = failOffset;
    report.addAttribute(num);
}


// reportMaxLimit a match hit the maxLimit ceiling with input still matching -- REFUSE rather than truncate; callers gate on max > 1 && !limitsSet
extern int reportMaxLimit(GroupItem field)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = field.rStuff;
    cerr "REFUSED match limit: rule " ruleStuff.ruleName " term " field.tag:;
    cerr "    hit maxLimit " toStringFromInt(max) " with input still matching":;
    cerr "    at " getDebugText(atRuleMark, 40):;
    return 0;
}


// reportNoBody a rule reached through a bound parse method has no compiled body -- a sibling of reportCodeFail, never a reuse of it
extern void reportNoBody(GroupItem field)
{
GroupRules  ruler = groupRules;
    cerr "REFUSED parseRule: " field.tag,"has a parse method but no compiled body":;
    cerr "    at " getDebugText(atRuleMark, 40):;
}


// reportRepeatLimit a rule repeated to its ceiling -- REPORTS and does not fail; the counts are passed in because rStuff may be a reentrancy clone's
extern int reportRepeatLimit(GroupItem rule,int kounted,int limit)
{
GroupRules  ruler = groupRules;
    cerr "REFUSED repetition limit: rule " rule.tag:;
    cerr "    repeated " toStringFromInt(kounted) " times, hit repeatLimit " toStringFromInt(limit):;
    cerr "    at " getDebugText(atRuleMark, 40):;
    return 0;
}


// restoreLocalFields restore what saveLocalFields banked, at the end of a nested call
extern void restoreLocalFields(GroupItem action)
{
Stak        recurseSTAK;
GroupBody   body;
GroupItem   frame,
            grup;
    frame = frameFind(action);
    if frame    recurseSTAK = frame.stak;
    // identityPair restore pairs by identity, never by position -- walk the STACK, not the field list, with no filter of its own
    // nullArm restore is reached where save never ran (the jit bracket among them); no frame child means nothing was saved
    if !recurseSTAK             action.recursive = false;
    or !recurseSTAK.length      action.recursive = false;
    else
    while body = recurseSTAK.pop() {
        grup = recurseSTAK.pop();
        *grup.groupBody = *body;
        body = 0; }
}


// ruleMethod bind the method the attribute's text names, found with dlsym -- as the parent's method for ruleMethod, else as its operator
extern GroupItem ruleMethod(GroupItem input)
{
String  name = text;
use input
    if input.fLAG
        if name {
            GroupItem   grup = parent;
            if grup {
                if input.tag == 'r' {
                    method = dlsym(RTLD_SELF,name);
                    isMethod = true; }
                else {
                    setOperat(dlsym(RTLD_SELF,name));
                    isOperator = true; }
                if instructType     grup.immediateACTION = true;
                else    cerr "ruleMethod: could not find method:",name:; }}
        else    cerr "ruleMethod: expected a method name in ruleMethod text":;
    else    cerr "ruleMethod: should be invoked as an attribute when its parent is defined":;
    return group;
}


// runAction run an action that may need code processing -- two arms, the jit arm and the interpreted one, each returning through its own exit
extern GroupItem runAction(GroupItem argument,GroupItem field)
{
GroupRules  ruler = groupRules;
GroupItem   result = null,
            capture,
            ruleArg;
use field
    if isCoded
        if !processCode(field,field)  goto exitRunAction;
    // lastREF a no-argument call leaves the action in lastREF
    lastREF.group = argument ? argument : field;
    // mint argument is a runtime-minted binding slot, never a declared attribute -- above the jitting gate because BOTH ROADS need it flagged
    ruleArg = field["argument"];
    if !ruleArg     ruleArg = field += "argument";
    ruleArg.isArgument = true;
    if jitting {
        if jitEmitSelfCall(argument, field) {
            result = field;
            goto exitRunAction; }
        // jitBind an INLINED callee is walked here at emit time, so the emit-time bind is this arm's; an emitted call binds in jitBindArgRT
        ruleArg.group = argument;
        jitInlinePush(field);
        result = processAction(field);
        jitInlinePop(result);
        goto exitRunAction; }
    // bindOrder save before bind so the outer activation gets its slot back
    saveLocalFields(field);
    ruleArg.group = argument;
    // chanCount chanT's pair, SAME MUST EQUAL BINDS -- passthrough because the check is pointer identity, which == is not
    -%
    GroupControl::groupController->groupRules->chanBinds++;
    if ( ruleArg->groupBody->gGroup == argument ) GroupControl::groupController->groupRules->chanSame++;
    %-
    result = processAction(field);
    if result {
        capture = new(result.tag);
        capture.setContent(result);
        result  = capture; }
    restoreLocalFields(field);
exitRunAction:
    // refusalArm activation-scoped: a refusal ends the action that raised it and NOT its caller, which gets a testable null
    if ruler.refused {
        clearRefusal(result);
        result = null; }
    return  result;
}


// runOP the operator dispatch hub: follow the argument, honour the arm, resolve the operands, then fire the op, a rule, an action or a method
extern GroupItem runOP(GroupItem field)
{
GroupRules  ruler = groupRules;
GroupItem   result,
            op      = field[1],
            arg     = field[3],
            target  = field[2];
    // argBinding argument is a BINDING: a rebind of it refuses, then an isArgument operand yields what it holds
    if refuseArgRebind(op,target)   return null;
    target  = followArgument(target);
    arg     = followArgument(arg);
    // storeRuling an armed statement dispatches nothing further, stores included -- interpreted only, emit time must reach every statement
    if ruler.refused
        if !jitting     return null;
    if op.instructType && target.isMethod && target.invoke  target = target.method(target);
    if arg
        if arg.isMethod && arg.invoke                       arg = arg.method(arg);
    // listOperand a list operand is never resolved here -- that would hand the list operators a copy
    // virtualFork UNGATED ON PURPOSE -- gated on defining, the bytecode emit path would mutate the shared prototype
    if target && target.isVirtual   target = copyOf(target);
    // perKindPick one spelling, pickKindOP, on both roads; under jitting the pick is EMITTED as a run-time call-through, never made here
    if op.hasMembers {
        if jitting      return jitEmitOpFire(op,arg,target);
        op = pickKindOP(op,target,arg); }
    // seedBothArms a unary is isUnary and isMethod, never isOperator -- seed on isOperator alone and jitEmitUnary segfaults
    if jitting && (op.isOperator || op.isUnary)     jitSeedOperands(target,arg);
    // slotFork an op with an emitter slot is migrated, one without cannot tell -- there is no default emitter, ever
    -% if ( ::jitSlotTaken(op) ) return op->groupBody->gJitEmitter(arg,target); %-
    // dispatchSeat which node the name reached, and which arm the fork will take
    measureRuleDispatch(op,target,arg);
    // doorByRoad interpreted, runRule for isRule only; jitting, a term call for isRule OR hasNewParse, so no bin is parsed at emit time (F-123)
    if op.isOperator                result = op.operat(arg,target);
    or op.isMethod                  result = op.method(target);
    or target.isRule || (jitting && target.hasNewParse) {
        -%
        if ( ruler->jitting )   result = ::jitEmitTermCall(field);
        else                  { ++gTermCallCount; result = ::runRule(arg,target); }
        %-
    }
    or target.actionType            result = runAction(arg,target);
    or target.isMethod {
        if !arg arg = target;
        result = target.method(arg); }
    else    result = refuseUnknownOperator(op,target);
    return result;
}


// runRule the drive step with no report; a generated root hands back its label, and the kant caller gets one bit
extern GroupItem runRule(GroupItem field,GroupItem rule)
{
GroupRules  ruler = groupRules;
GroupItem   result = driveStep(field,rule,null);
    // oneBit a generated root hands driveStep its LABEL; the kant caller still gets the chain's truth (ruling c')
    if rule.hasNewParse && result && result != falseResult     return trueResult;
    return result;
}


// runShortCircuit TIER 3: AND/OR/|| skip the right arm, which runOP would already have fired -- a sibling of runOP, bound at tree build by interpretXP
extern GroupItem runShortCircuit(GroupItem field)
{
GroupItem   op      = field[1],
            target  = field[2],
            arg     = field[3];
int         leftIsTrue;
    // phaseGate emit time never enters a run-time handler for its value -- and the floor is a REFUSAL, never a fall-through
    if jitting {
        -% return jitEmitShortCircuit(field); %-
    }
    if op.instructType && target.isMethod && target.invoke   target = target.method(target);
    leftIsTrue = truthOf(target);
    // theSkip the right arm is never touched on these two paths -- only COUNTING proves it, a value assertion cannot
    // skipByRegistration the skip direction is a REGISTRATION (opIsOR), never a spelling -- `||` matched neither tag test
    if !opIsOR(op)  && !leftIsTrue      return falseResult;
    if opIsOR(op)   &&  leftIsTrue      return trueResult;
    if arg && arg.isMethod && arg.invoke            arg = arg.method(arg);
    if truthOf(arg)     return trueResult;
    return falseResult;
}


// saveLocalFields save an action's argument and locals before a nested call, so each activation starts from its own state
extern void saveLocalFields(GroupItem action)
{
Stak        recurseSTAK;
GroupBody   body;
GroupItem   frame,
            grup;
    frame = frameStak(action);
    if !frame.isSTAK {
        recurseSTAK = new;
        frame.stak = recurseSTAK; }
    else    recurseSTAK = frame.stak;
    // frameFloor null pushed so restore stops at ITS OWN floor
    recurseSTAK += null;
    while grup = action.next(grup)
        if (grup.isArgument || grup.isLocal) && !grup.noPrint {
            body    = new;
            *body   = *grup.groupBody;
            if !grup.isArgument {
                grup.clearData();
                grup.groupList      = 0;
                grup.hasAttributes  = 0;
                grup.hasMembers     = 0; }
            // identityPair the field goes on with its body
            recurseSTAK += grup;
            recurseSTAK += body; }
}


// setCompiledMethod set the block's method by passing the method name to dlsym
extern int setCompiledMethod(GroupItem block,String name)
{
void*       methodAddress;
    if name
        if methodAddress = dlsym(RTLD_DEFAULT,name) {
            block.method    = methodAddress;
            return true; }
        else cerr :`"setCompiledMethod: ERROR no method found",name;
    cerr :`"setCompiledMethod: failed for",block.tag:;
    return false;
}


// setRuleAction link the action the block references and set its method type -- on the rule the block names, else on the block; returns the rule
extern GroupItem setRuleAction(GroupItem block)
{
GroupItem   item    = block ? block.parent : 0;
String      name;
    if item {
        if !method {
            if block.data {
                name = block.text;
                block.text = 0; }
            else {
                name = item.text;
                item.text = 0; }
            if name         setCompiledMethod(item,name); }
        if method {
            if block.tag eq "immediateAction"
                immediateACTION   = true;
            or block.tag eq "parseAction"
                setParseAction(method); }
        else cerr "setRuleAction: could not set action for",block.tag:; }
    else cerr "setRuleAction: could not set action target":;
    return item;
}


// statementMatches statement equivalence: v1 is a top-level GroupItem.matches; a recursive walk is the v2 candidate
extern int statementMatches(GroupItem a,GroupItem b)
{
    return a.matches(b);
}


// verdictCount add one named count to a verdict
extern void verdictCount(GroupItem verdict,String name,int value)
{
GroupItem   num = new(name);
    num.count   = value;
    verdict.addAttribute(num);
}


// wrapped quote output text for printing when it holds a space
extern String wrapped(GroupItem input)
{
String junkText = text;
    if isTOKEN || isSTRING || isFile
        if spaceSet.foundIn(junkText)
            if contains(junkText,'"')  junkText = "'" junkText "'";
            else    junkText = "\"" junkText "\"";
    return junkText;
}
