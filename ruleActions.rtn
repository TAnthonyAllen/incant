
/*******************************************************************************
	The ANYtoken rule action excludes key words and undefined token fields
*******************************************************************************/
extern GroupItem aCTionANYtoken(GroupItem input)
{
GroupItem   token;
    if input.isGROUP    token = input.group;
    else                token = input;
    if !compiling && token && registry == keyWords && !noPrint      return null;
    return input;
}

/*******************************************************************************
	The BlocK rule action.

    // bareReturnValue A BARE `return;` YIELDS THE PRIOR STATEMENT'S VALUE, not the keyword's tag, and the substitution MUST re-stamp isBranch or every break and continue dies.
*******************************************************************************/
extern GroupItem aCTionBlocK(GroupItem input)
{
int         broke = 0;
GroupRules  ruler = groupRules;
GroupItem   grup,
            result,
            prior;
    while grup = input.next(grup) {
        prior = result;
        if grup.isMethod    result = grup.gMethod(grup);
        else                result = grup;
        /*  THE RESULT SLOT (Tony's ruling, 2026-07-31). Under jitting, every
            statement commits the value it just emitted. That is not a
            convenience: the interpreted rule is "an action's value is the LAST
            EXECUTED STATEMENT'S", so a store-on-`return` emitter would return
            garbage from every action that simply ends. Storing per statement is
            what makes the compiled answer match the interpreted one.  */
        if jitting {
            -% jitStoreResult(); %-
            //  A3 + the statement-local gate: the check is emitted only for a
            //  statement that can actually refuse at RUN time, and the flag is
            //  cleared here so it cannot leak into the next statement.
            -% jitEmitRefusedCheck(); gJitStmtCanRefuse = false; %-
        }
        /*  ⚠ A REFUSAL STOPS THE BLOCK, and the jitting arm must NOT stop the
            EMIT walk -- same era split as the isBranch check below, and the
            same reason: at emit time the statements after a refusal are
            REACHABLE and must all be emitted. The emitted body does its own
            per-statement check at RUN time.   ruleActions.aCTionBlocK.refusalArm  */
        if ruler.refused
            if !jitting     broke = 1;
        if broke == 1       break;
        if result && result.isBranch {
            if prior && result.isBranch == 3 && result.registry == keyWords {
                result = prior;
                result.isBranch = 3; }
            // ⚠ DO NOT let this break run under jitting -- it stops the COMPILER'S walk and
            // emitWalkMustNotStop every statement after a branch vanishes from the IR
            if jitting  continue;
            broke = 1;
            break; }}
    if result && result.isGROUP  result = result.gGroup;
    /*  ⚠ A BLOCK THAT RAN TO THE END AND YIELDED NOTHING SUCCEEDED AND HAS NO VALUE --
        which is labelNO, not null. NULL means FAILED (GroupControl.twk:158), and
        aCTionWhilE/DO/FOR all end `if !result result = labelNO;` for exactly this. This
        one did not, so a body whose last statement yielded nothing handed back null and
        aCTionWhilE's `else break;` read it as "stop".
        ⚠ IT WAS INVISIBLE WHILE BlocK's CURLIES CARRIED LABELS: the trailing rightCurly
        was the block's value on every iteration, so no block ever handed back null and
        the loop could not stop that way. Honouring the noLabel dash removed the sentinel
        and left the channel -- value and continue-signal on one slot -- exposed.
        ⚠ BROKE IS THE SECOND CHANNEL, and it is the whole repair: a block that BROKE on
        a refusal or a branch still hands back what it had, because there null means
        failed and that is true.   ruleActions.aCTionBlocK.ranOutIsLabelNo  */
    if !result
        if broke == 0   result = labelNO;
    // measureBlockResult what the block hands back, and whether it is a value or a signal
    measureBlockResult(input,result,broke);
    return  result;
}

/*******************************************************************************
	Rule action for Braced rule.
        Braced      leftBrace="["- ExpressioN rightBrace="]"-;
*******************************************************************************/
extern GroupItem aCTionBraced(GroupItem input)
{
GroupItem ExpressioN:;
    input.clear();
    input.group = ExpressioN;
    input.fLAG  = true;
    return input;
}

/*******************************************************************************
	Rule action for BrancH.
*******************************************************************************/
extern GroupItem aCTionBrancH(GroupItem input)
{
GroupItem   BrancheS:,
            ExpressioN:;
GroupItem   arg = ExpressioN;
    if !arg         arg = BrancheS;
    or isMethod     arg = arg.gMethod(arg);
    // ke3NullOperand under jitting that method is an emitter and a null arg means I REFUSED
    if !arg         arg = BrancheS;
    switch(*BrancheS.tag) {
        case 'b':   isBreak     = true;
        case 'c':   isContinue  = true;
        case 'r':   isReturn    = true; }
    // branchesUnderJit break and return DEGRADE LOUDLY here rather than emitting nothing, and the tag
    // returnEmitNow
    if jitting {
        if BrancheS.tag == 'c'          jitEmitContinue();
        or BrancheS.tag == 'r' {
            // branchReturnPosition
            if ExpressioN && !isMethod  jitEmitBareRead(ExpressioN);
            if jitEmitReturn() < 0  jitDegrade("return REFUSED -- no builder, no epilogue block, or  inlining with no frame. A mis-sequenced caller", input); }
        else    jitDegrade("break under jit -- no emitter yet", input); }
    return arg;
}

/*******************************************************************************
    THE STDERR SINK. One print mechanism, several destinations -- PrintXP+ is fixed
    and only the sink varies. NO `generating` branch, and that is deliberate.
    ruleActions.aCTionCerR.stderrSink
*******************************************************************************/
extern GroupItem aCTionCerR(GroupItem input)
{
GroupItem   stuff:;
Buffer      buffer = bufferSTAK.pop();
    // ⚠ MUST SIT AFTER THE WHOLE DECLARATION BLOCK -- inside one, this line wiped
    // degradeByDefault GroupRules.h's extern block to zero
    if jitting  jitDegrade("cerr under jit -- no emitter, sink fires at emit time", input);
    if !buffer      buffer = new("cerr buffer");
    appendPrintXP(stuff,buffer);
    return opCerr(input,buffer);
}

/*******************************************************************************
    CheckFor is a debugging tool. It matches its text and returns null
    if it matches so it fails even if it succeeds.
    It should be entered as a rule attribute like: CheckFor?="some text".
    It enables you to stop the parse at some arbitrary point in the input
    stream and you can modify it to do whatever before it returns (like
    turn on debugAllRules). It runs in the parse not at runtime, unlike
    the similar opDoNothing operator that runs at code execution.
*******************************************************************************/
extern GroupItem aCTionCheckFor(GroupItem input)
{
    debugAllRules = true;
    return null;
}

/*******************************************************************************
	CodE rule action Note: box boundaries defined by its left and right attributes
*******************************************************************************/
extern GroupItem aCTionCodE(GroupItem rule)
{
GroupRules  ruler   = groupRules;
GroupItem   lefty   = rule[1],
            righty  = rule[2],
            label   = rule.label;
    if lefty && righty {
        String  atInput = atRuleMark;
        String  beginBox,
                endBox;
        String  left    = lefty.text;
        String  right   = righty.text;
        while *atInput && *atInput != *left     atInput++;
        if *atInput {
            beginBox = atInput;
            atInput++;
            while *atInput && *atInput != *right    atInput++;
            if *atInput  endBox = atInput; }
        if beginBox && endBox++ {
            label.setToken(beginBox,(int)(endBox - beginBox));
            atRuleMark = endBox; }
        else cerr "CodE action failed for", rule.tag:;
        }
    else cerr "CodE action did not find left and right attributes in", rule.tag:;
    return label;
}

/*******************************************************************************
    THE EXPLICIT STDOUT SINK. print is DIVERTIBLE, cout is not -- that is the whole
    reason it exists, and routing through opCout is what closes KANT-23.
    ruleActions.aCTionCouT.stdoutSink
*******************************************************************************/
extern GroupItem aCTionCouT(GroupItem input)
{
GroupItem   stuff:;
Buffer      buffer = bufferSTAK.pop();
    // ⚠ MUST SIT AFTER THE WHOLE DECLARATION BLOCK -- inside one, this line wiped
    // degradeByDefault GroupRules.h's extern block to zero
    if jitting  jitDegrade("cout under jit -- no emitter, sink fires at emit time", input);
    if !buffer      buffer = new("cout buffer");
    appendPrintXP(stuff,buffer);
    return opCout(input,buffer);
}

/*******************************************************************************
	Immediate method for DEBUG rule
        DEBUG       "debug"- followedBy rules?=NamE+;
*******************************************************************************/
extern GroupItem aCTionDEBUG(GroupItem input)
{
GroupRules  ruler = groupRules;
GroupItem   rules:,
            GUARD,
            ALLRULES,
            grup;
int         named   = 0,
            marked  = 0;
    // debugKeywords  GUARD and ALL are TEXT, not grammar -- only this method knows them
    if rules {
        while grup = rules.next(grup) {
            if grup.text eq "GUARD" {
                GUARD   = trueResult;
                continue; }
            if grup.text eq "ALL" {
                ALLRULES = trueResult;
                continue; }
            if GUARD    debugGuard = true;
            debugged    = true;
            named       = named + 1;
            if ALLRULES marked = marked + grup.setDebug(); }
        if ALLRULES {
            if named    cerr "debug ALL marked " toStringFromInt(marked) " components":;
            else        refuse(input,"debug ALL names no rules"); } }
    else    debugAllRules = !debugAllRules;
    return input;
}

/*******************************************************************************
	Immediate method for the Define rule that defines a rule.
*******************************************************************************/
extern GroupItem aCTionDefinE(GroupItem input)
{
GroupRules  ruler       = groupRules;
GroupItem   NewGroup    = input[1],
            Attributes:,
            CodE,
            MemberS:;
GroupItem   grup,
            item;
use NewGroup
    if isGROUP  NewGroup = group;
    /*  THIS IS THE OPERATOR-NAMING SITE. An operator is written in setup as a
        quoted literal, and the swap below is what gives it its symbol as its
        NAME, so it can be matched against the input stream by spelling.
        Measured 2026-08-16 over a whole grammar bootstrap: it fires 55 times,
        every firing is an Operators registry entry, and NOT ONE is a rule. So
        it looks like dead weight beside any literal-handling change and is the
        opposite -- delete it and every operator in the language unnames itself,
        silently. It reads NewGroup, the thing being DEFINED, never the terms
        inside it, which is why labelling literal terms does not reach it.  */
    if isLiteral {
        tag    = text;
        text   = 0; }
    if NewGroup {
        /***********************************************************************
            If currentRegistry and NewGroup is not a registry, add it to the current registry.
        ***********************************************************************/
        if !registry {
            affiliation = 0;
            parent      = null; }
        if currentRegistry {
            if currentRegistry.isRule {
                NewGroup = currentRegistry += NewGroup;
                if !binType     isRule = true;
                if !rStuff      rStuff = new(NewGroup);
                // ⚠ THE PRODUCER OWNS THE INVARIANT: every live rule carries rStuff. Assert here,
                // producerOwnsInvariant loudly -- do not soften this into a consumer-side guard
                if !rStuff  cerr "REGISTER: INVARIANT BROKEN -- " NewGroup.tag " promoted to a rule in registry " currentRegistry.tag " but carries no rStuff. Every live rule must carry rStuff (Mark 3); downstream guards will now read this broken rule as a lawful specimen.":; }
            or registry != currentRegistry
                if currentDefine == NewGroup ||  !currentDefine || !currentDefine.addingMembers
                    NewGroup = currentRegistry += NewGroup; }}
        if !isRule  rStuff = 0;
       /***********************************************************************
            Process Attributes.
        ***********************************************************************/
use item
        if Attributes
            while item = Attributes.next(item)
                if noPrint && immediateACTION {
                    /*******************************************************
                        if item gets run but is not added to the new group.
                        fLAG set so method can verify it is called from a
                        definition (some commands can be run as define
                        attributes or from the command line).
                    *******************************************************/
                    parent      = NewGroup;
                    fLAG        = true;
                    method(item);
                    fLAG        = false; }
                else {
                    if tag eq "code" {
                        CodE                = item;
                        CodE.tag            = "CodE";
                        CodE.noPrint        = true; }
                    // argument was set here once; no longer, now set in runAction
                    if tag eq "argument"
                        refuse(NewGroup,"a declared `argument` attribute is retired -- delete it; runAction mints the binding slot");
                    if NewGroup.isMacro     noPrint = true;
                    isInitialized  = true;
                    if NewGroup.isRule && !item.binType && !item.isRule item.isRule = true;
                    if isRule
                        if !rStuff rStuff = new(item);
                        else {
                            rStuff = new(rStuff);
                            grup = item.parent;
                            if grup && grup.rStuff {
                                parentStuff = grup.rStuff;
                                parentLabel = grup.label; }
                            rStuff.rule    = item; }
                    grup    = NewGroup +% item; }
        /***********************************************************************
            If there is code NewGroup is flagged as coded. The code gets processed
            by processCode() the first time NewGroup is included in an expression.
        ***********************************************************************/
use NewGroup
        if CodE {
            grup            = NewGroup += "this";
            grup.isLocal    = true;
            grup.noPrint    = true;
            grup.group      = NewGroup;
            grup            = NewGroup += "tempField";
            grup.isLocal    = true;
            grup.noPrint    = true;
            if isMacro {
                CodE.gText++;
                CodE.gCount     -= 2;
                text   = CodE.text; }
            else {
                isCoded         = true;
                CodE.parent     = 0; }}
        or isMacro  cerr "ERROR: A macro definition must have code specified as its body":;
        /***********************************************************************
            Process Members.
        ***********************************************************************/
        if MemberS
            while item = MemberS.next(item) {
                GroupItem newMember = NewGroup += item;
                if isRule && rStuff && (!data || data > 3)
                    if max != 1 || min != 1 {
                        RuleStuff   fresh = new(newMember);
                        newMember.setRStuff(fresh); }}
        // ruleMethodCheck the arms are ordered, not interchangeable.
        if isRule && !parseACTION && !isREGISTRY {
            if !rStuff          rStuff = new(NewGroup);
            NewGroup.setActions(); }
    // embeddedRuleCopy embedRule() copies an embedded RULE
    if isRule && groupList
        while item = NewGroup.nextAttribute(item)
            if item.isGROUP item.embedRule(item.gGroup);
use NewGroup
    input.clearList();
    isInitialized   = true;
    if registry && !parent  parent = currentRegistry;
    if addingMembers        addingMembers = false;
    if currentDefine && currentDefine.groupBody == NewGroup.groupBody    currentDefine = null;
    input.group     = NewGroup;
    /*  refusalBoundary  IT NAMES WHAT IT REMOVES, AND IT REPORTS BEFORE IT REMOVES
        refusalBoundary  so the name is read off a field that is still in the registry.
        refusalBoundary  ruleActions.aCTionDefinE.refusalBoundary  */
    if ruler.refused {
        reportDefineRemoved(NewGroup,currentRegistry);
        if currentRegistry  currentRegistry.remove(NewGroup.tag);
        clearRefusal(NewGroup); }
    return input;
}

/*******************************************************************************
	Immediate method for DelimText rule
*******************************************************************************/
extern GroupItem aCTionDelimText(GroupItem input)
{
GroupItem   dtext:;
GroupItem   grup = dtext.firstInList;
    input.clear();
    input.text = grup.text;
    return input;
}

/*******************************************************************************
	Sets the operator method in a do statement
        DO      do- BLOCKing StatemenT while- ExpressioN SemI-;
*******************************************************************************/
extern GroupItem aCTionDO(GroupItem input)
{
GroupItem   StatemenT:,
            ExpressioN:,
            result;
    if jitting {
        -% return jitEmitDO(input); %-
    }
    do {
        result = StatemenT.gMethod(StatemenT);
        if isBranch {
            // ⚠ TRAILING-CONTINUE GUARD -- one IDENTICAL body in DO, FOR and WhilE, and NOT
            // extractable: the arms are continue/return/break over THIS loop
            // trailingContinueGuard
            if isContinue {
                result      = trueResult;
                continue; }
            or isReturn     return result;
            // BREAK IS CONSUMED HERE -- clearing isBranch is what stops the enclosing
            // breakIsConsumed block breaking too
            result.isBranch = 0;
            if result.registry == keyWords  result = 0;
            break; }}
    while ExpressioN.gMethod(ExpressioN);
    // labelNO, not falseResult: this construct executed NO statement, so it has no
    // labelNoNotFalse value -- and 0 is a value
    if !result  result = labelNO;
    return result;
}

/*******************************************************************************
	ExpressioN rule immediate action. Note: operators including unary operators
    have to preceed their arguments.
        ExpressioN      Token+ SemI?- defer;
*******************************************************************************/
extern GroupItem aCTionExpressioN(GroupItem xpList)
{
    /* Thin dispatcher over two mode-handlers (jitXP folded out 2026-06-30, JIT
       unified-emit-on-walk pivot step 1): jitting now falls through to
       interpretXP. jitRunAction still raises generating alongside jitting, so
       generating is checked first — under jitting+generating, generateXP's
       by-reference revisedList still wins; interpretXP only fires under plain
       interpretation or, going forward, under jitting-without-generating. */
    if generating   return generateXP(xpList);
    return interpretXP(xpList);
}

/*******************************************************************************
	If the parse gets here it failed.
*******************************************************************************/
extern GroupItem aCTionFailed(GroupItem input)
{
GroupItem   lastStatement = groupRules.lastStatement;
use input
    // lastCodeToCrash
    cout "Rule " tag:;
    if rStuff   cout `"Failed at:" `getDebugText(failedAt, 40):;
    if !rStuff  cout `"Failed at:  <unavailable -- this subject carries no rStuff; see Ruling D>":;
    cout `"on Line:" ``sourceLINE,:;
    // added the gText guard (for cases that do not use StatemenT
    if lastStatement.gText   cout "  Last parsed: ", lastStatement.text:;
    stopParsingInput(input);
    return input;
}

/*******************************************************************************
	Runs the action associated with a for statement
        Looper=ANYtoken;
        LoopRestrict:
            loopOnAttributes="attributes";
            loopOnMembers="members";;
        FOR         for- followedBy Looper in- reversE?="<-" ExpressioN SemI- LoopRestrict? StatemenT defer;
    At present no loopModifier condition to control loop direction???
*******************************************************************************/
extern GroupItem aCTionFOR(GroupItem input)
{
GroupRules  ruler   = groupRules;
GroupItem   Looper  = input["Looper"],
            ExpressioN = input["ExpressioN"],
            reversE = input["reversE"],
            LoopOn,
            LoopRestrict:,
            StatemenT:,
            grup,
            result;
int         restrict;
    // ⚠ MUST SIT AFTER THE WHOLE DECLARATION BLOCK -- inside one, this line wiped
    // degradeByDefault GroupRules.h's extern block to zero
    if jitting  jitDegrade("FOR under jit -- no emitter (iterate's disease, different keyword)", input);
    if Looper.isGROUP       Looper = Looper.group;
    Looper.clear();
    if LoopRestrict {
        String restriction = LoopRestrict.text;
        if restriction eq "attributes"  restrict = 1;
        or restriction eq "members"     restrict = 2; }
    LoopOn = ExpressioN;
    while LoopOn.isGROUP {
        LoopOn = LoopOn.group;
        if LoopOn.groupList     result = LoopOn; }
    if !LoopOn.groupList && result  LoopOn = result;
    LoopRestrict = lastREF.group;
    while grup = reversE ? LoopOn.prior(grup) : LoopOn.next(grup) {
        result = 0;
        Looper.group = grup;
        if restrict && grup.affiliation != restrict   continue;
        if !LoopOn.byRef {
            lastREF.gGroup  = grup;
            lastREF.isGROUP = true; }
        result = StatemenT.gMethod(StatemenT);
        if byRef    grup = result.priorInParent;
        if isBranch {
            // ⚠ TRAILING-CONTINUE GUARD -- one IDENTICAL body in DO, FOR and WhilE, and NOT
            // extractable: the arms are continue/return/break over THIS loop
            // trailingContinueGuard
            if isContinue {
                result      = trueResult;
                continue; }
            or isReturn     return result;
            // BREAK IS CONSUMED HERE -- clearing isBranch is what stops the enclosing
            // breakIsConsumed block breaking too
            result.isBranch = 0;
            if result.registry == keyWords  result = 0;
            break; }}
    // labelNO, not falseResult: this construct executed NO statement, so it has no
    // labelNoNotFalse value -- and 0 is a value
    if !result  result = labelNO;
    if LoopRestrict
        if !LoopRestrict.byRef {
            lastREF.gGroup  = LoopRestrict;
            lastREF.isGROUP = true; }
        else                    lastREF.clear();
    return result;
}

/*******************************************************************************
	IF rule action
        IF=if ExpressioN ';'? StatemenT ElsE?;
*******************************************************************************/
extern GroupItem aCTionIF(GroupItem input)
{
GroupItem   ExpressioN:,
            StatemenT:,
            ElsE:;
GroupItem   result = ExpressioN;
    if jitting {
        -% return jitEmitGIF(input); %-
    }
    if isMethod result = result.gMethod(result);
    else        result = ExpressioN;
    // ifRefuseLoudly
    if truthOf(result) && !StatemenT {
        cerr "aCTionIF: REFUSING -- the condition parsed but its governed "
             "statement is MISSING. Common causes: a // between the condition "
             "and the statement (bear-trap #4), an `if <cond>;` with no "
             "statement at all, or a rule named in the condition consuming the "
             "statement as its input.":;
        return falseResult; }
    if truthOf(result)  result = StatemenT.gMethod(StatemenT);
    or ElsE     result = ElsE.gMethod(ElsE);
    // labelNoNotFalse if this executed NO statement, it has no value, hence labelNO
    if !result  result = labelNO;
    return result;
}

/*******************************************************************************
	The rule action for the Iterate rule
        Iterate     iterate- ANYtoken on- ANYtoken attributes? members? defer;
*******************************************************************************/
extern GroupItem aCTionIterate(GroupItem input)
{
GroupItem   attributes:,
            members:,
            IterSource:;
GroupItem   iterator = unWrap(input[1]);
GroupItem   source;
    // You cannot get here without an iterator, the rule stipulates it
    if IterSource {
        // SOURCE REACHED BY LABEL, NEVER BY POSITION
        GroupItem srcOp = IterSource.getLabelGroup("UnaryOPS");
        if source   = srcOp ? IterSource[2] : IterSource[1]
        if source.isGROUP   source = source.group;
        if srcOp
            if srcOp.tag eq "*" source = opDeref(source);
            else source = refuse(source,"iterate: only * may precede the source"); }
    if !source {
        // nullAfterStar    THE CONSUMER OF THE NULL REFUSES
        iterator.fLAG = 1;
        return      refuse(IterSource,"iterate: the source is nothing -- a star on a field that holds no group yields null"); }
    or isGROUP {
        // argumentBINDING
        if isArgument   source = source.group;
        else {
            String why="iterate: it holds a pointer, not a list; write *" source.tag;
            iterator.fLAG = 1;
            return refuse(source,why); }}
    if jitting {
        // emitThenFallThru -- the only gate in the tree that does not return, and deliberately so.
        jitEmitIterate(input); }
    if iterator && source && groupList {
        // RESETiterator iterator gets a copy of the source groupList
        iterator.groupList  = groupList;
        iterator.fLAG       = false; }
    else {
        // refusedSource A REFUSED SOURCE IS ANNOUNCED AND POISONED -- the poison is only thing between a refused iterate and an unbounded loop
        iterator.fLAG       = true;
        return      refuse(source,"iterate: the source has no list"); }
    // attributes and members filter overloaded on hasAttributes and hasMembers
    if attributes   iterator.hasAttributes = true;
    else            iterator.hasAttributes = false;
    if members      iterator.hasMembers = true;
    else            iterator.hasMembers = false;
    iterator.isIterator     = true;
    return  iterator;
}

/*******************************************************************************
    BEAR COUNTRY: the virtual fork below is define-gated ON PURPOSE. Forking a
    virtual outside a defining context silently reads 0 and writes to a copy.
    ruleActions.aCTionNamE.bearCountryVirtual
*******************************************************************************/
extern GroupItem aCTionNamE(GroupItem input)
{
GroupRules  ruler = groupRules;
GroupItem   action = currentMETHOD;
GroupItem   grup;
GroupItem   result;
String      arg = input.text;
    result = locateInMethod(arg);
    if result && result.parent == action  goto endName;
    if defining && result && result.isVirtual    result = copyOf(result);
    grup    = new(arg);
    if alphaSet.contains(*arg) && processingCode
        if !result || (!isArgument && !isLocal)
            if !(result && registry == opFields)
                if result
                    if action.isRule && isRule {
                        result  = action +% grup;
                        isLocal = true; }
                    else    result = action +% result;
                else {
                    result  = action +% grup;
                    isLocal = true; }
    if !result  result = grup;
endName:
    input.group = result;
    return input;
}

/*******************************************************************************
	The NewGroup action just sets the currentDefine field in GroupRules so
    that the MEMBERs case in processFlags can find it to set its addingMembers flag
*******************************************************************************/
extern GroupItem aCTionNewGroup(GroupItem field)
{
GroupRules  ruler = groupRules;
GroupItem   grup = group;
    if !currentRegistry.isRule && !currentDefine    currentDefine = grup;
    return field;
}

/*******************************************************************************
	immediate method for the incant Number rule.
        NumbeR=[0-9]+               FloaT?:
            HeX='0'                 x=[xX] value=[0-9a-fA-F]+;;
        FloaT='.'                   float=[0-9]+ PoweR?;
        ⚠ The `tokenize` terms this shape used to carry were stripped
        2026-09-02 when tokenize retired. The flattening they describe still
        happens -- it is now the `tokened` bit and captureSpan. HeX is parked.
*******************************************************************************/
extern GroupItem aCTionNumbeR(GroupItem input)
{
String  arg = input.text;
    if arg
        {
        // KANT'S NUMERIC TOWER IS count AND double. NO FLOATS, EVER -- a decimal point
        // numericTower mints isNUMBER here, at the literal's birth, and nothing rounds it
        String  scan        = arg;
        int     sawDecimal;
        while *scan {
            if *scan == '.'     sawDecimal = true;
            scan++; }
        if sawDecimal   input.number = atof(arg);
        else            input.count  = atoi(arg);
        input.isLiteral = true;
        }
    return input;
}

/*******************************************************************************
	Rule action for Parens rule.
        Parens      leftParen="("- ExpressioN? rightParen=")"-;
*******************************************************************************/
extern GroupItem aCTionParens(GroupItem input)
{
GroupItem ExpressioN:;
    input.clear();
    if ExpressioN   input.group = ExpressioN;
    return input;
}

/*******************************************************************************
	Immediate method for the Print rule or the StringXP rule.
        ToBuffer=">"    NamE@;
        PrinT           print ToBuffer? stuff=ExpressioN+  SemI-;
        StringXP        string stuff=ExpressioN+ ruleMethod=aCTionPrinT;
*******************************************************************************/
extern GroupItem aCTionPrinT(GroupItem input)
{
GroupRules  ruler   = groupRules;
GroupItem   stuff:;
GroupItem   grup;
    /***********************************************************************
        Generating branch — currently UNUSED on the bytecode print path
        (gPrinT passes the statement to bcPrint; runPrint calls aCTionPrinT
        with generating false). Kept (a) because it's the future home for real
        operand compilation and (b) because its presence keeps stuff: resolving
        to `input` in codegen. Never entered while generating is false.
    ***********************************************************************/
    if generating {
        GroupItem   revisedList = new("revisedList");
        while grup = stuff.nextAttribute(grup) {
            use grup
            if noPrint  continue;
            GroupItem   FormaT:,
                        ExpressioN:,
                        result;
            if ExpressioN   result = ExpressioN;
            else            result = grup;
            -%
            %-
            if FormaT   result += FormaT;
            revisedList += result; }
        input.group = revisedList;
        return input; }
    // ⚠ THE EMIT-TIME WALK MUST BE EFFECT-FREE -- a print that fires at compile time
    // jittedPrint is worse than one that does not print, because it appears to work
    // ⚠ CALLED AT tok LEVEL, NOT FROM PASSTHROUGH -- as passthrough this hit both
    // emittersAtTokLevel bear-trap #13 and the type-alias hazard at once
    if jitting {
        jitPrintOpen(input);
        while grup = stuff.nextAttribute(grup) {
            use grup
            jitPrintProbe(grup,0);
            if noPrint  continue;
            GroupItem   FormaT:,
                        result,
                        ExpressioN:;
            if ExpressioN {
                jitPrintArm();
                jitPrintProbe(ExpressioN,1);
                /*  A MULTI-PART OPERAND is classified per part by constancy --
                    see jitPrintList. Mentioning ExpressioN here also keeps the
                    bare `isMethod` below bound to it (last-mentioned wins), which
                    is the hazard this walk already paid for once.  */
                if ExpressioN.isLIST    jitPrintList(ExpressioN,FormaT);
                else {
                /*  EMIT THE EXPRESSION through the existing emitters -- they
                    leave the SSA value in gJitResult, which jitPrintItem picks
                    up. No expression emitter is written or duplicated here.  */
                if isMethod result = method(ExpressioN);
                else {
                    /*  ⚠ A BARE OPERAND. appendPrintXP's `else` branch makes NO
                        CALL -- interpreted that is fine, because appendGroup
                        then reads the field's own storage. Jitted, reading the
                        field's own storage is exactly what we cannot do, and
                        nothing had ever emitted a value here. This is the
                        missing primitive, and it is why a jitted print carried
                        a constant 0. (R3's printout, 2026-08-05.)  */
                    result = ExpressioN;
                    jitEmitBareRead(ExpressioN); }
                jitPrintProbe(result,2);
                /*  SAME NODE-ENTRY RULE AS jitPrintList's method arm: when the
                    emitted op produced a GroupItem, hand the chain the NODE and
                    let it format by the node's real datA at run time. The
                    emitter cannot type the result -- opDot's gate returns before
                    its interpreted body -- and guessing prints `taG` as a
                    number. jitPrintNode clears the channel it consumes.  */
                if jitNodeInFlight()    jitPrintNode(FormaT);
                else                    jitPrintItem(grup,FormaT,1); }}
            else {
                jitPrintProbe(grup,3);
                jitPrintItem(grup,FormaT,0); }}
        jitPrintClose(input);
        return input; }
Buffer      buffer = bufferSTAK.pop();
    if !buffer      buffer = new("print buffer");
    isPRINTING      = false;
    appendPrintXP(stuff,buffer);
    return opPrint(input,buffer);
}

/***************************************************************************
    QuotE rule action
        QuotE       tik=['"] isRule quoteBody}=tik;
***************************************************************************/
extern GroupItem aCTionQuotE(GroupItem input)
{
GroupItem   tik:,
            quoteBody:;
String      body = text;
use input
    clear();
    quoteBody.clear();
    if tik.gText != '"'
        if tik = opFields[body] group = tik;
        else {
            if strlen(body) == 1     character = *body;
            else    text = body;
            isLiteral = true; }
    else {
        text = body;
        isLiteral = true; }
    return  input;
}

/*******************************************************************************
	runs the rule passed in, returns the rule result if it succeeds.
*******************************************************************************/
extern GroupItem aCTionRunRulE(GroupItem input)
{
GroupItem   argument,
            InvokE:,
            rule = input[1];
    if rule
        {
        rule = group;
        input.clear();
        if InvokE
            if argument = InvokE[1]
                if argument.isGROUP argument = argument.group;
        if !isRule
            {
            input   += rule;
            if rule.isMethod    input.method = rule.method;
            if argument input += argument;
            if input.isMethod
                if argument     input.method(argument);
                else            input.method(rule);
            else    cerr "RunRulE: expected a method not", rule.tag:;
            }
        else rule   = runRule(argument,rule);
        }
    return input;
}

/***************************************************************************
    Process a scope expression. It is a convenient way to set local fields.
    The first field in the scope list becomes the lookin field searched for
    the fields that follow. Fields then found update local fields. The
    respective local fields then point to the found fields.
***************************************************************************/
extern void aCTionScopeXP(GroupItem input)
{
GroupItem   action = currentMETHOD,
            field,
            listItem,
            lookin,
            scopeList:,
            grup;
String      name;
    while listItem = scopeList.next(listItem) {
        if listItem.isGROUP grup = listItem.group;
        else    grup = listItem;
        if !lookin  lookin = grup;
        else {
            name    = grup.tag;
            field   = lookin[name];
            grup    = action[name];
            if !grup {
                grup = new(name);
                grup.isLocal = true;
                action  +% grup; }
            if field {
                if field.groupBody == grup.groupBody    continue;
                if listItem.isGROUP listItem.group = field;
                grup.group = field; }
            else    grup.clear(); }}
}

/*******************************************************************************
	Search rule action. List, setStakked, add to, or reset the SearchList.
*******************************************************************************/
extern GroupItem aCTionSearch(GroupItem input)
{
GroupItem   searchLIST = searchList;
GroupItem   base,
            grup;
int         setStakked;
    // ⚠ MUST SIT AFTER THE WHOLE DECLARATION BLOCK -- inside one, this line wiped
    // degradeByDefault GroupRules.h's extern block to zero
    if jitting  jitDegrade("search under jit -- no emitter, mutates the search stack at emit time", input);
    while grup = input.next(grup)
        if tag eq "reset"  searchLIST.clearList();
        or tag eq "list"
            if !searchLIST.listLength cout "Search list is empty":;
            else {
                cout "Search list:";
                base    = 0;
                while base = searchLIST.next(base)  cout ,base.tag;
                cout :; }
        or tag eq "stack"  setStakked = true;
        or binType {
            if setStakked
                if !groupList || listLength < 10    cerr "WARNING:",tag,"list too short to stack":;
                or !stakked     stakked = new(grup);
            base = searchLIST += grup; }
        else cout "WARNING:",tag,"must be a registry to add to searchlist":;
    return input;
}

/*******************************************************************************
	Create a set from the string passed in
*******************************************************************************/
extern GroupItem aCTionSetBrackets(GroupItem group)
{
GroupItem   setText = group[1];
String      stuff = text;
PLGset      set = new(stuff);
use group
    clear();
    characterSet = set;
    return group;
}

/*******************************************************************************
	Process string shortcuts.
*******************************************************************************/
extern GroupItem aCTionShortcuT(GroupItem group)
{
    if gCount == 2 && opFields[text]    return null;
    isShortcut = true;
    return group;
}

/*******************************************************************************
	Process a statement (if we are not parsing code), otherwise return it.
*******************************************************************************/
extern GroupItem aCTionStatemenT(GroupItem input)
{
GroupRules  ruler = groupRules;
RuleStuff   ruleStuff = rStuff;
GroupItem   sourceFile = new("sourceFile");
use input
    sourceLine  = new("sourceAt");
    sourceLine.count = sourceLINE;
    sourceFile.text = sourceFILE.tag;
    sourceLine  +% sourceFile;
    if !processingCode {
        /*  ⚠ outcome IS DECLARED FIRST SO `statement` STAYS LAST-MENTIONED -- the bare
            `isGROUP` and `group` below resolve against whatever was named most recently
            (bear-trap #42), and a declaration inserted after `statement` would silently
            re-aim them.  */
        GroupItem   outcome = input;
        GroupItem   statement = input;
        if isGROUP  statement = group;
        lastStatement = statement;
        if method   outcome = method(statement);
        // statementScope  A REFUSAL'S SCOPE IS THE STATEMENT -- it is cleared HERE, on the
        // statementScope  way out, whether or not a method ran, because the refusal may have
        // statementScope  been raised during the MATCH and never reached a method at all
        clearRefusal(statement);
        return outcome; }
    or generating
        if !gText && isGROUP {
            GroupItem xpStatement = group;
            input.clear();
            text    = "gXpress";
            input   +% xpStatement; }
        or gText eq "gFOR" doNothing = 0;
    return input;
}

/*******************************************************************************
	Immediate method for the StringXP rule.
        StringXP    pound="#"- stuff=PrintXP+ defer;
*******************************************************************************/
extern GroupItem aCTionStringXP(GroupItem input)
{
GroupItem   stuff:;
Buffer      buffer = bufferSTAK.pop();
    // ⚠ MUST SIT AFTER THE WHOLE DECLARATION BLOCK -- inside one, this line wiped
    // degradeByDefault GroupRules.h's extern block to zero
    if jitting  jitDegrade("string expression under jit -- no emitter, builds at emit time", input);
    if !buffer      buffer = new("print buffer");
    appendPrintXP(stuff,buffer);
    return opString(stuff,buffer);
}

/*******************************************************************************
	TokenXP returns a token or a token expression.

    ⚠ THIS IS A SEAT WITH FOUR CALLOUTS, NOT A BODY. Since 2026-09-10 the arms live
    in handleUnary, handleCall, handleSubscript and handleDot; what is left here is
    the dispatch and the two control facts it reads back from an arm.
        ruleActions.aCTionTokenXP.arms
*******************************************************************************/
extern GroupItem aCTionTokenXP(GroupItem xpress)
{
GroupRules  ruler = groupRules;
int         unaryOwed = 0;
GroupItem   swap,
            UnaryOPS:,
            InvokeArg = xpress["InvokeArg"],
            ANYtoken = xpress["ANYorNum"];
    if generating && !isPRINTING {
        // Bare the simple field-ref operand for the generating path: mirror the
        // non-generating normalization below (xpress.group = ANYtoken) so
        // aCTionExpressioN's unwrap (while grup.isGROUP grup = grup.group)
        // reaches the bare field instead of depositing the TokenXP wrapper.
        // Invoke / unary / dot operands are left raw for now (Brief 2026-06-04).
        if isGROUP  ANYtoken = group;
        if !InvokeArg && !UnaryOPS && registry != groupFields
            xpress.group = ANYtoken;
        return xpress; }
    xpress.clear();
    if isGROUP  ANYtoken = group;
    if !InvokeArg {
        // unaryOnlyArm  the ONE arm with no callout until 2026-09-16, which is why
        // unaryOnlyArm  bear-trap 52 read "no arm" for a term that fires handleUnary
        if UnaryOPS     measureTokenArm("unary-only",ANYtoken,0,UnaryOPS);
        if !UnaryOPS
            if registry == groupFields {
                measureTokenArm("dot-LEADING",ANYtoken,0,UnaryOPS);
                handleDot(xpress,UnaryOPS,ANYtoken,0); }
            else {
                measureTokenArm("primary",ANYtoken,0,UnaryOPS);
                xpress.group = ANYtoken; }}
    else {
        if InvokeArg.groupList {
            measureTokenArm("dot-COMPOSED",ANYtoken,InvokeArg,UnaryOPS);
            swap = handleDot(xpress,UnaryOPS,ANYtoken,InvokeArg);
            if swap     ANYtoken = swap; }
        or InvokeArg.fLAG {
            measureTokenArm("subscript",ANYtoken,InvokeArg,UnaryOPS);
            handleSubscript(xpress,UnaryOPS,ANYtoken,InvokeArg); }
        else {
            measureTokenArm("call",ANYtoken,InvokeArg,UnaryOPS);
            handleCall(xpress,ANYtoken,InvokeArg); }
        if !swap    xpress.invoke = true; }
    /*  ⚠ A ROTATING ARM FINISHES THE TERM ITSELF AND SAYS SO BY SETTING THE METHOD.
        That is the one control fact the loop needs from an arm, and reading it here
        is what preserves the old `goto endToken` out of both rotations -- the star is
        already spent on the dot's LEFT operand, so running the prefix arm again would
        apply it twice.   ruleActions.aCTionTokenXP.arms  */
    unaryOwed = 0;
    if UnaryOPS         unaryOwed = 1;
    if xpress.method    unaryOwed = 0;
    if unaryOwed {
        handleUnary(xpress,UnaryOPS,ANYtoken);
        goto endToken; }
    if xpress.invoke    xpress.method = runOP;
endToken:
    return xpress;
}

/*******************************************************************************
	Immediate method for the TraiT rule that defines an attribute. It can be
        TraiTdata="="       DatA Modifier? Limit?;
        TraiT               NamE@ Modifier? Limit? TraiTdata? TraiTlist?;
*******************************************************************************/
extern GroupItem aCTionTraiT(GroupItem input)
{
GroupItem   upFlags,
            Modifier:,
            Limit:,
            TraiTdata = input["TraiTdata"],
            trait = input[1];
    /***************************************************************************
        A trait value can be a group or a literal. Limit and Modifier are passed
        to trait to be handled in DefinE. Same applies to TraiTdata.
    ***************************************************************************/
    input.clearList();
    if isGROUP      trait = group;
    if Modifier || Limit {
        isAttribute = true;
        if rStuff   trait = new(trait);
        else        setRuleStuff(); }
    if TraiTdata    upFlags = TraiTdata["Modifier"];
    // packetIsSpent the flags are READ here and the node is TAKEN OFF -- nothing downstream reads a
    // packetIsSpent Modifier on a trait, and leaving it makes four rules enter testAttributes on every match
    if upFlags      upFlags.remove();
    // traitSubjectExplicit trait, NOT bare -- a bare setContent below the upFlags read re-points
    // traitSubjectExplicit to upFlags (bear-trap #42)
    if TraiTdata    trait.setContent(TraiTdata);
    // traitTakesOwnFlags BOTH modifier classes apply AFTER this line -- setContent discards flags
    if Modifier     modify(trait,Modifier.text);
    if upFlags      modifyClass(trait,upFlags.text,0);
    if Limit        setLimits(trait,Limit);
    input.group     = trait;
    return input;
}

/*******************************************************************************
    Immediate method for the TraiTdata rule.
*******************************************************************************/
extern GroupItem aCTionTraiTdata(GroupItem input)
{
int         tdBad = 0;
GroupItem   upMark,
            Modifier:,
            Limit:,
            DatA:;
    input.clear();
    if Modifier || Limit {
        isAttribute = true;
        if rStuff {
            DatA = new(DatA);
            actionMethod = null; }
        else        setRuleStuff();
        // modifierRidesUp repetition lands on the DATA only; applying it to the trait as well repeats TWICE
        if Modifier modifyClass(DatA,Modifier.text,1);
        if Limit    setLimits(DatA,Limit);
        isRule      = true; }
    // scalarRepeat a repetition after scalar data REFUSES -- a literal is one token and has nothing to repeat
    tdBad = 0;
    if Modifier
        if DatA.isLiteral   tdBad = hasRepeatClass(Modifier.text);
    if tdBad == 1   refuse(input,"a repetition modifier after scalar data -- a literal is one token and has nothing to repeat");
    // modifierRidesUp the flags ride up as a noPrint ARTIFACT, never as a term
    if Modifier     input +% Modifier;
    if Modifier     upMark = input["Modifier"];
    if upMark       upMark.noPrint = true;
    // upMarkNoRstuff THIS LINE hides the packet from the AUDIT; noPrint alone only hides it from the PARSE
    if upMark       upMark.rStuff = 0;
    if (isRule && !isLiteral) || registry == opFields    input.group = DatA;
    else input.setContent(DatA);
    return  input;
}

/*******************************************************************************
	Sets the operator method in a while statement
        WhilE   while- ExpressioN SemI-? BLOCKing StatemenT;
*******************************************************************************/
extern GroupItem aCTionWhilE(GroupItem input)
{
GroupItem   ExpressioN:,
            StatemenT:;
GroupItem   looper,
            result;
    if jitting {
        -% return jitEmitWHILE(input); %-
    }
    while looper = ExpressioN.gMethod(ExpressioN) {
        if looper.isIterator    looper = looper.group;
        if result = StatemenT.gMethod(StatemenT) {
            if isBranch {
                // ⚠ TRAILING-CONTINUE GUARD -- one IDENTICAL body in DO, FOR and WhilE, and NOT
                // extractable: the arms are continue/return/break over THIS loop
                // trailingContinueGuard
                if isContinue {
                    result      = trueResult;
                    continue; }
                or isReturn     return result;
                // BREAK IS CONSUMED HERE -- clearing isBranch is what stops the
                // breakIsConsumed enclosing block breaking too
                result.isBranch = 0;
                if result.registry == keyWords  result = 0;
                break; }}
        else    break; }
    // labelNO, not falseResult: this construct executed NO statement, so it has no
    // labelNoNotFalse value -- and 0 is a value
    if !result  result = labelNO;
    return result;
}

/*******************************************************************************
	Xpress rule method.
*******************************************************************************/
extern GroupItem aCTionXpress(GroupItem input)
{
GroupRules  ruler = groupRules;
GroupItem   ExpressioN:;
    if !processingCode && method    ExpressioN = method(ExpressioN);
    or ExpressioN {
        input.clear();
        input.group = ExpressioN; }
    return input;
}

/*******************************************************************************
    THE ONE PrintXP WALK. Callers: aCTionPrinT, aCTionStringXP, aCTionCerR,
    aCTionCouT. It exists because there were four copies of this loop.
    ruleActions.appendPrintXP.onePrintXPWalk
*******************************************************************************/
extern void appendPrintXP(GroupItem stuff, Buffer buffer)
{
GroupItem   grup;
    while grup = stuff.nextAttribute(grup) {
        if noPrint  continue;
        GroupItem   FormaT:,
                    result,
                    ExpressioN:;
        if ExpressioN {
            if isMethod result = method(ExpressioN);
            else        result = ExpressioN;
            appendGroup(result,FormaT,buffer); }
        else            appendGroup(grup,FormaT,buffer); }
}


/*  clearRefusal -- A REFUSAL'S SCOPE IS THE STATEMENT. Tony, ruled 2026-09-17.
    THE SINGLE WRITER of `ruler.refused = 0`, as refuse() is the single writer of the 1.
    docs/refusalScope.md carries the argument and the three measurements behind it.  */
extern int clearRefusal(GroupItem where)
{
GroupRules  ruler = groupRules;
    if !ruler.refused   return 0;
    ruler.refused = 0;
    return 1;
}

/*  foldDot -- MINT ONE xdot: a dot whose left operand the parser never handed it.
    THE ONLY PLACE AN xdot IS BUILT. Extracted from interpretXP 2026-09-17 when the fold
    grew a stack; before that it was inline and could only ever run once.
    docs/dotChain.md carries the argument.  */
extern GroupItem foldDot(GroupItem dotUxp, GroupItem left)
{
GroupRules  ruler = groupRules;
GroupItem   op, operand, innerOp, innerLeft, innerRight, lower, upper, folded;
    op      = dotUxp.firstInList;
    operand = dotUxp.lastInList;
    /*  ⚠ THE ORPHAN'S OPERAND MAY ITSELF BE A WHOLE DOT, AND THAT IS THE CHAIN CASE.
        `TokenXP UnaryOPS? ANYorNum^ InvokeArg?` takes ONE leading unary AND ONE postfix,
        so dots arrive in PAIRS: `a.b.c.d` is TWO terms, `a.b` and `.c.d`, not four and
        not three. Measured with measureTokenArm 2026-09-17 -- two dot-COMPOSED arms, the
        second carrying unary `.`. So the orphan here is `.`(c.d) and wrapping it would
        build `(a.b).(c.d)`, handing opDot a dot node as its right operand.
        SPLICE INSTEAD: push `left` into the INNERMOST-LEFT position, giving ((a.b).c).d.
        docs/dotChain.md carries the argument.  */
    // groupListFirst  listLength dereferences groupList, which is NULL on a leaf -- the
    // groupListFirst  raw field is what the runtime itself tests before walking
    if operand
        if operand.groupList
        if operand.listLength == 3 {
            innerOp = operand.firstInList;
            // nullGuards  every one of these reads exits 139 on a null, and the two-element
            // nullGuards  chain reaches here with an operand that has no list at all
            if !innerOp                         goto plainFold;
            if innerOp.registry == ruler.opFields
                if innerOp.tag eq "." {
                    innerLeft   = operand[2];
                    innerRight  = operand.lastInList;
                    lower = new("xdot");
                    lower   +% op;
                    lower   +% left;
                    lower   +% innerLeft;
                    lower.method = runOP;
                    lower.invoke = true;
                    upper = new("xdot");
                    upper   +% innerOp;
                    upper   +% lower;
                    upper   +% innerRight;
                    upper.method = runOP;
                    upper.invoke = true;
                    return upper; }}
plainFold:
    folded = new("xdot");
    folded  +% op;
    folded  +% left;
    folded  +% operand;
    folded.method = runOP;
    folded.invoke = true;
    return folded;
}


/*******************************************************************************
    generateXP — the `generating` mode: build a flat-RPN revisedList from the
    parsed expression and emit nothing (the bytecode walk emits later). Members
    are added BY REFERENCE; gXpress launders them with copyOf at bytecode-emit
    time. (jitXP, its copyOf-on-append twin for the JIT lowering, was folded out
    2026-06-30 — JIT now falls through to interpretXP per the unified
    emit-on-walk pivot; see docs/jitDesign.md.)
*******************************************************************************/
extern GroupItem generateXP(GroupItem xpList)
{
GroupItem   op, target, arg, xl, token;
GroupItem   revisedList = new("revisedList");
GroupItem   grup, store, tgt;
    if xpList.listLength == 1 {
        arg = xpList.firstInList;
        -%
        %-
        revisedList += arg; }
    else {
        /******************************************************************
            Mirror the non-generating walk's op/target/arg identification
            (right-to-left, precedence-correct via the same state machine),
            but emit flat RPN instead of building the runOP tree: for each
            completed instruction emit target, then arg (when a leaf), then
            op; for '=' emit the value then a bcStoreField carrying target.
        *******************************************************************/
        // No-operator expression (a bare operand sequence, e.g. the print
        // operands `"hello" name`): the RPN walk below only emits when it
        // completes an op+target, so with no operator it produces an EMPTY
        // revisedList and the clear() below would destroy the tokens. Detect
        // that and leave xpList intact so aCTionPrinT/appendGroup can print
        // the operands directly. (Operator expressions fall through to RPN.)
        GroupItem   hasOp, tk;
        while tk = xpList.prior(tk)
            if tk.isOperator   hasOp = tk;
        if !hasOp {
            xpList.isLIST       = true;
            xpList.reversePrint = true;
            return xpList; }
        while token = xpList.prior(token) {
            grup = token;
            // Operator-skip guard: never unwrap an operator. Operators carry
            // their interpret=/operateMethod= as attributes (e.g. > has
            // interpret=runGT), which is the dispatch handler gXpress/
            // interpretBC need — unwrapping would dis-member the op.
            if grup.isGROUP && !grup.isOperator
                while grup.isGROUP
                    grup = grup.group;
            if grup.isOperator   op = grup;
            else {
                if !arg arg = grup;
                or op   target = grup; }
            if op
                if target {
                    if op.tag eq "=" {
                        if !arg.method   revisedList += arg;
                        store = copyOf(bcOPs["bcStoreField"]);
                        tgt = new("target");
                        tgt.group = target;
                        store +% tgt;
                        revisedList += store; }
                    else {
                        revisedList += target;
                        if !arg.method   revisedList += arg;
                        revisedList += op; }
                    xl = new("xl");
                    xl.method   = runOP;
                    op = 0;
                    target = 0;
                    arg = xl; }}}
    dumpContents(revisedList);
    xpList.clear();
    xpList.group = revisedList;
    return xpList;
}

/*  handleCall -- the `(` arm. No operator: the falsy op is what tells runOP this is
    an invocation rather than an operation. ⚠ THE RECURSION STAMP LIVES HERE and
    nowhere else -- a body naming itself is how currentMETHOD learns it recurses.
    ruleActions.aCTionTokenXP.arms  */
extern GroupItem handleCall(GroupItem xpress, GroupItem ANYtoken, GroupItem InvokeArg)
{
GroupItem   op,
            arg;
GroupRules  ruler = groupRules;
    op = falseResult;
    if ruler.processingCode
        if ANYtoken.groupBody == ruler.currentMETHOD.groupBody   ruler.currentMETHOD.recursive = true;
    if InvokeArg.isGROUP    arg = InvokeArg.group;
    // emptyParens an EMPTY () carries nothing and is NOT an argument -- hand on no third operand
    if !arg
        if InvokeArg.groupList || InvokeArg.data     arg = InvokeArg;
    use xpress
    xpress  +% op;
    xpress  +% ANYtoken;
    if arg  xpress  +% arg;
    return null;
}

/*  handleDot -- the `.` arm, both shapes. With no InvokeArg it is the LEADING form
    (`.taG`), which hangs the dot op with no right operand so opDot falls to lastREF.
    With one it is the composed form, where InvokeArg arrived as a UnaryXP holding the
    operator and the right-hand name.
    ⚠ IT RETURNS A REPLACEMENT ANYtoken OR NULL, and that is the whole control
    protocol: non-null means the caller must run the prefix arm over the node handed
    back, null means the term is finished.   ruleActions.aCTionTokenXP.arms  */
extern GroupItem handleDot(GroupItem xpress, GroupItem unary, GroupItem ANYtoken, GroupItem InvokeArg)
{
int         dotName = 0;
GroupItem   op,
            arg;
GroupRules  ruler = groupRules;
    if !InvokeArg {
        op = ruler.opFields["."];
        xpress  +% op;
        xpress  +% ANYtoken;
        // w/no argument opDot will try to use lastREF
        xpress.invoke = true;
        return null; }
    op  = InvokeArg.firstInList;
    arg = InvokeArg.lastInList;
    if op.isGROUP   op = op.group;
    if arg.isGROUP  arg = arg.group;
    /*  THE DOT'S RIGHT OPERAND IS A NAME, NEVER A VALUE. It arrives RESOLVED, and a
        resolved node WITH DATA returns its DATA from .text (bear-trap 26) -- which is
        why `DesignDocs.TokFiles` looked up the whole description paragraph and missed.
        So hand opDot a fresh DATA-LESS node carrying the name as its tag: #26 working
        deliberately instead of by accident.
        ⚠ ACCESSORS ARE EXEMPT AND THE EXEMPTION IS LOAD-BEARING -- a groupFields entry
        is selected by REGISTRY MEMBERSHIP and re-minting would strip it, taking the
        whole accessor family off its road.   ruleActions.handleDot.rightIsAName  */
    dotName = 0;
    if op.tag eq "."        dotName = 1;
    -% if ( arg && arg->groupBody->registry == ruler->groupFields ) dotName = 0; %-
    if dotName == 1         arg = new(arg.tag);
    if unary {
        /*  THE STAR/DOT ROTATION. `*a.b` must mean `(*a).b`, so the star
            is applied to the dot's LEFT operand and the dot re-applied to
            the result -- not wrapped around the finished dot node.
            ruleActions.aCTionTokenXP.starDotRotation  */
        if unaryIsAccess(unary)
            if op.tag eq "." {
                GroupItem starred = new("uxp");
                starred +% ruler.opFields["deref"];
                starred +% ANYtoken;
                starred.method  = runOP;
                starred.invoke  = true;
                xpress  +% op;
                xpress  +% starred;
                xpress  +% arg;
                xpress.invoke   = true;
                xpress.method   = runOP;
                return null; }
        // this happens with two unary ops like: !field.someThing
        GroupItem xp = new("xp");
        xp  +% op;
        xp  +% ANYtoken;
        xp  +% arg;
        xp.method   = runOP;
        xp.invoke   = true;
        return xp; }
    xpress  +% op;
    xpress  +% ANYtoken;
    xpress  +% arg;
    return null;
}

/*  handleSubscript -- the `[` arm. InvokeArg carries fLAG, the op is `=[`, and the
    star rotation applies here for the same reason it applies to the dot.
    ruleActions.aCTionTokenXP.arms  */
extern GroupItem handleSubscript(GroupItem xpress, GroupItem unary, GroupItem ANYtoken, GroupItem InvokeArg)
{
GroupItem   op,
            arg;
GroupRules  ruler = groupRules;
    op = ruler.opFields["=["];
    if InvokeArg.isGROUP    arg = InvokeArg.group;
    if !arg                 arg = InvokeArg;
    if unary
        /*  THE STAR ROTATION, SUBSCRIPT HALF -- gated on `=[` so an INVOCATION
            `*fn(x)` is left alone   ruleActions.aCTionTokenXP.starDotRotation  */
        if unaryIsAccess(unary) {
            GroupItem starred = new("uxp");
            starred +% ruler.opFields["deref"];
            starred +% ANYtoken;
            starred.method  = runOP;
            starred.invoke  = true;
            xpress  +% op;
            xpress  +% starred;
            xpress  +% arg;
            xpress.invoke   = true;
            xpress.method   = runOP;
            return xpress; }
    xpress  +% op;
    xpress  +% ANYtoken;
    xpress  +% arg;
    return null;
}

/*  handleUnary -- the PREFIX operators. Wraps ANYtoken in a `uxp` under the unary's
    own op and hangs it as xpress's group. ⚠ A HAND, NOT A WITNESS: it changes the
    tree, so it does NOT wear the measure prefix.   ruleActions.aCTionTokenXP.arms  */
extern GroupItem handleUnary(GroupItem xpress, GroupItem unary, GroupItem ANYtoken)
{
GroupItem   op;
GroupRules  ruler = groupRules;
    // Prefix - routes to the named "negate" op (opUnaryMinus), keeping the
    // binary - slot (opMinus) completely isolated. Other unaries resolve
    // their method straight from their own Operators entry.
    if unary.tag eq "-"     unary = ruler.opFields["negate"];
    if unary.tag eq "*"     unary = ruler.opFields["deref"];
    op  = new("uxp");
    op  +% unary;
    op  +% ANYtoken;
    op.method = runOP;
    op.invoke = true;
    xpress.group = op;
    return xpress;
}

/*******************************************************************************
    interpretXP — the interpret/run mode: build the left-associative runOP tree
    the interpreter walks. (Split out of aCTionExpressioN 2026-06-30; was the
    fallthrough below the generating/jitting branches.)
*******************************************************************************/
extern GroupItem interpretXP(GroupItem xpList)
{
/*  ⚠ canFold IS DECLARED BEFORE THE GroupItem LINE, NOT AFTER. Every bare field in the
    loop below resolves against the MOST RECENTLY DECLARED name (bear-trap #42), and
    `token` is the one they mean.  */
int         canFold = 0;
GroupItem   op, target, arg, xl, token;
    if xpList.listLength == 1 {
        arg = xpList.firstInList;
        -%
        %-
        goto finishXP; }
    while token = xpList.prior(token) {
        if registry == opFields   op = token;
        else {
            if !arg arg = token;
            or op {
                target  = token;
                if xl   xl = null; }
            else {
                /*  ⚠ THE ACCUMULATOR IS THE RIGHT-HAND SIDE HERE, NOT THE LEFT, AND
                    NOTHING ELSE IN THIS FUNCTION SAYS SO. The loop walks
                    `xpList.prior` -- BACKWARD -- so the term already in `arg` sits
                    further RIGHT in the source and the `token` arriving now is its
                    LEFT. `a.b.c` dumps as [uxp, Token] for exactly that reason.
                    Read that before changing anything below it.
                    ruleActions.interpretXP.dotFold  */
                canFold = 0;
                if isDotUxp(arg)    canFold = 1;
                // threeTermChainNotFolded  FIVE names is the first chain that produces THREE
                // threeTermChainNotFolded  terms, and folding one pair of them leaves the
                // threeTermChainNotFolded  other orphaned -- which TRUNCATES the run at exit 0.
                // threeTermChainNotFolded  Refuse to fold and it answers `xl1` as it always
                // threeTermChainNotFolded  has: wrong, but VISIBLE. fixIts F-80.
                if isDotUxp(token)  canFold = 0;
                if canFold {
                    /*  THE CHAIN FOLD. An orphaned `.c` juxtaposed against a term on its
                        left is not a juxtaposition at all -- it is a dot whose left
                        operand the parser never handed it. Hand it one. Left associative
                        BY CONSTRUCTION: the left is whatever arrived.
                        ⚠ A CHAIN LONGER THAN TWO NEEDS A STACK, because the walk is
                        BACKWARD: `a.b.c.d` arrives as .d, then .c, then the primary, so
                        the dots are met in the OPPOSITE order to the one they apply in.
                        A dot met while another is still pending CANNOT fold yet -- its
                        left operand has not arrived -- so it is stacked, and the stack
                        unwinds LIFO onto the primary the moment a non-dot term shows up.
                        ruleActions.interpretXP.dotFold  */
                    arg = foldDot(arg,token);
                    if xl   xl = null; }
                else {
                    if !xl {
                        xl = new("xl1");
                        xl.isLIST   = true; }
                    if arg != xl    xl += arg;
                    xl  += token;
                    arg = xl; }}}
        if op
            if arg {
                if arg.actionType || arg.instructType   arg.invoke = true;
                if target {
                    // dotUnaryRight  `a.*b` -- ASK HERE OR NOWHERE; opDot's lastREF fixup has
                    // dotUnaryRight  already destroyed both operands by the time it could ask.
                    // dotUnaryRight  INSIDE the target guard: the backward walk reaches the arg
                    // dotUnaryRight  block once with op set and again with target set, so a seat
                    // dotUnaryRight  above this line fires TWICE on one expression
                    refuseDotUnaryRight(op,arg);
                    xl  = new("xl2");
                    xl  += op;
                    xl  += target;
                    xl  += arg;
                    // TIER-3 BINDING, AND THE SET IS A REGISTRATION -- `shortCircuit` on the
                    // operator in incant/setup, never a list of spellings here
                    // tier3Binding
                    if opIsShortCircuit(op)
                            xl.method   = runShortCircuit;
                    else    xl.method   = runOP;
                    xl.invoke   = true;
                    op = 0;
                    target = 0;
                    arg = xl; }}}
finishXP:
    xpList.clear();
    xpList.group = arg;
    return xpList;
}

/*  isDotUxp -- is this juxtaposed term an ORPHANED LEADING DOT?

    IDENTIFY IT BY ITS OP AND BY NOTHING ELSE. By the time interpretXP sees the
    term, handleUnary has already wrapped it -- the raw `UnaryOPS ANYorNum` shape
    is gone, so a shape test would be testing the wrapper. This asks the one
    durable question: is the first attribute the Operators entry `.`?
    ⚠ THE REGISTRY TEST IS NOT DECORATION. A bare tag compare would start
    answering yes the day anything else mints a node tagged `.`; membership of
    opFields is what makes it THE OPERATOR rather than a name that looks like
    one.   ruleActions.interpretXP.dotFold  */
extern int isDotUxp(GroupItem node)
{
GroupRules  ruler = groupRules;
GroupItem   op;
    if !node                            return false;
    if node.tag ne "uxp"                return false;
    op = node.firstInList;
    if !op                              return false;
    if op.registry != ruler.opFields    return false;
    if op.tag ne "."                    return false;
    return true;
}


/*  refuseDotUnaryRight -- `a.*b`. THE STAR IS ONLY VISIBLE HERE, AND THE REFUSAL THE
    2026-09-16 ruling asked for COULD NOT GO WHERE IT WAS SITED.

    A unary on the right of a dot never reaches opDot as a unary. Measured 2026-09-17:
    `a.*b` parses as TWO terms, `a` (bare primary, no InvokeArg) and `*b` (unary-only) --
    no dot-COMPOSED arm at all -- and opDot then arrives with a NULL right operand,
    because the 09-05 star ruling makes `*b` on a non-group field yield null.
    ⚠ THAT NULL IS INDISTINGUISHABLE FROM A LEADING DOT, so opDot's lastREF fixup fires,
    rewrites BOTH operands, and the expression silently becomes `.a`. DOTOPERANDS reads
    left=right=a, which is what F-72 recorded and mis-read as "no dot forms".
    ⚠ ONE CHANNEL, TWO MEANINGS: `!argument` in opDot means BOTH "no right operand was
    written" (a parse fact) and "the right operand evaluated to null" (a value fact). By
    the time opDot can ask, the evidence is gone -- so the question is asked HERE, where
    the uxp still carries its operator.
    A dot-uxp is NOT this: that is the chain, and the fold above has already taken it.
    ruleActions.interpretXP.dotUnaryRight  */
extern int refuseDotUnaryRight(GroupItem op, GroupItem arg)
{
GroupRules  ruler = groupRules;
GroupItem   aop;
    if !op                              return 0;
    if op.registry != ruler.opFields    return 0;
    if op.tag ne "."                    return 0;
    if !arg                             return 0;
    if arg.tag ne "uxp"                 return 0;
    aop = arg.firstInList;
    if !aop                             return 0;
    if aop.registry != ruler.opFields   return 0;
    if aop.tag eq "."                   return 0;
    /*  derefIsTheTag  NAME THE OPERATOR BY ITS REGISTRY TAG AND DO NOT RECONSTRUCT THE
        SOURCE SPELLING -- the unary star registers as `deref` (incant/setup:115), so
        echoing the tag into a cure produced `a[derefb]` on the first cut of this line.
        The cure is spelled as the SHAPE, with the star as the worked example.
        ⚠ THE CONCATENATION IDIOM IS setActions' -- juxtaposition allocates, so it is
        freed after the refusal has printed it.  */
    /*  escalated  refuse() PROPER, NOT A cerr, ON TONY'S RULING OF 2026-09-17. It rides
        escalated  WITH the refusalBoundary report above, because the two are one stroke
        escalated  seen from both ends: this raises ruler.refused, and the boundary is
        escalated  what turns that flag into a named removal instead of a silent one.
        ruleActions.interpretXP.dotUnaryRight  */
    String  why = "unary " aop.tag " on the right of a dot is never seen by opDot -- move it inside a subscript: a[*b], not a.*b";
    refuse(op,why);
    free(why);
    return 1;
}

/*  reportDefineRemoved -- THE BOUNDARY'S VOICE. A SIBLING OF reportNoBody, NOT A REUSE
    OF refuse(). Built 2026-09-17 on Tony's ruling: aCTionDefinE's refusalBoundary names
    what it removes WHEN it removes it, so a refusal inside a define block is loud with a
    patient (R-2). Until today the boundary deleted a definition in perfect silence and the
    only symptom was that nothing later could find the field.

    ⚠ IT DELIBERATELY DOES NOT RE-PRINT THE REFUSAL'S REASON, AND THAT IS THE DESIGN AND
    NOT AN OMISSION. Two sites, two facts: refuse() names ITS patient and why it refused;
    this names WHAT WAS REMOVED and from where, which is the fact only the boundary holds.
    A reporter that re-stated another site's reason would be a witness recomputing its
    subject's decision, which is the drift this project has already paid for.

    ⚠ AND THE PAIRING IS GUARANTEED RATHER THAN HOPED FOR: refuse() (GroupActions.rtn:859)
    is the SOLE WRITER of ruler.refused, measured 2026-09-17, so this line cannot print
    without a REFUSED line above it. If a second writer is ever added, that is the moment
    this comment stops being true.   ruleActions.aCTionDefinE.refusalBoundary  */
extern void reportDefineRemoved(GroupItem field, GroupItem intoReg)
{
String      regName = "(no registry)";
    if intoReg      regName = intoReg.tag;
    cerr "REMOVED " field.tag " from " regName " -- a refusal fired while it was being defined, so the definition is GONE and nothing later will find it":;
}


/*  reportRunAbandoned -- THE OUTERMOST BOUNDARY, AND THE ONLY PLACE THAT KNOWS THE RUN IS
    OVER. Built 2026-09-17 for fixIts F-76.

    A refusal is terminal for its action and it BREAKS the enclosing block (aCTionBlocK's
    refusalArm). The break walks outward, and the two things that CLEAR the flag --
    runAction's refusalArm and aCTionDefinE's refusalBoundary -- sit on paths a refusal
    raised from an EXPRESSION during a definition never reaches, because the match fails
    before aCTionDefinE's action ever fires. Measured 2026-09-17 with a probe at that
    action's tail: `arBad` (refused from a rule action) prints `refused=1` there and is
    reported and cleared; `dcBad` (refused from an expression) produces NO tail line at all.

    ⚠ SO THE BOUNDARY IS NOT MISSED ON THAT PATH, IT IS STRUCTURALLY UNREACHABLE -- and
    nothing clears the flag, so the rest of the FILE is abandoned. Silently. At exit 0,
    with no `stop:` line, which is indistinguishable from a short successful run and is
    the failure mode this project has paid for more than any other.

    ⚠ THIS DOES NOT CHANGE THAT BEHAVIOUR AND IS NOT TRYING TO. Whether a define-time
    expression refusal SHOULD be terminal is a ruling nobody has made, and giving that path
    a boundary is a change to parse semantics rather than a line. What this removes is the
    SILENCE: being terminal is defensible, being terminal without saying so is not.
    ruleActions.reportRunAbandoned  */
extern void reportRunAbandoned(String fileName)
{
GroupRules  ruler = groupRules;
String      whichFile = "(no file)";
    if fileName         whichFile = fileName;
    /*  unconsumedInput  THE ABANDONMENT THAT ACTUALLY HAPPENS, F-79. `Start` is
        unconsumedInput  `StatemenT+`, so a statement that FAILS TO MATCH ends the
        unconsumedInput  repetition and every byte after it is never parsed -- no error,
        unconsumedInput  no stop: line, exit 0. Measured 2026-09-17: a refusing define and
        unconsumedInput  an unterminated literal both do it, and a `@@@` or a bad operator
        unconsumedInput  do NOT, so the discriminator is MATCH FAILURE and not malformity.
        unconsumedInput  Reading the mark is what names it; the refusal flag cannot, because
        unconsumedInput  half these cases never raise one.   docs/refusalScope.md  */
    if *ruler.atRuleMark {
        cerr "ABANDONED " whichFile " -- the parse STOPPED with input left over. A statement failed to match, which ends Start's StatemenT+ repetition, so everything from here on was NEVER PARSED. The exit status is still 0. It resumes at:":;
        cerr "    " getDebugText(ruler.atRuleMark,60):;
        return; }
    if !ruler.refused   return;
    /*  wordingCorrected  THE FIRST CUT OF THIS LINE SAID "every statement after the
        wordingCorrected  REFUSED line was SKIPPED, not parsed" AND THAT IS FALSE FOR HALF
        wordingCorrected  THE CASES -- measured 2026-09-17, F-78. A refusal inside a define
        wordingCorrected  breaks the block and later statements ARE skipped; a refusal at
        wordingCorrected  statement level does NOT stop plain statements, it silences ACTION
        wordingCorrected  AND COMMAND DISPATCH -- so stop() is never entered and MORE gets
        wordingCorrected  parsed, not less. The message now claims only what is true of both.  */
    cerr "ABANDONED " whichFile " -- the run ended with a refusal outstanding. Nothing after the REFUSED line above is reliable: action and command dispatch is silenced, so statements can be skipped AND a stop() can be missed, leaving the region below it parsed as source. The exit status is still 0":;
}


/*  unaryIsAccess -- THE UNARY CLASS PREDICATE, one question asked by two arms. ACCESS
    class binds to the PRIMARY, before the postfix chain; VALUE class binds to the
    chain's RESULT. The class is a REGISTRATION (`accessClass` in incant/setup) and not
    a list here, so adding one is an edit to setup and never to this file.
    ⚠ A HAND, NOT A WITNESS -- no measure prefix, and it is asked for effect on control
    flow.   ruleActions.aCTionTokenXP.unaryClass  */
extern int unaryIsAccess(GroupItem unary)
{
GroupRules  ruler = groupRules;
GroupItem   reg;
    if !unary               return 0;
    reg = ruler.opFields[unary.tag];
    if !reg                 return 0;
    if reg["accessClass"]   return 1;
    return 0;
}


/*  opIsShortCircuit -- TIER-3 MEMBERSHIP. opIsOR -- WHICH WAY IT SKIPS. Two questions,
    two attributes on the operator in incant/setup, and NO SPELLING IN EITHER ACTION.
    ⚠ THEY REPLACED TWO LISTS, NOT ONE: interpretXP chose the tier-3 binding by tag AND
    runShortCircuit chose the skip direction by tag. `||` could be seen by neither, on
    the very same operateMethod as `OR`, and fixing only the first made `true || false`
    read FALSE because the second then sent it past both skips.
    ⚠ HANDS, NOT WITNESSES -- no measure prefix.   ruleActions.interpretXP.tier3Binding  */
extern int opIsShortCircuit(GroupItem op)
{
    if !op                  return 0;
    if op["shortCircuit"]   return 1;
    return 0;
}


extern int opIsOR(GroupItem op)
{
    if !op          return 0;
    if op["isOR"]   return 1;
    return 0;
}
