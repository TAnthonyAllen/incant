include /Users/anthony/Dropbox/data/InProcess/Groups/groupIncludes

/*******************************************************************************
	Layout view
*******************************************************************************/
class Layout extends View implements WindowDelegate
{
GroupItem       base,
                selection;
TextField       textField;
Path            layoutPath;
Stylish         style;
Frame           frame;

/*******************************************************************************
	Display a cell.
*******************************************************************************/
void displayCell()
{
GroupItem   align = base["align"];
NSString    tEXT = base.text;
use base
use style
Cell    cell = textField.cell;
    cell.init(tEXT);
    if align && align.gText
        switch(*align.gText) {
            case 'c':   cell.setAlign(alignCenter);
            case 'l':   cell.setAlign(alignLeft);
            case 'r':   cell.setAlign(alignRight); }
    if style.fillColor    textField.bgColor = fillColor;
    textField.color = textColor;
    textField.cell.setSingleLine(true);
    addSubview(textField);
    if editable
        if selected {
            window.makeFirstResponder(textField);
            textField.displayIfNeededIgnoringOpacity(); }
}

/*******************************************************************************
	Display an image (centered and cropped to fit the frame). Getting image
    to fit happens in incant in the imageFit action TBD; it will set scale and
    offset attributes in the image attribute.
*******************************************************************************/
void displayImage()
{
use base
GroupItem   image = base["image"],
            offset = base["offset"],
            scale = base["scale"];
Image		viewImage = image.object;
Frame       imageFrame;
	if !viewImage return;
    if scale    imageFrame = indentFrame(frame,scale.number);
    viewImage.setSize(size);
    if offset   imageFrame = *(Frame)offset.pointer;
    viewImage.drawIn(frame,imageFrame,sourceOver,1.0);
}

/*******************************************************************************
	Display text
*******************************************************************************/
void displayText()
{
Box         box;
TextView    editor;
Frame       indented = indentFrame(frame,5.0);
use base
GroupItem   align = base["align"];
use style
    //cout "displayText:",tag :;
	if object   editor = object;
	else        object  = editor;
    box = editor.textContainer;
    if align && align.gText
        switch(*align.gText) {
            case 'c':   editor.align(alignCenter);
            case 'l':   editor.align(alignLeft);
            case 'r':   editor.align(alignRight); }
        // case j means justify, how to set align justified???
    if bgColor  editor.bgColor = bgColor;
    else        editor.bgColor = clearColor;
    editor.setFont(font);
    if selected         editor.setEditable(true);
    else                editor.setEditable(false);
    editor.setFrame(indented);
    if !subbed {
        addSubview(editor);
        //cout "Font: " tag,editor.font.displayName :;
        subbed  = true; }
    //editor.displayIfNeededIgnoringOpacity();
}

/*******************************************************************************
	Draw — flat, read-only pass over base's attributes. The old recursive
    GroupItem.walk descended into scalar attribute leaves (null groupList) and
    SIGSEGV'd; this nextAttribute loop stays at base's own attribute level,
    never recursing, so it survives a paint cycle. For now it just reads each
    attribute and strokes its frame (getFrame yields a zero rect when there are
    no x/y/width/height, harmless). Real content dispatch hangs off this once
    it's a stable platform — green light is drawRect completing without SIGSEGV.
*******************************************************************************/
void drawRect(Frame r)
{
Frame       f;
    if !base return;
    style   = getStyle(base);
    setDefaultLineWidth(0.0);
    strokeColor = blackColor;
    strokeColor.set();
    f   = getFrame(base);
    f.y = frame.height - f.y - f.height;
    rectangle(f);
    stroke();
}

/*******************************************************************************
	init here takes a GroupItem argument. I assume that is allowed???
*******************************************************************************/
Layout init(GroupItem field)
{
    base        = field;
    layoutPath  = bezierPath();
    return self;
}

Point invertY(Point point)
{
double  baseY = frame.height - point.y;
    point.y = baseY;
    return point;
}

/*******************************************************************************
	Event handling will be passed to incant to deal with. How that happens
    is a design decision to be made. Methinks when an event happens, Layout
    calls an incant extern method passing it the event.
    How the incant -> layout -> incant cha cha works is the crux of the design
    decision. The events that incant has to handle are: keyUp mouseUp rightMouseUp
    and scrollWheel. incant also needs a blockContaining method to figure out
    which field gets the event.
*******************************************************************************/

void viewDidEndLiveResize()
{
	cout "View End resize":;
    setFrame(superview.frame);
    //base.updateFrame(frame);
    drawRect(frame);
}

void windowWillClose(Notification notification)
{
    cout "Window closing: will exit":;
    exit(0);
}
}
