Start();
include(unitTests);
include(utilities);
registry(fILEs);
define
    kantGrammar File='incant/kantGrammar';
    ;
include(kantGrammar);
search reset stack KantGrammar Grokking;
search UnitTests Utilities;
registry(cOMMANDs);
define
    testOP  immediateAction;
    ;
register(ClrN);
define
    nReq owner source result rule;
    it1;
    nT1="n1"; nT2="n2"; nT3="n3"; nT4="n4"; nT5="n5"; nT6="n6";
    np1="p1"; np2="p2"; np3="p3";
    nH1; nH2; nH3; nH4; nH5;
    nNew code={
        nSrc := argument.CodE;
        nReq.owner  := argument;
        nReq.source := nSrc;
        nReq.rule   := KantGrammar["STARt"];
        if compileIn(nReq);
            nBlock = nReq.result;
            *nBlock :. noPrinT;
            argument :. isActioN;
            argument +< *nBlock;
        };
    nRP code={ print "NR RP" "[" 7 #5d "]":; };
    nClrArg code={ clear(argument); };
    nA code={ clear(nH3); clear(np2); };
    nB code={ nH4 := nT4; clear(nH4); };
    ;
search ClrN list;
nNew(nRP); nRP();
nH1 := nT1;
it1 = STARt("clear(nH1);"); testOP(it1);
print "NT-H  new road, top: clear(h)  target" nT1 "holder isGrouP" nH1.isGrouP:;
nH2 := nT2;
it1 = STARt("clear(*nH2);"); testOP(it1);
print "NT-S  new road, top: clear(*h) target" nT2 "holder isGrouP" nH2.isGrouP:;
it1 = STARt("clear(np1);"); testOP(it1);
print "NT-P  new road, top: clear(plain)" np1:;
nH3 := nT3;
nNew(nA); nA();
print "NA-H  new-road action built AFTER the bind: clear(h) target" nT3 "holder isGrouP" nH3.isGrouP:;
print "NA-P  new-road action: clear(plain)" np2:;
nNew(nB); nB();
print "NA-HB new-road action, bound in the action: target" nT4 "holder isGrouP" nH4.isGrouP:;
nNew(nClrArg);
nClrArg(np3);
print "NA-AP new-road action clear(argument), plain: caller's field" np3:;
nH5 := nT5;
nClrArg(nH5);
print "NA-AH new-road action clear(argument), holder: target" nT5 "holder isGrouP" nH5.isGrouP:;
nH6 := nT6;
it1 = STARt("nClrArg(nH6);"); testOP(it1);
print "NT-AH new-road CALL, clear(argument), holder: target" nT6 "holder isGrouP" nH6.isGrouP:;
print "NEW SENTINEL":;
stop();
