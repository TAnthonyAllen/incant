Start();
include(unitTests);
include(utilities);
registry(fILEs);
define
    kantGrammar File='incant/kantGrammar';
    ;
include(kantGrammar);
search reset stack KantGrammar Grokking;
search UnitTests Utilities;
register(PrbReg);
define
    tgtA="text A";
    tgtB="text B";
    tgtC="text C";
    tgtD="text D";
    bumps=0;
    hE;
    hF;
    tgtE="text E";
    tgtF="text F";
    bump code={ bumps += 1; };
    actRoad code={
        hC := tgtC;
        print "A0 hC isGrouP before:" hC.isGrouP:;
        clear(hC);
        print "A0b hC isGrouP after:" hC.isGrouP:;
        print "A1 tgtC after clear(hC) in an action:" tgtC:;
        hD := tgtD;
        clear(*hD);
        print "A2 tgtD after clear(*hD) in an action:" tgtD:;
        };
    ;
search PrbReg list;
hE := tgtE;
print "K5 declared hE isGrouP before:" hE.isGrouP:;
clear(hE);
print "K6 tgtE after clear(hE), hE declared:" tgtE:;
print "K7 hE isGrouP after:" hE.isGrouP:;
hF := tgtF;
clear(*hF);
print "K8 tgtF after clear(*hF), hF declared:" tgtF:;
selection := tgtA;
print "K9 selection isGrouP:" selection.isGrouP:;
clear(selection);
print "K10 tgtA after clear(selection):" tgtA:;
actRoad();
print "SENTINEL core end":;
stop();
