registry(Spellers);
define
    spellLeaf argument code={
        :argument at sink slot site;
        local = string $"t" at;
        kind = argument.taG;
        if kind == "OPT";
            iterate inner on argument members;
            if ++inner;
                wrapped <- inner;
                wrapped :% sink;
                piece = this(wrapped);
                leaf = string $"(" piece " || 1)";
            else
                leaf = "NOINNER";
        or kind == "MANY";
            leaf = string $"many" site "(" sink "," local ")";
        or kind == "CALL";
            leaf = string $"parseR(" local "," sink ")";
        or kind == "LIT";
            leaf = string $"lit(" local "," '"' argument '"' ")";
        or kind == "LITTO";
            if sink == "into";
                leaf = string $"litOption(" local ",into," '"' argument '"' ")";
            else
                leaf = string $"litTo(" local ",label," '"' argument '"' "," '"' slot '"' ")";
        else
            leaf = string $"OTHER:" kind;
        return leaf;
        };
    ;
EOF
