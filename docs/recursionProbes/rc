Start();
include(utilities);
include(unitTests);
registry(fILEs);
define
    kantGrammar File='incant/kantGrammar';
    ;
include(kantGrammar);
search reset stack KantGrammar Grokking;
search Utilities UnitTests;
registry(NewReturnKindT);
define
    rkReq owner source result rule;
    rkNew code={
        rkSrc := argument.CodE;
        rkReq.owner  := argument;
        rkReq.source := rkSrc;
        rkReq.rule   := KantGrammar["STARt"];
        if compileIn(rkReq);
            rkBlock = rkReq.result;
            *rkBlock :. noPrinT;
            argument :. isActioN;
            argument +< *rkBlock;
        };

    os0 code={ if argument < 1; return "s"; r = os0(argument - 1); return r; };
    ns0 code={ if argument < 1; return "s"; r = ns0(argument - 1); return r; };
    oc0 code={ if argument < 1; return 5; r = oc0(argument - 1); return r; };
    nc0 code={ if argument < 1; return 5; r = nc0(argument - 1); return r; };
    ond code={ if argument < 1; return 1.5; r = ond(argument - 1); return r; };
    nnd code={ if argument < 1; return 1.5; r = nnd(argument - 1); return r; };
    odr code={ if argument < 1; return "s"; return odr(argument - 1); };
    ndr code={ if argument < 1; return "s"; return ndr(argument - 1); };
    ohd code={ if argument < 1; return "s"; r := ohd(argument - 1); return r; };
    nhd code={ if argument < 1; return "s"; r := nhd(argument - 1); return r; };
    oleaf code={ return "s"; };
    nleaf code={ return "s"; };
    ocall code={ r = oleaf(1); return r; };
    ncall code={ r = nleaf(1); return r; };
    ocallN code={ r = nleaf(1); return r; };
    ncallO code={ r = oleaf(1); return r; };
    obare code={ if argument < 1; return "s"; r = obare(argument - 1); cerr "RC  obare after call r=" r " arg=" argument:; return r; };
    nbare code={ if argument < 1; return "s"; r = nbare(argument - 1); cerr "RC  nbare after call r=" r " arg=" argument:; return r; };
    hold;
    ;
search NewReturnKindT;
rkNew(ns0);
rkNew(nc0);
rkNew(nnd);
rkNew(ndr);
rkNew(nhd);
rkNew(nleaf);
rkNew(ncall);
rkNew(ncallO);
rkNew(nbare);
hold = os0(0);
cerr "RC os0 0 = " hold:;
hold = os0(1);
cerr "RC os0 1 = " hold:;
hold = os0(2);
cerr "RC os0 2 = " hold:;
hold = ns0(0);
cerr "RC ns0 0 = " hold:;
hold = ns0(1);
cerr "RC ns0 1 = " hold:;
hold = ns0(2);
cerr "RC ns0 2 = " hold:;
hold = oc0(0);
cerr "RC oc0 0 = " hold:;
hold = oc0(1);
cerr "RC oc0 1 = " hold:;
hold = oc0(2);
cerr "RC oc0 2 = " hold:;
hold = nc0(0);
cerr "RC nc0 0 = " hold:;
hold = nc0(1);
cerr "RC nc0 1 = " hold:;
hold = nc0(2);
cerr "RC nc0 2 = " hold:;
hold = ond(0);
cerr "RC ond 0 = " hold:;
hold = ond(1);
cerr "RC ond 1 = " hold:;
hold = ond(2);
cerr "RC ond 2 = " hold:;
hold = nnd(0);
cerr "RC nnd 0 = " hold:;
hold = nnd(1);
cerr "RC nnd 1 = " hold:;
hold = nnd(2);
cerr "RC nnd 2 = " hold:;
hold = odr(0);
cerr "RC odr 0 = " hold:;
hold = odr(1);
cerr "RC odr 1 = " hold:;
hold = odr(2);
cerr "RC odr 2 = " hold:;
hold = ndr(0);
cerr "RC ndr 0 = " hold:;
hold = ndr(1);
cerr "RC ndr 1 = " hold:;
hold = ndr(2);
cerr "RC ndr 2 = " hold:;
hold = ohd(0);
cerr "RC ohd 0 = " hold:;
hold = ohd(1);
cerr "RC ohd 1 = " hold:;
hold = ohd(2);
cerr "RC ohd 2 = " hold:;
hold = nhd(0);
cerr "RC nhd 0 = " hold:;
hold = nhd(1);
cerr "RC nhd 1 = " hold:;
hold = nhd(2);
cerr "RC nhd 2 = " hold:;
hold = ocall(1);
cerr "RC ocall = " hold:;
hold = ncall(1);
cerr "RC ncall = " hold:;
hold = ocallN(1);
cerr "RC ocallN = " hold:;
hold = ncallO(1);
cerr "RC ncallO = " hold:;
hold = obare(2);
cerr "RC obare 2 = " hold:;
hold = nbare(2);
cerr "RC nbare 2 = " hold:;
cerr "RC SENTINEL":;
stop();
