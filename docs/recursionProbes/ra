Start();
include(utilities);
include(unitTests);
registry(fILEs);
define
    kantGrammar File='incant/kantGrammar';
    ;
include(kantGrammar);
search reset stack KantGrammar Grokking;
search Utilities UnitTests;
registry(NewReturnKindT);
define
    rkReq owner source result rule;
    rkNew code={
        rkSrc := argument.CodE;
        rkReq.owner  := argument;
        rkReq.source := rkSrc;
        rkReq.rule   := KantGrammar["STARt"];
        if compileIn(rkReq);
            rkBlock = rkReq.result;
            *rkBlock :. noPrinT;
            argument :. isActioN;
            argument +< *rkBlock;
        };
    oPrint code={ cerr "RA print arg=" argument:; };
    nPrint code={ cerr "RA print arg=" argument:; };
    oKind code={ k := argument.datA; h := *argument.datA; cerr "RA kind bare=" k " star=" h:; };
    nKind code={ k := argument.datA; h := *argument.datA; cerr "RA kind bare=" k " star=" h:; };
    oLt code={ if argument < 1; cerr "RA lt yes":; else cerr "RA lt no":; };
    nLt code={ if argument < 1; cerr "RA lt yes":; else cerr "RA lt no":; };
    oLtS code={ if *argument < 1; cerr "RA ltstar yes":; else cerr "RA ltstar no":; };
    nLtS code={ if *argument < 1; cerr "RA ltstar yes":; else cerr "RA ltstar no":; };
    oMinus code={ x = argument - 1; cerr "RA minus x=" x:; };
    nMinus code={ x = argument - 1; cerr "RA minus x=" x:; };
    oMinusS code={ x = *argument - 1; cerr "RA minusstar x=" x:; };
    nMinusS code={ x = *argument - 1; cerr "RA minusstar x=" x:; };
    oCopy code={ y = argument; z = y - 1; cerr "RA copied y=" y " z=" z:; };
    nCopy code={ y = argument; z = y - 1; cerr "RA copied y=" y " z=" z:; };
    oTyped code={ y = 0; y = argument; z = y - 1; cerr "RA typedcopy y=" y " z=" z:; };
    nTyped code={ y = 0; y = argument; z = y - 1; cerr "RA typedcopy y=" y " z=" z:; };
    oPlus code={ x = 1 + argument; cerr "RA argright x=" x:; };
    nPlus code={ x = 1 + argument; cerr "RA argright x=" x:; };
    hold;
    ;
search NewReturnKindT;
rkNew(nPrint);
rkNew(nKind);
rkNew(nLt);
rkNew(nLtS);
rkNew(nMinus);
rkNew(nMinusS);
rkNew(nCopy);
rkNew(nTyped);
rkNew(nPlus);
cerr "RA == oPrint 0":;
oPrint(0);
cerr "RA == nPrint 0":;
nPrint(0);
cerr "RA == oPrint 3":;
oPrint(3);
cerr "RA == nPrint 3":;
nPrint(3);
cerr "RA == oKind 0":;
oKind(0);
cerr "RA == nKind 0":;
nKind(0);
cerr "RA == oKind 3":;
oKind(3);
cerr "RA == nKind 3":;
nKind(3);
cerr "RA == oLt 0":;
oLt(0);
cerr "RA == nLt 0":;
nLt(0);
cerr "RA == oLt 3":;
oLt(3);
cerr "RA == nLt 3":;
nLt(3);
cerr "RA == oLtS 0":;
oLtS(0);
cerr "RA == nLtS 0":;
nLtS(0);
cerr "RA == oLtS 3":;
oLtS(3);
cerr "RA == nLtS 3":;
nLtS(3);
cerr "RA == oMinus 0":;
oMinus(0);
cerr "RA == nMinus 0":;
nMinus(0);
cerr "RA == oMinus 3":;
oMinus(3);
cerr "RA == nMinus 3":;
nMinus(3);
cerr "RA == oMinusS 0":;
oMinusS(0);
cerr "RA == nMinusS 0":;
nMinusS(0);
cerr "RA == oMinusS 3":;
oMinusS(3);
cerr "RA == nMinusS 3":;
nMinusS(3);
cerr "RA == oCopy 0":;
oCopy(0);
cerr "RA == nCopy 0":;
nCopy(0);
cerr "RA == oCopy 3":;
oCopy(3);
cerr "RA == nCopy 3":;
nCopy(3);
cerr "RA == oTyped 0":;
oTyped(0);
cerr "RA == nTyped 0":;
nTyped(0);
cerr "RA == oTyped 3":;
oTyped(3);
cerr "RA == nTyped 3":;
nTyped(3);
cerr "RA == oPlus 0":;
oPlus(0);
cerr "RA == nPlus 0":;
nPlus(0);
cerr "RA == oPlus 3":;
oPlus(3);
cerr "RA == nPlus 3":;
nPlus(3);
cerr "RA SENTINEL":;
stop();
