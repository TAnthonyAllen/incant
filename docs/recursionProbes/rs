Start();
include(utilities);
include(unitTests);
registry(fILEs);
define
    kantGrammar File='incant/kantGrammar';
    ;
include(kantGrammar);
search reset stack KantGrammar Grokking;
search Utilities UnitTests;
registry(NewReturnKindT);
define
    rkReq owner source result rule;
    rkNew code={
        rkSrc := argument.CodE;
        rkReq.owner  := argument;
        rkReq.source := rkSrc;
        rkReq.rule   := KantGrammar["STARt"];
        if compileIn(rkReq);
            rkBlock = rkReq.result;
            *rkBlock :. noPrinT;
            argument :. isActioN;
            argument +< *rkBlock;
        };

    ns1 code={ cerr "RS  ns1 entry arg=" argument:; if *argument < 1; return "s"; r = ns1(*argument - 1); return r; };
    ns2 code={ cerr "RS  ns2 entry arg=" argument:; if *argument < 1; return 1.5; r = ns2(*argument - 1); return r; };
    ns3 code={ cerr "RS  ns3 entry arg=" argument:; if *argument < 1; return 5; r = ns3(*argument - 1); return r; };
    ns4 code={ if *argument < 1; return "s"; return ns4(*argument - 1); };
    os1 code={ cerr "RS  os1 entry arg=" argument:; if *argument < 1; return "s"; r = os1(*argument - 1); return r; };
    hold;
    ;
search NewReturnKindT;
rkNew(ns1);
rkNew(ns2);
rkNew(ns3);
rkNew(ns4);
hold = ns1(0);
cerr "RS ns1 0 = " hold:;
hold = ns1(1);
cerr "RS ns1 1 = " hold:;
hold = ns1(3);
cerr "RS ns1 3 = " hold:;
hold = ns2(0);
cerr "RS ns2 0 = " hold:;
hold = ns2(2);
cerr "RS ns2 2 = " hold:;
hold = ns3(0);
cerr "RS ns3 0 = " hold:;
hold = ns3(2);
cerr "RS ns3 2 = " hold:;
hold = ns4(0);
cerr "RS ns4 0 = " hold:;
hold = ns4(2);
cerr "RS ns4 2 = " hold:;
hold = os1(0);
cerr "RS os1 0 = " hold:;
hold = os1(2);
cerr "RS os1 2 = " hold:;
cerr "RS SENTINEL":;
stop();
