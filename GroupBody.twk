include /Users/anthony/Dropbox/data/InProcess/Groups/groupIncludes

/*******************************************************************************
	The body of a GroupItem containing its data
*******************************************************************************/
class GroupBody
{
String          tag;
GroupList       groupList;
GroupItem       registry;
PLGset          guardSet;
union
    GroupItem       &gMethod(GroupItem);
    GroupItem       &gOp(GroupItem,GroupItem);
    ;
/*  gJitEmitter -- the JIT emitter slot, step 2 of the jit separation.
    BESIDE the binding union and deliberately NOT INSIDE IT: an op must carry
    its interpreter binding (gMethod or gOp) and its emitter AT THE SAME TIME,
    so a union would make installing the emitter destroy the interpreter.
    Two arguments, uniform for both families -- a binary op is emitted from
    (argument,target) and a unary from (argument,target) with target unused,
    because the emitter fork is one call site and an arity split there would
    reintroduce the dispatch anatomy the jit does not inherit.  */
GroupItem       &gJitEmitter(GroupItem,GroupItem);
union
    String          gText;
    void            *gPointer;
    ;
union
    Buffer          gBuffer;
    char            gCharacter;
    PLGset          gCharacterSet;
    int             gCount;
    GroupItem       gGroup;
    PLGitem         gItem;
    BitMAP          gMap;
    double          gNumber;
    Object          gObject;
    PLGrgx          gRegex;
    Stak            gStak;
    ;

/******************************************************************************
	Basic traits relating to gml
******************************************************************************/
boolean bools {
    isRule
    isLabel
    noPrint
    invoke
    fLAG
    data:5[isANY isCHAR isSET isBUFFER isCOUNT isGROUP isITEM isMAP isNUMBER isOBJECT isREGEX isSTAK isSTRING isTOKEN]
    actionType:2[isAction isCoded]
    binType:3[isBIN isCLASS isLIST isREGISTRY]
    fileType:2[isDirectory isExec isFile]
    guarding:2[guarded unGuarded guardInProcess]
    instructType:2[isMethod isOperator]
    isBranch:2[isBreak isContinue isReturn]
    isSorted:2[sortAscending sortDescending]
    methodType:2[immediateACTION parseACTION]

    addingMembers
    altered
    byRef
    debugged
    debugGuard
    deferred
    hasAttributes
    hasListeners
    hasMembers
    isArgument
    isAssign
    isCondition
    isIndexed
    isInitialized
    isIterator
    isLiteral
    isLocal
    isMacro
    isPercent
    isPointer
    isShortcut
    isSingleton
    isToggle
    isUnary
    isVirtual
    isWindow
    isXP
    mergeOn
    negate
    recursive
    reversePrint
    tokened
    hasNewParse } flags;
	
/*****************************************************************************
	Constructors uses default constructor
*****************************************************************************/
GroupBody()
{
    tag = "dummy";
}

GroupBody(String s)
{
    tag = s;
}
}

