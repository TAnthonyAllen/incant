include groupIncludes

/******************************************************************************
	An extendable list of GroupItems.
******************************************************************************/
class GroupControl
{
GroupRules      groupRules;
PLGset          cdataSet,
                endNameSet,
                mustQuoteSet;
DispatchQ       dispatchQ;
static GroupControl groupController;

/******************************************************************************
	GroupControl constructor
******************************************************************************/
GroupControl(int i)
{
	cdataSet		        = new("'<>&\"");
    endNameSet              = new("-~+?!%&|*@_<^ \n\r\t/;.,:='$#\\\"'()[]{}");
	mustQuoteSet            = new(" +?*:!#/@|$%<>~.,;=()\"[\r\t\n'{}");
    groupRules              = new;
}

/*******************************************************************************
	Add the registry passed in to the list of base registries
*******************************************************************************/
void addBaseRegistry(GroupItem r)
{
    if !baseRegistryList        baseRegistryList = getRegistry("BaseRegistries");
    baseRegistryList += r;
}

/***************************************************************************
	Debugging routine to list out the registry search list
***************************************************************************/
void dumpSearchList()
{
GroupItem   registri;
    cout "Search list: ":;
    while registri = searchList.next(registri)
        if isREGISTRY cout `registri.tag:;
    if baseRegistryList
        {
        cout "Base Search list: ":;
        registri = null;
        while registri = baseRegistryList.next(registri)
            if isREGISTRY cout `registri.tag:;
        }
}

/***************************************************************************
    Registry factory
***************************************************************************/
GroupItem getRegistry(String c)
{
GroupItem registri;
    if registries   registri = registries.getFromList(c);
    if !registri
        {
        /*******************************************************************
            Set the registry
        *******************************************************************/
        registri        = new(c);
        isREGISTRY      = true;
        sortAscending   = true;
        registry        = registri;
        if registries   registri = registries += registri;
        }
    return registri;
}

/******************************************************************************
    Locate a group looking for it in the usual suspects.
******************************************************************************/
GroupItem locate(String name)
{
GroupItem   registri,
            group = registries[name];
GroupRules  ruler = groupRules;
    if !group && currentRegistry    group = currentRegistry[name];
    if group                        return group;
    while registri = searchList.next(registri)
        if group = registri[name]   return group;
    while registri = baseRegistryList.next(registri)
        if group = registri[name]   return group;
    if name eq registries.tag       group = registries;
    return group;
}

/******************************************************************************
	Locate a group looking for it in the usual suspects.
******************************************************************************/
GroupItem locate(String name)
{
GroupItem   registri,
            group = registries[name];
GroupRules  ruler = groupRules;
    if !group && currentRegistry    group = currentRegistry[name];
    if group                        return group;
    while registri = searchList.next(registri)
        if group = registri[name]   return group;
    while registri = baseRegistryList.next(registri)
        if group = registri[name]   return group;
    if name eq registries.tag       group = registries;
    return group;
}

/******************************************************************************
	This version of locate searches for a group matching text of item passed in.
******************************************************************************/
GroupItem locate(GroupItem item)
{
String      name = item.text;
    return locate(name);
}

/******************************************************************************
	locateInMethod when processing code, looks for a group matching name in
    local fields before calling locate()
******************************************************************************/
GroupItem locateInMethod(String name)
{
GroupItem   action = currentMETHOD,
            result;
    if processingCode   result = action % name;
    if !result  result = locate(name);
    return  result;
}

/***************************************************************************
    Create a block and initialize content
***************************************************************************/
void setBaseRegistries()
{
GroupItem   action;
    fieldBUFFER             = new;
    stringBUFFER            = new("string buffer");
    formatBUFFER            = new("format buffer");
    registries              = getRegistry("registries");
    registries.registry     = registries;
    registries.groupList    = new(registries);
    inDENT                  = new("indenter");
    inDENT.isCOUNT          = true;
    /***********************************************************************
        Create properties registry and add groups to it
    ***********************************************************************/
    properties  = getRegistry("pROPERTIEs");
    trueResult              = properties += new("fieldBUFFER");
    trueResult.buffer       = fieldBUFFER;
    trueResult              = properties += new("true");
    trueResult.count        = 1;
    trueResult.noPrint      = true;
    falseResult             = properties += new("false");
    falseResult.isCOUNT     = true;
    falseResult.noPrint     = true;
    /*  labelNO -- the return channel's third value (LA''-0, PC-3, 2026-08-07).
        NULL = failed · labelNO = succeeded and yields NOTHING · any other node
        = succeeded and yields that node.

        ⚠ isCOUNT, VALUE 0, AND THAT IS THE WHOLE OF PC-3's ANSWER. The
        "yields nothing" meaning lives in labelNO's IDENTITY -- `lab == labelNO`
        -- and NOT in its numeric reading. That distinction is what lets the row
        land without an engine divergence.

        The alternative was to leave it non-numeric, and it does not work: the
        JIT's value channel is an i32 alloca (jitEmitters.rtn:1984), so a jitted
        empty construct yields the integer 0 and CANNOT yield a GroupItem at
        all. Making labelNO non-numeric would have put the interpreter and the
        JIT into permanent disagreement about what an empty construct is worth
        -- measured as ladder rung JV going red -- and closing that would mean
        widening the JIT's entire value representation, which is the frame arc
        and not this row.

        With isCOUNT it reads 0 exactly as falseResult did, so BOTH ENGINES
        STILL AGREE and JV needs no re-pin; what is new is only that the attach
        can now TELL "nothing" from "the number zero", which is the one thing
        it could never do before.  */
    labelNO                 = properties += new("labelNO");
    labelNO.isCOUNT         = true;
    labelNO.noPrint         = true;
    lastREF                 = properties += new("lastREF");

    /***********************************************************************
        Create other base registries
    ***********************************************************************/
    keyWords    = getRegistry("Keywords");
    opFields    = getRegistry("Operators");
    opFields.isSorted   = false;
    opFields.isOperator = true;
    groupFields = getRegistry("GroupFields");
    commands    = getRegistry("cOMMANDs");
    files       = getRegistry("fILEs");
    bcOPs       = getRegistry("bcOPs");
    bcOPs.isOperator    = true;
    addBaseRegistry(properties);
    addBaseRegistry(opFields);
    addBaseRegistry(commands);
    addBaseRegistry(files);
    addBaseRegistry(keyWords);
    addBaseRegistry(groupFields);
    /***********************************************************************
        Initialize commands needed by the rule parser (associating those
        commands w/their methods). A bit of bootstrapping. Once done the
        parser can take over command initialization.
    ***********************************************************************/
    action  = commands += "immediateAction";
    action.method   = setRuleAction;
    action.immediateACTION  = true;
    action.noPrint  = true;
    action.registry = commands;
    action  = commands += "noPrint";
    action.method   = processFlags;
    action.immediateACTION   = true;
    action.noPrint  = true;
    action.registry = commands;
    printSPACE      = new("printSPACE");
    printSPACE.text = " ";
    /***********************************************************************
        maxLimit -- the ceiling modify() stamps into rStuff.max for the `+`
        and `*` modifiers, replacing the inline -0xefffffff it used to
        write. Ordinary user-visible data in pROPERTIEs, so a grammar sets
        it the way it sets any other property.

        ⚠ modify() STAMPS max AT RULE-DEFINITION TIME, so a change to
        maxLimit affects only rules defined AFTER it. Set it before the
        grammar loads, never mid-session. The stamp is deliberate rather
        than a defect: the comparison it feeds sits on the hottest loop in
        the parser, and a live field read there would be paid for on every
        character of every match.

        ⚠⚠ THE VALUE BELOW IS THE STATUS QUO, NOT THE INTENDED DEFAULT, and
        that is on purpose. 268435457 is exactly what -0xefffffff evaluated
        to, so this change is behaviour-neutral by construction. The
        intended default is 100 and it is NOT pinned until the high-water
        measurement has run -- docs/fixIts.md F-27. The reason that
        measurement is owed rather than optional: this same max ALSO bounds
        parse()'s repetition loop at GroupItem.twk:1339, so the ceiling
        caps how many TIMES a rule may repeat, not only how many characters
        one match may span.
    ***********************************************************************/
    maxLimit        = new("maxLimit");
    maxLimit.count  = 268435457;
    properties += inDENT;
    properties += printSPACE;
    properties += maxLimit;
}
}
