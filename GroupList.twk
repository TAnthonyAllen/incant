include /Users/anthony/Dropbox/data/InProcess/Groups/groupIncludes

/*******************************************************************************
	A skeleton class containing a group list (used in GroupBody)
*******************************************************************************/
class GroupList
{
GroupItem       firstInList,
                lastInList;
int			    listLength;
GroupStak       stakked;
	
/*****************************************************************************
	Constructors
*****************************************************************************/
GroupList()
{
}

GroupList(GroupItem item)
{
    // listHasNoSet  a LIST is a value, not a bin: it gets no first-character set (c4, SEQ 322)
    if binType && !isLIST {
        PLGset  set = new;
        name            = tag "InSet":;
        if !guardSet    guardSet = new;
        setCharacterSet(set);
        guarded         = true; }
}

/***************************************************************************
	Clear the list.
***************************************************************************/
void clear()
{
    firstInList = lastInList = null;
    listLength  = 0;
    if stakked  stakked.clearStak();
}
}

