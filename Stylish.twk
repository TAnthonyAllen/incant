/*******************************************************************************
	Defined as class but just a structure really to encapsulate style attributes
*******************************************************************************/
class Stylish
{
String      styling;
Shadow      shadow;
double      borderWidth,
            radius,
            transparency;
Color       bgColor,
            fillColor,
            strokeColor,
            textColor;
Font        font;
GroupItem   shadowField;
NumberFormatter formatter;
boolean
        editable
        selected
        selectable
        subbed
		;

Stylish(GroupItem item)
{
    strokeColor = blackColor;
    textColor   = blackColor;
    styling     = item.tag;
	// This just zeros out everything
}

Stylish(String name)
{
    strokeColor = blackColor;
    textColor   = blackColor;
	styling     = name;
}

Stylish(GroupItem item,Stylish source)
{
#initNOT
	*this       = *source;
    styling     = item.tag;
}
}

/*******************************************************************************
	Return the lowest descendent block that contains the point passed in.
    Assumes the base passed in contains the point.
*******************************************************************************/
extern GroupItem blockContaining(GroupItem base,Point p)
{
GroupItem   item,
            grup;
Stylish     style;
    if base {
        //if detail = base.other cout "blockContaining",base.tag,frame,"Point:",p.x,p.y:;
        while item = base.nextMember(item) {
            style = getStyle(item);
            if item.contains(p)
                if item.hasMembers || !item.noPrint
                    if !selectable continue;
                    else break; }
        if item && item.hasMembers
            if grup = item.blockContaining(p)   return grup; }
    return item;
}

/*****************************************************************************
	Check if point is in the field frame
*****************************************************************************/
extern int contains(GroupItem field,Point p)
{
Frame   frame = getFrame(field);
double	top, right;
	//cout "Checking " wig.tag "\n";
	if y > frame.y && x > frame.x {
		top		= frame.y + frame.height;
		right	= frame.x + frame.width;
		return y <= top && x <= right; }
	return false;
}

/*******************************************************************************
    Look up the color in the cOLOr registry, set its color object if needed and
    return the color object.
*******************************************************************************/
extern Color getColor(String name)
{
Color       color;
GroupItem   item = locate(name);
    if item {
        if !isOBJECT    setColor(item);
        if !(color = item.object)   cerr "getColor: ERROR could not get color",name:; }
    else    cerr "getColor: ERROR could not find",name:;
    return color;
}

/*******************************************************************************
	Debug: setColor a field then print its resulting RGB components (0.0-1.0),
    to verify setColor's hex parse + scale. POP tool, not called from
    production paths.
*******************************************************************************/
extern void dumpColorRGB(GroupItem field)
{
    setColor(field);
    -%
    NSColor *c = (NSColor*)field->getObject();
    if (c) {
        CGFloat r = 0, g = 0, b = 0, a = 0;
        [c getRed:&r green:&g blue:&b alpha:&a];
        printf("dumpColorRGB %s: r=%.3f g=%.3f b=%.3f a=%.3f\n", field->getText(), r, g, b, a);
    } else printf("dumpColorRGB %s: NULL\n", field->getText());
    %-
}

/***************************************************************************
	Return the style for the field passed in. If the field has no style
    attribute, it walks the parent hierarchy and returns the first style
    it finds.
***************************************************************************/
extern Stylish getStyle(GroupItem field)
{
GroupItem   style:,
            grup = field;
Stylish     styled;
    if !style
        while grup = parent
            if style = grup["style"]    break;
    if style    styled = style.pointer;
    else        styled = makeStyleFor(field);
    return  styled;
}

/*******************************************************************************
	The indentFrame methods resize and reposition a frame. POP required to
    make sure they do what is intended wrt frame position. Named indentFrame*
    (not indent/indentWH) — those names collide at C linkage with the
    unrelated debug-print indent() in the shared support StringRoutines.C.
*******************************************************************************/
extern Frame indentFrame(Frame f,double b)
{
	return rectangle(x + b,y + b, width - 2 * b,height - 2 * b);
}

extern Frame indentFrameWH(Frame f,double w,double h)
{
	return rectangle(x + w,y + h, width - 2 * w,height - 2 * h);
}

/***************************************************************************
	Converts a color hex code into a color object
    Note: cOLORs registry stores color hex as a string like "rrggbb"
***************************************************************************/
extern void setColor(GroupItem field)
{
String      atPart = text;
GroupItem   hexSet = properties["hexSet"];
PLGset      set = characterSet;
unsigned int    isValid,
                red,
                green,
                blue;
use stringBUFFER
use field
    isValid = set.contains(atPart);
    if !isValid || strlen(atPart) != 6      cout "ERROR: expected a valid six character hex string not:" atPart:;
    else {
        Color       color;
        stringBUFFER.reset();
        stringBUFFER    += atPart;
        atPart  = start + 4;
        sscanf(atPart,"%x",&blue);
        *atPart = 0;
        atPart  = start + 2;
        sscanf(atPart,"%x",&green);
        *atPart = 0;
        atPart  = start;
        sscanf(atPart,"%x",&red);
        stringBUFFER.reset();
        color = rgbColor((double)red / 255.0,(double)green / 255.0,(double)blue / 255.0,1.0);
        object = color; }
}

/*******************************************************************************
	Process shadow. This compiles but design required plus POP to make sure
    shadow and shadowField are set right and in sync.
*******************************************************************************/
extern void sHADOW(GroupItem field)
{
Stylish shadowStyle = getStyle(field);
    if !shadow
        {
        shadow = new;
        hold((void*)shadow);
        }
    if shadowField {
        GroupItem   shadowBlur = shadowField["blur"];
        GroupItem   shadowColor = shadowField["color"];
        GroupItem   xOffset = shadowField["x"];
        GroupItem   yOffset = shadowField["y"];
        shadowStyle = getStyle(shadowField);
        if shadowBlur shadow.blur(shadowBlur.number);
        else shadow.blur(3.0);
        if shadowColor && shadowColor.isPointer {
            Color coloric = shadowColor.pointer;
            shadow.color(coloric); }
        else shadow.color(black.alpha(0.3));
        if xOffset && yOffset   shadow.offset(sized(xOffset.number,yOffset.number));
        else shadow.offset(sized(2.0,-2.0));
        }
}

/***************************************************************************
	Sets font object based on font attributes. May require revision after
    font design session.
***************************************************************************/
extern void setFont(GroupItem field)
{
GroupItem   family = field["family"],
            size = field["size"],
            bold = field["bold"],
            italic = field["italic"];
NSString    name = family.text;
int         mask;
unsigned int    boldMask;
unsigned int    italicMask;
Font        font;
use field
    font = fontWithName(name,size.number);
    if bold {
        boldMask = bold.count;
        mask &= boldMask; }
    if italic {
        italicMask = italic.count;
        mask &= italicMask; }
    hold((void*)font);
    object  = font;
}

/*******************************************************************************
	Assign a style to the field passed in, which is expected to be a style
    attribute. Looks up styles in sTYLEs registry that does not exist yet.
*******************************************************************************/
extern Stylish makeStyleFor(GroupItem field)
{
String          name    = text;
GroupItem       styles  = registries["sTYLEs"];
GroupItem       styleItem;
Stylish         style;
    if !styles {
        cerr "makeStyleFor",tag,"ERROR: could not find sTYLEs registry":;
        return style;}
    if !name {
        cerr "makeStyleFor",tag,"ERROR: style attribute has to have text to specify a name":;
        return style;}
    if styleItem = styles[name]     style = styleItem.pointer;
    else {
        style = new(name);
        styleItem   = new(name);
        styleItem.pointer = style;
        styles += styleItem; }
    styleItem = new("style");
    styleItem.pointer = style;
    field +% styleItem;
    return style;
}
